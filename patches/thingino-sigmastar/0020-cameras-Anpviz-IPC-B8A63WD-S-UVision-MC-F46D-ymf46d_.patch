index 000000000..3a7fc8e1d
--- /dev/null
+++ b/configs/cameras/ymf46d_ssc377d_gc4653/ymf46d_ssc377d_gc4653.kernel.config
@@ -0,0 +1,36 @@
+# Kernel config fragment for the Anjvision YMF46D / Anpviz IPC-B8A63WD-S
+# (ymf46d_ssc377d_gc4653), merged over
+# board/sigmastar/infinity6c/kernel/5.10/infinity6c.config.
+#
+# Same approach as the JL12D2 and MC-A85 fragments: boot under the OEM U-Boot
+# (the ANJOY888 .bin install keeps it) and force the kernel command line.
+#
+# The memory split is THIS board's, read from the running OEM kernel
+# (/proc/cmdline on the bench unit, 2026-10-25): LX_MEM=0x8000000 (128 MB)
+# and a 70 MB MMA (sz=0x4600000; the JL12D2 runs 0x4750000). Partition
+# offsets are identical to the JL12D2 and MC-A85:
+#   nor0:0x30000(BOOT),0x200000(kernel),0xCD0000(rootfs),0x100000(DATA)
+CONFIG_CMDLINE="console=ttyS0,115200 panic=20 root=/dev/mtdblock2 rootfstype=squashfs ro init=/init mtdparts=NOR_FLASH:0x30000(BOOT),0x200000(kernel),0xCD0000(rootfs),0x100000(data) LX_MEM=0x8000000 mma_heap=mma_heap_name0,miu=0,sz=0x4600000 mma_memblock_remove=1 cma=2M"
+CONFIG_CMDLINE_FORCE=y
+# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
+# CONFIG_CMDLINE_EXTEND is not set
+
+# This board's own DTB (board DTS patch 0004). Decoded from this unit's OEM
+# device tree, the board wiring matches the JL12D2's exactly: the same padmux
+# schematic triplets (only reordered), and byte-identical csi/vif sr0 MIPI
+# properties (lane_pn_swap all 0, mipi_rst_mode 3, mipi_pdn_mode 0,
+# lane_num 4, lane_select 3 1 2 4 5). Everything else that differs is the
+# older BSP (2023-06 vs 2024-12): clock nodes, i2c node names, sdmmc property
+# names. So the shared wiring is one include, infinity6c-ssc377d-anjvision.dtsi
+# (patch 0002), and this board's .dts adds only its model string and its
+# lights (the same pads as the JL12D2 today, but its own lines), so a JL12D2
+# board change no longer reaches this camera.
+CONFIG_SS_DTB_NAME="infinity6c-ssc377d-ymf46d"
+
+# microSD (one slot on SDIO IP 1). Modules, not built in, as the OEM loads
+# kdrv_sdmmc.ko: a probe that goes wrong then cannot stop the boot or the
+# network. exFAT for cards over 32 GB (the OEM ships exfat.ko too).
+CONFIG_MMC=m
+CONFIG_MMC_BLOCK=m
+CONFIG_MS_SDMMC=m
+CONFIG_EXFAT_FS=m
diff --git a/configs/cameras/ymf46d_ssc377d_gc4653/ymf46d_ssc377d_gc4653_defconfig b/configs/cameras/ymf46d_ssc377d_gc4653/ymf46d_ssc377d_gc4653_defconfig
new file mode 100644
index 000000000..152c5694d
--- /dev/null
+++ b/configs/cameras/ymf46d_ssc377d_gc4653/ymf46d_ssc377d_gc4653_defconfig
@@ -0,0 +1,196 @@
+# NAME: Anjvision YMF46D / Anpviz IPC-B8A63WD-S (UVision MC-F46D) — SSC377D, Infinity6C, GC4653
+#
+# Anpviz U-Series metal bullet, dual light. OEM firmware
+# YMF46D_IRC_N_AF_V4-A_Y_EN-RTMP-H5_L V3.4.2.2 (2025-06-11) on kernel 5.10.61
+# #20 (2023-06-12), MI build project 37fc3a2 / sdk 3ed7737 / mhal 6a8e4b0
+# (2023-03-21). Two units on the bench (2026-10-25), hardware-identical.
+#
+# Board:  SigmaStar SSC027A-S01A reference design, Infinity6C, 128 MB DDR.
+#         The OEM device tree's board wiring (padmux schematic, csi/vif sr0
+#         MIPI properties) is identical to the JL12D2's -- only BSP-version
+#         renames differ (clock tree, i2c node names, sdmmc property names) --
+#         so its board DTB shares the JL12D2's include and adds its own model
+#         string and lights. See the kernel fragment.
+# Sensor: GalaxyCore GC4653, 2560x1440 (16:9) 10-bit, MIPI 2-lane, 27 MHz
+#         MCLK, I2C 0x52 (8-bit). The OEM loads its own gc4653_MIPI.ko with
+#         chmap=1 on sensor pad 0, and mirrors + flips it (pad 0 bmirror=1
+#         bflip=1 in mi_sensor0). Marketed "6 MP": the OEM encodes 3072x2048
+#         (cust_video_res.txt), an ISP upscale of the 3.7 MP sensor.
+# Flash:  16 MB SPI NOR (GigaDevice c8 40 18), OEM layout identical to the
+#         JL12D2 and MC-A85: BOOT 0x30000 | kernel 0x200000 | rootfs 0xCD0000 |
+#         DATA 0x100000.
+# FRAG: soc-sigmastar core-sigmastar
+
+BR2_SOC_VENDOR_SIGMASTAR=y
+BR2_SIGMASTAR_SOC_MODEL="ssc377d"
+
+# ---- SENSOR ----
+# No GC4653 driver ships prebuilt in the 1230 drop (only imx335 + imx307), so
+# build the family's sensor-src against the 1230-matching headers from
+# sigmastar-sensor-headers -- the MC-A85's GC8613 path (every board sets
+# BR2_SIGMASTAR_SENSOR_SOURCE, so every image carries the same drivers).
+# load_sigmastar inserts sensor_gc4653_mipi.ko with chmap=1, as the OEM does.
+BR2_SENSOR_1_NAME="gc4653"
+BR2_SIGMASTAR_SENSOR_SOURCE=y
+
+FLASH_SIZE_MB=16
+
+# Wired Ethernet: installs the eth0 DHCP stanza (thingino-ethernet).
+BR2_ETHERNET=y
+
+# Forced kernel command line (OEM U-Boot layout + this board's memory split)
+# and the board DTB. See the fragment.
+BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THINGINO_PATH)/configs/cameras/ymf46d_ssc377d_gc4653/ymf46d_ssc377d_gc4653.kernel.config"
+
+# Toolchain -- identical to the other Infinity6C targets (see
+# mcl12d2_ssc377d_imx335_defconfig for why each line is here).
+BR2_THINGINO_TOOLCHAIN_LIBC_UCLIBC=y
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
+BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
+BR2_TOOLCHAIN_EXTERNAL_URL="file://$(HOME)/src/mirrors/releases/johnchia__thingino-firmware/toolchain-x86_64/thingino-toolchain-x86_64_infinity6e_uclibc_gcc16-linux-arm.tar.gz"
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-thingino-linux-uclibcgnueabihf"
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM_UCLIBC=y
+BR2_TOOLCHAIN_EXTERNAL_GCC_16=y
+BR2_TOOLCHAIN_EXTERNAL_CXX=y
+BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
+BR2_TOOLCHAIN_EXTERNAL_LOCALE=y
+BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_DEBUG=y
+BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
+# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
+BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
+
+# Builds BOOT.bin; never flashed (the OEM U-Boot stays).
+BR2_PACKAGE_SIGMASTAR_UBOOT=y
+
+BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_THINGINO_PATH)/board/sigmastar/post-image.sh"
+
+BR2_THINGINO_DEV_IPCAM=y
+
+BR2_PACKAGE_DROPBEAR=y
+
+# No VPN -- see mcl12d2_ssc377d_imx335_defconfig.
+BR2_PACKAGE_THINGINO_VPN_NONE=y
+
+BR2_PACKAGE_ZLIB=y
+
+# ---- ISP TUNING ----
+# The OEM ships no GC4653 tuning by that name: CUS3A's iqfile0-3 link to
+# imx307_iqfile.bin, an older-format file the 1230 ISP rejects, so CUS3A gets
+# the drop's generic iqfile0.bin (sigmastar-sdk aliases iqfile1.bin to it).
+# The per-sensor API bin raptor loads on the first frame is the OEM's own
+# day tuning, /config/iqfile/gc4023_day.bin (137832 B, md5
+# fd2b26904ee4f766efecd8237cfe93cc; isp_source.txt names its source
+# cfg/gc4653_f46d; media_server's CIspGc4023 class loads it -- the name is a
+# vendor leftover, as on the MC-A85). Same container + version (1.2) as the
+# MC-A85's gc8613.bin, which raptor accepts on 1230 with a minor-version
+# warning. Proprietary: copied into the build tree only, never into git.
+BR2_SENSOR_1_IQ_FILE="configs/cameras/ymf46d_ssc377d_gc4653/gc4653.bin"
+
+# 60 Hz mains (US), as on the MC-A85.
+
+# ---- SENSOR IDENTITY FOR RVD ----
+# 7-bit address, raptor.conf's convention (the driver's 8-bit slave is 0x52).
+# The Infinity6C backend does not use it; rvd will not start without it.
+
+# ---- STREAMS / OSD: native 16:9 ----
+# The Infinity6C backend scales the whole frame with no crop, so both streams
+# keep the sensor's 16:9. Main JPEG off and snapshots off the sub, the pattern
+# proven on the MC-A85 (4K) and JL12D2 (5 MP); 1440p leaves far more MMA free
+# than either: ~30 of 70 MB used with a sub and its JPEG. The sub is 960x540: a
+# 1280x720 cascaded sub needs 0x14400 of the encoder's 0x1d000 on-chip SRAM, and
+# at 720p the encoder wedged (dynamic SRAM ENOMEM, both streams dead) up to 13
+# times a day; at 960x540 the same unit ran a full day clean (2026-11-02/03).
+# Frigate scales its detect frames.
+
+# VBR with the cap written out: with max_bitrate 0 the Infinity6C backend caps
+# at the bitrate, but nothing in the config says so. Measured on a deployed unit with the whole-
+# frame ring below: main 3.2 Mbit/s under a 4 Mbit/s cap, sub 1.6 under 2,
+# both at 25 fps. Keyframes are ~330-370 KB in CBR and VBR alike (P frames
+# 0.5-2 KB); capping them needs the I-frame size knob the HAL does not have.
+# The GC4653's 25 fps on the sensor and both streams, 1 s GOPs: what rvd
+# defaults to here, written out so a profile states its own rates.
+
+# A whole-frame SCL->VENC ring (+4 MB MMA). With the HAL's quarter-frame ring
+# the scaler lapped the main encoder whenever it was busy with the 720p sub or
+# an IDR: 80% of main frames rewound on one unit and the main turned to all
+# IDRs at half rate.
+BR2_PACKAGE_THINGINO_RAPTOR_SCL_RING_DIV="1"
+
+# ---- WEBUI STREAM CHOICES ----
+# 16:9 sizes only (the backend scales without cropping); the sub is a cascade
+# off the main and cannot be larger. Every 5 fps up to the sensor's 25: the
+# main's rate sets the GC4653's (verified at 20: VIF 20.00, 50 ms spacing), and
+# the sub offers only rates that divide the main's. 1080p is not offered for
+# the sub: 1440p@25 + 1080p@25 is 144 Mpx/s against the SSC377's 150 and the
+# sub fell to 14 fps. 720p is not offered either: it wedges the encoder (above).
+BR2_PACKAGE_THINGINO_RAPTOR_UI_STREAM0_RESOLUTIONS="2560x1440 1920x1080"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_STREAM1_RESOLUTIONS="640x360 960x540"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_FPS="5 10 15 20 25"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_STREAM0_BITRATES="1000 2000 3000 4000 6000 8000"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_STREAM1_BITRATES="256 512 768 1000 1500 2000 3000"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_CODECS="h264 h265"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_PROFILES="baseline main high"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_RC_MODES="cbr vbr capped_vbr"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_GOP_SECONDS="1 2 4"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_JPEG_QUALITIES="50 60 75 85 95"
+
+# ---- RTSP ----
+# Four clients is not enough here: Frigate holds two (main + sub), the NVR
+# two more, and a live view or snapshot client then gets refused.
+
+# ---- ORIENTATION ----
+# With the ISP unflipped the picture is upside down against the stock unit
+# beside it (bench, 2026-10-25). The OEM's own driver reports the pad as
+# mirrored + flipped too, so its gc4653_MIPI.ko evidently inverts what the
+# sensor-src driver does. On this backend orientation is fixed when the ISP
+# channel is created (a live set-hflip is refused), so it belongs here.
+
+# ---- AUDIO ----
+# One AI device on this chip (the analog mic, ADC A/B); rad's default of
+# device 1 does not exist. Measured on the bench: 16 kHz mono, room level
+# around -21 dB. The speaker path (ao) does not initialise yet.
+# Off by choice (2026-10-26): the Zosi NVR played the AAC track
+# crackly, and no audio is wanted on this camera. The streams then carry
+# video only. Flip to TRUE to use the mic; device 0 above stays correct.
+
+# ---- DAY / NIGHT ----
+# IR-cut, from the OEM kernel's own GPIO labels and verified by pulsing each
+# line with frames grabbed after (pink IR glow with the filter out):
+#   gpio 11 "IRCUT A" -- pulsed = night (filter out)
+#   gpio 80 "IRCUT B" -- pulsed = day (filter in)
+# The MC-A85's polarity, so the same ric settings: gpio_ircut is the day
+# line, gpio_ircut2 the night one. The OEM also has an IRDET photosensor on
+# gpio 23 (digital, high in daylight); ric has no GPIO trigger, so the
+# trigger is luma, as tuned on the MC-A85. The
+# GC4653's thresholds are the MC-A85's, not yet checked at dusk.
+
+# ---- LIGHTS ----
+# Two PWM-dimmed banks at the OEM's 50 us period (OEM: PWM0 + PWM4):
+#   PAD_SPI0_CZ -> IR bank    -> PWM4
+#   PAD_PWM0    -> white bank -> PWM0 (PINMUX_FOR_PWM0_MODE_1, the OEM routing;
+#                  the board DTB moves the sensor's frame-sync wave to the
+#                  unconnected PWM2, which used to strobe this bank on PWM0)
+# Told apart on the bench from the AE: with the filter in, PWM4 changes
+# nothing and the white bank (then on PWM9) drops the total gain ~20%; with
+# it out, both do. sigmastar-light's /usr/sbin/light is thingino's light CLI
+# for the web UI buttons and S30light sets the channels up before raptor.
+# ric drives the IR bank through it.
+BR2_PACKAGE_SIGMASTAR_LIGHT_IR_PWM=4
+BR2_PACKAGE_SIGMASTAR_LIGHT_WHITE_PWM=0
+
+# ---- LENS / PTZ ----
+# Fixed lens, no lens board: lensd is built but does not run.
+BR2_PACKAGE_THINGINO_LENSD_MODE_OFF=y
+
+# ---- MICRO SD ----
+# MMC core, block, the SigmaStar SDIO driver and exFAT are kernel modules
+# (see the fragment), loaded at S11 from overlay/etc/modules.d/sdcard;
+# thingino's mdev rule mounts each partition at /mnt/<dev>. The slot is SDIO
+# IP 1 (the board DTS's sdmmc node, from the OEM tree). The mdev rule's
+# handler, /lib/mdev/automount (+ S30mdev's boot-time scan), is
+# BR2_PACKAGE_THINGINO_SYSTEM_AUTOMOUNT, which every board ships
+# (core-sigmastar.fragment). BR2_THINGINO_SDCARD would also select it, but it
+# pulls in the Ingenic MMC kernel options and U-Boot SD settings, which do not
+# apply here. Bench, 2026-10-25: a 128 GB SDXC card (FAT32) detected on
+# insertion and mounted read-write by the handler.
+# OVERLAY-HW: etc/modules.d/sdcard the microSD slot's modules, the same on every board with the slot
