+From: Andy <andylee77@users.noreply.github.com>
+Subject: [PATCH] ARM: dts: infinity6c: add the Anjvision YMF46D / Anpviz IPC-B8A63WD-S module
+
+Generated from infinity6c-ssc377d-ymf46d.dts by gen-board-dts-patch.sh (auto hunk count).
+
+---
+--- /dev/null
++++ b/arch/arm/boot/dts/infinity6c-ssc377d-ymf46d.dts
+@@ -0,0 +1,53 @@
++/*
++ * infinity6c-ssc377d-ymf46d.dts - Anjvision YMF46D / Anpviz IPC-B8A63WD-S
++ *
++ * SigmaStar SSC377D (Infinity6C) + GalaxyCore GC4653 (MIPI), 16 MB SPI NOR,
++ * 128 MB DDR. A fixed-lens bullet with an IR and a white LED bank and a
++ * microSD slot; the module is UVision's MC-F46D (OEM device type MCF46D).
++ *
++ * This program is free software; you can redistribute it and/or modify it
++ * under the terms of the GNU General Public License version 2, as published
++ * by the Free Software Foundation.
++ *
++ * The board wiring it shares with the JL12D2 (FUART, sensor MIPI and I2C,
++ * microSD) is in infinity6c-ssc377d-anjvision.dtsi: this unit's OEM device
++ * tree has the same padmux triplets and csi/vif sr0 properties. This file has
++ * the model string and the lights, from the same OEM tree:
++ *   - PAD_SPI0_CZ on PWM4: the IR bank;
++ *   - PAD_PWM0 on PWM0: the white bank. As on the JL12D2, the sensor's
++ *     frame-sync wave moves off PWM0 to the unconnected PWM2 (&vif below);
++ *   - PAD_PWM1 as ETH1_LED: the Ethernet activity LED.
++ * Bench check (2026-10-25), each bank lit alone at full duty: the PWM4 bank
++ * moves the AE only with the IR-cut filter out, the PAD_PWM0 bank cuts the
++ * total gain ~20% with it in.
++ *
++ * The OEM firmware also drives seven GPIOs from user space. Its GPIO table
++ * for this board names their roles: 12 the speaker amp enable (high while
++ * audio plays), 60 the reset button (active low), 10 and 61 alarm outputs,
++ * 44 an alarm input, 74 a Wi-Fi power enable. It also sets 30 (PAD_PM_GPIO4)
++ * high when it raises the CPU to 1 GHz (see the include's core_power note).
++ * None is bench-checked yet, so none is mapped here.
++ */
++
++#include "infinity6c-ssc377d-anjvision.dtsi"
++
++/ {
++	model = "Anjvision YMF46D / Anpviz IPC-B8A63WD-S (SSC377D + GC4653)";
++
++	soc {
++		padmux {
++			schematic =
++				<GPIO_NR         PINMUX_FOR_UNKNOWN_MODE       MDRV_PUSE_NA>,
++				/* LED banks; PAD_PWM0 on PWM0 (OEM routing); frame-sync moved off PWM0 in &vif */
++				<PAD_PWM0        PINMUX_FOR_PWM0_MODE_1        MDRV_PUSE_PWM0>,
++				<PAD_SPI0_CZ     PINMUX_FOR_PWM4_MODE_2        MDRV_PUSE_PWM4>,
++				/* Ethernet activity LED */
++				<PAD_PWM1        PINMUX_FOR_LED1_MODE_2        MDRV_PUSE_ETH1_LED>,
++				ANJV_SSC377D_PADMUX;
++		};
++	};
++};
++
++&vif {
++	vif_ds_rt_pwm_pin = <0x02>;	/* frame-sync off PWM0 -> unconnected PWM2, freeing PWM0 for the white LED */
++};
