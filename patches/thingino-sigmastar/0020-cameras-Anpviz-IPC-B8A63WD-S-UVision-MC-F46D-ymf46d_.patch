+#!/bin/sh
+# S30light -- set up the YMF46D LED PWM channels and leave both banks off.
+# Runs before S31raptor so ric's irled_cmd hook finds the channels ready.
+
+case "$1" in
+	start | restart | reload)
+		printf "Starting light: "
+		if /usr/sbin/light init; then echo "OK"; else echo "FAIL"; fi
+		;;
+	stop)
+		/usr/sbin/light ir off 2>/dev/null
+		/usr/sbin/light white off 2>/dev/null
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}"
+		exit 1
+		;;
+esac
+exit 0
