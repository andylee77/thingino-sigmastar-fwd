diff --git a/Makefile.ota b/Makefile.ota
index 297eb63fc..59d5b2685 100644
--- a/Makefile.ota
+++ b/Makefile.ota
@@ -84,6 +84,13 @@ else ifeq ($(BR2_THINGINO_FLASH_NAND),y)
 	@$(ORANGE) "Device IP: $(CAMERA_IP_ADDRESS)"
 	@if [ $(FIRMWARE_BIN_FULL_SIZE) -gt $(FLASH_SIZE) ]; then $(RED) "OVERSIZE"; fi
 	@echo "Image: $(FIRMWARE_BIN_FULL)"
+else ifeq ($(SOC_VENDOR),sigmastar)
+	# board/sigmastar/post-image.sh already printed the layout it wrote and
