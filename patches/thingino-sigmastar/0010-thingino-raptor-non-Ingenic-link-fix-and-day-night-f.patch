+From 615a05a4603b894748d173e9b3c66a8ad0ba7d55 Mon Sep 17 00:00:00 2001
+From: Andy <andylee77@users.noreply.github.com>
+Date: Sat, 24 Oct 2026 13:25:48 -0400
+Subject: [PATCH 1/2] Makefile: link libimp and libalog for Ingenic platforms
+ only
+
+LDFLAGS_HAL hardcodes -limp -lalog, the Ingenic SDK libraries the
+Ingenic HAL backend needs. A backend for another vendor links neither --
+the SigmaStar one reaches its MI libraries through dlopen -- so rvd and
+rad failed to link with "cannot find -limp".
+
+Add them only for the Ingenic platforms, as VENDOR_LIBS so a build can
+override the set.
+---
+ Makefile | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/Makefile b/Makefile
+index 013cc1f..9c11fee 100644
+--- a/Makefile
++++ b/Makefile
+@@ -176,7 +176,9 @@ endif
+ 
+ # System libs for HAL-linked daemons
+ # Shim must come BEFORE Ingenic SDK libs — symbols must be resolved first.
+-LDFLAGS_HAL := $(LDFLAGS_SYSROOT) $(SHIM_LIB) -limp -lalog -lpthread -lrt -lm -ldl -latomic
++INGENIC_PLATFORMS := T10 T20 T21 T23 T30 T31 T32 T33 T40 T41 A1
++VENDOR_LIBS ?= $(if $(filter $(PLATFORM),$(INGENIC_PLATFORMS)),-limp -lalog)
++LDFLAGS_HAL := $(LDFLAGS_SYSROOT) $(SHIM_LIB) $(VENDOR_LIBS) -lpthread -lrt -lm -ldl -latomic
+ 
+ # IVS detection libs
+ ifeq ($(IVS_DETECT),1)
diff --git a/package/thingino-raptor/0102-ric-irled_cmd-hook-for-an-850-nm-bank-that-is-not-on.patch b/package/thingino-raptor/0102-ric-irled_cmd-hook-for-an-850-nm-bank-that-is-not-on.patch
new file mode 100644
index 000000000..96ef4a9c0
--- /dev/null
+++ b/package/thingino-raptor/0102-ric-irled_cmd-hook-for-an-850-nm-bank-that-is-not-on.patch
