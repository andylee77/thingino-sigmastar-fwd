++# ir_levels =                 # irled_cmd bank only: IR brightness steps in %,
++                              # ascending (e.g. 10,20,40,70,100). Night starts
++                              # on the first and steps up while the IR-lit
++                              # gain stays above ir_step_gain; the command then
++                              # runs as "<cmd> on <percent>". Empty = on|off
++# ir_step_gain = 16000        # IR-lit gain above this -> next IR level
