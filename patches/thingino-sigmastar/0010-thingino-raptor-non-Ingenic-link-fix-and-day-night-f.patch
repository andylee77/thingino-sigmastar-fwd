+From 7b4fd0fb1139ddc6b2d0953879c543d3d7381137 Mon Sep 17 00:00:00 2001
+From: Andy <andylee77@users.noreply.github.com>
+Date: Sat, 17 Oct 2026 20:41:39 -0400
+Subject: [PATCH 2/2] ric: irled_cmd hook for an 850 nm bank that is not on a
+ GPIO
+
+Boards with PWM-dimmed IR LEDs (e.g. the UVision MC-A85 / SSC378DE, IR
+bank on PAD_PWM1) have no gpio_irled to give ric, so night mode never
+lit them. Add [ircut] irled_cmd: when gpio_irled is unset, ric runs
+"<irled_cmd> on|off" wherever it would drive that pin -- the automatic
+day/night switch and raptorctl ric ir850. It runs synchronously, so the
+light is up before the post-switch cooldown samples the night gain
+baseline the night->day trigger compares against.
+---
+ config/raptor.conf |  2 ++
+ ric/ric.h          |  7 +++++++
+ ric/ric_daynight.c | 25 ++++++++++++++++++++++++-
+ ric/ric_main.c     |  2 ++
+ 4 files changed, 35 insertions(+), 1 deletion(-)
+
+diff --git a/config/raptor.conf b/config/raptor.conf
+index 27a6bf2..a34964b 100644
+--- a/config/raptor.conf
++++ b/config/raptor.conf
+@@ -386,6 +386,8 @@ position = bottom_right
+ # gpio_ircut2 = -1
+ # gpio_irled = -1             # ir850 pin, -1 = auto from /etc/thingino.json
+ # gpio_irled2 = -1            # ir940 pin, -1 = auto from /etc/thingino.json
++# irled_cmd =                 # 850nm bank not on a GPIO (PWM, expander):
++                              # run as "<cmd> on|off", e.g. /usr/sbin/light ir
+ # ir850 = true                # enable 850nm IR LED (visible glow, stronger)
+ # ir940 = false               # enable 940nm IR LED (invisible, weaker);
+                               # auto-enabled when 940 is the board's ONLY
+diff --git a/ric/ric.h b/ric/ric.h
+index 4e0bbfb..8ca07f9 100644
+--- a/ric/ric.h
++++ b/ric/ric.h
+@@ -134,6 +134,13 @@ typedef struct {
+ 	bool ircut_active_low;	/* single-pin ircut driven inverted */
+ 	bool irled_active_low;	/* ir850 bank lights on 0 */
+ 	bool irled2_active_low; /* ir940 bank lights on 0 */
++	/*
++	 * Run as "<irled_cmd> on|off" for the 850 nm bank when it is not on a
++	 * plain GPIO (gpio_irled < 0): a PWM-dimmed bank, an expander. Empty =
++	 * unused. Synchronous, so the light is up before the post-switch
++	 * cooldown samples the night gain baseline.
++	 */
++	char irled_cmd[128];
+ 	bool ir850_enabled;
+ 	bool ir940_enabled;
+ 	bool ir940_explicit; /* config carries an ir940 key (vs the default) */
+diff --git a/ric/ric_daynight.c b/ric/ric_daynight.c
+index bee7aa9..f1e76f2 100644
+--- a/ric/ric_daynight.c
++++ b/ric/ric_daynight.c
+@@ -317,6 +317,26 @@ int ric_ircut_drive(ric_state_t *st, ric_mode_t pos)
+ 	return 0;
+ }
+ 
++/*
++ * The 850 nm bank through a command instead of a pin ([ircut] irled_cmd):
++ * "<cmd> on|off", run to completion so the light has settled before the
++ * post-switch cooldown samples the night gain baseline.
++ */
++static int ric_irled_run_cmd(const ric_config_t *c, bool on)
++{
++	char cmd[sizeof(c->irled_cmd) + 8];
++	int ret;
++
++	snprintf(cmd, sizeof(cmd), "%s %s", c->irled_cmd, on ? "on" : "off");
++	ret = system(cmd);
++	if (ret != 0) {
++		RSS_WARN("ir850: \"%s\" failed (status %d)", cmd, ret);
++		return -1;
++	}
++	RSS_INFO("ir850: %s via \"%s\"", on ? "on" : "off", c->irled_cmd);
++	return 0;
++}
++
+ /*
+  * Drive one IR LED bank alone (bank940 selects 940nm). Exported for
+  * raptorctl's manual control, which deliberately ignores the
+@@ -330,8 +350,11 @@ int ric_irled_drive(ric_state_t *st, bool bank940, bool on)
+ 	ric_config_t *c = &st->settings;
+ 	int pin = bank940 ? c->gpio_irled2 : c->gpio_irled;
+ 
+-	if (pin < 0)
++	if (pin < 0) {
++		if (!bank940 && c->irled_cmd[0])
++			return ric_irled_run_cmd(c, on);
+ 		return -1;
++	}
+ 	bool alow = bank940 ? c->irled2_active_low : c->irled_active_low;
+ 	int raw = (on != alow) ? 1 : 0;
+ 	gpio_set(pin, raw);
+diff --git a/ric/ric_main.c b/ric/ric_main.c
+index d11d265..064f297 100644
+--- a/ric/ric_main.c
++++ b/ric/ric_main.c
+@@ -63,6 +63,8 @@ static void load_config(ric_state_t *st)
+ 	c->ircut_active_low = rss_config_get_bool(cfg, "ircut", "gpio_ircut_active_low", false);
+ 	c->irled_active_low = rss_config_get_bool(cfg, "ircut", "gpio_irled_active_low", false);
+ 	c->irled2_active_low = rss_config_get_bool(cfg, "ircut", "gpio_irled2_active_low", false);
++	const char *irled_cmd = rss_config_get_str(cfg, "ircut", "irled_cmd", "");
++	snprintf(c->irled_cmd, sizeof(c->irled_cmd), "%s", irled_cmd ? irled_cmd : "");
+ 	c->ir850_enabled = rss_config_get_bool(cfg, "ircut", "ir850", true);
+ 	/* Probed before the get, because the getters store their default into
+ 	 * the config on a miss (for config-get-section) and the key would
diff --git a/package/thingino-raptor/0103-ric-luma-trigger-for-irled_cmd-banks-and-days-that-s.patch b/package/thingino-raptor/0103-ric-luma-trigger-for-irled_cmd-banks-and-days-that-s.patch
new file mode 100644
index 000000000..cf23f8da4
--- /dev/null
+++ b/package/thingino-raptor/0103-ric-luma-trigger-for-irled_cmd-banks-and-days-that-s.patch
@@ -0,0 +1,191 @@
+From 7259f925fb82c8cade9b68ad840b7716da476851 Mon Sep 17 00:00:00 2001
+From: andylee77 <andylee77@users.noreply.github.com>
+Date: Sat, 24 Oct 2026 16:31:05 -0400
+Subject: [PATCH 3/4] ric: luma trigger for irled_cmd banks, and days that
+ stick
+
+Three gaps in the luma trigger, found on the UVision MC-A85 (SSC378DE +
+GC8613), whose IR bank is PWM-dimmed and driven through irled_cmd:
+
+1. An irled_cmd bank did not count as an IR bank. ir_lit stayed false
+   under lit IR, so the luma day test ran against IR-inflated luma (the
+   oscillator the comment above it warns about), and the IR-off probe
+   never armed.
+
+2. Luma alone could declare day in a scene the day side rejects at once.
+   At ceiling gain AE still lifts a dim room's luma over night_luma; an
+   IR-off probe there switched to day, day mode saw gain > night_gain
+   and went straight back. The luma day test now also needs gain at or
+   under half of night_gain (the probe reads with the IR-cut out; in day
+   the filter takes the scene's own IR away), and the post-switch
+   verification reverts on either half of the night test, not luma
+   only.
+
+3. The verification samples three polls after the switch, while AE can
+   still be walking up. A day the night test takes back within
+   RIC_DAY_LOCKOUT_FIRST polls now arms the same doubling lockout, and
+   the backoff only starts over once a day has outlived that trial.
+---
+ ric/ric.h          |  5 ++++
+ ric/ric_daynight.c | 71 ++++++++++++++++++++++++++++++++++++----------
+ 2 files changed, 61 insertions(+), 15 deletions(-)
+
+diff --git a/ric/ric.h b/ric/ric.h
+index 8ca07f9..1f69fa3 100644
+--- a/ric/ric.h
++++ b/ric/ric.h
+@@ -215,6 +215,11 @@ typedef struct {
+ 	bool day_verify_pending;
+ 	int day_lockout_polls; /* suppress day attempts while > 0 */
+ 	int day_lockout_next;  /* doubling backoff, 0 = start over */
++	/* A day the night test takes back within RIC_DAY_LOCKOUT_FIRST
++	 * polls failed as surely as one the verification caught: AE can
++	 * still be walking up when the verification samples. */
++	bool day_on_trial;
++	int day_age_polls;
+ 
+ 	/* IR-off ambient probe (night, luma trigger): compressed-gain
+ 	 * sensors floor total_gain in a lit scene long before the day
+diff --git a/ric/ric_daynight.c b/ric/ric_daynight.c
+index f1e76f2..3427ec1 100644
+--- a/ric/ric_daynight.c
++++ b/ric/ric_daynight.c
+@@ -476,6 +476,7 @@ void ric_trigger_rearm(ric_state_t *st)
+ 	st->day_verify_pending = false;
+ 	st->day_lockout_polls = 0;
+ 	st->day_lockout_next = 0;
++	st->day_on_trial = false;
+ 	st->probe_active = false;
+ 	st->probe_polls_left = 0;
+ 	st->probe_holdoff_polls = 0;
+@@ -515,6 +516,20 @@ void ric_set_mode(ric_state_t *st, ric_mode_t mode)
+ 		st->night_gain_baseline = 0;
+ }
+ 
++/*
++ * A day attempt failed: hold off the next one, doubling up to
++ * RIC_DAY_LOCKOUT_MAX. Returns the hold, in polls.
++ */
++static int ric_day_lockout_arm(ric_state_t *st)
++{
++	int hold = st->day_lockout_next ? st->day_lockout_next : RIC_DAY_LOCKOUT_FIRST;
++
++	st->day_lockout_polls = hold;
++	st->day_lockout_next = hold * 2 > RIC_DAY_LOCKOUT_MAX ? RIC_DAY_LOCKOUT_MAX : hold * 2;
++	st->day_on_trial = false;
++	return hold;
++}
++
+ /*
+  * Debounce, shared by every trigger: hysteresis_sec consecutive polls
+  * agreeing before the filter moves. `why` is the trigger's own account of
+@@ -530,6 +545,12 @@ static void ric_debounce(ric_state_t *st, bool want_night, bool want_day, uint32
+ 			if (st->night_count >= st->settings.hysteresis_sec) {
+ 				RSS_DEBUG("night detected (%s for %ds)", why,
+ 					  st->settings.hysteresis_sec);
++				if (st->settings.trigger == RIC_TRIGGER_LUMA && st->day_on_trial) {
++					int hold = ric_day_lockout_arm(st);
++					RSS_WARN("day lasted only %d polls -- the scene was dark "
++						 "without IR; next day attempt in %d polls",
++						 st->day_age_polls, hold);
++				}
+ 				st->night_detect_gain = total_gain;
+ 				ric_set_mode(st, RIC_MODE_NIGHT);
+ 			}
+@@ -543,8 +564,13 @@ static void ric_debounce(ric_state_t *st, bool want_night, bool want_day, uint32
+ 			if (st->day_count >= st->settings.hysteresis_sec) {
+ 				RSS_DEBUG("day detected (%s for %ds)", why,
+ 					  st->settings.hysteresis_sec);
+-				if (st->settings.trigger == RIC_TRIGGER_LUMA)
++				if (st->settings.trigger == RIC_TRIGGER_LUMA) {
+ 					st->day_verify_pending = true;
++					/* An automatic day only: the startup day and a
++					 * forced one are not attempts that can fail. */
++					st->day_on_trial = true;
++					st->day_age_polls = 0;
++				}
+ 				ric_set_mode(st, RIC_MODE_DAY);
+ 			}
+ 		} else {
+@@ -644,6 +670,13 @@ void ric_poll_exposure(ric_state_t *st)
+ 		st->settings.trigger = RIC_TRIGGER_LUMA;
+ 	}
+ 
++	/* A day that outlives its trial has stuck: the backoff starts over. */
++	if (st->current_mode == RIC_MODE_DAY && st->day_on_trial &&
++	    ++st->day_age_polls >= RIC_DAY_LOCKOUT_FIRST) {
++		st->day_on_trial = false;
++		st->day_lockout_next = 0;
++	}
++
+ 	/* Cooldown after mode switch: wait for IR LEDs / ISP to stabilize.
+ 	 * After cooldown in night mode, sample total_gain as baseline for
+ 	 * the auto-calibrating night→day transition. */
+@@ -652,26 +685,26 @@ void ric_poll_exposure(ric_state_t *st)
+ 		if (st->cooldown_remaining == 0 && st->current_mode == RIC_MODE_DAY &&
+ 		    st->day_verify_pending) {
+ 			st->day_verify_pending = false;
+-			if (have_luma && ae_luma < (uint32_t)st->settings.night_luma) {
++			/* Either half of the day-side night test: AE lifts a
++			 * dim room's luma over night_luma at ceiling gain, so
++			 * luma alone passes a room the gain half sends straight
++			 * back to night. */
++			bool dark_luma = have_luma && ae_luma < (uint32_t)st->settings.night_luma;
++			bool dark_gain = have_gain && total_gain > (uint32_t)st->settings.night_gain;
++			if (dark_luma || dark_gain) {
+ 				/* The scene reads night-dark with the IR off: the
+ 				 * "day" was the LED's own light bouncing back (a
+ 				 * covered lens, a point-blank surface). Revert and
+ 				 * back off so this cannot oscillate; a covered
+ 				 * lens re-checks rarely instead of blinking. */
+-				int hold = st->day_lockout_next ? st->day_lockout_next
+-								: RIC_DAY_LOCKOUT_FIRST;
++				int hold = ric_day_lockout_arm(st);
+ 				RSS_WARN("day verification failed: scene reads night-dark "
+-					 "without IR (luma %u < %d) -- the day was IR "
+-					 "reflection; reverting, next attempt in %d polls",
+-					 ae_luma, st->settings.night_luma, hold);
+-				st->day_lockout_polls = hold;
+-				st->day_lockout_next = hold * 2 > RIC_DAY_LOCKOUT_MAX
+-							       ? RIC_DAY_LOCKOUT_MAX
+-							       : hold * 2;
++					 "without IR (luma %u/%d, gain %u/%d) -- the day was "
++					 "IR reflection; reverting, next attempt in %d polls",
++					 ae_luma, st->settings.night_luma, total_gain,
++					 st->settings.night_gain, hold);
+ 				st->night_detect_gain = total_gain;
+ 				ric_set_mode(st, RIC_MODE_NIGHT);
+-			} else {
+-				st->day_lockout_next = 0;
+ 			}
+ 		}
+ 		if (st->cooldown_remaining == 0 && st->current_mode == RIC_MODE_NIGHT) {
+@@ -760,7 +793,8 @@ void ric_poll_exposure(ric_state_t *st)
+ 		 * lifts luma over the threshold, day mode cuts the LEDs,
+ 		 * the scene goes dark again, and the filter clicks all
+ 		 * night. */
+-		bool ir_banks = (st->settings.gpio_irled >= 0 && st->settings.ir850_enabled) ||
++		bool ir_banks = ((st->settings.gpio_irled >= 0 || st->settings.irled_cmd[0]) &&
++				 st->settings.ir850_enabled) ||
+ 				(st->settings.gpio_irled2 >= 0 && st->settings.ir940_enabled);
+ 		bool ir_lit = ir_banks && st->current_mode == RIC_MODE_NIGHT && !st->probe_active;
+ 
+@@ -781,7 +815,14 @@ void ric_poll_exposure(ric_state_t *st)
+ 				st->night_gain_baseline * (uint32_t)st->settings.day_gain_pct / 100;
+ 			want_day = (total_gain < day_thr);
+ 		}
+-		if (!ir_lit && have_luma && ae_luma >= (uint32_t)st->settings.night_luma)
++		/* ...and never into a day the day-side gain test undoes at
++		 * once: at ceiling gain AE still lifts a dim room's luma over
++		 * night_luma, so on luma alone an IR-off probe there switched
++		 * to day, and day mode went straight back to night. The probe
++		 * reads with the IR-cut still out, and the filter costs the
++		 * scene its own IR in day mode, hence half of night_gain. */
++		if (!ir_lit && have_luma && ae_luma >= (uint32_t)st->settings.night_luma &&
++		    (!have_gain || total_gain <= (uint32_t)st->settings.night_gain / 2))
+ 			want_day = true;
+ 
+ 		/* IR-off ambient probe: compressed-gain sensors (T20 class)
+-- 
+2.43.0
+
diff --git a/package/thingino-raptor/0104-ric-IR-level-ladder-for-irled_cmd-banks.patch b/package/thingino-raptor/0104-ric-IR-level-ladder-for-irled_cmd-banks.patch
new file mode 100644
index 000000000..ce06cc46f
--- /dev/null
+++ b/package/thingino-raptor/0104-ric-IR-level-ladder-for-irled_cmd-banks.patch
@@ -0,0 +1,317 @@
+From 20e2dd5fc5db0404e61a8f8211456248d940ee7b Mon Sep 17 00:00:00 2001
+From: andylee77 <andylee77@users.noreply.github.com>
+Date: Sat, 24 Oct 2026 16:35:47 -0400
+Subject: [PATCH 4/4] ric: IR level ladder for irled_cmd banks
+
+A dimmable IR bank driven through irled_cmd was lit at one fixed level,
+which is wrong for both ends of a scene: enough to light the far field
+floods a near wall, and the IR-lit gain then lands wherever the scene
+puts it. On the MC-A85 bench the settled night gain went from 29460 at
+5% IR to 3003 at 100%.
+
+[ircut] ir_levels takes ascending percents ("10,20,40,70,100"). Every
+night starts on the first; while the IR-lit gain stays above
+ir_step_gain (default 16000) the bank steps up one level, as
+"<irled_cmd> on <percent>". A settled reading still above it climbs
+at baseline time instead of becoming the baseline, and a scene that
+darkens later climbs after hysteresis_sec polls. Each climb re-arms the
+cooldown, so the luma trigger's day ratio is always taken against the
+level the night settles on. Never steps down within a night: a brighter
+scene is the day trigger's job, and a two-way ladder would hunt.
+
+Forced night runs the ladder too, so "ric mode night" does not leave
+the scene on the lowest level. raptorctl ric get-thresholds lists the
+levels, ric status reports the level in use, and ir_step_gain is
+settable live.
