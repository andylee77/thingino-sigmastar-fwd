diff --git a/package/thingino-raptor/0105-ric-poll-exposure-on-a-fixed-cadence.patch b/package/thingino-raptor/0105-ric-poll-exposure-on-a-fixed-cadence.patch
new file mode 100644
index 000000000..cd54e5cd1
--- /dev/null
+++ b/package/thingino-raptor/0105-ric-poll-exposure-on-a-fixed-cadence.patch
@@ -0,0 +1,58 @@
+From abd68e9109c20a995bec971e50afd3e0aa15a7d2 Mon Sep 17 00:00:00 2001
+From: andylee77 <andylee77@users.noreply.github.com>
+Date: Sat, 24 Oct 2026 17:07:46 -0400
+Subject: [PATCH] ric: poll exposure on a fixed cadence
+
+The main loop polled exposure once per wake, and a control request wakes
+the epoll wait early. Every poll-counted delay (hysteresis_sec, the
+post-switch cooldown, the baseline settle, day lockouts, probe windows)
+therefore shrank while a client was asking. The web UI's live gain
+readout asks every second or two. Measured on the MC-A85 with
+status requests back to back: the 5-poll day->night debounce took 0.3 s.
+
+Keep a monotonic deadline: poll only when it has passed, and otherwise
+wait out the remainder, answering control requests as they come.
+---
+ ric/ric_main.c | 19 +++++++++++++++----
+ 1 file changed, 15 insertions(+), 4 deletions(-)
+
+diff --git a/ric/ric_main.c b/ric/ric_main.c
+index 585d1a3..f773772 100644
+--- a/ric/ric_main.c
++++ b/ric/ric_main.c
+@@ -744,17 +744,28 @@ int main(int argc, char **argv)
+ 	RSS_DEBUG("  hysteresis=%ds poll=%dms", st.settings.hysteresis_sec,
+ 		  st.settings.poll_interval_ms);
+ 
+-	/* Main loop: poll exposure + handle control socket */
++	/* Main loop: poll exposure on a fixed cadence + handle control socket.
++	 * A control request wakes the wait early. Polling on every wake made
++	 * each poll-counted delay (hysteresis, cooldown, lockouts) shrink
++	 * while a client was asking -- the web UI's live gain readout asks
++	 * every second or two. */
++	int64_t next_poll_us = 0;
+ 	while (*st.running) {
+-		ric_poll_exposure(&st);
++		int64_t now_us = rss_timestamp_us();
++		if (now_us >= next_poll_us) {
++			ric_poll_exposure(&st);
++			next_poll_us = now_us + (int64_t)st.settings.poll_interval_ms * 1000;
++			now_us = rss_timestamp_us();
++		}
++		int wait_ms = next_poll_us > now_us ? (int)((next_poll_us - now_us + 999) / 1000) : 0;
+ 
+ 		if (epoll_fd >= 0) {
+ 			struct epoll_event ev;
+-			int n = epoll_wait(epoll_fd, &ev, 1, st.settings.poll_interval_ms);
++			int n = epoll_wait(epoll_fd, &ev, 1, wait_ms);
+ 			if (n > 0 && st.ctrl)
+ 				rss_ctrl_accept_and_handle(st.ctrl, ric_ctrl_handler, &st);
+ 		} else {
+-			usleep(st.settings.poll_interval_ms * 1000);
++			usleep((useconds_t)wait_ms * 1000);
+ 		}
+ 	}
+ 
+-- 
+2.43.0
+
