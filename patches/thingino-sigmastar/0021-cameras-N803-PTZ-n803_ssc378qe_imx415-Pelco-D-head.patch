new file mode 100755
index 000000000..1a4dfbda9
--- /dev/null
+++ b/configs/cameras/n803_ssc378qe_imx415/overlay/etc/init.d/S04oemmac
@@ -0,0 +1,23 @@
+#!/bin/sh
+# N803-HS5X: present the unit's OEM MAC, the address its DHCP reservation and
+# records are keyed to (the camera label has no MAC). Thingino's SoC-die-ID
+# derivation (S03mac) fails on this SSC378QE and falls back to the U-Boot
+# ethaddr, so set eth.mac explicitly -- the same effect as the web UI's
+# network page.
+#
+# The MAC is per unit, so it is not in the image. Provisioning writes it once
+# onto the overlay (read it from the OEM web UI, or from the unit's OEM flash
+# backup):
+#   echo XX:XX:XX:XX:XX:XX > /etc/default/oemmac
+# eth.mac is set only while it is unset, so the web UI still wins and a reflash
+# that keeps the overlay keeps the chosen value. A factory reset clears both:
+# write the file again, or set the MAC in the web UI.
+command -v jct >/dev/null 2>&1 || exit 0
+jct /etc/thingino.json get eth.mac >/dev/null 2>&1 && exit 0
+[ -r /etc/default/oemmac ] || exit 0
+mac=$(tr -d ' \t\r\n' </etc/default/oemmac)
+if echo "$mac" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
+	jct /etc/thingino.json set eth.mac "$mac"
+else
+	echo "S04oemmac: /etc/default/oemmac is not a MAC address; eth.mac left unset" >&2
+fi
