+#!/bin/sh
+# N803-HS5X: present the unit's documented OEM MAC (the "original" address that
+# DHCP reservations/records are keyed to; the camera label has no MAC printed).
+# Thingino's SoC-die-ID derivation (S03mac) fails on this SSC378QE and falls back
+# to the U-Boot ethaddr, so set eth.mac explicitly -- same effect as the web-UI
+# network page. Only sets it when unset, so the web UI still wins and a reflash
+# that keeps the overlay keeps the chosen value.
+# PER-UNIT VALUE: set this to your unit's OEM MAC before building.
+command -v jct >/dev/null 2>&1 || exit 0
+jct /etc/thingino.json get eth.mac >/dev/null 2>&1 || \
+  jct /etc/thingino.json set eth.mac AA:BB:CC:DD:EE:FF
