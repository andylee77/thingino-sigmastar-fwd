@@ -0,0 +1,93 @@
+From: Andy <andylee77@users.noreply.github.com>
+Subject: [PATCH] ARM: dts: infinity6c: add the Anpviz/UVision N803-HS5X module
+
+SSC378QE + Sony IMX415 (4-lane) 5X-zoom AF PTZ dome. Starts from the SSC027D
+reference (this module's OEM base) and replaces the padmux with the one decoded
+from the OEM firmware: PWM9 white / PWM1 IR LED banks, Ethernet LEDs, the
+AF-lens 2-wire FUART (ttyS2), the IMX415 on I2C1, and a microSD slot (SDIO1).
+IR-cut is gpio80/81 (sysfs H-bridge, no padmux). emac0 comes from the base
+dtsi (internal MII PHY). Selected with
+CONFIG_SS_DTB_NAME="infinity6c-ssc378qe-n803".
+
+FIRST DRAFT: validate on the bench over UART before flashing a mounted unit
+(sensor I2C bus/addr, white-PWM and SD pads are the likely iteration points).
+
+---
+--- /dev/null	2026-10-17 15:21:06.361937226 -0400
++++ b/arch/arm/boot/dts/infinity6c-ssc378qe-n803.dts	2026-10-29 11:30:39.574377807 -0400
+@@ -0,0 +1,75 @@
++/*
++ * infinity6c-ssc378qe-n803.dts - Anpviz/UVision N803-HS5X 8MP PTZ module
++ *
++ * SigmaStar SSC378QE (Infinity6C) + Sony IMX415 (MIPI 4-lane), 16 MB SPI NOR,
++ * 256 MB DDR. A 5X-zoom AF pan/tilt dome (Anpviz PTZIP...-5X-A, "N803-HS5X").
++ * OEM U-Boot board tag KL_LX510; OEM DTB model "INFINITY6C SSC027D-S01A".
++ *
++ * This program is free software; you can redistribute it and/or modify it
++ * under the terms of the GNU General Public License version 2, as published
++ * by the Free Software Foundation.
++ *
++ * Starts from the SSC027D reference board (this module's OEM base is SSC027D)
++ * and replaces the padmux with the one decoded from the OEM firmware (ko.sh
++ * "378" branch + the vendor connector table; see
++ * docs/contrib/thingino/oem-reference/N803-PAD-MAP.md). emac0 comes from the
++ * base dtsi (internal MII PHY) -- the Ethernet signals physically route RJ45 ->
++ * PTZ base board -> SoC board, but electrically it is the i6c internal EMAC, so
++ * the base node brings the link up unchanged, as on the MC-A85 and JL12D2.
++ *
++ *  - PAD_PWM0 = white LED bank, driven as PWM9 (PWM9_MODE_2), not PWM0: this
++ *    does not depend on mi.ko leaving PWM0 alone. infinity6c.dtsi keeps the
++ *    dual-sensor frame-sync wave on PWM0 (vif_ds_rt_pwm_sync = <1>); PWM0 is
++ *    routed to no pad here, so that wave drives a dead end (the MC-A85 fix).
++ *    The OEM drives white on PWM0 directly; if the white bank misbehaves,
++ *    PWM9-on-PAD_PWM0 is the safe equivalent.
++ *  - PAD_PWM1 = IR LED bank (PWM1), as in the OEM DT.
++ *  - PAD_PM_LED0/LED1 = Ethernet link / activity LEDs.
++ *  - PAD_FUART_RX/TX = 2-wire FUART -> ttyS2 = the AF-lens MCU (57600 8N1; the
++ *    zoom/focus serial channel, driven by a lensd-style daemon -- PTZ phase 2).
++ *  - PAD_I2C1_SCL/SDA = IMX415 sensor I2C (adapter 1), as on the MC-A85.
++ *  - PAD_SD_* + PAD_PM_SD_CDZ = microSD slot (SDIO1), the N803 extend-board slot
++ *    (OEM /dev/mmcblk1). UNVERIFIED pad group -- confirm on the bench; SD is not
++ *    needed for streaming, so a wrong guess here only costs the card, not boot.
++ *
++ * IR-cut is gpio80 (day) / gpio81 (night), an H-bridge coil driven by ric via
++ * /sys/class/gpio -- a plain PM GPIO, no padmux entry needed. The pan/tilt
++ * steppers (ULN2803A on the PTZ base board) and their drive GPIOs are PTZ
++ * phase 2 and are not muxed here.
++ *
++ * Selected with CONFIG_SS_DTB_NAME="infinity6c-ssc378qe-n803".
++ */
++
++#include "infinity6c-ssc027d-s01a.dts"
++
++/ {
++	model = "Anpviz/UVision N803-HS5X (SSC378QE + IMX415)";
++
++	soc {
++		padmux {
++			schematic =
++				<GPIO_NR         PINMUX_FOR_UNKNOWN_MODE       MDRV_PUSE_NA>,
++				/* white LED bank: PWM9 on PAD_PWM0 (avoids the PWM0 frame-sync) */
++				<PAD_PWM0        PINMUX_FOR_PWM9_MODE_2        MDRV_PUSE_PWM9>,
++				/* IR LED bank: PWM1 on PAD_PWM1 */
++				<PAD_PWM1        PINMUX_FOR_PWM1_MODE_1        MDRV_PUSE_PWM1>,
++				/* Ethernet link / activity LEDs */
++				<PAD_PM_LED0     PINMUX_FOR_LED0_MODE_1        MDRV_PUSE_ETH0_LED>,
++				<PAD_PM_LED1     PINMUX_FOR_LED1_MODE_1        MDRV_PUSE_ETH1_LED>,
++				/* AF-lens MCU: 2-wire FUART -> ttyS2 */
++				<PAD_FUART_RX    PINMUX_FOR_FUART_2W_MODE_1    MDRV_PUSE_FUART_RX>,
++				<PAD_FUART_TX    PINMUX_FOR_FUART_2W_MODE_1    MDRV_PUSE_FUART_TX>,
++				/* IMX415 sensor I2C (adapter 1) */
++				<PAD_I2C1_SCL    PINMUX_FOR_I2C1_MODE_1        MDRV_PUSE_I2C1_SCL>,
++				<PAD_I2C1_SDA    PINMUX_FOR_I2C1_MODE_1        MDRV_PUSE_I2C1_SDA>,
++				/* microSD slot (SDIO1 on the SD0 pads) */
++				<PAD_SD_D1       PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_D1>,
++				<PAD_SD_D0       PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_D0>,
++				<PAD_SD_CLK      PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_CLK>,
++				<PAD_SD_CMD      PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_CMD>,
++				<PAD_SD_D3       PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_D3>,
++				<PAD_SD_D2       PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_D2>,
++				<PAD_PM_SD_CDZ   PINMUX_FOR_SD0_CDZ_MODE_1     MDRV_PUSE_SDIO1_CDZ>;
++		};
++	};
++};
