index 000000000..c2f6690cd
--- /dev/null
+++ b/configs/cameras/n803_ssc378qe_imx415/n803_ssc378qe_imx415.kernel.config
@@ -0,0 +1,32 @@
+# Kernel config fragment for the Anjvision/UVision N803-HS5X PTZ
+# (n803_ssc378qe_imx415), merged over
+# board/sigmastar/infinity6c/kernel/5.10/infinity6c.config.
+#
+# Boot under the OEM U-Boot (KL_LX510, I6C) and force the kernel command line,
+# the same way the MC-A85 and JL12D2 do. The command line is THIS unit's own,
+# read verbatim from its OEM U-Boot env + running boot log (bench dump
+# 2026-10-28): 256 MB DDR split LX_MEM=0x10000000 (base 0x20000000) with a
+# 166 MB MMA carve (sz=0xa600000, mma_memblock_remove=1) -> ~90 MB for Linux.
+#
+# Differences from the OEM line that are deliberate:
+#   - init=/init          (Thingino has /init, not the OEM /linuxrc)
+#   - mtdparts=NOR_FLASH:  THIS kernel names the NOR master NOR_FLASH (same as
+#                          the MC-A85/JL12D2 i6c kernel), not the OEM's nor0.
+#   - console=ttyS0,115200 panic=20  (explicit console + panic reboot)
+# Partition OFFSETS/SIZES and NAMES match the OEM exactly, so the OEM U-Boot
+# bootcmd (sf read KERNEL; bootm) still finds KERNEL, and flashcp-by-name works:
+#   nor0: 0x4F000(BOOT) 0x1000(ENV) 0x200000(KERNEL) 0xD10000(rootfs) 0xA0000(customer)
+# rootfs is the 4th partition -> root=/dev/mtdblock3. ENV is its own partition
+# (mtd1), so fw_env on mtd1 is safe (NOT the JL12D2 kernel-partition env trap).
+CONFIG_CMDLINE="console=ttyS0,115200 panic=20 root=/dev/mtdblock3 rootfstype=squashfs ro init=/init mtdparts=NOR_FLASH:0x4F000(BOOT),0x1000(ENV),0x200000(KERNEL),0xD10000(rootfs),0xA0000(data) LX_MEM=0x10000000 mma_heap=mma_heap_name0,miu=0,sz=0xa600000 mma_memblock_remove=1 cma=2M"
+CONFIG_CMDLINE_FORCE=y
+# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
+# CONFIG_CMDLINE_EXTEND is not set
+
+# N803 board device tree (board patch 0003-ARM-dts-infinity6c-add-the-N803-module),
+# derived from this unit's OEM DTB + the vendor pinout: PWM9 white / PWM1 IR LED
+# banks, Ethernet LEDs, the AF-lens 2-wire FUART (ttyS2), the IMX415 on I2C1, and
+# a microSD slot (SDIO1). IR-cut is gpio80/81 (sysfs, no padmux). emac0 comes from
+# the base dtsi (internal MII PHY), so first boot should reach the network.
+# FIRST DRAFT: validate on the bench over UART before flashing the mounted unit.
+CONFIG_SS_DTB_NAME="infinity6c-ssc378qe-n803"
diff --git a/configs/cameras/n803_ssc378qe_imx415/n803_ssc378qe_imx415_defconfig b/configs/cameras/n803_ssc378qe_imx415/n803_ssc378qe_imx415_defconfig
new file mode 100644
index 000000000..95a455570
--- /dev/null
+++ b/configs/cameras/n803_ssc378qe_imx415/n803_ssc378qe_imx415_defconfig
@@ -0,0 +1,251 @@
+# NAME: Anpviz/UVision N803-HS5X — SSC378QE, Infinity6C, Sony IMX415 (8MP) PTZ
+#
+# STATUS (2026-10-29): FIRST DRAFT, not yet booted on hardware. Cloned from the
+# MC-A85 (yma85_ssc378_gc8613): same SoC family + 8MP + IR-cut + LED banks, so
+# the streaming core should carry over. Differs in two axes: the SoC model
+# (ssc378qe, 256 MB part) and the sensor (Sony IMX415, prebuilt driver in the
+# SDK sensor-src). Target v1: boot + Ethernet + 4K IMX415 stream + day/night +
+# LEDs. PTZ (pan/tilt steppers via ULN2803A + the AF-lens zoom/focus over ttyS2)
+# is phase 2. First boot MUST be done on the bench over UART; it is a new board.
+#
+# Board:  Anpviz/UVision N803 module (SSC027D reference design, die SSC378QE,
+#         256 MB DDR); device tree infinity6c-ssc378qe-n803, see LINUX below.
+#         Anpviz PTZIP...-5X-A 8MP PTZ dome, OEM firmware "N803-HS5X V1.0.4.12".
+#         Full hardware map: docs/contrib/thingino/oem-reference/N803-PAD-MAP.md.
+# Sensor: Sony IMX415, MIPI 4-lane 10-bit, 8MP (1/2.8"). OEM captures the raw
+#         VIF pad at 3840x2160 (video.conf vi_width/height); main stream 4K@20.
+#         OEM ran 2-frame DOL HDR (wdr_mode=3); we run LINEAR 4K here (the i6c
+#         raptor-hal ISP does not tune DOL). OEM module: imx415_MIPI.ko chmap=1.
+# Flash:  16 MB SPI NOR, GigaDevice GD25Q128 (JEDEC c8 40 18).
+# CPU:    ARMv7-A / Cortex-A7 (see infinity6c.mk — built v7 despite the ARMv8
+#         die; same as the rest of the family).
+# Boot:   OEM U-Boot KL_LX510; this unit's OWN layout (NOT the MCL12D2's) —
+#         nor0:0x4F000(BOOT),0x1000(ENV),0x200000(KERNEL),0xD10000(rootfs),
+#         0xA0000(customer), root=/dev/mtdblock3 rootfstype=squashfs ro
+#         init=/linuxrc. ENV is its own partition (mtd1), so fw_env is safe.
+#         The thingino kernel forces its own command line (LINUX below), which
+#         replays these offsets as NOR_FLASH:... with init=/init.
+#
+# ---- SoC model ----
+# ssc378qe is in infinity6c.mk's family filter
+# (ssc377 ssc377d ssc377de ssc377qe ssc378de ssc378qe), so SOC_FAMILY resolves
+# to infinity6c and the family kernel + U-Boot + toolchain serve it with no
+# package change — exactly as ssc378de (the MC-A85) does. The 378 members differ
+# from the 377 members only in DRAM / encoder ceiling / package, none of which
+# reaches the kernel config or the bootloader binary. ssc378qe is the 256 MB
+# part; this unit's OEM bootargs read LX_MEM=0x10000000 (256 MB) with a 166 MB
+# MMA carve (sz=0xa600000) leaving ~90 MB to Linux. The command line forced in
+# the kernel fragment replays exactly that split.
+#
+# ---- SENSOR ----
+# Sony IMX415 ships as source in the SDK's sensor-src (sensor_imx415_mipi.c,
+# infinity6c), and load_sigmastar already handles it: insmod sensor_imx415_mipi.ko
+# chmap=1 (no lane override — the driver forces 4-lane for the 4K modes; add
+# lane_num=4 if a live i2cdetect/dmesg shows it bringing up only 2). We build it
+# from source via BR2_SIGMASTAR_SENSOR_SOURCE (same path the GC8613 uses, against
+# the sensor headers package/sigmastar-sdk/0001 restores to match 1230's mi.ko).
+# FRAG: soc-sigmastar core-sigmastar
+
+# board.mk includes this file as a makefile before thingino.mk runs, so the
+# vendor/model are readable there and drive SOC_VENDOR / SOC_MODEL / SOC_FAMILY
+# / SOC_ARCH / SOC_CPU / KERNEL_VERSION.
+BR2_SOC_VENDOR_SIGMASTAR=y
+BR2_SIGMASTAR_SOC_MODEL="ssc378qe"
+
+# Sony IMX415 (8MP), built from the SDK sensor-src (see SENSOR above).
+BR2_SENSOR_1_NAME="imx415"
+BR2_SIGMASTAR_SENSOR_SOURCE=y
+
+FLASH_SIZE_MB=16
+
+# Wired Ethernet: installs the eth0 DHCP stanza (thingino-ethernet).
+BR2_ETHERNET=y
+
+# Toolchain — identical to the Infinity6E/6C targets. A generic
+# arm-thingino-linux-uclibcgnueabihf; Cortex-A35 runs the same aarch32 code,
+# and nothing in it is 6E-specific. uClibc (not glibc): every libmi_*.so in the
+# hardware's vendor drop is NEEDED libc.so.0, which no glibc rootfs satisfies.
+# This matches our own OEM toolchain reference (arm-sigmastar-...-uclibcgnueabihf
+# 9.1.0). Re-pointed here because the toolchain fragment is resolved from
+# TYPE/GCC/LIBC alone, with no architecture in it, so the appended default is
+# thingino's mipsel one; the camera defconfig is appended after the fragments,
+# so these win.
+BR2_THINGINO_TOOLCHAIN_LIBC_UCLIBC=y
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
+BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
+BR2_TOOLCHAIN_EXTERNAL_URL="file://$(HOME)/src/mirrors/releases/johnchia__thingino-firmware/toolchain-x86_64/thingino-toolchain-x86_64_infinity6e_uclibc_gcc16-linux-arm.tar.gz"
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-thingino-linux-uclibcgnueabihf"
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM_UCLIBC=y
+BR2_TOOLCHAIN_EXTERNAL_GCC_16=y
+BR2_TOOLCHAIN_EXTERNAL_CXX=y
+BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
+BR2_TOOLCHAIN_EXTERNAL_LOCALE=y
+BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_DEBUG=y
+# Vendor blobs need __stack_chk_fail, so the producer builds uClibc with SSP and
+# Buildroot requires this stated for an external toolchain.
+BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
+# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
+# Toolchain is built against 4.9 headers regardless of the 5.10 kernel; headers
+# older than the kernel is the supported direction.
+BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
+
+# Build U-Boot. sigmastar-uboot is already family-generic (configures
+# $(SOC_FAMILY)_defconfig, passes the model as -DPRODUCT_SOC) and OpenIPC's tree
+# carries infinity6c_defconfig + ipl/infinity6c + the GCIS-at-36k NOR branch, so
+# ssc378qe needs no package change. NB: producing BOOT.bin is not flashing it —
+# on this board mtd0 (BOOT) is the one place a bad write cannot be undone in
+# software. We NEVER flash BOOT/ENV; only KERNEL (mtd2) + rootfs (mtd3).
+BR2_PACKAGE_SIGMASTAR_UBOOT=y
+
+BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_THINGINO_PATH)/board/sigmastar/post-image.sh"
+
+# ---- LINUX ----
+# The board device tree (infinity6c-ssc378qe-n803) and a fixed kernel command
+# line for the OEM U-Boot and this unit's flash layout. The fragment says why
+# the bootloader's own arguments cannot be used.
+BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THINGINO_PATH)/configs/cameras/n803_ssc378qe_imx415/n803_ssc378qe_imx415.kernel.config"
+
+# Gates the camera stack in Config.soc.in; pulls in raptor/raptor-common/
+# raptor-hal by default (INFINITY6C is a raptor-hal platform).
+BR2_THINGINO_DEV_IPCAM=y
+
+BR2_PACKAGE_DROPBEAR=y
+
+# No VPN: core-sigmastar.fragment selects WireGuard, but thingino-vpn selects
+# the out-of-tree wireguard-linux-compat under a guard (KERNEL_VERSION_7) that
+# is undefined and always reads n, so it tries to build the compat module on
+# this 5.10 kernel where WireGuard is already mainline and it does not compile.
+# A select cannot be declined by a defconfig, so choose None.
+BR2_PACKAGE_THINGINO_VPN_NONE=y
+
+# The external toolchain's bundled libz is not copied to target; anything
+# linking -lz needs a real target zlib.
+BR2_PACKAGE_ZLIB=y
+
+# ---- ISP TUNING ----
+# Two files, loaded by two different parties, and both are needed:
+#
+#  1. CUS3A's own iqfile, read when its AE/AWB initialise:
+#     /etc/firmware/iqfile<1 << isp_chn>.bin = iqfile1.bin. sigmastar-sdk
+#     installs the drop's generic iqfile0.bin and (our patch) aliases iqfile1.bin
+#     to it. Without iqfile1.bin the AWB never starts: gains 1.0x, green image.
+#     It must match the SDK's IQ version -- if IspLoadIqCfg rejects the OEM bin,
+#     the SDK's generic iqfile0.bin is used (as on the MC-A85). VERIFY on boot.
+#
+#  2. The per-sensor API bin raptor loads on the first frame via
+#     MI_ISP_ApiCmdLoadBinFile (accepted despite a minor-version warning):
+#     /usr/share/sensor/imx415.bin. This is the OEM's own IMX415 tuning, shipped
+#     in the N803 OEM rootfs as /config/iqfile/imx415_day.bin (111620 B, md5
+#     a45eafa8ab10979718706c176b1c19cf, header magic 27 03 65 6d). The OEM also
+#     ships imx415_night.bin (same size) and imx415_day_wdr.bin (HDR); we use the
+#     linear DAY tuning and handle night via the luma + IR ladder below.
+#     Proprietary: staged into the build tree only (gitignored), never committed.
+BR2_SENSOR_1_IQ_FILE="configs/cameras/n803_ssc378qe_imx415/imx415.bin"
+
+# 60 Hz mains (US). On infinity6c our raptor-hal fork applies this as an
+# MI_ISP_AE_SetFlickerEx manual lock on the first frame, after the tuning loads:
+# exposure snaps to n x 1/120 s. Measured rolling band ripple 3.8 DN unlocked ->
+# 0.03 DN locked at a forced 12 ms shutter.
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_SENSOR_ANTIFLICKER="2"
+
+# ---- SENSOR IDENTITY FOR RVD ----
+# Upstream rvd reads the sensor's name and I2C address from /proc/jz/sensor, an
+# Ingenic driver node, and will not start without them, so on SigmaStar they
+# come from [sensor]. The address is 7-bit, raptor.conf's convention (IMX415's
+# 8-bit slave is 0x34). The Infinity6C backend does not use it; rvd only
+# refuses 0.
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_SENSOR_NAME="imx415"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_SENSOR_I2C_ADDR="0x1a"
+
+# ---- DAY/NIGHT ----
+# IR-cut: two-pin H-bridge coil (datasheet AOUT/BOUT, 5-12 V, 25-60 Ohm), from
+# the OEM ko.sh "378" branch (the active path on this SSC027D board):
+#   gpio 80 "IRCUT B / AOUT" -- pulsed high = day   (filter in)
+#   gpio 81 "IRCUT A / BOUT" -- pulsed high = night (filter out)
+# The OEM pulses ~250 ms then drives both low. ric's two-pin convention pulses
+# gpio_ircut for day and gpio_ircut2 for night, hence the order. ric's default
+# pulse_ms (10) is too short for this coil. Same pins/behaviour as the MC-A85.
+# The coil plugs into the sensor board and the drive reaches it via the SoC<->
+# sensor FPC ribbon; gpio 23 is the CDS/IR-detect input. See N803-PAD-MAP.md.
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_IRCUT_GPIO_IRCUT="80"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_IRCUT_GPIO_IRCUT2="81"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_IRCUT_PULSE_MS="250"
+
+# Auto day/night: ric's luma trigger, which judges night->day against a night
+# baseline taken with the IR lit, plus an IR level ladder. The legacy gain
+# trigger's fixed thresholds cannot hold: the IR-lit night gain is whatever the
+# scene makes it (IR 40% settled at 11000 in one spot and 7262 in the next, under
+# day_threshold 8000, so the camera flipped every ~20 s). Night starts at 10% IR
+# and steps up while the IR-lit gain stays above 16000 (on the bench: 29460 at
+# 5% down to 3003 at 100%); day returns when gain drops under 25% of the settled
+# night baseline, or when an IR-off probe finds gain at or under 20000 (half of
+# night_gain). Needs raptor patches 0003-0004 and the raptor-hal fork's 0..255
+# ae_luma. See docs/contrib/thingino/DAYNIGHT-TUNING.md.
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_IRCUT_TRIGGER="luma"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_IRCUT_NIGHT_GAIN="40000"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_IRCUT_IR_LEVELS="10,20,40,70,100"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_IRCUT_IR_STEP_GAIN="16000"
+
+# ---- LIGHTS ----
+# IR (850 nm) and white banks are PWM-dimmed on the SoC's two PWM pads, as in
+# the OEM firmware (padmux PAD_PWM0/PAD_PWM1 -> PWM0/PWM1, period 50 us):
+#   PAD_PWM1 = IR bank   -> PWM1
+#   PAD_PWM0 = white bank -> PWM9 (PINMUX_FOR_PWM9_MODE_2), not the OEM's
+#     PWM0: mi.ko drives a dual-sensor frame-sync wave on PWM0 when the DT
+#     enables it (infinity6c.dtsi does: vif_ds_rt_pwm_sync = <1>, pin <0>), and
+#     with PWM0 on this pad that strobed the white LEDs at the frame rate.
+# The board device tree muxes both pads that way; PWM0 is routed to no pad, so
+# mi.ko's frame-sync wave on PWM0 strobes nothing and the sync output is left at
+# its default (the reference board gave these pads to I2C0 and carried PWM0 on
+# PAD_PWM0, which is what strobed). overlay/etc/init.d/
+# S30light sets up the two PWM channels at boot via overlay/usr/sbin/light,
+# which also provides thingino's "light <type> on|off|toggle|read" CLI (the
+# WebUI light buttons) plus "light <type> brightness 0-100". ric switches the
+# IR bank with day/night through our irled_cmd hook
+# (package/thingino-raptor/0002-ric-irled_cmd-hook-*.patch).
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_IRCUT_IRLED_CMD="/usr/sbin/light ir"
+
+# ---- STREAMS / OSD / RING ----
+# This module has 256 MB DDR (~90 MB Linux + 166 MB MMA) -- unlike the MC-A85's
+# tight 70 MB, there is ample MMA for 4K. 4K H.264 main (3840x2160) WITH JPEG ON
+# the main, so /x/ch0.jpg snapshots are full 3840x2160 (ENABLED 2026-10-31,
+# live-verified: 4K JPEGs encode with ~59 MB MMA still free -- the MC-A85's "4K
+# main + JPEG floods MMA" does NOT apply here, that was its tight 70 MB part).
+# The 720p sub also carries JPEG. refmode (zero-copy ring) over-allocs -- copy mode.
+# OSD = timestamp (date+clock) only; each MI_RGN element costs MMA.
+# See docs/contrib/thingino/RAPTOR-PACKAGE-TOPOLOGY.md.
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_STREAM0_WIDTH="3840"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_STREAM0_HEIGHT="2160"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_STREAM1_ENABLED_TRUE=y
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_STREAM1_WIDTH="1280"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_STREAM1_HEIGHT="720"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_RING_REFMODE_FALSE=y
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_OSD_ENABLED_TRUE=y
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_OSD_TIMESTAMP_VISIBLE_TRUE=y
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_OSD_UPTIME_VISIBLE_FALSE=y
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_OSD_CAMERA_VISIBLE_FALSE=y
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_OSD_LOGO_VISIBLE_FALSE=y
+
+# ---- RTSP ----
+# Four clients is not enough: Frigate holds two (main + sub), an NVR two
+# more, and a live view or snapshot client then gets refused (as on the
+# YMF46D).
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_RTSP_MAX_CLIENTS="8"
+
+# ---- HTTP (rhd) ----
+# rhd serves the snapshots and MJPEG the web UI previews. HTTPS on 8443, as on
+# the unit today: its [http] credentials travel as Basic auth.
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_HTTP_PORT="8443"
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_HTTP_HTTPS_TRUE=y
+
+# ---- AUDIO ----
+# One AI device on this chip (the analog condenser mic); rad's default of device
+# 1 does not exist, so without this the mic stays off (the same fix the B8A63
+# needed). Unlike the MC-A85, the N803 HAS a microSD slot (SDIO1 in the board
+# DTS, OEM /dev/mmcblk1) -- SD is left to the kernel MMC driver + thingino
+# automount, a bench verify item. The speaker/talk path needs its amp enabled
+# (gpio54 high); deferred to the two-way-audio bring-up.
+BR2_PACKAGE_THINGINO_RAPTOR_CONF_AUDIO_DEVICE="0"
+
+# ---- LENS / PTZ: N803 is a Pelco-D manual-focus head; lensd runs -P ----
+BR2_PACKAGE_THINGINO_LENSD=y
