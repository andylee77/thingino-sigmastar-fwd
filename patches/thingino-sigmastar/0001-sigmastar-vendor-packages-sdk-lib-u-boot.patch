++static int pCus_SetFPS(ms_cus_sensor *handle, u32 fps)
++{
++    int vts = 0;
++    gc8613_params *params = (gc8613_params *)handle->private_data;
++
++    if (fps >= Preview_MIN_FPS && fps <= Preview_MAX_FPS) {
++        params->expo.fps = fps;
++        params->expo.vts = vts_linefreq / fps;
++    } else if (fps >= 5000 && fps <= 30000) {
++        params->expo.fps = fps;
++        params->expo.vts = vts_linefreq_milli / fps;
++    } else {
++        return FAIL;
++    }
++
++    if ((params->expo.line) > (params->expo.vts) - 4)
++        vts = params->expo.line + 4;
++    else
++        vts = params->expo.vts;
++
++    params->tVts_reg[0].data = (vts >> 8) & 0x003f;
++    params->tVts_reg[1].data = (vts >> 0) & 0x00ff;
++    params->vts_dirty = true;
++    return SUCCESS;
++}
