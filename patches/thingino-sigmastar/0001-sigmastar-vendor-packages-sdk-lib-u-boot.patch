+	bool "sigmastar-sdk"
+	depends on BR2_SOC_VENDOR_SIGMASTAR
+	depends on BR2_LINUX_KERNEL
+	select BR2_PACKAGE_SIGMASTAR_LIB
+	# The 1230-matching sensor headers for the sensor-src build.
+	select BR2_PACKAGE_SIGMASTAR_SENSOR_HEADERS if BR2_SIGMASTAR_SENSOR_SOURCE
+	help
+	  The kernel side of the SigmaStar vendor stack: the prebuilt mi_*
+	  and mhal kernel modules, the sensor drivers built from source for
+	  the configured Infinity family, the ISP tuning blobs and the VENC
+	  firmware.
+
+	  The vendor modules are prebuilt against Linux 4.9.84, which is why
+	  this board pins that kernel: insmod checks vermagic and a mismatch
+	  is fatal. The sensor drivers are compiled here and have no such
+	  constraint; one is chosen at runtime by load_sigmastar from the
+	  U-Boot `sensor` variable.
+
+	  Selects sigmastar-lib, which carries the MI userspace libraries
+	  the Raptor HAL dlopens. Neither half is useful alone.
+
+	  https://github.com/johnchia/sigmastar-sdk
+
+# The 1230-matching sensor headers it selects; a hidden symbol, so here rather
+# than in the top-level Config.in.
+source "$BR2_EXTERNAL_THINGINO_PATH/package/sigmastar-sensor-headers/Config.in"
diff --git a/package/sigmastar-sdk/files/S20sigmastar b/package/sigmastar-sdk/files/S20sigmastar
new file mode 100644
index 000000000..9997d084c
--- /dev/null
+++ b/package/sigmastar-sdk/files/S20sigmastar
@@ -0,0 +1,53 @@
+#!/bin/sh
+#
+# Load the SigmaStar MI kernel modules.
+#
+# WHY S20, AND WHY RAPTOR IS NOT RENAMED
+#
+# The only real constraint is that the MI modules are in and /dev/mi_* exists
+# before rvd opens the HAL. thingino installs Raptor at S31raptor.
+#
+# OpenIPC solves the same ordering the other way round: its module load lives
+# in S70vendor, so it has to rename upstream's S31raptor to S95raptor to get
+# behind it. That rename is forced by *OpenIPC's* init layout, not by anything
+# about this hardware, and reproducing it here would cost two things for no
+# gain: an edit to thingino-raptor.mk's install path, and a patch to
+# thingino-agent-adapter-raptor, which hardcodes /etc/init.d/S31raptor in two
+# places (its detection probe and its streamer-restart action). Loading early
+# instead leaves both untouched.
+#
+# S20 is safe this early because:
+#   - CONFIG_DEVTMPFS_MOUNT=y, so /dev is populated by the kernel and does not
+#     wait on mdev. The one node devtmpfs does not create, /dev/mi_poll, is
+#     mknod'd by load_sigmastar itself.
+#   - S30mdev only runs `mdev -s` and sets the hotplug helper; it does not
+#     remount /dev, so the node created here survives it.
+#   - fw_printenv works from S03mac onward, which is earlier still.
+#
+# If Raptor ever does move to S95, this can stay where it is -- late loading
+# is what needs justifying, not early.
+
+case "$1" in
+	start)
+		echo -c 15 "Loading SigmaStar vendor modules"
+		load_sigmastar -i
+		;;
+
+	stop)
+		# Deliberately a no-op. Unloading the MI stack in reverse is not
+		# reliable while anything still holds a buffer, and the only caller
+		# is shutdown, where the reboot does it properly.
+		true
+		;;
+
+	restart)
+		load_sigmastar -i
+		;;
+
+	*)
+		echo "Usage: $0 {start|stop|restart}"
+		exit 1
+		;;
+esac
+
+exit 0
diff --git a/package/sigmastar-sdk/files/script/load_sigmastar b/package/sigmastar-sdk/files/script/load_sigmastar
new file mode 100644
index 000000000..1432c6b57
--- /dev/null
+++ b/package/sigmastar-sdk/files/script/load_sigmastar
@@ -0,0 +1,180 @@
+#!/bin/sh
+#
+# Insert the SigmaStar MI kernel modules and bind the sensor driver.
+#
+# Ported from OpenIPC (general/package/sigmastar-sdk-infinity6e). Three
+# deliberate changes from their version:
+#
+#   1. The module directory is derived from `uname -r` rather than hardcoded
+#      to 4.9.84. The modules are installed under the kernel release Buildroot
+#      probed, and hardcoding it here means a kernel bump silently loads
+#      nothing -- the loop just finds no files and every later insmod fails
+#      with a message about the module, not about the path.
+#   2. The OpenIPC-specific bits are gone: the `fpv` check against
+#      /etc/os-release, and the OpenIPC logger tag.
+#   3. There is no sensor autodetection. The U-Boot `sensor` variable is the
+#      per-unit override; when it is unset the build-time name installed at
+#      /usr/share/sensor/model is used instead.
+#
+# The i2c probe used to come from OpenIPC's ipctool. That package is gone, and
+# thingino's own detector (sensor-info/sinfo) is Ingenic-only, so this platform
+# has no native probe to fall back on yet. Restore autodetection here once
+# sensor-info learns SigmaStar -- do not reintroduce ipctool.
+#
+# Argument: accepted and ignored, so the init script's `-i` keeps working. It
+# used to mean "trust the stored variable rather than re-probing", a
+# distinction with no meaning now that the variable is the only source.
+
+MODULE=/lib/modules/$(uname -r)/sigmastar
+SENSOR=$(fw_printenv -n sensor 2>/dev/null)
+
+# A full sysupgrade erases the environment, so the variable cannot be the only
+# source: without this the camera does not stream until it is re-entered by
+# hand, and there is no remote recovery. The environment is never written back
+# -- it stays the per-unit override and wins wherever it exists.
+# model is written by sigmastar-sdk-infinity6e from SENSOR_1_MODEL.
+if [ -z "$SENSOR" ] && [ -r /usr/share/sensor/model ]; then
+	SENSOR=$(cat /usr/share/sensor/model)
+	SENSOR_FROM_BUILD=1
+fi
+
+log() { echo "$@" | logger -s -t sigmastar; }
+
+set_sensor() {
+	case $SENSOR in
+		gc8613)
+			insmod $MODULE/sensor_${SENSOR}_mipi.ko chmap=1 lane_num=4
+			;;
+		gc2053 | gc4653 | imx274 | imx307 | imx335 | imx347 | imx415 | sc501ai | sc8235 | os04a10 | os04c10)
+			insmod $MODULE/sensor_${SENSOR}_mipi.ko chmap=1
+			;;
+		tp9950)
+			insmod $MODULE/sensor_${SENSOR}_mipi.ko chmap=1 mode=3 channel=0
+			;;
+		tp9951)
+			insmod $MODULE/sensor_${SENSOR}_mipi.ko chmap=1 mode=0 channel=2
+			;;
+		*)
+			log "unsupported sensor - $SENSOR"
+			return 1
+			;;
+	esac
+}
+
+# The module set is per family and the two barely overlap. Infinity6E has
+# mhal, mi_mipitx, mi_divp and mi_vpe; Infinity6C ships none of them and needs
+# mi_vcodec -- which carries the MHAL_* symbols mi_venc links against -- plus
+# mi_isp, mi_scl and mi_aio. 6E's list on 6C leaves mi_venc and the sensor
+# driver with unresolved symbols and nothing streams.
+#
+# The device tree is the only family source that is correct before any module
+# is loaded.
+SOC_COMPAT=$(tr -d '\0' </proc/device-tree/compatible 2>/dev/null)
+
+# Load order is the vendor's and is not arbitrary -- mi_sys owns the buffer
+# pool every later module registers against, and 6E's mi_venc wants the VENC
+# firmware path at insmod time.
+insert_ko_infinity6e() {
+	insmod $MODULE/mhal.ko
+	insmod $MODULE/mi_common.ko
+	insmod $MODULE/mi_sys.ko cmdQBufSize=768 logBufSize=256
+	insmod $MODULE/mi_rgn.ko
+	insmod $MODULE/mi_ldc.ko
+	insmod $MODULE/mi_ai.ko
+	insmod $MODULE/mi_ao.ko
+	insmod $MODULE/mi_mipitx.ko
+	insmod $MODULE/mi_sensor.ko
+	insmod $MODULE/mi_shadow.ko
+	insmod $MODULE/mi_divp.ko
+	insmod $MODULE/mi_vif.ko
+	insmod $MODULE/mi_vpe.ko
+	insmod $MODULE/mi_venc.ko fw_path=/etc/firmware/chagall.bin
+}
+
+# 6C ships in two shapes. From the 2024-12 drop the whole MI stack is one
+# mi.ko; before that it is nineteen modules whose load order matters. Which one
+# is installed is a build-time choice, but testing for the file keeps this
+# script independent of it.
+#
+# g_ModParamPath and the VENC firmware path both default to /config paths that
+# thingino does not have. vdisp_bufq_depth is the vendor's own value from
+# script/demo.sh.
+insert_ko_infinity6c_mono() {
+	insmod $MODULE/mi.ko \
+		g_ModParamPath=/etc/firmware/modparam.json \
+		vdisp_bufq_depth=4 \
+		drv_codec40_common.fw_load_path=/etc/firmware/chagall.bin
+}
+
+# Order is modules.dep's, verified on an SSC377QE. 6C's mi_sys rejects
+# cmdQBufSize and logBufSize by name. sensor_config only registers /dev/srcfg
+# and configures nothing until something writes to it.
+#
+# 6C loads the VENC firmware through mi_vcodec, not mi_venc, and the parameter
+# carries the vendor's per-object prefix. Without it the driver keeps its
+# compiled-in /config/venc_fw path, finds nothing, and MI_VENC_CreateDev fails.
+insert_ko_infinity6c() {
+	if [ -f $MODULE/mi.ko ]; then
+		insert_ko_infinity6c_mono
+		return
+	fi
+
+	insmod $MODULE/mi_common.ko
+	insmod $MODULE/mi_sys.ko
+	insmod $MODULE/mi_rgn.ko
+	insmod $MODULE/mi_vif.ko
+	insmod $MODULE/mi_sensor.ko
+	insmod $MODULE/mi_isp.ko
+	insmod $MODULE/mi_ldc.ko
+	insmod $MODULE/mi_shadow.ko
+	insmod $MODULE/mi_scl.ko
+	insmod $MODULE/mi_vcodec.ko \
+		drv_codec40_common.fw_load_path=/etc/firmware/chagall.bin
+	insmod $MODULE/mi_venc.ko
+	insmod $MODULE/mi_aio.ko
+	insmod $MODULE/mi_ai.ko
+	insmod $MODULE/mi_ao.ko
+	insmod $MODULE/sensor_config.ko
+}
+
+insert_ko() {
+	case "$SOC_COMPAT" in
+		*infinity6c*) insert_ko_infinity6c ;;
+		*)            insert_ko_infinity6e ;;
+	esac
+
+	# mi_poll registers a chrdev with no class, so devtmpfs does not create
+	# the node for it. Everything else under /dev/mi_* appears on its own.
+	MAJOR=$(awk '$2=="mi_poll" {print $1}' /proc/devices)
+	[ -n "$MAJOR" ] && mknod /dev/mi_poll c "$MAJOR" 0
+	echo isproot /etc/firmware >/dev/ispmid
+}
+
+if [ ! -d "$MODULE" ]; then
+	log "no vendor modules at $MODULE"
+	exit 1
+fi
+
+if [ ! -e /sys/module/mi_common ]; then
+	insert_ko
+fi
+
+if [ -z "$SENSOR" ]; then
+	log "no sensor identified -- set the U-Boot 'sensor' variable"
+	exit 1
+fi
+
+# Named explicitly: a board whose sensor differs from the target's is corrected
+# by setting the variable, and the log is the only place that is visible.
+[ -n "$SENSOR_FROM_BUILD" ] && log "U-Boot 'sensor' unset, using build-time $SENSOR"
+
+# Re-binding: drop whatever driver is already bound before inserting one.
+DRIVER=$(ls /sys/module | grep "$SENSOR")
+if [ -n "$DRIVER" ]; then
+	rmmod $DRIVER
+fi
+
+log "sensor $SENSOR"
+set_sensor
+
+exit $?
