++/* Mirror/flip data per orientation, reversed from OEM SetOrien. The register
++ * addresses are mirror_reg1[]/mirror_reg2[]; only the data bytes change. */
++static int pCus_SetOrien(ms_cus_sensor *handle, CUS_CAMSENSOR_ORIT orit)
++{
++    gc8613_params *params = (gc8613_params *)handle->private_data;
++    /* mr1 data[0..8] for regs 022c,0063,0a67,0a98,05be,05a9,0a70,0a73,0a5a */
++    static const u8 mr1[4][9] = {
++        /* M0F0 */ {0x00,0x00,0x80,0x04,0x00,0x01,0x03,0x60,0x80},
++        /* M1F0 */ {0x00,0x05,0x80,0x04,0x00,0x01,0x03,0x61,0x80},
++        /* M0F1 */ {0x01,0x02,0x80,0x04,0x00,0x01,0x03,0x62,0x80},
++        /* M1F1 */ {0x01,0x07,0x80,0x04,0x00,0x01,0x03,0x63,0x80},
++    };
++    /* mr2 data[0..3] for regs 05be,0a70,0080,0a67 (same for all orientations) */
++    static const u8 mr2[4] = {0x01,0x00,0x02,0x00};
++    int sel, i;
++
++    switch (orit) {
++        case CUS_ORIT_M0F0: sel = 0; break;
++        case CUS_ORIT_M1F0: sel = 1; break;
++        case CUS_ORIT_M0F1: sel = 2; break;
++        case CUS_ORIT_M1F1: sel = 3; break;
++        default: return FAIL;
++    }
++    for (i = 0; i < 9; i++)
++        params->tMirror_reg1[i].data = mr1[sel][i];
++    for (i = 0; i < 4; i++)
++        params->tMirror_reg2[i].data = mr2[i];
++
++    handle->orient = orit;
++    params->orient_dirty = true;
++    return SUCCESS;
++}
