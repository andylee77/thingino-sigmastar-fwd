diff --git a/package/sigmastar-sensor-headers/sigmastar-sensor-headers.mk b/package/sigmastar-sensor-headers/sigmastar-sensor-headers.mk
new file mode 100644
index 000000000..0291ea792
--- /dev/null
+++ b/package/sigmastar-sensor-headers/sigmastar-sensor-headers.mk
@@ -0,0 +1,40 @@
+################################################################################
+#
+# sigmastar-sensor-headers
+#
+# The six Infinity6C sensor-framework headers sigmastar-sdk's sensor-src must
+# be built against for the 1230 drop. sigmastar-sdk at its pin carries the
+# release_0907 set (fe5d953 there took sensor-src from release_0907), whose
+# ms_cus_sensor has no spi_cfg/spi_bus: 1230's mi.ko keeps its SPI handle at
+# handle+0x4c and dereferences it after init_handle, and with the 0907 layout
+# that slot is an AE field, so every driver built from it oopsed in
+# DrvSensorSPIAttach. The set before fe5d953 matches the 1230 prebuilts
+# (i2c_cfg at 0x2c, spi_bus at 0x4c).
+#
+# That set came from openipc/sensors, and it is byte-identical there (same git
+# blobs) at the commit sigmastar-sdk's PROVENANCE names, 8143e4d:
+# sigmastar/infinity6c/include/. This package fetches it from there instead of
+# carrying SigmaStar's text in a patch. The headers are SigmaStar's, marked
+# confidential, and carry no license: not redistributed.
+#
+################################################################################
+
+SIGMASTAR_SENSOR_HEADERS_SITE_METHOD = git
+# Local mirror of https://github.com/openipc/sensors, kept by
+# mirror-sigmastar-deps.sh so the build does not depend on that repository.
+SIGMASTAR_SENSOR_HEADERS_SITE = file://$(HOME)/src/mirrors/git/openipc__sensors.git
+SIGMASTAR_SENSOR_HEADERS_VERSION = 8143e4da181d39d569572519595ce4b7e1a9a02d
+SIGMASTAR_SENSOR_HEADERS_LICENSE = PROPRIETARY
+SIGMASTAR_SENSOR_HEADERS_REDISTRIBUTE = NO
+
+SIGMASTAR_SENSOR_HEADERS_INSTALL_STAGING = YES
+SIGMASTAR_SENSOR_HEADERS_INSTALL_TARGET = NO
+
+# Staged where sigmastar-sdk copies them from; nothing is compiled here.
+define SIGMASTAR_SENSOR_HEADERS_INSTALL_STAGING_CMDS
+	$(INSTALL) -d -m 0755 $(STAGING_DIR)/usr/share/sigmastar-sensor-headers/infinity6c
+	$(INSTALL) -m 0644 -t $(STAGING_DIR)/usr/share/sigmastar-sensor-headers/infinity6c \
+		$(@D)/sigmastar/infinity6c/include/*.h
+endef
+
+$(eval $(generic-package))
diff --git a/package/sigmastar-uboot/0001-cmd_sf-drop-retrospective-rootfs-auto-sizing.patch b/package/sigmastar-uboot/0001-cmd_sf-drop-retrospective-rootfs-auto-sizing.patch
new file mode 100644
index 000000000..4faa3ae8d
--- /dev/null
+++ b/package/sigmastar-uboot/0001-cmd_sf-drop-retrospective-rootfs-auto-sizing.patch
@@ -0,0 +1,64 @@
+From: thingino-firmware sigmastar fork
+Subject: [PATCH] cmd_sf: drop the retrospective rootfs partition auto-sizing
+
+`sf probe` ended by reading the squashfs superblock already in flash and
+setting rootmtd/rootsize from it. Two properties made that unusable here.
+
+It is retrospective. The superblock it reads describes the image that is
+already on the chip, not the one being written, so the partition is always
+sized for the previous image. The first image to cross the 5120k threshold
+cannot be flashed at all: mtd3 is still 5120k at that moment and flashcp
+refuses it.
+
+It is also unconditional and runs before `run setargs` expands ${rootmtd},
+so it overwrites the stored environment in RAM on every boot. `fw_setenv
+rootmtd` can never take effect, which makes the stored value misleading
+rather than merely unused.
+
+This tree sizes the kernel and rootfs partitions to the built images at
+build time and ships the result in the environment. Boot-time auto-sizing
+is redundant against that, and worse, the two disagree: the build says one
+size and `sf probe` says another, with the bootloader winning.
+
+Removing the block leaves `sf probe` doing only what its name says. The
+declarations go with it because magic/bytes/buf/file have no other use in
+the function.
+
+This is OpenIPC-specific code. Mainline U-Boot and SigmaStar's vendor tree
+have no equivalent, so nothing upstream of this fork depends on it.
+
+--- a/common/cmd_sf.c
++++ b/common/cmd_sf.c
+@@ -171,32 +171,6 @@
+ 	flash = new;
+ #endif
+ 
+-	char buf[64];
+-	unsigned int magic, bytes;
+-
+-	if (spi_flash_read(flash, CONFIG_ENV_ROOTADDR, sizeof(buf), buf)) {
+-		printf("Failed to read from SPI flash\n");
+-		return 1;
+-	}
+-
+-	memcpy(&magic, &buf[0], sizeof(magic));
+-	memcpy(&bytes, &buf[40], sizeof(bytes));
+-
+-	if (magic == 0x73717368) {
+-		if (bytes + 0x1000 < 0x500000) {
+-			setenv("rootmtd", "5120k");
+-		} else {
+-			setenv("rootmtd", "8192k");
+-		}
+-	}
+-
+-	ulong file = getenv_ulong("filesize", 16, 0);
+-	if (file < 0x500000) {
+-		setenv("rootsize", "0x500000");
+-	} else {
+-		setenv("rootsize", "0x800000");
+-	}
+-
+ 	return 0;
+ }
+ 
diff --git a/package/sigmastar-uboot/Config.in b/package/sigmastar-uboot/Config.in
new file mode 100644
index 000000000..e064b4bcf
--- /dev/null
+++ b/package/sigmastar-uboot/Config.in
@@ -0,0 +1,19 @@
+config BR2_PACKAGE_SIGMASTAR_UBOOT
+	bool "sigmastar-uboot"
+	depends on BR2_SOC_VENDOR_SIGMASTAR
+	help
+	  U-Boot for SigmaStar Infinity6-family SoCs, from OpenIPC's fork of
+	  the vendor tree.
+
+	  Builds a NOR boot image (BOOT.bin) into images/ and installs nothing
+	  to the target. Producing it does not flash it: the boot partition is
+	  the one place on this board where a bad write cannot be recovered in
+	  software, so writing it needs a serial console and an SPI flash clip
+	  on the bench.
+
+	  A sibling of thingino-uboot rather than a variant of it. That package
+	  is Ingenic silicon end to end -- jz_sfc flash controllers, per-SoC
+	  isvp_* board defconfigs, a MIPS SPL -- and has no SigmaStar path to
+	  extend.
+
+	  https://github.com/openipc/u-boot-sigmastar
diff --git a/package/sigmastar-uboot/sigmastar-uboot.mk b/package/sigmastar-uboot/sigmastar-uboot.mk
new file mode 100644
index 000000000..bba409f2d
--- /dev/null
+++ b/package/sigmastar-uboot/sigmastar-uboot.mk
@@ -0,0 +1,97 @@
+################################################################################
+#
+# sigmastar-uboot
+#
+# U-Boot for SigmaStar Infinity6-family SoCs, from OpenIPC's fork of the vendor
+# tree. Builds a NOR boot image into images/ and installs nothing to the target.
+#
+# The artifact is not u-boot.bin. A SigmaStar NOR boot image is a container the
+# mask ROM reads, assembled by make_boot_spinor.sh from four pieces at fixed
+# offsets in the first 128KB -- IPL at 0, MXP_SF at 60k, IPL_CUST at 64k -- with
+# the compressed U-Boot appended at 128k. The first three are vendor blobs
+# carried in the tree; only the tail is built here. Flashing u-boot.bin instead
+# produces a board that does not boot and cannot be recovered over the network.
+#
+# The SoC model reaches the compiler as a define rather than a defconfig: one
+# defconfig covers the whole family. PRODUCT_SOC does NOT select DDR timing --
+# it is stringified into the "soc=" environment variable and used only to build
+# TFTP filenames (u-boot-${soc}-nor.bin, uImage.${soc}); see
+# include/configs/sstar-common.h. DDR init lives in the IPL/GCIS blobs, which
+# are per family, not per part: make_boot_spinor.sh takes the family and there
+# is one ipl/infinity6c/ set. Upstream's build.sh iterates ssc377 ssc377d
+# ssc377de ssc377qe ssc378de ssc378qe over that single build, so the bootloader
+# binary differs between those parts in name only.
+#
+# Building this does not flash it, and nothing in the image references it. The
+# boot partition is the only one on this board where a bad write cannot be
+# undone in software.
+#
+################################################################################
+
+SIGMASTAR_UBOOT_VERSION = bf77aff5d44f34d14b89b3f4014aa8dda9834794
+SIGMASTAR_UBOOT_SITE = https://github.com/openipc/u-boot-sigmastar
+SIGMASTAR_UBOOT_SITE_METHOD = git
+SIGMASTAR_UBOOT_LICENSE = GPL-2.0+ (u-boot), PROPRIETARY (ipl/)
+SIGMASTAR_UBOOT_LICENSE_FILES = Licenses/gpl-2.0.txt
+SIGMASTAR_UBOOT_REDISTRIBUTE = NO
+SIGMASTAR_UBOOT_INSTALL_IMAGES = YES
+SIGMASTAR_UBOOT_INSTALL_TARGET = NO
+SIGMASTAR_UBOOT_INSTALL_STAGING = NO
+
+# From thingino.mk's exported environment, not from .config: the model reaches
+# Kconfig too, but the family is derived there and never written back. Both are
+# checked below because an empty one here builds a target named "_defconfig" and
+# fails several steps later with nothing naming the cause.
+SIGMASTAR_UBOOT_SOC_MODEL = $(SOC_MODEL)
+SIGMASTAR_UBOOT_SOC_FAMILY = $(SOC_FAMILY)
+
+# Only when the package is actually selected. external.mk includes every
+# package .mk for every build, and a toolchain producer has no SoC at all.
+ifeq ($(BR2_PACKAGE_SIGMASTAR_UBOOT),y)
+ifeq ($(SIGMASTAR_UBOOT_SOC_MODEL),)
+$(error sigmastar-uboot: SOC_MODEL is empty -- expected it exported by thingino.mk)
+endif
+ifeq ($(SIGMASTAR_UBOOT_SOC_FAMILY),)
+$(error sigmastar-uboot: SOC_FAMILY is empty -- expected it exported by thingino.mk)
+endif
+endif
+
+# For mkenvimage, which the post-image script uses to build the environment
+# image describing the partition table. host-uboot-tools installs it
+# unconditionally. BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE is a different thing
+# and not what is wanted here -- it asks Buildroot to generate an environment
+# image from a static source file, which cannot express a table whose sizes
+# come from the images this build produces.
+SIGMASTAR_UBOOT_DEPENDENCIES = host-uboot-tools
+
+SIGMASTAR_UBOOT_MAKE_ENV = ARCH=arm CROSS_COMPILE="$(TARGET_CROSS)"
+
+define SIGMASTAR_UBOOT_CONFIGURE_CMDS
+	$(SIGMASTAR_UBOOT_MAKE_ENV) $(MAKE1) -C $(@D) \
+		$(SIGMASTAR_UBOOT_SOC_FAMILY)_defconfig
+endef
+
+# -std=gnu11 because this tree predates C23 and GCC 16 defaults to it. Its
+# include/fwfs.h carries
+#
+#     #ifndef bool
+#     typedef unsigned char       bool;
+#     #endif
+#
+# which guards against bool being a *macro* from stdbool.h. Under C23 it is a
+# keyword instead, so the guard passes and the typedef is rejected. Infinity6C
+# is where this surfaces -- infinity6c_defconfig builds fs/firmwarefs and the
+# Infinity6E one does not -- but the flag is set for every family, since it
+# describes the age of the source rather than anything about a chip.
+define SIGMASTAR_UBOOT_BUILD_CMDS
+	$(SIGMASTAR_UBOOT_MAKE_ENV) $(MAKE) -C $(@D) \
+		KCFLAGS="-DPRODUCT_SOC=$(SIGMASTAR_UBOOT_SOC_MODEL) -std=gnu11"
+	cd $(@D) && $(SHELL) make_boot_spinor.sh $(SIGMASTAR_UBOOT_SOC_FAMILY)
+endef
+
+define SIGMASTAR_UBOOT_INSTALL_IMAGES_CMDS
+	$(INSTALL) -D -m 0644 $(@D)/BOOT.bin \
+		$(BINARIES_DIR)/u-boot-$(SIGMASTAR_UBOOT_SOC_MODEL)-nor.bin
+endef
+
+$(eval $(generic-package))
