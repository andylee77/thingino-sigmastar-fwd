++/////////////////// gain ///////////////////
++static int pCus_GetAEGain(ms_cus_sensor *handle, u32 *gain)
++{
++    gc8613_params *params = (gc8613_params *)handle->private_data;
++    u32 again = SENSOR_AE_MIN_GAIN, dgain;
++    u8 i;
++
++    for (i = 0; i < ARRAY_SIZE(gain_table); i++) {
++        if ((gain_table[i].again[0] == params->tGain_reg[1].data) &&
++            (gain_table[i].again[1] == params->tGain_reg[2].data) &&
++            (gain_table[i].again[2] == params->tGain_reg[4].data) &&
++            (gain_table[i].again[3] == params->tGain_reg[5].data) &&
++            (gain_table[i].again[4] == params->tGain_reg[6].data) &&
++            (gain_table[i].again[5] == params->tGain_reg[7].data) &&
++            (gain_table[i].again[6] == params->tGain_reg[8].data) &&
++            (gain_table[i].again[7] == params->tGain_reg[9].data)) {
++            again = gain_table[i].gain;
++            break;
++        }
++    }
++
++    dgain = ((params->tGain_reg[10].data & 0xf) << 6) + (params->tGain_reg[11].data & 0x3f);
++    *gain = (again * dgain) / 64;   /* fits u32: <=67450*1024 */
++    return SUCCESS;
++}
++
++static int pCus_SetAEGain(ms_cus_sensor *handle, u32 gain)
++{
++    gc8613_params *params = (gc8613_params *)handle->private_data;
++    u32 dgain;
++    u8 i, tmp;
++
++    params->expo.final_gain = gain;
++
++    if (gain < SENSOR_AE_MIN_GAIN)
++        gain = SENSOR_AE_MIN_GAIN;
++    else if (gain > SENSOR_MAX_GAIN)
++        gain = SENSOR_MAX_GAIN;
++
++    tmp = ARRAY_SIZE(gain_table) - 1;
++    for (i = 1; i < ARRAY_SIZE(gain_table); i++) {
++        if ((gain >= gain_table[i-1].gain) && (gain < gain_table[i].gain)) {
++            tmp = i - 1;
++            break;
++        }
++    }
++
++    dgain = (gain * 64) / gain_table[tmp].gain;
++    if (dgain > SENSOR_DGAIN_MAX)
++        dgain = SENSOR_DGAIN_MAX;
++
++    /* analog gain registers (fixed-order 0x031d toggles already preset) */
++    params->tGain_reg[0].data = 0x2d;
++    params->tGain_reg[1].data = gain_table[tmp].again[0];
++    params->tGain_reg[2].data = gain_table[tmp].again[1];
++    params->tGain_reg[3].data = 0x28;
++    params->tGain_reg[4].data = gain_table[tmp].again[2];
++    params->tGain_reg[5].data = gain_table[tmp].again[3];
++    params->tGain_reg[6].data = gain_table[tmp].again[4];
++    params->tGain_reg[7].data = gain_table[tmp].again[5];
++    params->tGain_reg[8].data = gain_table[tmp].again[6];
++    params->tGain_reg[9].data = gain_table[tmp].again[7];
++    /* digital gain: 64 = 1x, integer part to 0x0064, frac/64 to 0x0065 */
++    params->tGain_reg[10].data = (dgain >> 6) & 0xff;
++    params->tGain_reg[11].data = dgain & 0x3f;
++
++    params->gain_dirty = true;
++    return SUCCESS;
++}
