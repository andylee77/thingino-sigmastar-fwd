++/////////////////// exposure ///////////////////
++static int pCus_GetAEUSecs(ms_cus_sensor *handle, u32 *us)
++{
++    gc8613_params *params = (gc8613_params *)handle->private_data;
++    u32 lines = 0;
++
++    lines  = (u32)(params->tExpo_reg[0].data & 0xff);
++    lines |= (u32)(params->tExpo_reg[1].data & 0x3f) << 8;
++    *us = (lines * Preview_line_period) / 1000;   /* fits u32: <=2250*14814 */
++    return SUCCESS;
++}
++
++static int pCus_SetAEUSecs(ms_cus_sensor *handle, u32 us)
++{
++    u32 lines = 0, vts = 0;
++    gc8613_params *params = (gc8613_params *)handle->private_data;
++
++    lines = (1000 * us) / Preview_line_period;   /* us AE-clamped <=200000 */
++    if (lines < 1) lines = 1;
++
++    if (lines > params->expo.vts - 4)
++        vts = lines + 4;
++    else
++        vts = params->expo.vts;
++
++    params->expo.line = lines;
++    params->tExpo_reg[0].data = (lines) & 0x00ff;
++    params->tExpo_reg[1].data = (lines >> 8) & 0x003f;
++    params->tVts_reg[0].data = (vts >> 8) & 0x003f;
++    params->tVts_reg[1].data = (vts >> 0) & 0x00ff;
++
++    params->expo_dirty = true;
++    params->vts_dirty = true;
++    return SUCCESS;
++}
