diff --git a/package/thingino-lensd/files/raptor-hook b/package/thingino-lensd/files/raptor-hook
new file mode 100755
index 000000000..62808bccc
--- /dev/null
+++ b/package/thingino-lensd/files/raptor-hook
@@ -0,0 +1,6 @@
+#!/bin/sh
+# Raptor runs this with "stop" before any of its daemons go down and with
+# "start" once they are back. lensd reads the ISP every frame; a call that
+# lands while rvd tears the ISP channel down oopses the vendor MI module and
+# leaves the MI device locked, so the next rvd hangs opening it.
+exec /etc/init.d/S33lensd "$1"
diff --git a/package/thingino-lensd/files/stock_af.h b/package/thingino-lensd/files/stock_af.h
new file mode 100644
index 000000000..817eb486f
--- /dev/null
+++ b/package/thingino-lensd/files/stock_af.h
@@ -0,0 +1,53 @@
+/* Stock JL12D2 AF configuration, read off a running stock firmware (
+ * V3.3.2.4) with MI_ISP_CUS3A_GetAF*, 2026-10-25. Applied with the matching
+ * MI_ISP_CUS3A_SetAF* so the focus values match stock's scale; the other nine
+ * AF structs are identical on both firmwares. */
+
+/* 264 bytes; 13 differ from the 1230 default */
+static const unsigned char STOCK_AFWINDOW[264] = {
+	0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x13, 0x00, 0x00, 0x00,
+	0x13, 0x00, 0x00, 0x00, 0xeb, 0x03, 0x00, 0x00, 0xeb, 0x03, 0x00, 0x00,
+	0xaa, 0x00, 0x00, 0x00, 0xaa, 0x00, 0x00, 0x00, 0x52, 0x03, 0x00, 0x00,
+	0x52, 0x03, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0xff, 0x02, 0x00, 0x00, 0xff, 0x00, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0xff, 0x03, 0x00, 0x00, 0xff, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0xff, 0x00, 0x00, 0x00,
+	0xff, 0x01, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00,
+	0xff, 0x01, 0x00, 0x00, 0xff, 0x01, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00,
+	0x00, 0x01, 0x00, 0x00, 0xff, 0x02, 0x00, 0x00, 0xff, 0x01, 0x00, 0x00,
+	0x00, 0x03, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0xff, 0x03, 0x00, 0x00,
+	0xff, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00,
+	0xff, 0x00, 0x00, 0x00, 0xff, 0x02, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00,
+	0x00, 0x02, 0x00, 0x00, 0xff, 0x01, 0x00, 0x00, 0xff, 0x02, 0x00, 0x00,
+	0x00, 0x02, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0xff, 0x02, 0x00, 0x00,
+	0xff, 0x02, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00,
+	0xff, 0x03, 0x00, 0x00, 0xff, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
