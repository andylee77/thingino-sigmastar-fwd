diff --git a/package/thingino-lensd/thingino-lensd.mk b/package/thingino-lensd/thingino-lensd.mk
new file mode 100644
index 000000000..09babb0a5
--- /dev/null
+++ b/package/thingino-lensd/thingino-lensd.mk
@@ -0,0 +1,85 @@
+################################################################################
+#
+# thingino-lensd
+#
+################################################################################
+
+THINGINO_LENSD_VERSION = 1.2
+THINGINO_LENSD_SITE_METHOD = local
+THINGINO_LENSD_SITE = $(THINGINO_LENSD_PKGDIR)/files
+THINGINO_LENSD_LICENSE = MIT
+
+THINGINO_LENSD_DEPENDENCIES = sigmastar-lib
+
+# off, af or pelco (Config.in). Every SigmaStar camera builds lensd; the mode
+# says whether it runs and whether the camera offers PTZ at all. The head
+# names its calibration file (heads/), which ONVIF RelativeMove needs.
+THINGINO_LENSD_MODE = $(call qstrip,$(BR2_PACKAGE_THINGINO_LENSD_MODE))
+THINGINO_LENSD_HEAD = $(call qstrip,$(BR2_PACKAGE_THINGINO_LENSD_HEAD))
+
+ifneq ($(THINGINO_LENSD_MODE),off)
+ifeq ($(BR2_PACKAGE_THINGINO_WEBUI),y)
+# The web UI PTZ plugin: installed after thingino-webui so that its plugin
+# assembly (a target-finalize hook) finds lensd.webui.json.
+THINGINO_LENSD_DEPENDENCIES += thingino-webui
+
+define THINGINO_LENSD_INSTALL_WWW_CMDS
+	$(INSTALL) -D -m 0644 $(@D)/www/a/preview-lensd.js \
+		$(TARGET_DIR)/var/www/a/preview-lensd.js
+	$(INSTALL) -D -m 0755 $(@D)/www/x/json-lensd.cgi \
+		$(TARGET_DIR)/var/www/x/json-lensd.cgi
+	$(INSTALL) -D -m 0644 $(@D)/lensd.webui.json \
+		$(TARGET_DIR)/var/www/a/plugins/lensd.webui.json
+endef
+endif
+
+# /usr/bin/motors is what turns the ONVIF server's PTZ on (/bin -> usr/bin);
+# S33lensd points the server's ptz section at lensctl with onvif-ptz.json.
+# Every head's calibration ships; LENSD_HEAD picks this camera's.
+define THINGINO_LENSD_INSTALL_PTZ_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/motors $(TARGET_DIR)/usr/bin/motors
+	$(INSTALL) -D -m 0644 $(@D)/onvif-ptz.json \
+		$(TARGET_DIR)/usr/share/lensd/onvif-ptz.json
+	$(INSTALL) -d -m 0755 $(TARGET_DIR)/usr/share/lensd/heads
+	$(INSTALL) -m 0644 -t $(TARGET_DIR)/usr/share/lensd/heads $(@D)/heads/*.conf
+	printf '%s\n' \
+		'# The head calibration (/usr/share/lensd/heads/<head>.conf), from' \
+		'# BR2_PACKAGE_THINGINO_LENSD_HEAD. Empty: no ONVIF RelativeMove.' \
+		'LENSD_HEAD="$(THINGINO_LENSD_HEAD)"' \
+		>>$(TARGET_DIR)/etc/default/lensd
+	$(THINGINO_LENSD_INSTALL_WWW_CMDS)
+endef
+endif
+
+# The same vendor drop sigmastar-lib installs; see SIGMASTAR_LIB_BLOBS.
+THINGINO_LENSD_MI_LIBS = $(SIGMASTAR_LIB_DIR)/$(SOC_FAMILY)/lib/$(SIGMASTAR_DROP)/$(SIGMASTAR_LIBC)/$(SIGMASTAR_GCC)
+
+# Linked, not dlopened: libmi_isp and libcus3a call each other, and uClibc
+# resolves a dlopened library's lazy calls only against libraries loaded
+# before it, so no dlopen order works. --no-as-needed keeps libcus3a and
+# libispalgo, which lensd itself does not call.
+define THINGINO_LENSD_BUILD_CMDS
+	$(TARGET_CC) $(TARGET_CFLAGS) $(TARGET_LDFLAGS) -Os -s -Wall -Wextra \
+		-o $(@D)/lensd $(@D)/lensd.c -L$(THINGINO_LENSD_MI_LIBS) \
+		-Wl,--no-as-needed -lmi_isp -lcus3a -lispalgo -lmi_sys \
+		-lmi_common -lcam_os_wrapper -lcam_fs_wrapper \
+		-Wl,--allow-shlib-undefined -ldl
+endef
+
+# /etc/raptor.d/lensd has raptor stop lensd before rvd goes down (S33lensd
+# does nothing in mode off). /etc/default/lensd carries the mode.
+define THINGINO_LENSD_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/lensd $(TARGET_DIR)/usr/sbin/lensd
+	$(INSTALL) -D -m 0755 $(@D)/lensctl $(TARGET_DIR)/usr/sbin/lensctl
+	$(INSTALL) -D -m 0755 $(@D)/S33lensd $(TARGET_DIR)/etc/init.d/S33lensd
+	$(INSTALL) -D -m 0755 $(@D)/raptor-hook $(TARGET_DIR)/etc/raptor.d/lensd
+	$(INSTALL) -d -m 0755 $(TARGET_DIR)/etc/default
+	printf '%s\n' \
+		'# The lens/PTZ board, from BR2_PACKAGE_THINGINO_LENSD_MODE: off, af or pelco.' \
+		'# S33lensd starts lensd only when it is not off.' \
+		'LENSD_MODE="$(THINGINO_LENSD_MODE)"' \
+		>$(TARGET_DIR)/etc/default/lensd
+	$(THINGINO_LENSD_INSTALL_PTZ_CMDS)
+endef
+
+$(eval $(generic-package))
