+++ b/package/thingino-raptor/files/www/a/streamer-osd.js
@@ -17,6 +17,53 @@
   const alphaFill = document.getElementById("alpha_fill");
   const alphaOutline = document.getElementById("alpha_outline");
   const saveBtn = document.getElementById("save-osd-config");
+  const applyNote = document.getElementById("osd-apply-note");
+
+  // Where a stream restart is known to apply saved OSD changes (a platform
+  // feature flag; on a T20 it dropped the OSD until the next boot, so the
+  // default stays "reboot"), offer that instead: about 10 s, not a reboot.
+  const uiDevice = (window.thinginoUIConfig || {}).device || {};
+  const restartApplies = uiDevice.osd_restart_applies === true;
+  const RESTART_NOTE =
+    "Saved to /etc/raptor.conf. Most text changes show at once; the logo, " +
+    "the OSD on/off switch and anything that does not show yet apply when " +
+    "the stream restarts (about 10 seconds).";
+
+  async function restartStream() {
+    showAlert("info", "Restarting the stream...", 5000);
+    try {
+      await fetch("/x/restart-streamer.cgi", {
+        method: "POST",
+        cache: "no-store",
+      });
+      showAlert(
+        "success",
+        "Stream restarted; the OSD can take a few seconds to reappear.",
+        6000,
+      );
+    } catch (err) {
+      showAlert("danger", "Failed to restart the stream: " + err.message);
+    }
+  }
+
+  if (restartApplies && applyNote) {
+    applyNote.textContent = RESTART_NOTE + " ";
+    const btn = document.createElement("button");
+    btn.type = "button";
+    btn.className = "btn btn-link btn-sm p-0 align-baseline";
+    btn.textContent = "Restart stream now";
+    btn.addEventListener("click", async () => {
+      const ok = await thinginoConfirm({
+        title: "Restart stream",
+        message:
+          "Restart the stream to apply the saved OSD? Video stops for about 10 seconds.",
+        confirmLabel: "Restart stream",
+        intent: "warning",
+      });
+      if (ok) restartStream();
+    });
+    applyNote.appendChild(btn);
+  }
 
   function updateSwatch(input, swatch) {
     let v = (input.value || "").trim();
@@ -273,11 +320,23 @@
       await patchLeaves(helper, "time/", time);
 
       await saveElements(helper);
-      showAlert(
-        "success",
-        "OSD configuration saved. Reboot the camera to apply it.",
-        6000,
-      );
+      if (restartApplies) {
+        const restart = await thinginoConfirm({
+          title: "OSD saved",
+          message:
+            "Most text changes show at once. Restart the stream now to apply the rest (the logo, the OSD on/off switch)? Video stops for about 10 seconds.",
+          confirmLabel: "Restart stream",
+          cancelLabel: "Later",
+          intent: "warning",
+        });
+        if (restart) await restartStream();
+      } else {
+        showAlert(
+          "success",
+          "OSD configuration saved. Reboot the camera to apply it.",
+          6000,
+        );
+      }
