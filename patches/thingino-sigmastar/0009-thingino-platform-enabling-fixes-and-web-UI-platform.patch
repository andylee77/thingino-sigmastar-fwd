 package/thingino-ethernet/Config.in           |  4 +-
 package/thingino-isp/Config.in                |  2 +
 .../files/www/a/streamer-osd.js               | 69 +++++++++++++++++--
 .../files/www/streamer-osd.html               |  2 +-
 .../files/www/x/json-sensor-upload.cgi        |  7 +-
 package/thingino-raptor/files/www/x/zoom.cgi  |  4 +-
 .../thingino-webui/files/www/a/control-bar.js | 27 ++++++--
 package/thingino-webui/files/www/a/main.js    |  2 +-
 .../files/www/x/json-sensor-info.cgi          |  7 +-
 10 files changed, 110 insertions(+), 18 deletions(-)

diff --git a/overlay/usr/sbin/sensor-iq-name b/overlay/usr/sbin/sensor-iq-name
index 962df9677..9ef362077 100755
--- a/overlay/usr/sbin/sensor-iq-name
+++ b/overlay/usr/sbin/sensor-iq-name
@@ -1,6 +1,8 @@
 #!/bin/sh
 # Print the sensor IQ file name the Ingenic SDK loads for a sensor and SoC.
 # T10/T20/T30 SDKs install <sensor>.bin; newer families <sensor>-<soc>.bin.
+# SigmaStar (soc -f prints infinity*): the raptor HAL looks the file up by
+# the sensor name alone, <sensor>.bin.
 
 if [ $# -ne 2 ]; then
 	echo "usage: sensor-iq-name <sensor> <soc>" >&2
@@ -8,6 +10,6 @@ if [ $# -ne 2 ]; then
 fi
 
 case "$2" in
-	t10 | t20 | t30) printf '%s.bin\n' "$1" ;;
+	t10 | t20 | t30 | infinity*) printf '%s.bin\n' "$1" ;;
 	*) printf '%s-%s.bin\n' "$1" "$2" ;;
 esac
