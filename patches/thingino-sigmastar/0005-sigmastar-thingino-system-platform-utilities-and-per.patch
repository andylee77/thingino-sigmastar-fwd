diff --git a/package/thingino-system/Config.in b/package/thingino-system/Config.in
index 774f8a19e..2a477169a 100644
--- a/package/thingino-system/Config.in
+++ b/package/thingino-system/Config.in
@@ -19,6 +19,19 @@ config BR2_PACKAGE_THINGINO_SYSTEM_INGENIC
 	  Another vendor supplies its own block rather than teaching these
 	  to branch.
 
+config BR2_PACKAGE_THINGINO_SYSTEM_SIGMASTAR
+	default y
+	bool "SigmaStar platform utilities"
+	depends on BR2_PACKAGE_THINGINO_SYSTEM && BR2_SOC_VENDOR_SIGMASTAR
