index 000000000..951d98d47
--- /dev/null
+++ b/board/sigmastar/infinity6c/patches/linux/0001-ARM-dts-infinity6c-add-the-UVision-MC-A85-module.patch
@@ -0,0 +1,93 @@
+From: Andy <andylee77@users.noreply.github.com>
+Subject: [PATCH] ARM: dts: infinity6c: add the UVision MC-A85 module
+
+SSC378DE + GC8613 camera module (Anpviz IPC-D3B83B-S and others). Starts
+from the SSC027D reference board and changes only the padmux: PWM on the LED
+pads instead of I2C0, the Ethernet PHY LED and 2-wire FUART pads. PWM0 is left
+unrouted so mi.ko's dual-sensor frame-sync wave (on by default in the dtsi)
+drives nothing instead of strobing the white LEDs. Selected with
+CONFIG_SS_DTB_NAME="infinity6c-ssc378de-mca85".
+
+---
+--- /dev/null	2026-10-17 15:21:06.361937226 -0400
++++ b/arch/arm/boot/dts/infinity6c-ssc378de-mca85.dts	2026-10-18 00:24:49.999278444 -0400
+@@ -0,0 +1,79 @@
++/*
++ * infinity6c-ssc378de-mca85.dts - UVision MC-A85 camera module
++ *
++ * SigmaStar SSC378DE (Infinity6C) + GalaxyCore GC8613, 16 MB SPI NOR,
++ * 128 MB DDR. Sold as the Anpviz IPC-D3B83B-S dome, among others.
++ *
++ * This program is free software; you can redistribute it and/or modify it
++ * under the terms of the GNU General Public License version 2, as published
++ * by the Free Software Foundation.
++ *
++ * The module follows SigmaStar's SSC027D reference design closely, so this
++ * file starts from that board and overrides only what the module's own OEM
++ * device tree (decompiled from the vendor kernel) does differently:
++ *
++ *  - PAD_PWM0/PAD_PWM1 drive the white and IR LED banks. The reference board
++ *    gives both pads to I2C0, which this module does not use. IR is PWM1 on
++ *    PAD_PWM1, as in the OEM DT. White is PWM9 on PAD_PWM0 (PWM9_MODE_2)
++ *    rather than the OEM's PWM0: the result is the same, and it does not
++ *    depend on mi.ko leaving PWM0 alone (see vif below).
++ *  - PAD_PM_LED0/LED1 carry the Ethernet PHY LEDs, and PAD_FUART_RX/TX the
++ *    2-wire FUART, as in the OEM DT.
++ * infinity6c.dtsi leaves the dual-sensor frame-sync output on
++ * (vif_ds_rt_pwm_sync = <1>), so mi.ko claims PWM0 for a frame-rate square
++ * wave. That is deliberately NOT overridden here: PWM0 is routed to no pad in
++ * the padmux above (white is PWM9, IR is PWM1), so the wave drives a dead end
++ * and no LED strobes -- which is what caused the strobe on the reference board,
++ * where PAD_PWM0 carried PWM0. Leaving the property at its default keeps mi.ko's
++ * ISP bring-up on the same path the reference board uses; forcing it to 0 left
++ * the ISP IQ semaphore uninitialised and crashed rvd in MI_ISP_IMPL_GetIQApiData
++ * at the first-frame tuning load.
++ *
++ * Left as in the reference board:
++ *  - SDIO. The OEM DT also muxes SDIO1 (PAD_SD_*, power on PAD_FUART_RTS,
++ *    detect on PAD_PM_SD_CDZ) for an optional SD daughterboard; not fitted
++ *    on the unit this was brought up on, so it is untested and not muxed.
++ *  - core_power. The OEM board selects Vcore with two VID GPIOs (PM_GPIO7
++ *    and PM_GPIO8: 860/920/980/1000 mV). The reference DT drives only
++ *    PM_GPIO8, and PM_GPIO7 sits pulled high, so the levels it requests land
++ *    at 920/1000 mV -- at or above the OEM's at every OPP. Adopting the OEM
++ *    table would lower the 1.1-1.2 GHz level, which is only safe if its
++ *    index-to-pin order matches the OEM driver's; not verified.
++ */
++
++#include "infinity6c-ssc027d-s01a.dts"
++
++/ {
++    model = "UVision MC-A85 (SSC378DE + GC8613)";
++
++    soc {
++        padmux {
++            schematic =
++                <GPIO_NR                 PINMUX_FOR_UNKNOWN_MODE         MDRV_PUSE_NA>,
++                /* white LED bank */
++                <PAD_PWM0                PINMUX_FOR_PWM9_MODE_2          MDRV_PUSE_PWM9>,
++                /* IR LED bank */
++                <PAD_PWM1                PINMUX_FOR_PWM1_MODE_1          MDRV_PUSE_PWM1>,
++                <PAD_PM_LED0             PINMUX_FOR_LED0_MODE_1          MDRV_PUSE_ETH0_LED>,
++                <PAD_PM_LED1             PINMUX_FOR_LED1_MODE_1          MDRV_PUSE_ETH1_LED>,
++                <PAD_FUART_RX            PINMUX_FOR_FUART_2W_MODE_1      MDRV_PUSE_FUART_RX>,
++                <PAD_FUART_TX            PINMUX_FOR_FUART_2W_MODE_1      MDRV_PUSE_FUART_TX>,
++                /* sensor I2C */
++                <PAD_I2C1_SCL            PINMUX_FOR_I2C1_MODE_1          MDRV_PUSE_I2C1_SCL>,
++                <PAD_I2C1_SDA            PINMUX_FOR_I2C1_MODE_1          MDRV_PUSE_I2C1_SDA>,
++                /* SDMMC0, as the reference board */
++                <PAD_SD1_IO1             PINMUX_FOR_SDIO_MODE_1          MDRV_PUSE_SDIO0_D1>,
++                <PAD_SD1_IO0             PINMUX_FOR_SDIO_MODE_1          MDRV_PUSE_SDIO0_D0>,
++                <PAD_SD1_IO5             PINMUX_FOR_SDIO_MODE_1          MDRV_PUSE_SDIO0_CLK>,
++                <PAD_SD1_IO4             PINMUX_FOR_SDIO_MODE_1          MDRV_PUSE_SDIO0_CMD>,
++                <PAD_SD1_IO3             PINMUX_FOR_SDIO_MODE_1          MDRV_PUSE_SDIO0_D3>,
++                <PAD_SD1_IO2             PINMUX_FOR_SDIO_MODE_1          MDRV_PUSE_SDIO0_D2>,
++                <PAD_PM_GPIO9            PINMUX_FOR_GPIO_MODE            MDRV_PUSE_SDIO0_PWR>,
++                <PAD_SD1_IO6             PINMUX_FOR_SDIO_CDZ_MODE_1      MDRV_PUSE_SDIO0_CDZ>,
++                <PAD_GPIO0               PINMUX_FOR_I2S_RX_MODE_1        MDRV_PUSE_I2S0_RX_WCK>,
++                <PAD_GPIO1               PINMUX_FOR_I2S_RX_MODE_1        MDRV_PUSE_I2S0_RX_BCK>,
++                <PAD_GPIO2               PINMUX_FOR_I2S_RX_MODE_1        MDRV_PUSE_I2S0_RX_SDI>,
++                <PAD_GPIO3               PINMUX_FOR_I2S_RX_MODE_1        MDRV_PUSE_I2S0_TX_SDO>;
++        };
++    };
++};
