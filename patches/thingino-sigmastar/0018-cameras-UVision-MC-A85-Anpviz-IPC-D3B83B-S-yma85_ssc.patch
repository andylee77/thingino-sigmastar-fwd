diff --git a/board/sigmastar/infinity6c/patches/linux/0001-ARM-dts-infinity6c-add-the-UVision-MC-A85-module.patch b/board/sigmastar/infinity6c/patches/linux/0001-ARM-dts-infinity6c-add-the-UVision-MC-A85-module.patch
