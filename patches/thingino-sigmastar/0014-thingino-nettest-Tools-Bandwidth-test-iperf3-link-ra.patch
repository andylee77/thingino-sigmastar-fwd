diff --git a/package/thingino-nettest/files/www/a/tool-nettest.js b/package/thingino-nettest/files/www/a/tool-nettest.js
new file mode 100644
index 000000000..3b7c25108
--- /dev/null
+++ b/package/thingino-nettest/files/www/a/tool-nettest.js
@@ -0,0 +1,378 @@
+(function () {
+  const API_URL = "/x/json-nettest.cgi";
+  const STATUS_MS = 3000;
+  const RESULT_MS = 1000;
+  // Retransmit share of the TCP segments sent in one refresh, below which the
+  // link is fine and above which video over UDP visibly breaks up.
+  const RETRANS_OK = 0.5;
+  const RETRANS_BAD = 2;
+  // Too few segments in a refresh make the share meaningless.
+  const MIN_SEGMENTS = 100;
+
+  const linkTable = $("#linkTable");
+  const linkNote = $("#linkNote");
+  const serverState = $("#serverState");
+  const serverPort = $("#serverPort");
+  const serverMinutes = $("#serverMinutes");
+  const serverStart = $("#serverStart");
+  const serverStop = $("#serverStop");
+  const serverBoot = $("#serverBoot");
+  const serverHint = $("#serverHint");
+  const testForm = $("#testForm");
+  const testTarget = $("#testTarget");
+  const testProto = $("#testProto");
+  const testDir = $("#testDir");
+  const testSeconds = $("#testSeconds");
+  const testMbps = $("#testMbps");
+  const testMbpsLabel = $("#testMbpsLabel");
+  const testPort = $("#testPort");
+  const testHelp = $("#testHelp");
+  const testRun = $("#testRun");
+  const testStatus = $("#testStatus");
+  const testSummary = $("#testSummary");
+  const testIntervals = $("#testIntervals");
+
+  const runDefaultHtml = testRun.innerHTML;
+  let previous = null;
+  let portEdited = false;
+  let polling = false;
+
+  async function call(action, params = {}, method = "GET") {
+    const query = new URLSearchParams({ a: action, ...params });
+    const response =
+      method === "GET"
+        ? await fetch(`${API_URL}?${query}`, { cache: "no-store" })
+        : await fetch(API_URL, { method: "POST", body: query, cache: "no-store" });
+    let payload = null;
+    try {
+      payload = await response.json();
+    } catch (e) {
+      payload = null;
+    }
+    if (!response.ok || !payload || payload.error) {
+      const message = payload && payload.error && payload.error.message;
+      throw new Error(message || `HTTP ${response.status}`);
+    }
+    return payload;
+  }
+
+  // Text from the camera or an iperf3 peer goes into the page as text only.
+  function esc(value) {
+    const div = document.createElement("div");
+    div.textContent = String(value);
+    return div.innerHTML;
+  }
+
+  function showError(el, message) {
+    el.innerHTML = `<span class="text-danger">${esc(message)}</span>`;
+  }
+
+  function mbps(bitsPerSecond) {
+    return `${(bitsPerSecond / 1e6).toFixed(1)} Mbit/s`;
+  }
+
+  function percent(part, whole) {
+    return whole > 0 ? (100 * part) / whole : 0;
+  }
+
+  function badge(text, tone) {
+    return `<span class="badge text-bg-${tone}">${text}</span>`;
+  }
+
+  function retransTone(share) {
+    if (share < RETRANS_OK) return "success";
+    return share < RETRANS_BAD ? "warning" : "danger";
+  }
+
+  function row(label, html) {
+    return `<tr><th class="fw-normal text-secondary text-nowrap">${label}</th><td>${html}</td></tr>`;
+  }
+
+  function linkText(link) {
+    if (!link.carrier) return badge("down", "danger");
+    const speed = link.speed_mbps ? `${link.speed_mbps} Mbit/s` : "speed unknown";
+    const how = link.autoneg === false ? ", forced" : link.autoneg ? ", autonegotiated" : "";
+    const tone = link.duplex === "full" ? "" : ` ${badge(`${link.duplex} duplex`, "warning")}`;
+    return `${speed}, ${link.duplex} duplex${how}${tone}`;
+  }
+
+  function partnerText(partner) {
+    if (!partner) return '<span class="text-secondary">not readable on this interface</span>';
+    if (partner.modes.length === 0) {
+      return `${badge("advertises nothing", "warning")} the port does not autonegotiate, so the duplex can disagree <code>${esc(partner.lpa)}</code>`;
+    }
+    const modes = partner.modes.map((m) => m.replace(/(full|half)$/, " $1")).join(", ");
+    const pause = partner.pause || partner.asym_pause ? ", flow control" : "";
+    return `${modes}${pause} <code title="MII link partner register, a fingerprint of the switch model">${esc(partner.lpa)}</code>`;
+  }
+
+  function retransText(status) {
+    const tcp = status.tcp;
+    const sinceBoot = percent(tcp.retrans_segs, tcp.out_segs);
+    let now = '<span class="text-secondary">measuring...</span>';
+    if (previous && status.uptime_s > previous.uptime_s) {
+      const out = tcp.out_segs - previous.tcp.out_segs;
+      const retrans = tcp.retrans_segs - previous.tcp.retrans_segs;
+      if (out >= MIN_SEGMENTS) {
+        const share = percent(retrans, out);
+        now = `${badge(`${share.toFixed(2)}%`, retransTone(share))} of ${out} segments in the last ${status.uptime_s - previous.uptime_s} s`;
+      } else {
+        now = '<span class="text-secondary">too little TCP traffic to judge</span>';
+      }
+    }
+    return `${now}<br><small class="text-secondary">${sinceBoot.toFixed(2)}% since boot (${tcp.retrans_segs} of ${tcp.out_segs})</small>`;
+  }
+
+  function errorsText(c, udp) {
+    const errors = {
+      "rx errors": c.rx_errors,
+      "CRC errors": c.rx_crc_errors,
+      "rx overruns": c.rx_fifo_errors,
+      "tx errors": c.tx_errors,
+      "tx drops": c.tx_dropped,
+      "tx underruns": c.tx_fifo_errors,
+      collisions: c.collisions,
+      "UDP receive buffer drops": udp.rcvbuf_errors,
+      "UDP send buffer drops": udp.sndbuf_errors,
+    };
+    const seen = Object.entries(errors).filter(([, n]) => n > 0);
+    const list = seen.length
+      ? seen.map(([name, n]) => `${name} ${n}`).join(", ")
+      : '<span class="text-success">none</span>';
+    return `${list}<br><small class="text-secondary">${c.rx_dropped} received frames dropped by the stack (mostly protocols the camera does not run)</small>`;
+  }
+
+  function renderLink(status) {
+    linkTable.innerHTML =
+      row("Interface", status.iface) +
+      row("Link", linkText(status.link)) +
+      row("Switch port", partnerText(status.link.partner)) +
+      row("TCP retransmits", retransText(status)) +
+      row("Errors since boot", errorsText(status.counters, status.udp));
+    linkNote.textContent =
+      "Retransmits are the camera's own count of TCP segments it had to send again: lost on the way, whatever the client. " +
+      "Above a few tenths of a percent, video over UDP (VLC, the web preview) breaks up; check the switch and cable.";
+  }
+
+  function clock(seconds) {
+    const m = Math.floor(seconds / 60);
+    const s = String(seconds % 60).padStart(2, "0");
+    return `${m}:${s}`;
+  }
+
+  function renderServer(server) {
+    if (server.running) {
+      const off =
+        server.off_in_s === null ? "until stopped" : `switches off in ${clock(server.off_in_s)}`;
+      serverState.innerHTML = `${badge("running", "success")} on port ${server.port}, ${off}`;
+    } else {
+      serverState.innerHTML = badge("stopped", "secondary");
+    }
+    serverStart.textContent = server.running ? "Restart" : "Start";
+    serverStop.disabled = !server.running;
+    serverBoot.checked = server.boot;
+    if (!portEdited) serverPort.value = server.running ? server.port : server.saved_port;
+    const host = window.location.hostname;
+    const port = server.running ? server.port : serverPort.value;
+    const p = String(port) === "5201" ? "" : ` -p ${port}`;
+    serverHint.textContent =
+      `From a PC with iperf3:\n` +
+      `  iperf3 -c ${host}${p}              # PC sends to the camera\n` +
+      `  iperf3 -c ${host}${p} -R           # camera sends to the PC\n` +
+      `  iperf3 -c ${host}${p} -R -u -b 20M # camera sends UDP, reports loss`;
+  }
+
+  async function refresh() {
+    try {
+      const status = await call("status");
+      renderLink(status);
+      renderServer(status.server);
+      previous = status;
+      if (status.test === "running" && !polling) pollResult();
+    } catch (error) {
+      linkTable.innerHTML = row("Error", `<span class="text-danger">${esc(error.message)}</span>`);
+    }
+    setTimeout(refresh, STATUS_MS);
+  }
+
+  async function serverAction(action, params, button) {
+    button.disabled = true;
+    try {
+      await call(action, params, "POST");
+      portEdited = false;
+      previous = null;
+    } catch (error) {
+      showError(serverState, error.message);
+    } finally {
+      button.disabled = false;
+    }
+    const status = await call("status").catch(() => null);
+    if (status) renderServer(status.server);
+  }
+
+  function updateTestHelp() {
+    const udp = testProto.value === "udp";
+    testMbpsLabel.textContent = udp ? "UDP rate, Mbit/s" : "Rate cap, Mbit/s";
+    testMbps.min = udp ? 1 : 0;
+    if (udp && Number(testMbps.value) < 1) testMbps.value = 20;
+    if (!udp && testMbps.dataset.touched !== "1") testMbps.value = 0;
+    const from = testDir.value === "send" ? "camera to target" : "target to camera";
+    testHelp.textContent = udp
+      ? `UDP at a fixed rate, ${from}: shows loss and jitter, as video over UDP sees them.`
+      : `TCP as fast as the path allows (0 = no cap), ${from}: shows throughput and retransmits.`;
+  }
+
+  function setRunning(running) {
+    testRun.disabled = running;
+    testRun.innerHTML = running
+      ? '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Running...'
+      : runDefaultHtml;
+  }
+
+  function summaryRows(test, result) {
+    const end = result.end || {};
+    const rows = [];
+    const direction = esc(test.dir === "send" ? `camera → ${test.target}` : `${test.target} → camera`);
+    rows.push(row("Test", `${test.proto.toUpperCase()}, ${direction}, ${test.seconds} s`));
+    if (test.proto === "udp") {
+      const sum = end.sum_received || end.sum || {};
+      const sent = end.sum_sent || end.sum || {};
+      const lost = sum.lost_percent || 0;
+      const tone = lost === 0 ? "success" : lost < 0.5 ? "warning" : "danger";
+      rows.push(row("Sent", `${mbps(sent.bits_per_second || 0)} (asked ${test.mbps} Mbit/s)`));
+      rows.push(row("Received", mbps(sum.bits_per_second || 0)));
+      rows.push(row("Lost", `${badge(`${lost.toFixed(3)}%`, tone)} ${sum.lost_packets || 0} of ${sum.packets || 0} packets`));
+      rows.push(row("Jitter", `${(sum.jitter_ms || 0).toFixed(3)} ms`));
+    } else {
+      const sent = end.sum_sent || {};
+      const received = end.sum_received || {};
+      rows.push(row("Throughput", `${mbps(received.bits_per_second || 0)} received, ${mbps(sent.bits_per_second || 0)} sent`));
+      if (typeof sent.retransmits === "number") {
+        rows.push(row("Retransmits", String(sent.retransmits)));
+      }
+    }
+    return rows.join("");
+  }
+
+  function intervalLines(test, result) {
+    return (result.intervals || [])
+      .map((interval) => {
+        const s = interval.sum || {};
+        let line = `${s.start.toFixed(0).padStart(3)}-${s.end.toFixed(0).padEnd(3)} s  ${mbps(s.bits_per_second || 0).padStart(14)}`;
+        if (test.proto === "udp" && typeof s.lost_packets === "number") {
+          line += `  lost ${s.lost_packets}/${s.packets}`;
+        } else if (typeof s.retransmits === "number") {
+          line += `  retransmits ${s.retransmits}`;
+        }
+        return line;
+      })
+      .join("\n");
+  }
+
+  function renderResult(reply) {
+    const result = reply.result || {};
+    if (result.error) {
+      showError(testStatus, result.error);
+      testSummary.classList.add("d-none");
+      testIntervals.classList.add("d-none");
+      return;
+    }
+    testStatus.textContent = "";
+    testSummary.querySelector("tbody").innerHTML = summaryRows(reply.test, result);
+    testSummary.classList.remove("d-none");
+    testIntervals.textContent = intervalLines(reply.test, result);
+    testIntervals.classList.toggle("d-none", !testIntervals.textContent);
+  }
+
+  async function pollResult() {
+    polling = true;
+    setRunning(true);
+    try {
+      for (;;) {
+        const reply = await call("result");
+        if (reply.state === "running") {
+          const elapsed = reply.uptime_s - reply.test.started;
+          testStatus.innerHTML = `<span class="text-secondary">Testing against ${esc(reply.test.target)}: ${elapsed} of ${reply.test.seconds} s</span>`;
+          await sleep(RESULT_MS);
+          continue;
+        }
+        if (reply.state === "done") renderResult(reply);
+        break;
+      }
+    } catch (error) {
+      showError(testStatus, error.message);
+    } finally {
+      polling = false;
+      setRunning(false);
+    }
+  }
+
+  async function runTest(event) {
+    event.preventDefault();
+    if (!testTarget.value.trim()) {
+      testStatus.innerHTML = '<span class="text-danger">Enter a target host.</span>';
+      return;
+    }
+    setRunning(true);
+    testSummary.classList.add("d-none");
+    testIntervals.classList.add("d-none");
+    try {
+      await call(
+        "run",
+        {
+          target: testTarget.value.trim(),
+          proto: testProto.value,
+          dir: testDir.value,
+          seconds: testSeconds.value,
+          mbps: testMbps.value,
+          port: testPort.value,
+        },
+        "POST",
+      );
+      await pollResult();
+    } catch (error) {
+      showError(testStatus, error.message);
+      setRunning(false);
+    }
+  }
+
+  async function showLastResult() {
+    try {
+      const reply = await call("result");
+      if (reply.test) {
+        testTarget.value = reply.test.target;
+        testProto.value = reply.test.proto;
+        testDir.value = reply.test.dir;
+        testSeconds.value = reply.test.seconds;
+        testMbps.value = reply.test.mbps;
+        testPort.value = reply.test.port;
+        updateTestHelp();
+      }
+      if (reply.state === "running") pollResult();
+      else if (reply.state === "done") renderResult(reply);
+    } catch (error) {
+      // No last test to show.
+    }
+  }
+
+  serverPort.addEventListener("input", () => {
+    portEdited = true;
+  });
+  serverStart.addEventListener("click", () =>
+    serverAction("server", { on: 1, minutes: serverMinutes.value, port: serverPort.value }, serverStart),
+  );
+  serverStop.addEventListener("click", () => serverAction("server", { on: 0 }, serverStop));
+  serverBoot.addEventListener("change", () =>
+    serverAction("boot", { on: serverBoot.checked ? 1 : 0, port: serverPort.value }, serverBoot),
+  );
+  testProto.addEventListener("change", updateTestHelp);
+  testDir.addEventListener("change", updateTestHelp);
+  testMbps.addEventListener("input", () => {
+    testMbps.dataset.touched = "1";
+  });
+  testForm.addEventListener("submit", runTest);
+
+  updateTestHelp();
+  showLastResult();
+  refresh();
+})();
