diff --git a/package/thingino-nettest/Config.in b/package/thingino-nettest/Config.in
new file mode 100644
index 000000000..4425ae04d
--- /dev/null
+++ b/package/thingino-nettest/Config.in
@@ -0,0 +1,23 @@
+config BR2_PACKAGE_THINGINO_NETTEST
+	bool "thingino-nettest"
+	depends on BR2_TOOLCHAIN_HAS_ATOMIC # iperf3
+	depends on BR2_TOOLCHAIN_HAS_THREADS # iperf3
+	select BR2_PACKAGE_IPERF3
+	help
+	  Network testing from the camera, on the web UI's Tools >
+	  Bandwidth test page and as the nettest command:
+
+	  - the Ethernet link's health: speed, duplex, what the switch
+	    port advertises, error counters and the live TCP
+	    retransmit rate, which shows a lossy switch or cable at a
+	    glance;
+	  - an iperf3 server for tests from a PC or another camera. It
+	    answers anyone who can reach the camera, so it is off
+	    unless switched on, and switches itself off again after a
+	    set time unless it is set to start at boot;
+	  - iperf3 tests run from the camera to another host, TCP or
+	    UDP, in either direction.
+
+comment "thingino-nettest needs a toolchain w/ threads"
+	depends on BR2_TOOLCHAIN_HAS_ATOMIC
+	depends on !BR2_TOOLCHAIN_HAS_THREADS
diff --git a/package/thingino-nettest/files/S92nettest b/package/thingino-nettest/files/S92nettest
new file mode 100755
index 000000000..026844d4e
--- /dev/null
+++ b/package/thingino-nettest/files/S92nettest
@@ -0,0 +1,25 @@
+#!/bin/sh
+# S92nettest -- start the iperf3 server at boot when the Bandwidth test page's
+# "start at boot" is on (nettest.server_boot in /etc/thingino.json). Off by
+# default: the server answers anyone who can reach the camera.
+
+NETTEST=/usr/sbin/nettest
+
+case "$1" in
+start)
+	[ "$(jct /etc/thingino.json get nettest.server_boot 2>/dev/null)" = true ] || exit 0
+	echo "Starting iperf3 server..."
+	$NETTEST server start 0 >/dev/null
+	;;
+stop)
+	$NETTEST server stop >/dev/null
+	;;
+restart)
+	"$0" stop
+	"$0" start
+	;;
+*)
+	echo "Usage: $0 {start|stop|restart}"
+	exit 1
+	;;
+esac
diff --git a/package/thingino-nettest/files/miiread.c b/package/thingino-nettest/files/miiread.c
new file mode 100644
index 000000000..4a18fa590
--- /dev/null
+++ b/package/thingino-nettest/files/miiread.c
@@ -0,0 +1,42 @@
+/* miiread [ifname] -- print a NIC's MII registers 0-7 (BMCR, BMSR, PHY id,
+ * our advertisement, the link partner's, autoneg expansion) through
+ * SIOCGMIIPHY/SIOCGMIIREG. Read-only. Busybox has no mii-tool and these
+ * images carry no ethtool; nettest reads register 5 to say what the switch
+ * port advertises. */
+#include <linux/mii.h>
+#include <linux/sockios.h>
+#include <net/if.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+int main(int argc, char **argv)
+{
+	struct ifreq ifr;
+	struct mii_ioctl_data *mii = (struct mii_ioctl_data *)&ifr.ifr_data;
+	int fd = socket(AF_INET, SOCK_DGRAM, 0);
+
+	if (fd < 0) {
+		perror("socket");
+		return 1;
+	}
+	memset(&ifr, 0, sizeof(ifr));
+	strncpy(ifr.ifr_name, argc > 1 ? argv[1] : "eth0", IFNAMSIZ - 1);
+	if (ioctl(fd, SIOCGMIIPHY, &ifr) < 0) {
+		perror("SIOCGMIIPHY");
+		return 1;
+	}
+	printf("phy_addr=%u\n", mii->phy_id);
+	for (int r = 0; r < 8; r++) {
+		mii->reg_num = r;
+		if (ioctl(fd, SIOCGMIIREG, &ifr) < 0) {
+			perror("SIOCGMIIREG");
+			return 1;
+		}
+		printf("reg%d=0x%04x\n", r, mii->val_out);
+	}
+	close(fd);
+	return 0;
+}
diff --git a/package/thingino-nettest/files/nettest b/package/thingino-nettest/files/nettest
new file mode 100755
index 000000000..921d7040f
--- /dev/null
+++ b/package/thingino-nettest/files/nettest
@@ -0,0 +1,276 @@
+#!/bin/sh
+# nettest -- the camera end of the web UI's Tools > Bandwidth test page, also
+# usable over ssh. Every command but run prints JSON.
+#
+#   nettest status                   link, switch port, counters, server, test
+#   nettest server start [MIN] [PORT]
+#                                    iperf3 server, off again after MIN minutes
+#                                    (default 30; 0 = until stopped)
+#   nettest server stop
+#   nettest run HOST tcp|udp send|receive SECONDS [MBPS] [PORT]
+#                                    iperf3 test from this camera, in the
+#                                    background; MBPS caps TCP (0 = no cap)
+#                                    and sets the UDP rate
+#   nettest result                   the last test, {"state":"idle|running|done"}
+#
+# The server answers anyone who can reach the camera, so it is off unless
+# switched on, and switches itself off again unless asked to stay up (the
+# page's "start at boot", nettest.server_boot in /etc/thingino.json).
+
+CONFIG=/etc/thingino.json
+IPERF3=/usr/bin/iperf3
+RUN=/run/nettest
+SERVER_PID=$RUN/server.pid
+SERVER_PORT=$RUN/server.port
+DEADLINE=$RUN/server.deadline
+TIMER_PID=$RUN/timer.pid
+CLIENT_PID=$RUN/client.pid
+TEST=$RUN/test.json
+RESULT=$RUN/result.json
+DEFAULT_PORT=5201
+MAX_SECONDS=60
+
+mkdir -p "$RUN"
+
+die() {
+	echo "$*" >&2
+	exit 1
+}
+
+# alive <pidfile> <word>: the pid in the file is running and is ours (its
+# command line has <word>), not a later process that reused the number.
+alive() {
+	[ -s "$1" ] && grep -q "$2" "/proc/$(cat "$1")/cmdline" 2>/dev/null
+}
+
+uptime_s() {
+	cut -d. -f1 /proc/uptime
+}
+
+# A nettest key from thingino.json; empty when unset (jct exits 1 then).
+config_get() {
+	jct "$CONFIG" get "nettest.$1" 2>/dev/null
+}
+
+is_port() {
+	case "$1" in
+	'' | *[!0-9]*) return 1 ;;
+	esac
+	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
+}
+
+saved_port() {
+	_p=$(config_get server_port)
+	is_port "$_p" || _p=$DEFAULT_PORT
+	echo "$_p"
+}
+
+# The interface the default route leaves by (eth0 on our wired cameras).
+iface() {
+	_if=$(ip route show default 2>/dev/null |
+		awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
+	echo "${_if:-eth0}"
+}
+
+jbool() {
+	if [ "$1" -ne 0 ]; then printf true; else printf false; fi
+}
+
+# Speed, duplex and autoneg from the PHY, plus what the switch port
+# advertises (its MII register 5). A partner that advertises nothing does not
+# autonegotiate: a port forced to a speed, where the duplex can disagree.
+link_json() {
+	_carrier=$(cat "/sys/class/net/$1/carrier" 2>/dev/null)
+	_speed=$(cat "/sys/class/net/$1/speed" 2>/dev/null)
+	_duplex=$(cat "/sys/class/net/$1/duplex" 2>/dev/null)
+	case "$_speed" in
+	'' | *[!0-9]*) _speed=null ;;
+	esac
+	printf '{"carrier":%s,"speed_mbps":%s,"duplex":"%s"' \
+		"$([ "$_carrier" = 1 ] && echo true || echo false)" "$_speed" "${_duplex:-unknown}"
+	if _mii=$(miiread "$1" 2>/dev/null); then
+		_bmcr=$(printf '%s\n' "$_mii" | sed -n 's/^reg0=//p')
+		_bmsr=$(printf '%s\n' "$_mii" | sed -n 's/^reg1=//p')
+		_lpa=$(printf '%s\n' "$_mii" | sed -n 's/^reg5=//p')
+		_modes=
+		for _m in 0x0100:100full 0x0080:100half 0x0040:10full 0x0020:10half; do
+			[ $((_lpa & ${_m%%:*})) -ne 0 ] && _modes="$_modes${_modes:+,}\"${_m#*:}\""
+		done
+		printf ',"autoneg":%s,"autoneg_done":%s' \
+			"$(jbool $((_bmcr & 0x1000)))" "$(jbool $((_bmsr & 0x0020)))"
+		printf ',"partner":{"lpa":"%s","modes":[%s],"pause":%s,"asym_pause":%s}' \
+			"$_lpa" "$_modes" "$(jbool $((_lpa & 0x0400)))" "$(jbool $((_lpa & 0x0800)))"
+	else
+		printf ',"autoneg":null,"autoneg_done":null,"partner":null'
+	fi
+	printf '}'
+}
+
+counters_json() {
+	_c=
+	for _k in rx_packets rx_errors rx_dropped rx_crc_errors rx_fifo_errors \
+		tx_packets tx_errors tx_dropped tx_fifo_errors collisions; do
+		_v=$(cat "/sys/class/net/$1/statistics/$_k" 2>/dev/null)
+		_c="$_c${_c:+,}\"$_k\":${_v:-0}"
+	done
+	printf '{%s}' "$_c"
+}
+
+# Cumulative since boot; the page turns two samples into a rate.
+snmp_json() {
+	awk '
+	$1 == "Tcp:" || $1 == "Udp:" {
+		if (!seen[$1]++) { for (i = 2; i <= NF; i++) col[$1 $i] = i; next }
+		for (i = 2; i <= NF; i++) val[$1 i] = $i
+	}
+	function get(p, k) { return (p k) in col ? val[p col[p k]] + 0 : 0 }
+	END {
+		printf "\"tcp\":{\"out_segs\":%d,\"retrans_segs\":%d},", get("Tcp:", "OutSegs"), get("Tcp:", "RetransSegs")
+		printf "\"udp\":{\"in_errors\":%d,\"rcvbuf_errors\":%d,\"sndbuf_errors\":%d}", \
+			get("Udp:", "InErrors"), get("Udp:", "RcvbufErrors"), get("Udp:", "SndbufErrors")
+	}' /proc/net/snmp
+}
+
+server_json() {
+	_running=false _port=null _off=null
+	if alive "$SERVER_PID" iperf3; then
+		_running=true
+		_port=$(cat "$SERVER_PORT" 2>/dev/null)
+		is_port "$_port" || _port=null
+		if [ -s "$DEADLINE" ]; then
+			_off=$(($(cat "$DEADLINE") - $(uptime_s)))
+			[ "$_off" -ge 0 ] || _off=0
+		fi
+	fi
+	_boot=$(config_get server_boot)
+	[ "$_boot" = true ] || _boot=false
+	printf '{"running":%s,"port":%s,"off_in_s":%s,"boot":%s,"saved_port":%s}' \
+		"$_running" "$_port" "$_off" "$_boot" "$(saved_port)"
+}
+
+test_state() {
+	if alive "$CLIENT_PID" iperf3; then
+		echo running
+	elif [ -s "$RESULT" ]; then
+		echo done
+	else
+		echo idle
+	fi
+}
+
+status() {
+	_if=$(iface)
+	printf '{"iface":"%s","uptime_s":%s,"link":%s,"counters":%s,%s,"server":%s,"test":"%s"}\n' \
+		"$_if" "$(uptime_s)" "$(link_json "$_if")" "$(counters_json "$_if")" \
+		"$(snmp_json)" "$(server_json)" "$(test_state)"
+}
+
+server_stop() {
+	# The auto-off timer ends by running this; it must not kill itself.
+	if alive "$TIMER_PID" nettest && [ "$(cat "$TIMER_PID")" != "$$" ]; then
+		kill "$(cat "$TIMER_PID")" 2>/dev/null
+	fi
+	alive "$SERVER_PID" iperf3 && kill "$(cat "$SERVER_PID")" 2>/dev/null
+	rm -f "$TIMER_PID" "$DEADLINE" "$SERVER_PID" "$SERVER_PORT"
+}
+
+server_start() {
+	_min=${1:-30}
+	_port=${2:-$(saved_port)}
+	case "$_min" in
+	'' | *[!0-9]*) die "minutes must be a whole number" ;;
+	esac
+	is_port "$_port" || die "port must be 1-65535"
+	server_stop
+	"$IPERF3" -s -D -p "$_port" -I "$SERVER_PID" >/dev/null 2>&1 ||
+		die "the iperf3 server did not start (is port $_port in use?)"
+	sleep 1
+	alive "$SERVER_PID" iperf3 || die "the iperf3 server exited (is port $_port in use?)"
+	echo "$_port" >"$SERVER_PORT"
+	if [ "$_min" -gt 0 ]; then
+		echo $(($(uptime_s) + _min * 60)) >"$DEADLINE"
+		start-stop-daemon -S -b -m -p "$TIMER_PID" -x /bin/sh -- \
+			-c "sleep $((_min * 60)); exec /usr/sbin/nettest server stop"
+	fi
+	server_json
+	echo
+}
+
+run() {
+	_host=$1 _proto=$2 _dir=$3 _secs=$4 _mbps=${5:-0} _port=${6:-$DEFAULT_PORT}
+	# The host goes on a shell command line: names and addresses only.
+	case "$_host" in
+	'' | -* | *[!A-Za-z0-9.:-]*) die "target must be a host name or IP address" ;;
+	esac
+	case "$_proto" in
+	tcp | udp) ;;
+	*) die "protocol must be tcp or udp" ;;
+	esac
+	case "$_dir" in
+	send | receive) ;;
+	*) die "direction must be send or receive" ;;
+	esac
+	case "$_secs" in
+	'' | *[!0-9]*) die "seconds must be a whole number" ;;
+	esac
+	[ "$_secs" -ge 1 ] && [ "$_secs" -le $MAX_SECONDS ] || die "seconds must be 1-$MAX_SECONDS"
+	case "$_mbps" in
+	'' | *[!0-9]*) die "rate must be a whole number of Mbit/s" ;;
+	esac
+	[ "$_mbps" -le 1000 ] || die "rate must be at most 1000 Mbit/s"
+	[ "$_proto" = tcp ] || [ "$_mbps" -ge 1 ] || die "UDP needs a rate of at least 1 Mbit/s"
+	is_port "$_port" || die "port must be 1-65535"
+	alive "$CLIENT_PID" iperf3 && die "a test is already running"
+
+	_args="-c $_host -p $_port -t $_secs -J --connect-timeout 3000"
+	[ "$_dir" = receive ] && _args="$_args -R"
+	if [ "$_proto" = udp ]; then
+		_args="$_args -u -b ${_mbps}M -l 1400"
+	elif [ "$_mbps" -gt 0 ]; then
+		_args="$_args -b ${_mbps}M"
+	fi
+	rm -f "$RESULT" "$RESULT.tmp"
+	printf '{"target":"%s","proto":"%s","dir":"%s","seconds":%s,"mbps":%s,"port":%s,"started":%s}\n' \
+		"$_host" "$_proto" "$_dir" "$_secs" "$_mbps" "$_port" "$(uptime_s)" >"$TEST"
+	start-stop-daemon -S -b -m -p "$CLIENT_PID" -x /bin/sh -- \
+		-c "$IPERF3 $_args >$RESULT.tmp 2>&1; mv $RESULT.tmp $RESULT"
+	printf '{"state":"running","test":%s}\n' "$(cat "$TEST")"
+}
+
+result() {
+	_state=$(test_state)
+	_test=$(cat "$TEST" 2>/dev/null)
+	printf '{"state":"%s","test":%s,"uptime_s":%s' "$_state" "${_test:-null}" "$(uptime_s)"
+	if [ "$_state" = done ]; then
+		# iperf3 -J reports its own errors as JSON; anything else is wrapped.
+		if [ "$(sed -n '/[^[:space:]]/{s/^[[:space:]]*\(.\).*/\1/p;q}' "$RESULT")" = "{" ]; then
+			printf ',"result":'
+			cat "$RESULT"
+		else
+			printf ',"result":{"error":"%s"}' \
+				"$(tr '\n\t' '  ' <"$RESULT" | sed 's/\\/\\\\/g; s/"/\\"/g' | cut -c1-500)"
+		fi
+	fi
+	printf '}\n'
+}
+
+case "$1" in
+status) status ;;
+server)
+	case "$2" in
+	start) server_start "$3" "$4" ;;
+	stop)
+		server_stop
+		server_json
+		echo
+		;;
+	*) die "usage: nettest server start [MIN] [PORT] | stop" ;;
+	esac
+	;;
+run)
+	shift
+	run "$@"
+	;;
+result) result ;;
+*) die "usage: nettest status | server start [MIN] [PORT] | server stop | run HOST tcp|udp send|receive SECONDS [MBPS] [PORT] | result" ;;
+esac
