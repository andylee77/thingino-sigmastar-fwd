diff --git a/package/thingino-nettest/files/www/x/json-nettest.cgi b/package/thingino-nettest/files/www/x/json-nettest.cgi
new file mode 100755
index 000000000..ea74b5cba
--- /dev/null
+++ b/package/thingino-nettest/files/www/x/json-nettest.cgi
@@ -0,0 +1,114 @@
+#!/bin/sh
+# shellcheck disable=SC1091,SC3043
+# json-nettest.cgi -- the Tools > Bandwidth test page's calls, passed to
+# nettest, which answers in JSON:
+#
+#   GET  a=status | a=result
+#   POST a=server&on=1[&minutes=N][&port=P]   iperf3 server on (N=0: until stopped)
+#        a=server&on=0
+#        a=boot&on=1|0[&port=P]   start the server at boot, and now; or not
+#        a=run&target=HOST&proto=tcp|udp&dir=send|receive&seconds=N[&mbps=N][&port=P]
+#
+# Errors answer {"error":{"code":...,"message":...}} like tool-ping-trace.cgi.
+
+. /var/www/x/auth.sh
+require_auth
+
+CONFIG=/etc/thingino.json
+NETTEST=/usr/sbin/nettest
+# nettest's: a server with no auto-off deadline was started to stay up
+DEADLINE=/run/nettest/server.deadline
+
+send() {
+	printf 'Status: %s\r\n' "$1"
+	printf 'Content-Type: application/json\r\n'
+	printf 'Cache-Control: no-store\r\n'
+	printf 'Connection: close\r\n'
+	printf '\r\n'
+	printf '%s\n' "$2"
+	exit 0
+}
+
+json_escape() {
+	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
+}
+
+fail() {
+	send "${2:-422 Unprocessable Entity}" \
+		"{\"error\":{\"code\":${3:-422},\"message\":\"$(json_escape "$1")\"}}"
+}
+
+# nettest's JSON on success, its message as the error otherwise.
+nettest() {
+	_err=/tmp/json-nettest.$$
+	if _out=$("$NETTEST" "$@" 2>"$_err"); then
+		rm -f "$_err"
+		send "200 OK" "$_out"
+	fi
+	_msg=$(cat "$_err" 2>/dev/null)
+	rm -f "$_err"
+	fail "${_msg:-nettest failed}"
+}
+
+if [ "$REQUEST_METHOD" = "POST" ]; then
+	_len=${CONTENT_LENGTH:-0}
+	case "$_len" in
+	'' | *[!0-9]*) _len=0 ;;
+	esac
+	PARAMS=$(dd bs=1 count="$_len" 2>/dev/null)
+else
+	PARAMS=$QUERY_STRING
+fi
+
+# One parameter, URL-decoded. Nothing from the request is eval'd; nettest
+# validates every value before it reaches a command line.
+param() {
+	_v=$(printf '%s' "$PARAMS" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n 1)
+	printf '%b' "$(printf '%s' "$_v" | sed 's/+/ /g; s/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
+}
+
+action=$(param a)
+case "$REQUEST_METHOD:$action" in
+GET: | GET:status)
+	nettest status
+	;;
+GET:result)
+	nettest result
+	;;
+POST:server)
+	if [ "$(param on)" = 1 ]; then
+		nettest server start "$(param minutes)" "$(param port)"
+	fi
+	nettest server stop
+	;;
+POST:boot)
+	port=$(param port)
+	if [ -n "$port" ]; then
+		case "$port" in
+		*[!0-9]*) fail "port must be 1-65535" ;;
+		esac
+		{ [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } || fail "port must be 1-65535"
+	fi
+	if [ "$(param on)" = 1 ]; then
+		jct "$CONFIG" set nettest.server_boot true >/dev/null 2>&1 || fail "could not save the setting"
+		[ -z "$port" ] || jct "$CONFIG" set nettest.server_port "$port" >/dev/null 2>&1
+		nettest server start 0 "$port"
+	fi
+	jct "$CONFIG" set nettest.server_boot false >/dev/null 2>&1 || fail "could not save the setting"
+	# A server this setting kept up (no auto-off) goes with it.
+	if [ ! -s "$DEADLINE" ]; then
+		nettest server stop
+	fi
+	nettest status
+	;;
+POST:run)
+	nettest run "$(param target)" "$(param proto)" "$(param dir)" \
+		"$(param seconds)" "$(param mbps)" "$(param port)"
+	;;
+GET:server | GET:boot | GET:run)
+	fail "$action needs POST" "405 Method Not Allowed" 405
+	;;
+*)
+	fail "unknown action" "400 Bad Request" 400
+	;;
+esac
diff --git a/package/thingino-nettest/thingino-nettest.mk b/package/thingino-nettest/thingino-nettest.mk
new file mode 100644
index 000000000..11958c05f
--- /dev/null
+++ b/package/thingino-nettest/thingino-nettest.mk
@@ -0,0 +1,42 @@
+################################################################################
+#
+# thingino-nettest
+#
+################################################################################
+
+THINGINO_NETTEST_VERSION = 1.0
+THINGINO_NETTEST_SITE_METHOD = local
+THINGINO_NETTEST_SITE = $(THINGINO_NETTEST_PKGDIR)/files
+
+THINGINO_NETTEST_DEPENDENCIES = iperf3
+
+ifeq ($(BR2_PACKAGE_THINGINO_WEBUI),y)
+# The Tools > Bandwidth test page: installed after thingino-webui so that its
+# plugin assembly (a target-finalize hook) finds nettest.webui.json.
+THINGINO_NETTEST_DEPENDENCIES += thingino-webui
+
+define THINGINO_NETTEST_INSTALL_WWW_CMDS
+	$(INSTALL) -D -m 0644 $(@D)/www/tool-nettest.html \
+		$(TARGET_DIR)/var/www/tool-nettest.html
+	$(INSTALL) -D -m 0644 $(@D)/www/a/tool-nettest.js \
+		$(TARGET_DIR)/var/www/a/tool-nettest.js
+	$(INSTALL) -D -m 0755 $(@D)/www/x/json-nettest.cgi \
+		$(TARGET_DIR)/var/www/x/json-nettest.cgi
+	$(INSTALL) -D -m 0644 $(@D)/nettest.webui.json \
+		$(TARGET_DIR)/var/www/a/plugins/nettest.webui.json
+endef
+endif
+
+define THINGINO_NETTEST_BUILD_CMDS
+	$(TARGET_CC) $(TARGET_CFLAGS) $(TARGET_LDFLAGS) -Os -s -Wall -Wextra \
+		-o $(@D)/miiread $(@D)/miiread.c
+endef
+
+define THINGINO_NETTEST_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/miiread $(TARGET_DIR)/usr/sbin/miiread
+	$(INSTALL) -D -m 0755 $(@D)/nettest $(TARGET_DIR)/usr/sbin/nettest
+	$(INSTALL) -D -m 0755 $(@D)/S92nettest $(TARGET_DIR)/etc/init.d/S92nettest
+	$(THINGINO_NETTEST_INSTALL_WWW_CMDS)
+endef
+
+$(eval $(generic-package))
