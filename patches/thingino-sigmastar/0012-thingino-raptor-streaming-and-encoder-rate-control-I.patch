+    fps: byId("ss-fps"),
+    fpsNote: byId("ss-fps-note"),
+    codec: byId("ss-codec"),
+    profile: byId("ss-profile"),
+    rc: byId("ss-rc"),
+    bitrate: byId("ss-bitrate"),
+    maxbr: byId("ss-maxbitrate"),
+    maxbrWrap: byId("ss-maxbitrate-wrap"),
+    gop: byId("ss-gop"),
+    jpeg: byId("ss-jpeg"),
+    jq: byId("ss-jpeg-quality"),
+    enabled: byId("ss-enabled"),
+    apply: byId("ss-apply"),
+    revert: byId("ss-revert"),
