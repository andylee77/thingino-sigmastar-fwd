diff --git a/package/thingino-raptor/files/agent-adapter b/package/thingino-raptor/files/agent-adapter
index 243df735f..5012652e3 100644
--- a/package/thingino-raptor/files/agent-adapter
+++ b/package/thingino-raptor/files/agent-adapter
@@ -4,6 +4,12 @@
 AGENT_CONFIG="${AGENT_CONFIG:-/etc/raptor.conf}"
 THINGINO_AGENT_SEND2_CONFIG="${THINGINO_AGENT_SEND2_CONFIG:-/etc/send2.json}"
 AGENT_PRIVACY_STATE="${AGENT_PRIVACY_STATE:-/run/agent/raptor-privacy}"
+# Stream choices the WebUI offers: the camera profile's, built into the image,
+# then any key overridden on the camera. See agent_stream_options_load.
+AGENT_STREAM_OPTIONS="${AGENT_STREAM_OPTIONS:-/usr/share/raptor/streams.conf}"
+AGENT_STREAM_OPTIONS_LOCAL="${AGENT_STREAM_OPTIONS_LOCAL:-/etc/raptor-streams.conf}"
+AGENT_STREAM_LOCK="${AGENT_STREAM_LOCK:-/run/agent/stream-apply.lock}"
+AGENT_STREAM_BACKUP="${AGENT_STREAM_BACKUP:-/run/agent/raptor.conf.before-apply}"
 
 # The adapter owns the EXIT trap of the agentctl shell that sources it.
 trap 'rm -f /tmp/agent-raptor-isp.$$ /tmp/agent-raptor-wb.$$' EXIT
@@ -143,7 +149,19 @@ agent_ctl() {
 		echo "raptorctl is not available" >&2
 		return 1
 	}
-	raptorctl "$@"
+	# raptorctl exits 0 whenever the daemon answers, even when the answer is
+	# {"status":"error","reason":...} (not supported on this SoC, a bad value),
+	# so read the reply: the callers' "|| return 1" must see the failure, and
+	# the setting must not be saved as if it had been applied.
+	_ctl_out=$(raptorctl "$@") || return 1
+	case "$_ctl_out" in
+	*'"status":"error"'* | *'"status": "error"'*)
+		_ctl_reason=$(printf '%s' "$_ctl_out" | sed -n 's/.*"reason": *"\([^"]*\)".*/\1/p')
+		echo "$1 $2: ${_ctl_reason:-error}" >&2
+		return 1
+		;;
+	esac
+	[ -z "$_ctl_out" ] || printf '%s\n' "$_ctl_out"
 }
 
 agent_daemon_status() {
@@ -420,6 +438,57 @@ agent_image_bool() {
 	agent_bool01_to_json "$(agent_image_raw "$1")" false
 }
 
+# Which ISP controls the HAL publishes (rvd get-isp-caps), cached per rvd
+# process, since a restart can bring up another HAL. Empty when rvd is down or
+# too old to answer; every control then counts as present, as before.
+agent_isp_caps_json() {
+	_rvd=$(pidof rvd 2>/dev/null | awk '{ print $1 }')
+	[ -n "$_rvd" ] || return 0
+	_caps="/tmp/agent-isp-caps.$_rvd"
+	if [ ! -s "$_caps" ]; then
+		command -v raptorctl >/dev/null 2>&1 || return 0
+		_caps_out=$(raptorctl rvd get-isp-caps 2>/dev/null | tr -d ' \t\r\n') || return 0
+		case "$_caps_out" in
+			*'"status":"ok"'*) ;;
+			*) return 0 ;;
+		esac
+		rm -f /tmp/agent-isp-caps.*
+		printf '%s\n' "$_caps_out" >"$_caps"
+	fi
+	cat "$_caps" 2>/dev/null
+}
+
+# agent_isp_has <control>: false only when rvd says the HAL lacks it.
+agent_isp_has() {
+	case "$(agent_isp_caps_json)" in
+		*"\"$1\":false"*) return 1 ;;
+	esac
+	return 0
+}
+
+# An image knob for the config block: its value, or null when the HAL lacks it
+# (the web UI hides those rather than offering a control that does nothing).
+agent_image_knob() {
+	if agent_isp_has "$1"; then
+		agent_json_value_or "$(agent_image_raw "$2")" null
+	else
+		printf 'null'
+	fi
+}
+
+agent_print_image_capabilities() {
+	printf '{'
+	_sep=
+	for _pair in brightness:brightness contrast:contrast saturation:saturation \
+		sharpness:sharpness noise_reduction:sinter temporal_noise_reduction:temper drc_strength:drc defog_strength:defog \
+		ae_compensation:ae_comp anti_flicker:antiflicker hflip:hflip vflip:vflip wb:wb; do
+		if agent_isp_has "${_pair#*:}"; then _has=true; else _has=false; fi
+		printf '%s"%s":%s' "$_sep" "${_pair%%:*}" "$_has"
+		_sep=,
+	done
+	printf '}'
+}
+
 # Map UI / prudynt-style WB mode integers onto raptor set-wb names (and back).
 agent_wb_mode_to_int() {
 	mode=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr '-' '_')
@@ -775,6 +844,521 @@ agent_stream_mode() {
 	esac
 }
 
+# ---- Stream settings: choices, video memory, apply -------------------------
+#
+# The Streamer pages change a stream as one request, and every change is
+# applied the same way: the keys are written to /etc/raptor.conf and the stack
+# restarts (about 6 s; RTSP clients reconnect). rvd's in-place paths --
+# set-resolution, set-codec, set-bitrate and the rest -- rebuild one encoder
+# channel inside the running pipeline. On Infinity6C the sub is a VENC cascade
+# off the main and the JPEG channel holds an SCL port of its own, and rebuilding
+# one of them in place disturbs the others: a live bitrate change on the main
+# alone was measured dropping the sub from 25 to 17 fps. A clean start is the
+# path every boot takes.
+#
+# The values the pages offer come from the camera profile, built into
+# AGENT_STREAM_OPTIONS; any key can be overridden on the camera in
+# AGENT_STREAM_OPTIONS_LOCAL. An empty list offers no choice: the page shows the
+# current value only.
+
+agent_stream_options_load() {
+	UI_STREAM0_RESOLUTIONS=
+	UI_STREAM1_RESOLUTIONS=
+	UI_FPS=
+	UI_STREAM0_BITRATES=
+	UI_STREAM1_BITRATES=
+	UI_CODECS=
+	UI_PROFILES=
+	UI_RC_MODES=
+	UI_GOP_SECONDS=
+	UI_JPEG_QUALITIES=
+	UI_MMA_RESERVE_KIB=
+	UI_MMA_MAIN_MBPP=
+	UI_MMA_SUB_MBPP=
+	UI_MMA_JPEG_MBPP=
+	# shellcheck disable=SC1090
+	[ -r "$AGENT_STREAM_OPTIONS" ] && . "$AGENT_STREAM_OPTIONS"
+	# shellcheck disable=SC1090
+	[ -r "$AGENT_STREAM_OPTIONS_LOCAL" ] && . "$AGENT_STREAM_OPTIONS_LOCAL"
+	# Video memory a stream costs, in thousandths of a byte per pixel, measured
+	# from the MI heap table (/proc/mi_modules/mi_sys_mma/mma_heap_name0) on the
+	# YMF46D and the JL12D2: the main's encoder buffers plus the SCL->VENC rings
+	# (~5.0), a cascade sub's encoder buffers (3.2-4.1), and a JPEG channel's
+	# three NV12 frames on its own SCL port plus its bitstream (6.5).
+	: "${UI_MMA_RESERVE_KIB:=4096}"
+	: "${UI_MMA_MAIN_MBPP:=5200}"
+	: "${UI_MMA_SUB_MBPP:=4100}"
+	: "${UI_MMA_JPEG_MBPP:=6600}"
+}
+
+agent_list_json() {
+	# A space-separated list as a JSON array; with "num", numbers only.
+	_lj=
+	for _li in $1; do
+		if [ "$2" = num ]; then
+			case "$_li" in '' | *[!0-9]*) continue ;; esac
+			_lj="$_lj${_lj:+,}$_li"
+		else
+			_lj="$_lj${_lj:+,}$(agent_json_string "$_li")"
+		fi
+	done
+	printf '[%s]' "$_lj"
+}
+
+agent_list_has() {
+	for _li in $1; do
+		[ "$_li" = "$2" ] && return 0
+	done
+	return 1
+}
+
+agent_bool_word() {
+	case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
+		1 | true | yes | on) printf 'true' ;;
+		0 | false | no | off) printf 'false' ;;
+		*) printf '%s' "$2" ;;
+	esac
+}
+
+agent_mma_kib() {
+	# "total_kib free_kib" of the MI heap the video pipeline allocates from.
+	_mma=$(awk '$1 ~ /^mma_heap_name/ { print $3, $4; exit }' \
+		/proc/mi_modules/mi_sys_mma/mma_heap_name0 2>/dev/null)
+	[ -n "$_mma" ] || return 1
+	set -- $_mma
+	printf '%s %s\n' $((0x$1 / 1024)) $((0x$2 / 1024))
+}
+
+agent_stream_mma_kib() {
+	# Video memory one stream holds, in KiB: <id> <width> <height> <jpeg> <enabled>.
+	if [ "$5" = false ]; then
+		printf '0'
+		return 0
+	fi
+	awk -v id="$1" -v w="$2" -v h="$3" -v j="$4" \
+		-v vm="$UI_MMA_MAIN_MBPP" -v vs="$UI_MMA_SUB_MBPP" -v vj="$UI_MMA_JPEG_MBPP" 'BEGIN {
+		px = w * h
+		c = px * (id == 0 ? vm : vs) / 1000
+		if (j == "true") c += px * vj / 1000
+		printf "%d", c / 1024 + 0.5
+	}'
+}
+
+agent_stream_state_load() {
+	# Effective settings of stream $1 (rvd's defaults merged) into _st_*.
+	_st_w=$(agent_stream_field "$1" width)
+	_st_h=$(agent_stream_field "$1" height)
+	_st_fps=$(agent_stream_field "$1" fps)
+	_st_bitrate=$(agent_stream_field "$1" bitrate)
+	_st_maxbr=$(agent_stream_field "$1" max_bitrate)
+	[ -n "$_st_maxbr" ] || _st_maxbr=0
+	_st_gop=$(agent_stream_field "$1" gop)
+	_st_codec=$(agent_stream_field "$1" codec | tr 'A-Z' 'a-z')
+	_st_profile=$(agent_profile_to_name "$(agent_stream_field "$1" profile)")
+	_st_rc=$(agent_stream_field "$1" rc_mode | tr 'A-Z' 'a-z')
+	# rvd pairs a JPEG channel with every stream unless [jpeg] or the stream
+	# says otherwise.
+	if [ "$(agent_config_bool jpeg enabled true)" = true ]; then
+		_st_jpeg=$(agent_bool_word "$(agent_stream_field "$1" jpeg)" true)
+	else
+		_st_jpeg=false
+	fi
+	_st_jq=$(agent_stream_field "$1" jpeg_quality)
+	[ -n "$_st_jq" ] || _st_jq=$(agent_config_get jpeg quality)
+	_st_enabled=$(agent_stream_enabled "$1")
+}
