diff --git a/package/thingino-raptor/0109-rvd-size-JPEG-rings-for-the-largest-JPEG-not-the-ave.patch b/package/thingino-raptor/0109-rvd-size-JPEG-rings-for-the-largest-JPEG-not-the-ave.patch
new file mode 100755
index 000000000..57970462f
--- /dev/null
+++ b/package/thingino-raptor/0109-rvd-size-JPEG-rings-for-the-largest-JPEG-not-the-ave.patch
@@ -0,0 +1,42 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Andy <andylee77@users.noreply.github.com>
+Date: Sun, 1 Nov 2026 13:30:00 -0500
+Subject: [PATCH] rvd: size JPEG rings for the largest JPEG, not the average
+
+A JPEG ring sized its data region at w*h/16 bytes a slot for quality 70-89,
+half a bit a pixel, with a 16 KB floor. rss_ring refuses any frame larger
+than the whole region with ENOSPC, so on a detailed outdoor scene the 640x360
+sub's JPEGs (over 64 KB at quality 75, about 2.2 bits a pixel) were dropped
+one after another: "stream2: publish_iov failed (-28)" every few seconds and
+a stalling MJPEG preview on a YMF46D. Size for 2.7 bits a pixel at 70-89
+(4 at 90+), with a 32 KB floor; the 4 MB cap stays.
+---
+ rvd/rvd_pipeline.c | 12 +++++++++---
+ 1 file changed, 9 insertions(+), 3 deletions(-)
+
+--- a/rvd/rvd_pipeline.c
++++ b/rvd/rvd_pipeline.c
+@@ -1622,11 +1622,17 @@
+ 			uint32_t h = s->enc_cfg.height;
+ 			uint32_t q = (uint32_t)s->enc_cfg.init_qp;
+ 			uint32_t fps = s->enc_cfg.fps_num;
+-			uint32_t divisor = (q >= 90) ? 6 : (q >= 70) ? 16 : 24;
++			/* Bytes per pixel a JPEG can reach at this quality. A frame
++			 * larger than the whole data region is refused (ENOSPC), so
++			 * the region must hold the worst case, not the average: a
++			 * detailed outdoor scene at quality 75 measured over 64 KB at
++			 * 640x360 -- 2.2 bits a pixel -- against the 0.5 the old
++			 * w*h/16 allowed, and every such frame was dropped. */
++			uint32_t divisor = (q >= 90) ? 2 : (q >= 70) ? 3 : 5;
+ 			uint32_t slots = (fps >= 9) ? 16 : (fps >= 3) ? 8 : 4;
+ 			uint32_t jpeg_max = w * h / divisor;
+-			if (jpeg_max < 16384)
+-				jpeg_max = 16384;
++			if (jpeg_max < 32768)
++				jpeg_max = 32768;
+ 			uint32_t data = jpeg_max * slots;
+ 			if (data > 4 * 1024 * 1024)
+ 				data = 4 * 1024 * 1024;
+-- 
+2.43.0
+
diff --git a/package/thingino-raptor/0110-S31raptor-export-etc-default-raptor-to-the-daemons.patch b/package/thingino-raptor/0110-S31raptor-export-etc-default-raptor-to-the-daemons.patch
new file mode 100755
index 000000000..91406df90
--- /dev/null
+++ b/package/thingino-raptor/0110-S31raptor-export-etc-default-raptor-to-the-daemons.patch
@@ -0,0 +1,33 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Andy <andylee77@users.noreply.github.com>
+Date: Sun, 1 Nov 2026 13:30:00 -0500
+Subject: [PATCH] S31raptor: export /etc/default/raptor to the daemons
+
+Some settings the daemons take are environment, not raptor.conf: the
+Infinity6C HAL reads the depth of its SCL->VENC ring from
+RSS_SCL_RING_DIV. Read /etc/default/raptor when it exists, exporting every
+assignment, so a camera profile can set them.
+---
+ config/S31raptor | 8 ++++++++
+ 1 file changed, 8 insertions(+)
+
+--- a/config/S31raptor
++++ b/config/S31raptor
+@@ -12,6 +12,14 @@ if [ -z "$S31RAPTOR_LOCKED" ] && command -v flock >/dev/null 2>&1; then
+ 	S31RAPTOR_LOCKED=1 exec flock "$RUNDIR/.lock" "$0" "$@"
+ fi
+ 
++# Environment the daemons read at start, set per camera (for example
++# RSS_SCL_RING_DIV for the Infinity6C HAL). Every assignment is exported.
++if [ -r /etc/default/raptor ]; then
++	set -a
++	. /etc/default/raptor
++	set +a
++fi
++
+ # Executables here run with "stop" before any daemon goes down and with
+ # "start" once the stack is up. They are for processes outside the stack that
+ # call into the video pipeline: those must be off it while rvd tears it down
+-- 
+2.43.0
+
diff --git a/package/thingino-raptor/0111-rvd-get-isp-caps-reports-which-ISP-controls-the-HAL-.patch b/package/thingino-raptor/0111-rvd-get-isp-caps-reports-which-ISP-controls-the-HAL-.patch
new file mode 100644
index 000000000..c9825dd70
--- /dev/null
+++ b/package/thingino-raptor/0111-rvd-get-isp-caps-reports-which-ISP-controls-the-HAL-.patch
@@ -0,0 +1,91 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Andy <andylee77@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 18:45:01 -0500
+Subject: [PATCH] rvd: get-isp-caps reports which ISP controls the HAL has
+
+A backend that does not publish an ISP op answers "not supported" to its
+set- command, and nothing else tells a client which ones those are: get-isp
+reports 0 for a missing getter, which is also a real value. The web UI
+therefore offered knobs that did nothing (sharpness and white balance on the
+Infinity6C) and hid ones that worked.
+
+get-isp-caps answers one boolean per set- op, true when the HAL publishes it,
+plus "ivs" for the motion path. It reads the ops table only, so it is safe at
+any time, before the first frame included.
+---
+ raptorctl/raptorctl_dispatch.c |  1 +
+ raptorctl/raptorctl_help.c     |  1 +
+ rvd/rvd_ctrl.c                 | 33 +++++++++++++++++++++++++++++++++
+ 3 files changed, 35 insertions(+)
+
+diff --git a/raptorctl/raptorctl_dispatch.c b/raptorctl/raptorctl_dispatch.c
+index a98f8de..a6c744c 100644
+--- a/raptorctl/raptorctl_dispatch.c
++++ b/raptorctl/raptorctl_dispatch.c
+@@ -145,6 +145,7 @@ static const struct cmd_def cmd_table[] = {
+ 	{"share", NULL, 0, args_none},
+ 	{"share-rotate", NULL, 0, args_none},
+ 	{"get-enc-caps", NULL, 0, args_none},
++	{"get-isp-caps", NULL, 0, args_none},
+ 
+ 	/* Optional channel */
+ 	{"request-idr", NULL, 0, args_ch},
+diff --git a/raptorctl/raptorctl_help.c b/raptorctl/raptorctl_help.c
+index 5f50863..4afc542 100644
+--- a/raptorctl/raptorctl_help.c
++++ b/raptorctl/raptorctl_help.c
+@@ -46,6 +46,7 @@ const struct help_entry help_entries[] = {
+ 	{"rvd", "enc-get <ch> <param>                Get encoder parameter"},
+ 	{"rvd", "enc-list [ch]                       List encoder parameters"},
+ 	{"rvd", "get-enc-caps                        Show encoder capabilities"},
++	{"rvd", "get-isp-caps                        Show which ISP controls the HAL has"},
+ 	{"rvd", "get-h264-trans <ch>                 Show H.264 chroma QP offset"},
+ 	{"rvd", "get-h265-trans <ch>                 Show H.265 chroma QP offsets"},
+ 	{"rvd", "get-roi <ch> <idx>                  Show ROI region"},
+diff --git a/rvd/rvd_ctrl.c b/rvd/rvd_ctrl.c
+index 2683ded..12b72ea 100644
+--- a/rvd/rvd_ctrl.c
++++ b/rvd/rvd_ctrl.c
+@@ -1123,6 +1123,39 @@ static int handle_isp_cmd(const char *cmd, const char *cmd_json, rvd_state_t *st
+ 	int sensor_idx = -1;
+ 	rss_json_get_int(cmd_json, "sensor", &sensor_idx);
+ 
++	/*
++	 * Which ISP controls the HAL publishes. A NULL op answers "not supported"
++	 * to its set- command, so a client (the web UI) can hide the controls a
++	 * backend does not have instead of offering knobs that do nothing. Setters
++	 * only: a control is offered when it can be set. "ivs" is the motion path.
++	 */
++	if (strcmp(cmd, "get-isp-caps") == 0) {
++		const rss_hal_ops_t *o = st->ops;
++		cJSON *r = cJSON_CreateObject();
++		cJSON_AddStringToObject(r, "status", "ok");
++		cJSON_AddBoolToObject(r, "brightness", o->isp_set_brightness != NULL);
++		cJSON_AddBoolToObject(r, "contrast", o->isp_set_contrast != NULL);
++		cJSON_AddBoolToObject(r, "saturation", o->isp_set_saturation != NULL);
++		cJSON_AddBoolToObject(r, "sharpness", o->isp_set_sharpness != NULL);
++		cJSON_AddBoolToObject(r, "hue", o->isp_set_hue != NULL);
++		cJSON_AddBoolToObject(r, "sinter", o->isp_set_sinter_strength != NULL);
++		cJSON_AddBoolToObject(r, "temper", o->isp_set_temper_strength != NULL);
++		cJSON_AddBoolToObject(r, "dpc", o->isp_set_dpc_strength != NULL);
++		cJSON_AddBoolToObject(r, "drc", o->isp_set_drc_strength != NULL);
++		cJSON_AddBoolToObject(r, "highlight_depress", o->isp_set_highlight_depress != NULL);
++		cJSON_AddBoolToObject(r, "backlight_comp", o->isp_set_backlight_comp != NULL);
++		cJSON_AddBoolToObject(r, "defog", o->isp_set_defog_strength != NULL);
++		cJSON_AddBoolToObject(r, "ae_comp", o->isp_set_ae_comp != NULL);
++		cJSON_AddBoolToObject(r, "max_again", o->isp_set_max_again != NULL);
++		cJSON_AddBoolToObject(r, "max_dgain", o->isp_set_max_dgain != NULL);
++		cJSON_AddBoolToObject(r, "hflip", o->isp_set_hflip != NULL);
++		cJSON_AddBoolToObject(r, "vflip", o->isp_set_vflip != NULL);
++		cJSON_AddBoolToObject(r, "antiflicker", o->isp_set_antiflicker != NULL);
++		cJSON_AddBoolToObject(r, "wb", o->isp_set_wb != NULL);
++		cJSON_AddBoolToObject(r, "ivs", o->ivs_create_group != NULL);
++		return rss_ctrl_resp_json(resp, resp_size, r);
++	}
++
+ /* ISP_SET_N: supports --sensor N via _n variant */
+ #define ISP_SET_N(name, fn)                                                                        \
+ 	if (strcmp(cmd, name) == 0) {                                                              \
+-- 
+2.43.0
+
