+      text: `${s} s (${s * fps} frames)`,
+    }));
+    let value = `f:${selectedFrames}`;
+    const secs = selectedFrames / fps;
+    if (Number.isInteger(secs) && choices.some((c) => c.value === `s:${secs}`)) value = `s:${secs}`;
+    fill(ui.gop, choices, value, (v) => {
+      const frames = Number(String(v).slice(2));
+      return `${frames} frames`;
+    });
+  }
+
+  function renderProfile(selected) {
+    if (ui.codec.value === "h265") {
+      // H.265 has the one profile here; the setting is H.264's.
+      fill(ui.profile, [{ value: "main", text: "Main (H.265)" }], "main", () => "Main");
+      ui.profile.disabled = true;
+      return;
+    }
+    const choices = (data.options.profiles || []).map((p) => ({ value: p, text: LABELS.profile[p] || p }));
+    fill(ui.profile, choices, selected, (v) => LABELS.profile[v] || v);
+  }
+
+  function render() {
+    const opts = data.options;
+    renderResolution(`${current.width}x${current.height}`);
+    renderFps(current.fps);
+    fill(
+      ui.codec,
+      (opts.codecs || []).map((c) => ({ value: c, text: LABELS.codec[c] || c })),
+      current.codec,
+      (v) => LABELS.codec[v] || v,
+    );
+    renderProfile(current.profile);
+    fill(
+      ui.rc,
+      (opts.rc_modes || []).map((m) => ({ value: m, text: LABELS.rc[m] || m })),
+      current.rc_mode,
+      (v) => LABELS.rc[v] || v,
+    );
+    fill(
+      ui.bitrate,
+      (streamOptions().bitrates_kbps || []).map((k) => ({ value: k * 1000, text: bitrateLabel(k * 1000) })),
+      current.bitrate,
+      bitrateLabel,
+    );
+    renderMaxBitrate(currentMaxBitrate());
+    renderGop(current.gop || current.fps);
+    ui.jpeg.checked = !!current.jpeg;
+    ui.jpeg.disabled = busy;
+    if (ui.enabled) ui.enabled.disabled = busy;
+    fill(
+      ui.jq,
+      (opts.jpeg_qualities || []).map((q) => ({ value: q, text: `${q}` })),
+      current.jpeg_quality,
+      (v) => `${v}`,
+    );
+    if (ui.enabled) ui.enabled.checked = current.enabled !== false;
+    ui.url.textContent = current.rtsp_url || "";
+    refresh();
+  }
+
+  // ---- form state ----------------------------------------------------------
+
+  function formValues() {
+    const [width, height] = ui.resolution.value.split("x").map(Number);
+    const fps = Number(ui.fps.value);
+    const gopSel = ui.gop.value;
+    const gop = gopSel.startsWith("f:") ? Number(gopSel.slice(2)) : Number(gopSel.slice(2)) * fps;
+    const values = {
+      width,
+      height,
+      fps,
+      codec: ui.codec.value,
+      rc_mode: ui.rc.value,
+      bitrate: Number(ui.bitrate.value),
+      gop,
+      jpeg: ui.jpeg.checked,
+      jpeg_quality: Number(ui.jq.value),
+    };
+    if (ui.codec.value === "h264") values.profile = ui.profile.value;
+    if (values.rc_mode !== "cbr") values.max_bitrate = Number(ui.maxbr.value);
+    if (streamId === 1) values.enabled = ui.enabled.checked;
+    return values;
+  }
+
+  function changes() {
+    const values = formValues();
+    const out = {};
+    for (const key of Object.keys(values)) {
+      const was = key === "max_bitrate" ? currentMaxBitrate() : current[key];
+      if (String(values[key]) !== String(was)) out[key] = values[key];
+    }
+    return out;
+  }
+
+  function refresh() {
+    if (!current) return;
+    const values = formValues();
+    ui.jq.disabled = busy || !values.jpeg || ui.jq.options.length <= 1;
+    ui.fpsNote.textContent = fpsNote(values.fps);
+    const pending = Object.keys(changes()).length > 0;
+
+    // Memory bar: the heap as it is, plus what this change would add.
+    const m = data.mma;
+    let fits = true;
+    if (m.total_kib) {
+      const used = m.total_kib - m.free_kib;
+      const free = freeAfter(values.width, values.height, values.jpeg, values.enabled !== false);
+      const delta = m.free_kib - free;
+      fits = free >= m.reserve_kib;
+      ui.mmaUsed.style.width = `${(Math.min(used, m.total_kib) / m.total_kib) * 100}%`;
+      ui.mmaDelta.style.width = `${(Math.max(delta, 0) / m.total_kib) * 100}%`;
+      ui.mmaDelta.className = `progress-bar ${fits ? "bg-warning" : "bg-danger"}`;
+      let text = `${mib(used)} of ${mib(m.total_kib)} MiB used`;
+      if (pending && delta !== 0) text += ` · after apply ${mib(used + delta)} MiB`;
+      ui.mmaText.textContent = text;
+      ui.mmaNote.textContent = fits
+        ? `${mib(m.reserve_kib)} MiB is kept free. JPEG snapshots on this stream cost about ${mib(
+            costKib(streamId, values.width, values.height, true, true) -
+              costKib(streamId, values.width, values.height, false, true),
+          )} MiB at this size.`
+        : `Does not fit: ${mib(m.reserve_kib - free)} MiB short. Turn JPEG snapshots off or choose a smaller size.`;
+    } else {
+      ui.mmaText.textContent = "not reported by this camera";
+      ui.mmaNote.textContent = "";
+    }
+
+    ui.apply.disabled = busy || !pending || !fits;
+    ui.revert.disabled = busy || !pending;
+  }
+
+  function setBusy(on) {
+    busy = on;
+    for (const control of ui.form.querySelectorAll("select, input")) control.disabled = on;
+    if (!on) render();
+    else refresh();
+  }
+
+  function setStatus(kind, message) {
+    ui.status.className = kind ? `small text-${kind}` : "small";
+    ui.status.textContent = message || "";
+  }
+
+  // ---- preview -------------------------------------------------------------
+
+  let previewRetry = null;
+
+  function reloadPreview() {
+    clearTimeout(previewRetry);
+    const anyJpeg = (data.streams || []).some((s) => s.jpeg && s.enabled !== false);
+    if (!anyJpeg) {
+      ui.preview.src = "/a/nostream.svg";
+      ui.previewNote.textContent = "No preview: JPEG snapshots are off on both streams.";
+      return;
+    }
+    ui.previewNote.textContent = current.jpeg
+      ? "Live preview from this stream's JPEG channel."
+      : "Live preview from the other stream's JPEG channel.";
+    ui.preview.src = `/x/ch${streamId}.mjpg?t=${Date.now()}`;
+  }
+
+  ui.preview.addEventListener("error", () => {
+    if (ui.preview.src.endsWith("nostream.svg")) return;
+    ui.preview.src = "/a/nostream.svg";
+    previewRetry = setTimeout(reloadPreview, 3000);
+  });
+
+  // ---- load / apply ----------------------------------------------------------
+
+  async function load() {
+    data = await request("/api/v1/settings/streams/options");
+    current = (data.streams || []).find((s) => s.id === streamId);
+    if (!current) throw new Error("the camera did not report this stream");
+    render();
+  }
+
+  async function apply() {
+    const body = changes();
+    if (!Object.keys(body).length) return;
+    setBusy(true);
+    setStatus("warning", "Applying: the video restarts, about 6 seconds…");
+    try {
+      const res = await request(`/api/v1/settings/streams/${streamId}`, { method: "PATCH", body });
+      await load();
+      const secs = res.restart_ms ? ` in ${(res.restart_ms / 1000).toFixed(1)} s` : "";
+      const sub = res.sub_fps_followed ? ` The substream moved to ${res.sub_fps_followed} fps.` : "";
+      setStatus("success", `Applied and saved; the video restarted${secs}.${sub}`);
+      reloadPreview();
+    } catch (err) {
+      setStatus("danger", err.message);
+      try {
+        await load();
+      } catch (_err) {
+        /* keep the form as it was */
+      }
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  ui.form.addEventListener("change", (ev) => {
+    if (ev.target === ui.fps) renderGop(formValues().gop);
+    if (ev.target === ui.codec) renderProfile(current.profile);
+    if (ev.target === ui.rc || ev.target === ui.bitrate) {
+      renderMaxBitrate(Math.max(Number(ui.maxbr.value) || 0, currentMaxBitrate()));
+    }
+    if (ev.target === ui.jpeg || ev.target === ui.enabled) renderResolution(ui.resolution.value);
+    setStatus("", "");
+    refresh();
+  });
+  ui.apply.addEventListener("click", apply);
+  ui.revert.addEventListener("click", () => {
+    render();
+    setStatus("", "");
+  });
+
+  if (streamId !== 1) {
+    for (const node of section.querySelectorAll("[data-substream-only]")) node.remove();
+    ui.enabled = null;
+  }
+
+  load()
+    .then(reloadPreview)
+    .catch((err) => setStatus("danger", `Could not read the stream settings: ${err.message}`));
+})();
