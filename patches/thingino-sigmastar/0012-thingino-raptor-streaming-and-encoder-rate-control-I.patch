+# RMD reports what rvd's IVS path detects. A HAL without IVS (the Infinity6C)
+# never has motion, so there is nothing to wait for: ask rvd (it may still be
+# starting) and stop if it says so. An rvd too old to answer get-isp-caps is
+# watched as before.
+no_ivs() {
+	i=0
+	while [ "$i" -lt 30 ]; do
+		caps=$(raptorctl rvd get-isp-caps 2>/dev/null | tr -d ' \t\r\n')
+		case "$caps" in
+			*'"ivs":false'*) return 0 ;;
+			*'"status":"ok"'* | *'unknowncommand'*) return 1 ;;
+		esac
+		sleep 1
+		i=$((i + 1))
+	done
+	return 1
+}
+if no_ivs; then
+	echo "raptor-motion-watch: rvd has no IVS (no on-camera motion); not watching" >&2
+	exit 0
+fi
+
 last=idle
