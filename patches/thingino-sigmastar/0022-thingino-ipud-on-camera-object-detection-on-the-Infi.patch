diff --git a/package/thingino-ipud/files/mi_ipu.h b/package/thingino-ipud/files/mi_ipu.h
new file mode 100644
index 000000000..575db7018
--- /dev/null
+++ b/package/thingino-ipud/files/mi_ipu.h
@@ -0,0 +1,67 @@
+/* mi_ipu.h - reconstructed SigmaStar MI_IPU API for Infinity6C.
+ *
+ * The 11 MI_IPU_* entry points are the exports of libmi_ipu.so. The struct
+ * layout is reconstructed from OpenIPC divinus src/hal/star/i6c_ipu.h (MIT),
+ * which dlopens the same lib and binds the same symbols. Field names follow
+ * divinus; the exact layout is RECONSTRUCTED - verify it against the
+ * GetInOutTensorDesc output on a new drop or SoC.
+ */
+#ifndef MI_IPU_H
+#define MI_IPU_H
+
+typedef int (*MI_IPU_ReadFn)(void *data, int offset, int size, char *ctx);
+
+typedef enum {
+    MI_IPU_FMT_U8 = 0, MI_IPU_FMT_NV12, MI_IPU_FMT_INT8, MI_IPU_FMT_FP32,
+    MI_IPU_FMT_ARGB8888, MI_IPU_FMT_GRAY, MI_IPU_FMT_COMPLEX64
+} MI_IPU_Fmt;                       /* enum order from divinus; values [U] */
+
+typedef struct {
+    unsigned int maxDynBufSize, yuv420Walign, yuv420Halign, rgbWalign, reserved[8];
+} MI_IPU_DevAttr;
+
+typedef struct {
+    unsigned int subnet, usrDepth, bufDepth, maxBatch, reserved[8];
+} MI_IPU_ChnAttr;
+
+typedef struct {
+    unsigned int dimension;
+    unsigned int format;            /* MI_IPU_Fmt */
+    unsigned int shape[10];
+    char         name[256];
+    unsigned int innerMost;
+    float        scalar;            /* quant scale */
+    long long    zeroPnt;           /* quant zero point */
+    int          alignedBufSize;
+    unsigned int bufSize;
+    unsigned int inWalign, inHalign;
+    int          nchwModeOn;
+    unsigned int reserved[4];
+} MI_IPU_TensorDesc;
+
+typedef struct {
+    unsigned int inCnt, outCnt;
+    MI_IPU_TensorDesc inDesc[60], outDesc[60];
+} MI_IPU_TensorDescSet;
+
+typedef struct { void *data[2]; unsigned long long phyAddr[2]; } MI_IPU_Tensor;
+typedef struct { unsigned int count; MI_IPU_Tensor tensor[60]; } MI_IPU_TensorVector;
+
+/* function-pointer types for the exported symbols (resolved via dlsym) */
+typedef int (*fn_MI_IPU_CreateDevice)(MI_IPU_DevAttr *, MI_IPU_ReadFn, char *, unsigned int);
+typedef int (*fn_MI_IPU_DestroyDevice)(void);
+typedef int (*fn_MI_IPU_CreateCHN)(unsigned int *, MI_IPU_ChnAttr *, MI_IPU_ReadFn, char *);
+typedef int (*fn_MI_IPU_DestroyCHN)(unsigned int);
+typedef int (*fn_MI_IPU_GetInOutTensorDesc)(unsigned int, MI_IPU_TensorDescSet *);
+typedef int (*fn_MI_IPU_GetInputTensors)(unsigned int, MI_IPU_TensorVector *);
+typedef int (*fn_MI_IPU_PutInputTensors)(unsigned int, MI_IPU_TensorVector *);
+typedef int (*fn_MI_IPU_GetOutputTensors)(unsigned int, MI_IPU_TensorVector *);
+typedef int (*fn_MI_IPU_PutOutputTensors)(unsigned int, MI_IPU_TensorVector *);
+typedef int (*fn_MI_IPU_Invoke)(unsigned int, MI_IPU_TensorVector *, MI_IPU_TensorVector *);
+
+/* MI_SYS must be initialised before any MI_IPU call (chip id = 0 on i6c);
+ * signature from divinus src/hal/star/i6c_sys.h. */
+typedef int (*fn_MI_SYS_Init)(unsigned short chip);
+typedef int (*fn_MI_SYS_Exit)(unsigned short chip);
+
+#endif /* MI_IPU_H */
diff --git a/package/thingino-ipud/files/mi_scl_sys.h b/package/thingino-ipud/files/mi_scl_sys.h
new file mode 100644
index 000000000..2f9f4ac27
--- /dev/null
+++ b/package/thingino-ipud/files/mi_scl_sys.h
@@ -0,0 +1,47 @@
+/* mi_scl_sys.h - the MI_SCL output-port and MI_SYS frame-fetch ABI on Infinity6C
+ * (drop 1230), as the IPU frame feed uses it.
+ *
+ * Port, bind and enum layouts follow raptor-hal's vendored i6c headers
+ * (sigmastar-headers/infinity6c, from OpenIPC divinus, MIT). The frame-fetch
+ * calls were read off the shipped 1230 libmi_sys.so (2026-11-10, objdump -M
+ * force-thumb), because no header carries them for MI 3:
+ *
+ *   MI_SYS_ChnOutputPortGetBuf(port*, bufinfo*, handle*)   no SoC id; ioctl
+ *       0xc2086913, a 520-byte payload: port 0..15, BufInfo 16..503 (488 B,
+ *       memcpy'd out), handle at 504.
+ *   MI_SYS_ChnOutputPortPutBuf(handle)                     ioctl 0x40046914
+ *   MI_SYS_GetFd(port*, int *fd)                           no SoC id
+ *   MI_SYS_SetChnOutputPortDepth(u16 soc, port*, user, buf)
+ *
+ * MI_SYS_BufInfo_t is kept opaque (488 bytes); the frame fields are read at the
+ * offsets in scl_src.c, which were located on hardware (README.md).
+ */
+#ifndef MI_SCL_SYS_H
+#define MI_SCL_SYS_H
+
+#define MI_MOD_SCL          34      /* i6c_sys_mod: ISP 33, SCL 34 */
+#define MI_PIXFMT_NV12      11      /* I6C_PIXFMT_YUV420SP */
+#define MI_COMPR_NONE       0
+#define MI_BUFINFO_SIZE     488
+
+typedef struct { unsigned int module, device, channel, port; } MI_ChnPort;
+
+typedef struct {
+    unsigned short x, y, width, height;   /* crop; all zero = whole input */
+    unsigned short out_w, out_h;
+    char mirror, flip;
+    unsigned int pixfmt, compress;
+} MI_SclPortAttr;                         /* 24 B, as SetOutputPortParam marshals */
+
+typedef struct { unsigned char raw[MI_BUFINFO_SIZE]; } MI_BufInfo;
+
+typedef int (*fn_MI_SCL_SetOutputPortParam)(unsigned int dev, unsigned int chn, unsigned int port, MI_SclPortAttr *);
+typedef int (*fn_MI_SCL_GetOutputPortParam)(unsigned int dev, unsigned int chn, unsigned int port, MI_SclPortAttr *);
+typedef int (*fn_MI_SCL_PortOp)(unsigned int dev, unsigned int chn, unsigned int port);
+typedef int (*fn_MI_SYS_GetBuf)(MI_ChnPort *, MI_BufInfo *, int *handle);
+typedef int (*fn_MI_SYS_PutBuf)(int handle);
+typedef int (*fn_MI_SYS_GetFd)(MI_ChnPort *, int *fd);
+typedef int (*fn_MI_SYS_CloseFd)(int fd);
+typedef int (*fn_MI_SYS_SetDepth)(unsigned short soc, MI_ChnPort *, unsigned int user, unsigned int buf);
+
+#endif
diff --git a/package/thingino-ipud/files/raptor-hook b/package/thingino-ipud/files/raptor-hook
new file mode 100755
index 000000000..952f7a8d8
--- /dev/null
+++ b/package/thingino-ipud/files/raptor-hook
@@ -0,0 +1,5 @@
+#!/bin/sh
+# Raptor runs this with "stop" before any of its daemons go down and with
+# "start" once they are back. ipud drains an SCL output port on rvd's channel;
+# stopping it first keeps it off the channel while rvd tears it down.
+exec /etc/init.d/S35ipud "$1"
diff --git a/package/thingino-ipud/files/scl_src.c b/package/thingino-ipud/files/scl_src.c
new file mode 100644
index 000000000..000d9afda
--- /dev/null
+++ b/package/thingino-ipud/files/scl_src.c
@@ -0,0 +1,158 @@
+/* scl_src.c - see scl_src.h. */
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <dlfcn.h>
+#include <sys/select.h>
+#include "scl_src.h"
+
+/* MI_SYS_BufInfo_t (488 B) field offsets on drop 1230, read from a GetBuf of an
+ * 800x480 NV12 port on N803 (README.md): bufType 0x10 (1 = frame), then the
+ * frame data: pixfmt 0x24, width/height u16 at 0x38/0x3a, VA[3] at 0x3c,
+ * PA[3] (u64) at 0x48, stride[3] at 0x60, bufSize at 0x6c; pts u64 at 0x00. */
+#define BI_PTS      0x00
+#define BI_TYPE     0x10
+#define BI_PIXFMT   0x24
+#define BI_W        0x38
+#define BI_H        0x3a
+#define BI_VA       0x3c
+#define BI_PA       0x48
+#define BI_STRIDE   0x60
+#define BI_BUFSIZE  0x6c
+
+#define LD(h, var, name) do { \
+    *(void **)&s->var = dlsym(h, name); \
+    if (!s->var) { fprintf(stderr, "scl: dlsym %s: %s\n", name, dlerror()); return -1; } \
+} while (0)
+
+int scl_src_load(scl_src *s)
+{
+    memset(s, 0, sizeof *s);
+    s->fd = -1;
+    s->h_sys = dlopen("libmi_sys.so", RTLD_NOW | RTLD_GLOBAL);
+    s->h_scl = dlopen("libmi_scl.so", RTLD_NOW | RTLD_GLOBAL);
+    if (!s->h_sys || !s->h_scl) { fprintf(stderr, "scl: dlopen: %s\n", dlerror()); return -1; }
+    LD(s->h_scl, SetPort, "MI_SCL_SetOutputPortParam");
+    LD(s->h_scl, GetPort, "MI_SCL_GetOutputPortParam");
+    LD(s->h_scl, Enable, "MI_SCL_EnableOutputPort");
+    LD(s->h_scl, Disable, "MI_SCL_DisableOutputPort");
+    LD(s->h_sys, GetBuf, "MI_SYS_ChnOutputPortGetBuf");
+    LD(s->h_sys, PutBuf, "MI_SYS_ChnOutputPortPutBuf");
+    LD(s->h_sys, GetFd, "MI_SYS_GetFd");
+    LD(s->h_sys, CloseFd, "MI_SYS_CloseFd");
+    LD(s->h_sys, SetDepth, "MI_SYS_SetChnOutputPortDepth");
+    return 0;
+}
+
+/* Free: never configured in this raptor run (0x0), or left configured exactly as
+ * ours by an earlier run of this consumer - a disabled port keeps its param
+ * until raptor destroys the SCL device, and raptor never asks for an
+ * uncompressed NV12 port at the model's size. */
+static int port_free(scl_src *s, int p, unsigned int w, unsigned int h)
+{
+    MI_SclPortAttr pa;
+    memset(&pa, 0, sizeof pa);
+    if (s->GetPort(0, 0, (unsigned)p, &pa)) return -1;      /* no SCL channel: raptor down */
+    if (!pa.out_w && !pa.out_h) return 1;
+    return pa.out_w == w && pa.out_h == h && pa.pixfmt == MI_PIXFMT_NV12 &&
+           pa.compress == MI_COMPR_NONE;
+}
+
+int scl_src_open(scl_src *s, int port, unsigned int w, unsigned int h, unsigned int depth)
+{
+    MI_SclPortAttr pa;
+    int r;
+
+    if (port < 0) {
+        for (int p = 3; p >= 0 && port < 0; p--) {
+            int f = port_free(s, p, w, h);
+            if (f < 0) return -1;
+            if (f) port = p;
+        }
+        if (port < 0) { fprintf(stderr, "scl: no free SCL output port (raptor uses 0-3)\n"); return -1; }
+    } else if (port_free(s, port, w, h) != 1) {
+        fprintf(stderr, "scl: port %d is in use or SCL is down\n", port);
+        return -1;
+    }
+    /* ports 2 and 3 take at most 1920 wide (raptor-hal i6c_fs_port_takes_width) */
+    if (port >= 2 && w > 1920) { fprintf(stderr, "scl: port %d is narrow (<= 1920)\n", port); return -1; }
+
+    memset(&pa, 0, sizeof pa);
+    pa.out_w = (unsigned short)w;
+    pa.out_h = (unsigned short)h;
+    pa.pixfmt = MI_PIXFMT_NV12;
+    pa.compress = MI_COMPR_NONE;
+    if ((r = s->SetPort(0, 0, (unsigned)port, &pa))) { fprintf(stderr, "scl: SetOutputPortParam(%d) = %d\n", port, r); return -1; }
+    if ((r = s->Enable(0, 0, (unsigned)port))) { fprintf(stderr, "scl: EnableOutputPort(%d) = %d\n", port, r); return -1; }
+    s->enabled = 1;
+    s->cp.module = MI_MOD_SCL; s->cp.device = 0; s->cp.channel = 0; s->cp.port = (unsigned)port;
+    s->w = w; s->h = h;
+    if ((r = s->SetDepth(0, &s->cp, depth ? depth : 1, (depth ? depth : 1) + 2)))
+        fprintf(stderr, "scl: SetChnOutputPortDepth = %d\n", r);
+    if ((r = s->GetFd(&s->cp, &s->fd)) || s->fd < 0) {
+        fprintf(stderr, "scl: GetFd = %d\n", r);
+        s->fd = -1;
+        scl_src_close(s);
+        return -1;
+    }
+    return port;
+}
+
+int scl_src_get(scl_src *s, scl_frame *f, int timeout_ms)
+{
+    MI_BufInfo bi;
+    fd_set fds;
+    struct timeval tv = { timeout_ms / 1000, (timeout_ms % 1000) * 1000 };
+    int r;
+
+    if (s->fd < 0) return -1;
+    FD_ZERO(&fds);
+    FD_SET(s->fd, &fds);
+    r = select(s->fd + 1, &fds, NULL, NULL, &tv);
+    if (r == 0) return 1;
+    if (r < 0) return errno == EINTR ? 1 : -1;     /* a signal (SIGTERM) is not a dead port */
+
+    memset(&bi, 0, sizeof bi);
+    if ((r = s->GetBuf(&s->cp, &bi, &f->handle))) return r == -1 ? -1 : 1;
+
+    unsigned int type, va[2], st[2];
+    unsigned short w, h;
+    memcpy(&type, bi.raw + BI_TYPE, 4);
+    memcpy(&f->pixfmt, bi.raw + BI_PIXFMT, 4);
+    memcpy(&w, bi.raw + BI_W, 2);
+    memcpy(&h, bi.raw + BI_H, 2);
+    memcpy(va, bi.raw + BI_VA, 8);
+    memcpy(&f->phy_y, bi.raw + BI_PA, 8);
+    memcpy(&f->phy_uv, bi.raw + BI_PA + 8, 8);
+    memcpy(st, bi.raw + BI_STRIDE, 8);
+    memcpy(&f->bufsize, bi.raw + BI_BUFSIZE, 4);
+    memcpy(&f->pts, bi.raw + BI_PTS, 8);
+    f->w = w; f->h = h;
+    f->y = (unsigned char *)(unsigned long)va[0];
+    f->uv = (unsigned char *)(unsigned long)va[1];
+    f->stride_y = st[0]; f->stride_uv = st[1];
+
+    if (type != 1 || f->pixfmt != MI_PIXFMT_NV12 || w != s->w || h != s->h || !f->y || !f->uv) {
+        fprintf(stderr, "scl: unexpected buffer: type %u fmt %u %ux%u va %p/%p\n",
+                type, f->pixfmt, w, h, (void *)f->y, (void *)f->uv);
+        s->PutBuf(f->handle);
+        return 1;
+    }
+    return 0;
+}
+
+void scl_src_put(scl_src *s, scl_frame *f)
+{
+    s->PutBuf(f->handle);
+}
+
+void scl_src_close(scl_src *s)
+{
+    if (s->fd >= 0) { s->CloseFd(s->fd); s->fd = -1; }
+    if (s->enabled) {
+        /* depth back to 0 before the port goes, as the vendor recommends */
+        s->SetDepth(0, &s->cp, 0, 3);
+        s->Disable(0, 0, s->cp.port);
+        s->enabled = 0;
+    }
+}
diff --git a/package/thingino-ipud/files/scl_src.h b/package/thingino-ipud/files/scl_src.h
new file mode 100644
index 000000000..4074a03b2
--- /dev/null
+++ b/package/thingino-ipud/files/scl_src.h
@@ -0,0 +1,46 @@
+/* scl_src.h - frames for the IPU from a spare SCL output port (option A).
+ *
+ * raptor owns SCL dev 0 / chn 0 and configures ports 0-3 as its streams need;
+ * a second process may configure, enable and drain an unused one (bench-proven
+ * on N803 2026-11-10: README.md). MI_SYS_Init must already have been called
+ * (ipu_rt_open does it).
+ */
+#ifndef SCL_SRC_H
+#define SCL_SRC_H
+
+#include "mi_scl_sys.h"
+
+typedef struct {
+    void *h_sys, *h_scl;
+    fn_MI_SCL_SetOutputPortParam SetPort;
+    fn_MI_SCL_GetOutputPortParam GetPort;
+    fn_MI_SCL_PortOp Enable, Disable;
+    fn_MI_SYS_GetBuf GetBuf;
+    fn_MI_SYS_PutBuf PutBuf;
+    fn_MI_SYS_GetFd GetFd;
+    fn_MI_SYS_CloseFd CloseFd;
+    fn_MI_SYS_SetDepth SetDepth;
+    MI_ChnPort cp;
+    unsigned int w, h;
+    int fd, enabled;
+} scl_src;
+
+typedef struct {
+    int handle;
+    unsigned char *y, *uv;              /* mapped in this process by GetBuf */
+    unsigned long long phy_y, phy_uv;
+    unsigned int stride_y, stride_uv, w, h, pixfmt, bufsize;
+    unsigned long long pts;             /* MI's frame pts */
+} scl_frame;
+
+/* Resolve the MI_SCL / MI_SYS frame symbols (libs already in global scope). */
+int  scl_src_load(scl_src *s);
+/* port < 0: the highest of 0..3 that raptor has not configured. Returns the
+ * port used, or -1 (none free, or MI refused). */
+int  scl_src_open(scl_src *s, int port, unsigned int w, unsigned int h, unsigned int depth);
+/* 0 = frame, 1 = timeout, -1 = error (the port went away: raptor restarted?) */
+int  scl_src_get(scl_src *s, scl_frame *f, int timeout_ms);
+void scl_src_put(scl_src *s, scl_frame *f);
+void scl_src_close(scl_src *s);
+
+#endif
diff --git a/package/thingino-ipud/files/www/a/config-ipud.js b/package/thingino-ipud/files/www/a/config-ipud.js
new file mode 100644
index 000000000..eae7c3b21
--- /dev/null
+++ b/package/thingino-ipud/files/www/a/config-ipud.js
@@ -0,0 +1,167 @@
+/**
+ * Settings and status page for thingino-ipud (IPU object detection).
+ * Reads and writes the "ipud" block of /etc/thingino.json through
+ * /x/json-ipud.cgi, which restarts ipud after a save.
+ *
+ * The model comes from one of three sources (ipud.source): built into the
+ * firmware (/usr/share/ipud), a folder on the SD card (a model picked from the
+ * .img files there), or custom paths. The CGI reports what each source has
+ * (available) and what the saved settings resolve to (resolved); enabling is
+ * locked while the chosen source has no model.
+ */
+(function () {
+  "use strict";
+
+  const ENDPOINT = "/x/json-ipud.cgi";
+  const BOOLS = ["enabled", "mqtt", "onvif", "ha", "frigate"];
+  const NUMBERS = ["score", "iou", "max_fps", "hold_ms", "mqtt_interval_ms"];
+  const TEXTS = ["firmware", "model", "labels", "report", "mqtt_topic", "sd_dir",
+    "frigate_url", "frigate_camera"];
+  const el = (k) => document.getElementById("ipud_" + k);
+  let last = null;
+  let statusTimer = null;
+
+  function alert(variant, message, timeout = 5000) {
+    if (window.showAlert) window.showAlert(variant, message, timeout);
+  }
+
+  function setText(id, text) {
+    const n = document.getElementById(id);
+    if (n) n.textContent = text;
+  }
+
+  function showStatus(s) {
+    if (!s || !s.running) {
+      setText("ipud-state", s && s.reason ? `not running (${s.reason})` : "not running");
+      ["ipud-rate", "ipud-source", "ipud-mqtt", "ipud-objects"].forEach((id) => setText(id, "-"));
+      return;
+    }
+    setText("ipud-state", `running, ${s.inferences} inferences`);
+    setText("ipud-rate", `${s.fps} per second, ${s.invoke_ms} ms on the IPU, ${s.decode_ms} ms decode`);
+    setText("ipud-source", `SCL port ${s.port}, ${s.input[0]}x${s.input[1]}${s.zero_copy ? ", zero-copy" : ""}; model ${s.model}`);
+    setText("ipud-mqtt", s.mqtt ? "connected" : "off or not connected");
+    const objs = (s.objects || []).map((o) => `${o.label} ${Math.round(o.score * 100)}%`);
+    setText("ipud-objects", objs.length ? objs.join(", ") : "nothing");
+  }
+
+  // Can the source picked on the page run? [ok, why not]
+  function sourceReady() {
+    const a = (last && last.available) || {};
+    const src = el("source").value;
+    if (src === "builtin")
+      return a.builtin ? [true, ""] : [false, "This firmware has no built-in model"];
+    if (src === "sdcard") {
+      if (el("sd_dir").value.trim() !== (a.sd_dir || "")) return [true, ""]; // checked after the save
+      if (!a.sd_found) return [false, `The SD card folder ${a.sd_dir || ""} is not there`];
+      if (!(a.sd_models || []).length) return [false, `No model (.img) in ${a.sd_dir}`];
+      if (!a.sd_firmware && !a.builtin) return [false, "No IPU firmware on the card or built in"];
+      return [true, ""];
+    }
+    return [true, ""]; // custom paths: checked when ipud starts
+  }
+
+  function refreshSource() {
+    const src = el("source").value;
+    document.getElementById("ipud-src-sdcard").classList.toggle("d-none", src !== "sdcard");
+    document.getElementById("ipud-src-custom").classList.toggle("d-none", src !== "custom");
+    const a = (last && last.available) || {};
+    let note = "";
+    if (src === "builtin") note = a.builtin ? "The model in this firmware." : "This firmware carries no model.";
+    if (src === "sdcard") {
+      const n = (a.sd_models || []).length;
+      note = a.sd_found ? `${n} model${n === 1 ? "" : "s"} on the card; IPU firmware ${a.sd_firmware ? "from the card" : "built in"}.`
+        : "The card folder is not there (is a card in?).";
+    }
+    if (src === "custom") note = "Any path on the camera; an empty firmware path uses the built-in one.";
+    setText("ipud-source-note", note);
+    const [ok, why] = sourceReady();
+    document.getElementById("ipud-files-alert").classList.toggle("d-none", ok);
+    setText("ipud-files-reason", why || "The selected model is not available");
+    // Locked while the chosen source has no model; an enabled switch can still be turned off.
+    el("enabled").disabled = !ok && !el("enabled").checked;
+  }
+
+  function apply(data) {
+    last = data;
+    const c = data.config || {};
+    const r = data.resolved || {};
+    const a = data.available || {};
+    BOOLS.forEach((k) => { if (el(k)) el(k).checked = c[k] === true; });
+    NUMBERS.forEach((k) => { if (el(k) && c[k] !== undefined) el(k).value = c[k]; });
+    TEXTS.forEach((k) => { if (el(k)) el(k).value = c[k] || ""; });
+    el("source").value = r.source || c.source || "builtin";
+    const sel = el("sd_model");
+    sel.innerHTML = "";
+    const models = a.sd_models || [];
+    if (!models.length) sel.add(new Option("(none on the card)", ""));
+    models.forEach((m) => sel.add(new Option(m, m)));
+    sel.value = models.includes(c.sd_model) ? c.sd_model : models[0] || "";
+    setText("ipud-labels-note", r.labels_file
+      ? `Now taken from ${r.model.replace(/\.[^.]*$/, "")}.labels: ${r.labels}`
+      : "A .labels file beside the model (one comma-separated line) takes precedence.");
+    refreshSource();
+    showStatus(data.status);
+  }
+
+  async function load() {
+    const res = await fetch(ENDPOINT, { cache: "no-store" });
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    apply(await res.json());
+  }
+
+  async function pollStatus() {
+    try {
+      const res = await fetch(ENDPOINT + "?a=status", { cache: "no-store" });
+      if (res.ok) showStatus(await res.json());
+    } catch (e) {
+      /* the next poll retries */
+    }
+  }
+
+  async function save() {
+    const ipud = {};
+    BOOLS.forEach((k) => (ipud[k] = el(k).checked));
+    NUMBERS.forEach((k) => {
+      const v = Number(el(k).value);
+      if (!Number.isNaN(v) && el(k).value !== "") ipud[k] = v;
+    });
+    TEXTS.forEach((k) => (ipud[k] = el(k).value.trim()));
+    ipud.source = el("source").value;
+    ipud.sd_model = el("sd_model").value;
+    const [ok, why] = sourceReady();
+    if (ipud.enabled && !ok) {
+      alert("warning", `${why}: detection stays off.`);
+      ipud.enabled = false;
+    }
+    const btn = document.getElementById("ipud-save");
+    btn.disabled = true;
+    try {
+      const res = await fetch(ENDPOINT, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ ipud }),
+      });
+      const data = await res.json();
+      if (!res.ok || data.error) throw new Error((data.error && data.error.message) || `HTTP ${res.status}`);
+      apply(data);
+      alert("success", "Saved; object detection restarts with the new settings.", 3000);
+    } catch (err) {
+      alert("danger", `Could not save: ${err.message || err}`);
+    } finally {
+      btn.disabled = false;
+    }
+  }
+
+  el("source").addEventListener("change", refreshSource);
+  el("sd_dir").addEventListener("input", refreshSource);
+  document.getElementById("ipud-save").addEventListener("click", save);
+  document.getElementById("ipud-reload").addEventListener("click", () =>
+    load().then(() => alert("info", "Reloaded.", 2000)).catch((e) => alert("danger", `Reload failed: ${e.message}`)));
+  document.addEventListener("visibilitychange", () => {
+    clearInterval(statusTimer);
+    statusTimer = document.hidden ? null : setInterval(pollStatus, 1000);
+  });
+
+  load().catch((e) => alert("danger", `Could not read the settings: ${e.message}`));
+  statusTimer = setInterval(pollStatus, 1000);
+})();
diff --git a/package/thingino-ipud/files/www/a/preview-ipud.js b/package/thingino-ipud/files/www/a/preview-ipud.js
new file mode 100644
index 000000000..200d4ba30
--- /dev/null
+++ b/package/thingino-ipud/files/www/a/preview-ipud.js
@@ -0,0 +1,192 @@
+/**
+ * Preview-page overlay for thingino-ipud: draws the IPU's latest detections over
+ * the live preview while ipud runs.
+ *
+ * ipud's boxes are normalised to the full frame (its SCL port scales the whole
+ * sensor image), which is what the preview shows, so a box maps onto the
+ * picture by the picture's displayed rectangle alone. The picture is the media
+ * element that shares the canvas's wrapper: raptor's WebRTC <video> on the
+ * raptor preview, the snapshot <img id="preview"> on the plain one. A video is
+ * letterboxed inside its box (object-fit: contain), so the canvas covers the
+ * content rectangle, not the element.
+ *
+ * Off until the viewer turns it on with the Detections button (remembered per
+ * browser). While on, ipud pushes its detections: one server-sent event per
+ * inference from /x/json-ipud.cgi?a=stream, which relays ipud's socket, so the
+ * camera runs no request per update. The stream closes while the tab is hidden
+ * and on the router's page-leave, which also removes every listener this script
+ * added, so the page can be swapped in and out.
+ *
+ * Plugin-owned file: registered via ipud.webui.json `preview.scripts`,
+ * injected into the preview page at build time.
+ */
+(function () {
+  "use strict";
+
+  const ENDPOINT = "/x/json-ipud.cgi?a=stream";
+  const POLL_MS = 500;
+  const COLORS = {
+    person: "#ff4d4d", bicycle: "#ffd24d", car: "#4da6ff",
+    motorcycle: "#ff9f40", bus: "#4dffb8", truck: "#b84dff"
+  };
+
+  const canvas = document.getElementById("ipud-overlay");
+  if (!canvas) return;
+
+  let timer = null;
+
+  function media() {
+    const wrap = canvas.parentElement;
+    return (wrap && wrap.querySelector("video, img#preview")) ||
+      document.getElementById("raptor-webrtc-video") || document.getElementById("preview");
+  }
+
+  // The displayed picture inside el, in el's offset coordinates.
+  function contentRect(el) {
+    const w = el.clientWidth;
+    const h = el.clientHeight;
+    const nw = el.videoWidth || el.naturalWidth || w;
+    const nh = el.videoHeight || el.naturalHeight || h;
+    if (!w || !h || !nw || !nh) return null;
+    const s = Math.min(w / nw, h / nh);
+    const dw = nw * s;
+    const dh = nh * s;
+    return { x: el.offsetLeft + (w - dw) / 2, y: el.offsetTop + (h - dh) / 2, w: dw, h: dh };
+  }
+
+  function place() {
+    const el = media();
+    const r = el && contentRect(el);
+    if (!r) return false;
+    canvas.style.left = r.x + "px";
+    canvas.style.top = r.y + "px";
+    canvas.style.width = r.w + "px";
+    canvas.style.height = r.h + "px";
+    const cw = Math.round(r.w);
+    const ch = Math.round(r.h);
+    if (canvas.width !== cw) canvas.width = cw;
+    if (canvas.height !== ch) canvas.height = ch;
+    return true;
+  }
+
+  function draw(status) {
+    if (!status || !status.running || !place()) {
+      canvas.style.display = "none";
+      return;
+    }
+    canvas.style.display = "";
+    const ctx = canvas.getContext("2d");
+    const w = canvas.width;
+    const h = canvas.height;
+    ctx.clearRect(0, 0, w, h);
+    ctx.lineWidth = 2;
+    ctx.font = "12px sans-serif";
+    (status.objects || []).forEach((o) => {
+      const [x0, y0, x1, y1] = o.box;
+      const color = COLORS[o.label] || "#ffd24d";
+      ctx.strokeStyle = color;
+      ctx.strokeRect(x0 * w, y0 * h, (x1 - x0) * w, (y1 - y0) * h);
+      const text = `${o.label} ${Math.round(o.score * 100)}%`;
+      const tw = ctx.measureText(text).width + 6;
+      ctx.fillStyle = color;
+      ctx.fillRect(x0 * w, Math.max(0, y0 * h - 16), tw, 16);
+      ctx.fillStyle = "#000";
+      ctx.fillText(text, x0 * w + 3, Math.max(12, y0 * h - 4));
+    });
+  }
+
+  // While ipud does not run the stream answers {"running":false} and ends;
+  // ask again after this long rather than at EventSource's own retry.
+  const DOWN_RETRY_MS = 30 * POLL_MS;
+  const STORE_KEY = "thingino.ipudOverlay";
+  let source = null;
+
+  function enabled() {
+    try {
+      return localStorage.getItem(STORE_KEY) === "1";
+    } catch (e) {
+      return false;
+    }
+  }
+
+  function setEnabled(on) {
+    try {
+      if (on) localStorage.setItem(STORE_KEY, "1");
+      else localStorage.removeItem(STORE_KEY);
+    } catch (e) {
+      /* no storage: the button still works for this page */
+    }
+  }
+
+  function open() {
+    clearTimeout(timer);
+    timer = null;
+    if (source || !enabled() || document.hidden) return;
+    source = new EventSource(ENDPOINT);
+    source.onmessage = (ev) => {
+      let status = null;
+      try {
+        status = JSON.parse(ev.data);
+      } catch (e) {
+        return;
+      }
+      if (status.running === false) {
+        close();
+        timer = setTimeout(open, DOWN_RETRY_MS);
+        return;
+      }
+      status.running = true;
+      draw(status);
+    };
+    source.onerror = () => draw(null);
+  }
+
+  function close() {
+    if (source) source.close();
+    source = null;
+    draw(null);
+  }
+
+  const button = document.createElement("button");
+  button.type = "button";
+  button.id = "ipud-overlay-toggle";
+  button.className = "btn btn-outline-secondary";
+  button.title = "Show the IPU's detections over the picture";
+  button.innerHTML = '<i class="bi bi-bounding-box"></i> Detections';
+
+  function render() {
+    const on = enabled();
+    button.classList.toggle("active", on);
+    button.setAttribute("aria-pressed", String(on));
+  }
+
+  button.addEventListener("click", () => {
+    setEnabled(!enabled());
+    render();
+    if (enabled()) open();
+    else close();
+  });
+
+  const bar = document.querySelector(".preview-header-actions");
+  if (bar) bar.appendChild(button);
+  else if (canvas.parentElement) canvas.parentElement.insertAdjacentElement("beforebegin", button);
+
+  function onVisibility() {
+    if (document.hidden) close();
+    else open();
+  }
+
+  function leave() {
+    clearTimeout(timer);
+    timer = null;
+    close();
+    document.removeEventListener("visibilitychange", onVisibility);
+    window.removeEventListener("resize", place);
+  }
+
+  document.addEventListener("visibilitychange", onVisibility);
+  document.addEventListener("thingino:page-leave", leave, { once: true });
+  window.addEventListener("resize", place);
+  render();
+  open();
+})();
diff --git a/package/thingino-ipud/files/www/config-ipud.html b/package/thingino-ipud/files/www/config-ipud.html
new file mode 100644
index 000000000..dd4bfcb18
--- /dev/null
+++ b/package/thingino-ipud/files/www/config-ipud.html
@@ -0,0 +1,192 @@
+<!DOCTYPE html>
+<html lang="en" data-bs-theme="dark">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width,initial-scale=1">
+  <title>thingino · Object detection</title>
+  <script src="/a/theme-init.js"></script>
+  <link rel="icon" type="image/svg+xml" href="/a/favicon.svg">
+  <link rel="preconnect" href="https://fonts.googleapis.com">
+  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap">
+  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
+    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
+  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
+  <link rel="stylesheet" href="/a/main.css">
+</head>
+
+<body id="page-config-ipud">
+<nav data-app-nav></nav>
+
+<main class="pb-4">
+  <div class="container" style="min-height:80vh">
+    <div data-app-controls></div>
+
+    <section>
+      <div id="ipud-files-alert" class="alert alert-warning d-none" role="alert">
+        <span id="ipud-files-reason">The selected model is not available</span>, so detection cannot be
+        enabled with this source. Pick another source below, or put the model in place.
+      </div>
+
+      <form id="ipud-form" class="needs-validation" novalidate autocomplete="off">
+        <div class="card mb-3">
+          <div class="card-header">
+            <h2 class="card-title">Object detection</h2>
+            <small>Runs a YOLO model on the SoC's neural-network unit (IPU) and reports what it finds.</small>
+            <button type="button" class="btn btn-outline-secondary" id="ipud-reload" title="Reload values from camera">
+              <i class="bi bi-arrow-clockwise"></i> Reload
+            </button>
+          </div>
+          <div class="card-body">
+            <div class="row row-cols-lg-3 g-4">
+              <div class="col">
+                <h4>Detection</h4>
+                <p class="form-switch">
+                  <input type="checkbox" id="ipud_enabled" role="switch" class="form-check-input">
+                  <label for="ipud_enabled" class="form-check-label">Enable object detection</label>
+                </p>
+                <p>
+                  <label for="ipud_score">Score threshold</label>
+                  <input type="number" id="ipud_score" class="form-control" min="0.05" max="0.95" step="0.05">
+                  <small class="text-secondary">Lower finds more, with more false alarms.</small>
+                </p>
+                <p>
+                  <label for="ipud_max_fps">Inferences per second</label>
+                  <input type="number" id="ipud_max_fps" class="form-control" min="0" max="25" step="1">
+                  <small class="text-secondary">0 runs every frame (about 22 a second).</small>
+                </p>
+                <p>
+                  <label for="ipud_report">Report these classes</label>
+                  <input type="text" id="ipud_report" class="form-control" placeholder="person,car">
+                  <small class="text-secondary">Comma-separated; empty reports every class.</small>
+                </p>
+              </div>
+              <div class="col">
+                <h4>Events</h4>
+                <p class="form-switch">
+                  <input type="checkbox" id="ipud_mqtt" role="switch" class="form-check-input">
+                  <label for="ipud_mqtt" class="form-check-label">Publish to MQTT</label>
+                </p>
+                <small class="text-secondary d-block mb-2">Uses the broker set in Services &gt; Send to MQTT.</small>
+                <p>
+                  <label for="ipud_mqtt_topic">Base topic</label>
+                  <input type="text" id="ipud_mqtt_topic" class="form-control" placeholder="thingino/&lt;hostname&gt;/ipud">
+                </p>
+                <p>
+                  <label for="ipud_mqtt_interval_ms">Detections at most every (ms)</label>
+                  <input type="number" id="ipud_mqtt_interval_ms" class="form-control" min="100" max="10000" step="100">
+                </p>
+                <p class="form-switch">
+                  <input type="checkbox" id="ipud_onvif" role="switch" class="form-check-input">
+                  <label for="ipud_onvif" class="form-check-label">ONVIF events</label>
+                </p>
+                <small class="text-secondary d-block mb-2">Person, Vehicle and Pet Detection (MyRuleDetector topics) for the classes reported.</small>
+                <p class="form-switch">
+                  <input type="checkbox" id="ipud_ha" role="switch" class="form-check-input">
+                  <label for="ipud_ha" class="form-check-label">Home Assistant entities</label>
+                </p>
+                <small class="text-secondary d-block mb-2">A sensor per reported class and an Objects sensor with the boxes, on this camera's device; uses the broker of Services &gt; Home Assistant, in place of the MQTT topic above.</small>
+                <p class="form-switch">
+                  <input type="checkbox" id="ipud_frigate" role="switch" class="form-check-input">
+                  <label for="ipud_frigate" class="form-check-label">Frigate events</label>
+                </p>
+                <small class="text-secondary d-block mb-2">A Frigate event per class while it is present, with its boxes on the snapshot.</small>
+                <p>
+                  <label for="ipud_frigate_url">Frigate URL</label>
+                  <input type="text" id="ipud_frigate_url" class="form-control" placeholder="http://frigate-host:5000">
+                  <small class="text-secondary">Frigate's internal port (5000), which needs no login.</small>
+                </p>
+                <p>
+                  <label for="ipud_frigate_camera">Camera name in Frigate</label>
+                  <input type="text" id="ipud_frigate_camera" class="form-control">
+                </p>
+                <p>
+                  <label for="ipud_hold_ms">Presence hold (ms)</label>
+                  <input type="number" id="ipud_hold_ms" class="form-control" min="0" max="60000" step="500">
+                  <small class="text-secondary">How long a class stays ON after its last detection.</small>
+                </p>
+              </div>
+              <div class="col">
+                <h4>Model</h4>
+                <p>
+                  <label for="ipud_source">Load the model from</label>
+                  <select id="ipud_source" class="form-select">
+                    <option value="builtin">Built in (in the firmware)</option>
+                    <option value="sdcard">SD card</option>
+                    <option value="custom">Custom path</option>
+                  </select>
+                  <small class="text-secondary" id="ipud-source-note"></small>
+                </p>
+                <div id="ipud-src-sdcard" class="d-none">
+                  <p>
+                    <label for="ipud_sd_dir">SD card folder</label>
+                    <input type="text" id="ipud_sd_dir" class="form-control" placeholder="/mnt/mmcblk0p1/ipud">
+                  </p>
+                  <p>
+                    <label for="ipud_sd_model">Model on the card</label>
+                    <select id="ipud_sd_model" class="form-select"></select>
+                    <small class="text-secondary">A model's <code>.img</code> file in the folder; its IPU firmware is
+                      the folder's <code>ipu_firmware.bin</code> if there is one, else the built-in one. Save the
+                      folder to list a new one.</small>
+                  </p>
+                </div>
+                <div id="ipud-src-custom" class="d-none">
+                  <p>
+                    <label for="ipud_model">Model file</label>
+                    <input type="text" id="ipud_model" class="form-control">
+                  </p>
+                  <p>
+                    <label for="ipud_firmware">IPU firmware file</label>
+                    <input type="text" id="ipud_firmware" class="form-control" placeholder="built-in">
+                  </p>
+                </div>
+                <p>
+                  <label for="ipud_labels">Class names, in model order</label>
+                  <input type="text" id="ipud_labels" class="form-control">
+                  <small class="text-secondary" id="ipud-labels-note">A <code>.labels</code> file beside the model
+                    (one comma-separated line) takes precedence.</small>
+                </p>
+                <p>
+                  <label for="ipud_iou">NMS overlap (IoU)</label>
+                  <input type="number" id="ipud_iou" class="form-control" min="0.1" max="0.9" step="0.05">
+                </p>
+              </div>
+            </div>
+          </div>
+        </div>
+
