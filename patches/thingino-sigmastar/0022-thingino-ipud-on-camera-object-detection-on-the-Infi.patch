diff --git a/package/thingino-ipud/files/www/x/json-ipud.cgi b/package/thingino-ipud/files/www/x/json-ipud.cgi
new file mode 100755
index 000000000..b4a429e65
--- /dev/null
+++ b/package/thingino-ipud/files/www/x/json-ipud.cgi
@@ -0,0 +1,148 @@
+#!/bin/sh
+# shellcheck disable=SC1091,SC3043
+# json-ipud.cgi -- the web UI's IPU detection (thingino-ipud) settings and status.
+#
+#   GET              {"config":{<ipud block over the defaults>},
+#                     "resolved":{"source","firmware","model","labels","labels_file","missing"},
+#                     "available":{"builtin","sd_dir","sd_found","sd_models":[..],"sd_firmware"},
+#                     "files":{"firmware":b,"model":b},"status":{..}}
+#   GET ?a=status    ipud's status file (/run/ipud/status.json) alone, for the
+#                    preview overlay's poll
+#   POST {"ipud":{..}}   merge into /etc/thingino.json, restart ipud, answer as GET
+#
+# The settings live in the "ipud" block of /etc/thingino.json (defaults from
+# /usr/share/thingino-defaults/45-ipud.json); /usr/libexec/ipud-paths resolves
+# the model source the same way S35ipud does.
+
+. /var/www/x/auth.sh
+require_auth
+
+# The preview overlay's stream and the status read first, and lean: no
+# config, paths or subshells. The stream relays ipud's socket, one
+# server-sent event per inference, until the page or ipud goes away; then
+# {"running":false} tells the overlay to stop asking for a while.
+case "$REQUEST_METHOD:$QUERY_STRING" in
+GET:*a=stream* | :*a=stream*)
+	printf 'Status: 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-store\r\n\r\nretry: 15000\n\n'
+	[ -S /run/ipud.sock ] && /usr/bin/ipucat 2>/dev/null | awk '{ printf "data: %s\n\n", $0; fflush() }'
+	printf 'data: {"running":false}\n\n'
+	exit 0
+	;;
+GET:*a=status* | :*a=status*)
+	printf 'Status: 200 OK\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n'
+	if [ -s /run/ipud/status.json ]; then cat /run/ipud/status.json; else printf '{"running":false}\n'; fi
+	exit 0
+	;;
+esac
+
+CONFIG_FILE="${THINGINO_CONFIG:-/etc/thingino.json}"
+DEFAULTS_FILE=/usr/share/thingino-defaults/45-ipud.json
+STATUS=/run/ipud/status.json
+REQ_FILE=""
+MERGED=""
+trap 'rm -f ${REQ_FILE:+"$REQ_FILE"} ${MERGED:+"$MERGED" "$MERGED.in"}' EXIT
+
+IPUD_CONFIG="$CONFIG_FILE"
+. /usr/libexec/ipud-paths
+
+send_json() {
+	printf 'Status: %s\r\n' "${2:-200 OK}"
+	printf 'Content-Type: application/json\r\n'
+	printf 'Cache-Control: no-store\r\n'
+	printf 'Connection: close\r\n'
+	printf '\r\n'
+	printf '%s\n' "$1"
+	exit 0
+}
+
+esc() {
+	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
+}
+
+status_json() {
+	if [ -s "$STATUS" ]; then
+		cat "$STATUS"
+	else
+		printf '{"running":false}'
+	fi
+}
+
+bool_file() {
+	[ -n "$1" ] && [ -f "$1" ] && printf true || printf false
+}
+
+# The ipud block over the package defaults: an overlay that kept an older
+# thingino.json has no block or only some keys, and the page shows every
+# setting. Merged in a /tmp copy; thingino.json is written only by a save.
+merged_config() {
+	local cfg
+	MERGED=$(mktemp /tmp/ipud-cfg.XXXXXX)
+	if [ -f "$DEFAULTS_FILE" ]; then cp "$DEFAULTS_FILE" "$MERGED"; else echo '{}' >"$MERGED"; fi
+	cfg=$(jct "$CONFIG_FILE" get ipud 2>/dev/null)
+	case "$cfg" in
+	"" | null) ;;
+	*)
+		printf '{"ipud":%s}\n' "$cfg" >"$MERGED.in"
+		jct "$MERGED" import "$MERGED.in" >/dev/null 2>&1
+		rm -f "$MERGED.in"
+		;;
+	esac
+	cfg=$(jct "$MERGED" get ipud 2>/dev/null)
+	rm -f "$MERGED"
+	case "$cfg" in "" | null) cfg='{}' ;; esac
+	printf '%s' "$cfg"
+}
+
+sd_models_json() {
+	ipud_sd_models "$1" | {
+		sep=
+		while read -r n; do
+			printf '%s"%s"' "$sep" "$(esc "$n")"
+			sep=,
+		done
+	}
+}
+
+full_json() {
+	local sd builtin
+	ipud_resolve
+	sd=$(ipud_get sd_dir)
+	builtin=false
+	[ -f "$IPUD_BUILTIN/model.img" ] && [ -f "$IPUD_BUILTIN/ipu_firmware.bin" ] && builtin=true
+	printf '{"config":%s,' "$(merged_config)"
+	printf '"resolved":{"source":"%s","firmware":"%s","model":"%s","labels":"%s","labels_file":%s,"missing":"%s"},' \
+		"$(esc "$IPUD_SOURCE")" "$(esc "$IPUD_FW")" "$(esc "$IPUD_MODEL")" "$(esc "$IPUD_LABELS")" \
+		"$([ "$IPUD_LABELS_FILE" = 1 ] && echo true || echo false)" "$(esc "$IPUD_MISSING")"
+	printf '"available":{"builtin":%s,"sd_dir":"%s","sd_found":%s,"sd_models":[%s],"sd_firmware":%s},' \
+		"$builtin" "$(esc "$sd")" "$([ -n "$sd" ] && [ -d "$sd" ] && echo true || echo false)" \
+		"$(sd_models_json "$sd")" "$(bool_file "$sd/ipu_firmware.bin")"
+	printf '"files":{"firmware":%s,"model":%s},"status":%s}' \
+		"$(bool_file "$IPUD_FW")" "$(bool_file "$IPUD_MODEL")" "$(status_json | tr -d '\n')"
+}
+
+case "$REQUEST_METHOD" in
+GET | "")
+	case "$QUERY_STRING" in
+	*a=status*) send_json "$(status_json | tr -d '\n')" ;;
+	*) send_json "$(full_json)" ;;
+	esac
+	;;
+POST)
+	REQ_FILE=$(mktemp /tmp/ipud-req.XXXXXX)
+	if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ]; then
+		dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null >"$REQ_FILE"
+	else
+		cat >"$REQ_FILE"
+	fi
+	grep -q '"ipud"' "$REQ_FILE" ||
+		send_json '{"error":{"code":400,"message":"expected {\"ipud\":{...}}"}}' "400 Bad Request"
+	jct "$CONFIG_FILE" import "$REQ_FILE" >/dev/null 2>&1 ||
+		send_json '{"error":{"code":500,"message":"could not save /etc/thingino.json"}}' "500 Internal Server Error"
+	# restart in the background: stop waits for ipud to leave the IPU
+	/etc/init.d/S35ipud restart >/dev/null 2>&1 &
+	send_json "$(full_json)"
+	;;
+*)
+	send_json '{"error":{"code":405,"message":"Method not allowed"}}' "405 Method Not Allowed"
+	;;
+esac
diff --git a/package/thingino-ipud/files/yolo.c b/package/thingino-ipud/files/yolo.c
new file mode 100644
index 000000000..4ccb7c5ec
--- /dev/null
+++ b/package/thingino-ipud/files/yolo.c
@@ -0,0 +1,106 @@
+/* yolo.c - YOLOv5 decode + NMS; see yolo.h. */
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include "yolo.h"
+
+const float yolo_v5_default_anchors[3][3][2] = {
+    { { 10, 13 }, { 16, 30 }, { 33, 23 } },        /* P3, stride 8 */
+    { { 30, 61 }, { 62, 45 }, { 59, 119 } },       /* P4, stride 16 */
+    { { 116, 90 }, { 156, 198 }, { 373, 326 } },   /* P5, stride 32 */
+};
+
+static inline float sigm(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+static inline long long qat(const yolo_head *hd, long i)
+{
+    return hd->elem == 2 ? (long long)((const short *)hd->data)[i]
+                         : (long long)((const signed char *)hd->data)[i];
+}
+
+static int by_score(const void *a, const void *b)
+{
+    float sa = ((const yolo_det *)a)->score, sb = ((const yolo_det *)b)->score;
+    return (sa < sb) - (sa > sb);
+}
+
+static float iou(const yolo_det *a, const yolo_det *b)
+{
+    float ix = fminf(a->x1, b->x1) - fmaxf(a->x0, b->x0);
+    float iy = fminf(a->y1, b->y1) - fmaxf(a->y0, b->y0);
+    if (ix <= 0 || iy <= 0) return 0;
+    float in = ix * iy;
+    float ua = (a->x1 - a->x0) * (a->y1 - a->y0) + (b->x1 - b->x0) * (b->y1 - b->y0) - in;
+    return ua > 0 ? in / ua : 0;
+}
+
+int yolo_v5_decode(const yolo_head *heads, int nh, const yolo_params *p, yolo_det *out, int max)
+{
+    int cap = p->max_cand > 0 ? p->max_cand : 4096, n = 0;
+    yolo_det *cand;
+
+    if (!heads || nh <= 0 || !p || p->conf <= 0 || p->conf >= 1) return -1;
+    cand = malloc(sizeof *cand * (size_t)cap);
+    if (!cand) return -1;
+
+    /* sig(obj) * sig(cls) >= conf needs sig(obj) >= conf, so a cell whose
+     * objectness logit is below logit(conf) cannot pass: test that in the
+     * quantised domain before any float work. */
+    float lconf = logf(p->conf / (1.0f - p->conf));
+
+    for (int k = 0; k < nh; k++) {
+        const yolo_head *hd = &heads[k];
+        int nc = hd->nch - 5;
+        if (nc < 1 || hd->inner < hd->nch || hd->scale <= 0) { free(cand); return -1; }
+        long long qthr = (long long)ceilf(lconf / hd->scale) + hd->zp;
+
+        for (int a = 0; a < hd->na; a++)
+            for (int gy = 0; gy < hd->h; gy++)
+                for (int gx = 0; gx < hd->w; gx++) {
+                    long base = ((long)(a * hd->h + gy) * hd->w + gx) * hd->inner;
+                    if (qat(hd, base + 4) < qthr) continue;
+
+                    long long qbest = qat(hd, base + 5);
+                    int cbest = 0;
+                    for (int c = 1; c < nc; c++) {
+                        long long q = qat(hd, base + 5 + c);
+                        if (q > qbest) { qbest = q; cbest = c; }
+                    }
+                    float obj = sigm((float)(qat(hd, base + 4) - hd->zp) * hd->scale);
+                    float score = obj * sigm((float)(qbest - hd->zp) * hd->scale);
+                    if (score < p->conf) continue;
+
+                    float tx = sigm((float)(qat(hd, base + 0) - hd->zp) * hd->scale);
+                    float ty = sigm((float)(qat(hd, base + 1) - hd->zp) * hd->scale);
+                    float tw = sigm((float)(qat(hd, base + 2) - hd->zp) * hd->scale);
+                    float th = sigm((float)(qat(hd, base + 3) - hd->zp) * hd->scale);
+                    float cx = (tx * 2.0f - 0.5f + (float)gx) * (float)hd->stride;
+                    float cy = (ty * 2.0f - 0.5f + (float)gy) * (float)hd->stride;
+                    float bw = (tw * 2.0f) * (tw * 2.0f) * hd->anchors[a][0];
+                    float bh = (th * 2.0f) * (th * 2.0f) * hd->anchors[a][1];
+
+                    yolo_det d = { cx - bw / 2, cy - bh / 2, cx + bw / 2, cy + bh / 2, score, cbest };
+                    if (n < cap) {
+                        cand[n++] = d;
+                    } else {            /* full: replace the weakest */
+                        int lo = 0;
+                        for (int i = 1; i < n; i++) if (cand[i].score < cand[lo].score) lo = i;
+                        if (d.score > cand[lo].score) cand[lo] = d;
+                    }
+                }
+    }
+
+    qsort(cand, (size_t)n, sizeof *cand, by_score);
+    int kept = 0;
+    for (int i = 0; i < n && kept < max; i++) {
+        int drop = 0;
+        for (int j = 0; j < kept; j++)
+            if ((p->agnostic || out[j].cls == cand[i].cls) && iou(&out[j], &cand[i]) > p->iou) {
+                drop = 1;
+                break;
+            }
+        if (!drop) out[kept++] = cand[i];
+    }
+    free(cand);
+    return kept;
+}
diff --git a/package/thingino-ipud/files/yolo.h b/package/thingino-ipud/files/yolo.h
new file mode 100644
index 000000000..94b1b0b10
--- /dev/null
+++ b/package/thingino-ipud/files/yolo.h
@@ -0,0 +1,45 @@
+/* yolo.h - YOLOv5 (anchor-based, v6+ head) decode + NMS for SGS IPU outputs.
+ *
+ * Each head is one IPU output tensor [1, na, H, W, 5+nc] of quantised logits
+ * (INT16 on the OEM models): real = (q - zp) * scale. The v6+
+ * decode (SPPF era, which the OEM models are) is
+ *   xy = (2*sig(t) - 0.5 + grid) * stride,  wh = (2*sig(t))^2 * anchor,
+ *   score = sig(obj) * sig(best class).
+ * No MI dependency: builds and tests on the host.
+ */
+#ifndef YOLO_H
+#define YOLO_H
+
+typedef struct {
+    float x0, y0, x1, y1;   /* model-input pixels */
+    float score;
+    int   cls;
+} yolo_det;
+
+typedef struct {
+    const void *data;       /* the head tensor as the IPU returned it */
+    int   elem;             /* bytes per element: 2 (INT16) or 1 (INT8) */
+    int   na, h, w, nch;    /* anchors, grid rows, grid cols, 5 + nc */
+    int   inner;            /* elements from one cell to the next (>= nch) */
+    float scale;            /* dequant scale */
+    long long zp;           /* dequant zero point */
+    int   stride;           /* input pixels per grid cell */
+    float anchors[3][2];    /* anchor w,h in input pixels */
+} yolo_head;
+
+typedef struct {
+    float conf;             /* keep sig(obj)*sig(cls) >= conf */
+    float iou;              /* NMS IoU threshold */
+    int   agnostic;         /* 1: NMS across classes */
+    int   max_cand;         /* candidate cap before NMS (0 = 4096) */
+} yolo_params;
+
+/* The stock YOLOv5 anchors for strides 8, 16, 32 (pixels). */
+extern const float yolo_v5_default_anchors[3][3][2];
+
+/* Decode nh heads, run NMS, write at most max boxes (best first) to out.
+ * Returns the number written, or -1 on bad input. */
+int yolo_v5_decode(const yolo_head *heads, int nh, const yolo_params *p,
+                   yolo_det *out, int max);
+
+#endif
diff --git a/package/thingino-ipud/thingino-ipud.mk b/package/thingino-ipud/thingino-ipud.mk
new file mode 100644
index 000000000..2ae9d915e
--- /dev/null
+++ b/package/thingino-ipud/thingino-ipud.mk
@@ -0,0 +1,80 @@
+################################################################################
+#
+# thingino-ipud
+#
+################################################################################
+
+THINGINO_IPUD_VERSION = 0.1
+THINGINO_IPUD_SITE_METHOD = local
+THINGINO_IPUD_SITE = $(THINGINO_IPUD_PKGDIR)/files
+THINGINO_IPUD_LICENSE = MIT
+
+THINGINO_IPUD_DEPENDENCIES = sigmastar-lib thingino-core thingino-jct
+
+# The MI libraries (libmi_ipu, libmi_scl, libmi_sys and their deps) and
+# libmosquitto are dlopened at run time, so nothing links against the drop.
+define THINGINO_IPUD_BUILD_CMDS
+	$(TARGET_CC) $(TARGET_CFLAGS) $(TARGET_LDFLAGS) -Os -s -Wall -Wextra \
+		-o $(@D)/ipud $(@D)/ipud.c $(@D)/ipu_rt.c $(@D)/scl_src.c \
+		$(@D)/yolo.c -ldl -lm
+	$(TARGET_CC) $(TARGET_CFLAGS) $(TARGET_LDFLAGS) -Os -s -Wall -Wextra \
+		-o $(@D)/ipucat $(@D)/ipucat.c
+endef
+
+ifeq ($(BR2_PACKAGE_THINGINO_WEBUI),y)
+THINGINO_IPUD_DEPENDENCIES += thingino-webui
+define THINGINO_IPUD_INSTALL_WWW_CMDS
+	$(INSTALL) -d $(TARGET_DIR)/var/www/a
+	$(INSTALL) -d $(TARGET_DIR)/var/www/x
+	$(INSTALL) -d $(TARGET_DIR)/var/www/a/plugins
+	$(INSTALL) -D -m 0644 $(@D)/www/config-ipud.html \
+		$(TARGET_DIR)/var/www/config-ipud.html
+	$(INSTALL) -D -m 0644 $(@D)/www/a/config-ipud.js \
+		$(TARGET_DIR)/var/www/a/config-ipud.js
+	$(INSTALL) -D -m 0644 $(@D)/www/a/preview-ipud.js \
+		$(TARGET_DIR)/var/www/a/preview-ipud.js
+	$(INSTALL) -D -m 0755 $(@D)/www/x/json-ipud.cgi \
+		$(TARGET_DIR)/var/www/x/json-ipud.cgi
+	$(INSTALL) -D -m 0644 $(@D)/ipud.webui.json \
+		$(TARGET_DIR)/var/www/a/plugins/ipud.webui.json
+endef
+endif
+
+# The built-in model: the IPU firmware and the model are vendor files that no
+# license lets us publish, so they are never in the repository (vendor/ is
+# git-ignored). A private build stages them in vendor/ first, with
+# model.labels; whatever is there goes to /usr/share/ipud/. Without them the
+# image has no built-in model, and ipud runs from the SD card or a custom path.
+THINGINO_IPUD_VENDOR_DIR = $(THINGINO_IPUD_PKGDIR)/vendor
+define THINGINO_IPUD_INSTALL_VENDOR_CMDS
+	for f in ipu_firmware.bin model.img model.labels; do \
+		if [ -f $(THINGINO_IPUD_VENDOR_DIR)/$$f ]; then \
+			$(INSTALL) -D -m 0644 $(THINGINO_IPUD_VENDOR_DIR)/$$f \
+				$(TARGET_DIR)/usr/share/ipud/$$f || exit 1; \
+		fi; \
+	done
+endef
+
+# /etc/raptor.d/ipud has raptor stop ipud before its daemons go down and start
+# it once they are back; ipud also reopens its port by itself if raptor
+# restarts under it. Defaults go to the thingino.json merge (thingino-core).
+# /usr/libexec/ipud-paths resolves the model source for S35ipud and the CGI;
+# /usr/libexec/ipud-onvif adds or drops the ONVIF object events (ipud.onvif);
+# /usr/libexec/ipud-ha publishes or clears the Home Assistant entities
+# (ipud.ha) through thingino-ha's library, when that package is in the image.
+define THINGINO_IPUD_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/ipud $(TARGET_DIR)/usr/sbin/ipud
+	$(INSTALL) -D -m 0755 $(@D)/ipucat $(TARGET_DIR)/usr/bin/ipucat
+	$(INSTALL) -D -m 0755 $(@D)/S35ipud $(TARGET_DIR)/etc/init.d/S35ipud
+	$(INSTALL) -D -m 0755 $(@D)/raptor-hook $(TARGET_DIR)/etc/raptor.d/ipud
+	$(INSTALL) -D -m 0644 $(@D)/ipud-paths $(TARGET_DIR)/usr/libexec/ipud-paths
+	$(INSTALL) -D -m 0755 $(@D)/ipud-onvif $(TARGET_DIR)/usr/libexec/ipud-onvif
+	$(INSTALL) -D -m 0755 $(@D)/ipud-ha $(TARGET_DIR)/usr/libexec/ipud-ha
+	$(INSTALL) -D -m 0755 $(@D)/ipud-frigate $(TARGET_DIR)/usr/libexec/ipud-frigate
+	$(INSTALL) -D -m 0644 $(@D)/ipud.json \
+		$(TARGET_DIR)/usr/share/thingino-defaults/45-ipud.json
+	$(THINGINO_IPUD_INSTALL_VENDOR_CMDS)
+	$(THINGINO_IPUD_INSTALL_WWW_CMDS)
+endef
+
+$(eval $(generic-package))
-- 
2.43.0

