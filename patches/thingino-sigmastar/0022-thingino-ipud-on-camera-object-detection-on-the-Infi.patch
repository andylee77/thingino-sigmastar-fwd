+++ b/package/thingino-ipud/files/ipu_rt.c
@@ -0,0 +1,206 @@
+/* ipu_rt.c - MI_IPU runtime wrapper; see ipu_rt.h and README.md. */
+#include <stdio.h>
+#include <string.h>
+#include <dlfcn.h>
+#include <sys/stat.h>
+#include "ipu_rt.h"
+
+/* The lib calls this to pull firmware/model bytes; ctx is the path passed to
+ * CreateDevice/CreateCHN (confirmed on N803, 2026-11-10). */
+static int read_cb(void *data, int offset, int size, char *ctx)
+{
+    FILE *f = fopen(ctx, "rb");
+    if (!f) return -1;
+    if (fseek(f, offset, SEEK_SET)) { fclose(f); return -1; }
+    size_t n = fread(data, 1, (size_t)size, f);
+    fclose(f);
+    return n == (size_t)size ? 0 : -1;
+}
+
+#define SYM(n) do { \
+    rt->n = (fn_MI_IPU_##n) dlsym(rt->h_ipu, "MI_IPU_" #n); \
+    if (!rt->n) { fprintf(stderr, "ipu: dlsym MI_IPU_" #n ": %s\n", dlerror()); return -1; } \
+} while (0)
+
+static int load_libs(ipu_rt *rt)
+{
+    /* libmi_ipu.so resolves against the rest of the MI stack: load its deps
+     * into the global scope first (the order raptor-hal's loader uses). */
+    static const char *deps[] = { "libcam_os_wrapper.so", "libcam_fs_wrapper.so",
+                                  "libmi_common.so", "libmi_sys.so" };
+    for (unsigned i = 0; i < sizeof deps / sizeof *deps; i++) {
+        void *d = dlopen(deps[i], RTLD_NOW | RTLD_GLOBAL);
+        if (!d) { fprintf(stderr, "ipu: dlopen %s: %s\n", deps[i], dlerror()); return -1; }
+        if (!strcmp(deps[i], "libmi_sys.so")) rt->h_sys = d;
+    }
+    rt->h_ipu = dlopen("libmi_ipu.so", RTLD_NOW | RTLD_GLOBAL);
+    if (!rt->h_ipu) { fprintf(stderr, "ipu: dlopen libmi_ipu.so: %s\n", dlerror()); return -1; }
+    SYM(CreateDevice); SYM(DestroyDevice); SYM(CreateCHN); SYM(DestroyCHN);
+    SYM(GetInOutTensorDesc); SYM(GetInputTensors); SYM(PutInputTensors);
+    SYM(GetOutputTensors); SYM(PutOutputTensors); SYM(Invoke);
+    rt->SysInit = (fn_MI_SYS_Init) dlsym(rt->h_sys, "MI_SYS_Init");
+    rt->SysExit = (fn_MI_SYS_Exit) dlsym(rt->h_sys, "MI_SYS_Exit");
+    if (!rt->SysInit || !rt->SysExit) { fprintf(stderr, "ipu: dlsym MI_SYS_Init/Exit\n"); return -1; }
+    *(void **)&rt->FlushInvCache = dlsym(rt->h_sys, "MI_SYS_FlushInvCache");
+    if (!rt->FlushInvCache) { fprintf(stderr, "ipu: dlsym MI_SYS_FlushInvCache\n"); return -1; }
+    return 0;
+}
+
+/* One channel on the model. MI_IPU_ChnAttr's second and third words are the
+ * output and input buffer depths (SigmaStar's u32OutputBufDepth,
+ * u32InputBufDepth; divinus calls them usrDepth and bufDepth). Input depth 0:
+ * MI allocates no input buffer and every Invoke brings its own (zero copy). */
+static int chn_open(ipu_rt *rt, unsigned int in_depth)
+{
+    MI_IPU_ChnAttr ca;
+    int r;
+
+    memset(&ca, 0, sizeof ca);
+    ca.usrDepth = 1; ca.bufDepth = in_depth; ca.maxBatch = 1;
+    if ((r = rt->CreateCHN(&rt->chn, &ca, read_cb, (char *)rt->model))) {
+        /* 54: "Model version doesn't match this platform" (README.md) */
+        fprintf(stderr, "ipu: CreateCHN(%s) = %d\n", rt->model, r); return -1;
+    }
+    rt->chn_ok = 1;
+    rt->in_depth = in_depth;
+
+    if ((r = rt->GetInOutTensorDesc(rt->chn, &rt->desc))) {
+        fprintf(stderr, "ipu: GetInOutTensorDesc = %d\n", r); return -1;
+    }
+    memset(&rt->in, 0, sizeof rt->in);
+    if (in_depth) {
+        if ((r = rt->GetInputTensors(rt->chn, &rt->in))) {
+            fprintf(stderr, "ipu: GetInputTensors = %d\n", r); return -1;
+        }
+        rt->in_ok = 1;
+    } else {
+        rt->in.count = rt->desc.inCnt;
+    }
+    if ((r = rt->GetOutputTensors(rt->chn, &rt->out))) {
+        fprintf(stderr, "ipu: GetOutputTensors = %d\n", r); return -1;
+    }
+    rt->out_ok = 1;
+    return 0;
+}
+
+static void chn_close(ipu_rt *rt)
+{
+    if (rt->in_ok)  rt->PutInputTensors(rt->chn, &rt->in);
+    if (rt->out_ok) rt->PutOutputTensors(rt->chn, &rt->out);
+    if (rt->chn_ok) rt->DestroyCHN(rt->chn);
+    rt->in_ok = rt->out_ok = rt->chn_ok = 0;
+}
+
+int ipu_rt_open(ipu_rt *rt, const char *fw, const char *model, unsigned int dynbuf)
+{
+    struct stat st;
+    int r;
+
+    memset(rt, 0, sizeof *rt);
+    rt->cache_mode = 3;     /* Invoke does not write the input back (README.md) */
+    if (stat(fw, &st)) { perror(fw); return -1; }
+    if (load_libs(rt)) return -1;
+
+    if ((r = rt->SysInit(0))) { fprintf(stderr, "ipu: MI_SYS_Init = %d\n", r); return -1; }
+    rt->sys_ok = 1;
+
+    /* The model's variable buffer sets DevAttr.maxDynBufSize: too small and
+     * Invoke fails (9), too big and it holds MMA for nothing. On drop 1230
+     * GetOfflineModeStaticInfo(readFn, path, info) reads the model header and
+     * fills a 92-byte info; word 0 is the variable buffer (0x196000 for the
+     * JL12D2 model), word 1 the model size. */
+    if (!dynbuf) {
+        int (*static_info)(MI_IPU_ReadFn, char *, unsigned int *) =
+            (int (*)(MI_IPU_ReadFn, char *, unsigned int *))dlsym(rt->h_ipu, "MI_IPU_GetOfflineModeStaticInfo");
+        unsigned int info[64];
+        memset(info, 0, sizeof info);
+        if (static_info && !static_info(read_cb, (char *)model, info) && info[0])
+            dynbuf = info[0];
+    }
+    rt->dynbuf = dynbuf ? dynbuf : 4u << 20;
+
+    MI_IPU_DevAttr dev;
+    memset(&dev, 0, sizeof dev);
+    dev.maxDynBufSize = rt->dynbuf;
+    dev.yuv420Walign = 2; dev.yuv420Halign = 2; dev.rgbWalign = 1;
+    if ((r = rt->CreateDevice(&dev, read_cb, (char *)fw, (unsigned int)st.st_size))) {
+        fprintf(stderr, "ipu: CreateDevice(%s) = %d\n", fw, r); return -1;
+    }
+    rt->dev_ok = 1;
+    rt->model = model;
+    return chn_open(rt, 1);
+}
+
+int ipu_rt_invoke(ipu_rt *rt)
+{
+    if (rt->cache_mode & 1)
+        for (unsigned i = 0; i < rt->desc.inCnt && i < 60; i++)
+            if (rt->in.tensor[i].data[0])
+                rt->FlushInvCache(rt->in.tensor[i].data[0], rt->desc.inDesc[i].bufSize);
+    int r = rt->Invoke(rt->chn, &rt->in, &rt->out);
+    if (!r && (rt->cache_mode & 2))
+        for (unsigned i = 0; i < rt->desc.outCnt && i < 60; i++)
+            if (rt->out.tensor[i].data[0])
+                rt->FlushInvCache(rt->out.tensor[i].data[0], rt->desc.outDesc[i].bufSize);
+    return r;
+}
+
+int ipu_rt_rechannel(ipu_rt *rt, unsigned int in_depth)
+{
+    chn_close(rt);
+    return chn_open(rt, in_depth);
+}
+
+void ipu_rt_close(ipu_rt *rt)
+{
+    chn_close(rt);
+    if (rt->dev_ok) rt->DestroyDevice();
+    if (rt->sys_ok) rt->SysExit(0);
+    if (rt->h_ipu)  dlclose(rt->h_ipu);
+    rt->in_ok = rt->out_ok = rt->chn_ok = rt->dev_ok = rt->sys_ok = 0;
+    rt->h_ipu = NULL;
+}
+
+static void dump1(const char *tag, unsigned i, const MI_IPU_TensorDesc *d)
+{
+    printf("%s[%u] %-28s fmt=%u dim=%u shape=[", tag, i, d->name, d->format, d->dimension);
+    for (unsigned k = 0; k < d->dimension && k < 10; k++)
+        printf(k ? ",%u" : "%u", d->shape[k]);
+    printf("] inner=%u scale=%.8g zp=%lld buf=%u abuf=%d walign=%u halign=%u nchw=%d\n",
+           d->innerMost, (double)d->scalar, d->zeroPnt, d->bufSize, d->alignedBufSize,
+           d->inWalign, d->inHalign, d->nchwModeOn);
+}
+
+void ipu_rt_dump_desc(const ipu_rt *rt)
+{
+    for (unsigned i = 0; i < rt->desc.inCnt && i < 60; i++) dump1("IN ", i, &rt->desc.inDesc[i]);
+    for (unsigned i = 0; i < rt->desc.outCnt && i < 60; i++) dump1("OUT", i, &rt->desc.outDesc[i]);
+}
+
+int ipu_rt_load_nv12(ipu_rt *rt, const unsigned char *nv12, unsigned int w, unsigned int h,
+                     int swap_uv)
+{
+    const MI_IPU_TensorDesc *d = &rt->desc.inDesc[0];
+    unsigned char *dst = rt->in.tensor[0].data[0];
+    if (!rt->desc.inCnt || !dst) return -1;
+
+    /* The input row stride: bufSize = stride * h * 3/2 for NV12. A packed
+     * 800x480 model input has bufSize 576000, so stride == w there. */
+    unsigned int stride = (unsigned int)((unsigned long long)d->bufSize * 2 / 3 / h);
+    if (stride < w) { fprintf(stderr, "ipu: input %ux%u does not fit buf %u\n", w, h, d->bufSize); return -1; }
+
+    for (unsigned y = 0; y < h; y++)
+        memcpy(dst + (size_t)y * stride, nv12 + (size_t)y * w, w);
+    unsigned char *duv = dst + (size_t)stride * h;
+    const unsigned char *suv = nv12 + (size_t)w * h;
+    for (unsigned y = 0; y < h / 2; y++) {
+        if (!swap_uv) {
+            memcpy(duv + (size_t)y * stride, suv + (size_t)y * w, w);
+        } else {
+            const unsigned char *s = suv + (size_t)y * w;
+            unsigned char *o = duv + (size_t)y * stride;
+            for (unsigned x = 0; x < w; x += 2) { o[x] = s[x + 1]; o[x + 1] = s[x]; }
+        }
+    }
+    return 0;
+}
diff --git a/package/thingino-ipud/files/ipu_rt.h b/package/thingino-ipud/files/ipu_rt.h
new file mode 100644
index 000000000..0d0e73c75
--- /dev/null
+++ b/package/thingino-ipud/files/ipu_rt.h
@@ -0,0 +1,63 @@
+/* ipu_rt.h - a thin MI_IPU runtime wrapper for Infinity6C (dlopen, one channel).
+ *
+ * Wraps the validated bring-up flow (README.md): the MI deps in global scope,
+ * MI_SYS_Init(0), CreateDevice(firmware), CreateCHN(model), GetInOutTensorDesc,
+ * GetInputTensors / GetOutputTensors once, then Invoke per frame.
+ */
+#ifndef IPU_RT_H
+#define IPU_RT_H
+
+#include "mi_ipu.h"
+
+typedef struct {
+    void *h_ipu, *h_sys;
+    fn_MI_IPU_CreateDevice       CreateDevice;
+    fn_MI_IPU_DestroyDevice      DestroyDevice;
+    fn_MI_IPU_CreateCHN          CreateCHN;
+    fn_MI_IPU_DestroyCHN         DestroyCHN;
+    fn_MI_IPU_GetInOutTensorDesc GetInOutTensorDesc;
+    fn_MI_IPU_GetInputTensors    GetInputTensors;
+    fn_MI_IPU_PutInputTensors    PutInputTensors;
+    fn_MI_IPU_GetOutputTensors   GetOutputTensors;
+    fn_MI_IPU_PutOutputTensors   PutOutputTensors;
+    fn_MI_IPU_Invoke             Invoke;
+    fn_MI_SYS_Init               SysInit;
+    fn_MI_SYS_Exit               SysExit;
+    int (*FlushInvCache)(void *va, unsigned int size);   /* 2 args on 1230 */
+
+    /* Cache maintenance around Invoke (bits): 1 = write the input tensor back
+     * before Invoke, 2 = invalidate the outputs after it. README.md says which
+     * the 1230 runtime needs. */
+    int cache_mode;
+    unsigned int dynbuf;            /* DevAttr.maxDynBufSize as used */
+    const char *model;              /* for CreateCHN's read callback */
+    unsigned int in_depth;          /* the channel's input buffer depth */
+
+    unsigned int chn;
+    MI_IPU_TensorDescSet desc;      /* ~43 KB: keep the struct off the stack */
+    MI_IPU_TensorVector in, out;
+    int sys_ok, dev_ok, chn_ok, in_ok, out_ok;
+} ipu_rt;
+
+/* dynbuf: DevAttr.maxDynBufSize, >= the model's variable buffer (0 = read it
+ * from the model header, else 4 MiB). */
+int  ipu_rt_open(ipu_rt *rt, const char *fw, const char *model, unsigned int dynbuf);
+int  ipu_rt_invoke(ipu_rt *rt);
+void ipu_rt_close(ipu_rt *rt);
+void ipu_rt_dump_desc(const ipu_rt *rt);
+
+/* Copy a packed NV12 frame (w x h, Y then interleaved UV) into input tensor 0,
+ * honouring the tensor's row alignment. swap_uv writes NV21 instead. */
+int  ipu_rt_load_nv12(ipu_rt *rt, const unsigned char *nv12, unsigned int w,
+                      unsigned int h, int swap_uv);
+
+/* Re-create the channel with input buffer depth in_depth. MI allocates the
+ * input buffer (the model's input size in MMA, 576000 B for an 800x480 NV12
+ * model) at CreateCHN, and PutInputTensors does not return it; zero copy points
+ * input tensor 0 at each frame and needs none, so it re-creates the channel
+ * with depth 0 (rt->in then holds the count and NULL buffers). Depth 1 brings
+ * the buffer back for the copy path. The output tensors are new: re-read
+ * rt->out. 0 on success; on failure the channel is gone. */
+int  ipu_rt_rechannel(ipu_rt *rt, unsigned int in_depth);
+
+#endif
diff --git a/package/thingino-ipud/files/ipucat.c b/package/thingino-ipud/files/ipucat.c
new file mode 100644
index 000000000..4987ea3ee
--- /dev/null
+++ b/package/thingino-ipud/files/ipucat.c
@@ -0,0 +1,39 @@
+/* ipucat.c - print ipud's detection stream (one JSON line per inference).
+ *
+ *   ipucat [-n lines] [socket]      (default /run/ipud.sock)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+
+int main(int argc, char **argv)
+{
+    long max = 0;
+    int opt;
+    while ((opt = getopt(argc, argv, "n:")) != -1) {
+        if (opt == 'n') max = atol(optarg);
+        else { fprintf(stderr, "usage: %s [-n lines] [socket]\n", argv[0]); return 2; }
+    }
+    const char *path = optind < argc ? argv[optind] : "/run/ipud.sock";
+    struct sockaddr_un a;
+    int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    memset(&a, 0, sizeof a);
+    a.sun_family = AF_UNIX;
+    snprintf(a.sun_path, sizeof a.sun_path, "%s", path);
+    if (fd < 0 || connect(fd, (struct sockaddr *)&a, sizeof a)) { perror(path); return 1; }
+
+    char buf[8192];
+    long lines = 0;
+    ssize_t n;
+    while ((n = read(fd, buf, sizeof buf)) > 0) {
+        fwrite(buf, 1, (size_t)n, stdout);
+        fflush(stdout);
+        for (ssize_t i = 0; i < n; i++) lines += buf[i] == '\n';
+        if (max && lines >= max) break;
+    }
+    close(fd);
+    return 0;
+}
diff --git a/package/thingino-ipud/files/ipud-frigate b/package/thingino-ipud/files/ipud-frigate
new file mode 100755
index 000000000..2c1a86302
--- /dev/null
+++ b/package/thingino-ipud/files/ipud-frigate
@@ -0,0 +1,65 @@
+#!/bin/sh
+# ipud-frigate -- Frigate events from thingino-ipud (ipud -x).
+#
+#   ipud-frigate LABEL ON    open a Frigate event for LABEL on this camera
+#   ipud-frigate LABEL OFF   end it
+#   ipud-frigate reset       end every event an earlier run left open
+#
+# ipud runs it on each presence change of a reported class. ON creates a
+# manual event through Frigate's API (POST /api/events/<camera>/<label>/create:
+# sub_label "ipud", ipud's score, no duration so it stays open, the recording
+# kept, and the class's boxes of that moment drawn on the event's snapshot,
+# from IPUD_SCORE and IPUD_DRAW); OFF ends it (PUT /api/events/<id>/end).
+# Frigate's internal port (5000) needs no login; the id of each open event is
+# kept in /run/ipud/frigate/<label>.
+#
+# Environment (S35ipud sets them from ipud.frigate_url and ipud.frigate_camera):
+#   IPUD_FRIGATE_URL      http://<frigate-host>:5000
+#   IPUD_FRIGATE_CAMERA   this camera's name in Frigate's config
+
+URL=${IPUD_FRIGATE_URL%/}
+CAM=$IPUD_FRIGATE_CAMERA
+DIR=/run/ipud/frigate
+
+log() { logger -t ipud-frigate "$*"; }
+
+[ -n "$URL" ] && [ -n "$CAM" ] || {
+	log "ipud.frigate_url or ipud.frigate_camera is not set"
+	exit 1
+}
+
+end_event() {
+	id=$(cat "$1" 2>/dev/null)
+	rm -f "$1"
+	[ -n "$id" ] || return 0
+	curl -s -m 5 -X PUT -H 'Content-Type: application/json' -d '{}' \
+		"$URL/api/events/$id/end" >/dev/null || log "ending event $id failed"
+}
+
+case "$1:$2" in
+reset:*)
+	for f in "$DIR"/*; do
+		[ -f "$f" ] && end_event "$f"
+	done
+	;;
+*:ON)
+	mkdir -p "$DIR"
+	[ -f "$DIR/$1" ] && end_event "$DIR/$1"
+	draw=${IPUD_DRAW:-'{}'}
+	body="{\"sub_label\":\"ipud\",\"score\":${IPUD_SCORE:-0},\"duration\":null,\"include_recording\":true,\"draw\":$draw}"
+	r=$(curl -s -m 5 -H 'Content-Type: application/json' -d "$body" "$URL/api/events/$CAM/$1/create")
+	id=$(printf '%s' "$r" | sed -n 's/.*"event_id": *"\([^"]*\)".*/\1/p')
+	if [ -n "$id" ]; then
+		printf '%s\n' "$id" >"$DIR/$1"
+	else
+		log "creating the $1 event failed: $r"
+	fi
+	;;
+*:OFF)
+	end_event "$DIR/$1"
+	;;
+*)
+	echo "usage: $0 LABEL ON|OFF | reset" >&2
+	exit 2
+	;;
+esac
diff --git a/package/thingino-ipud/files/ipud-ha b/package/thingino-ipud/files/ipud-ha
new file mode 100755
index 000000000..9185fd4db
--- /dev/null
+++ b/package/thingino-ipud/files/ipud-ha
@@ -0,0 +1,126 @@
+#!/bin/sh
+# shellcheck disable=SC1091,SC2153
+# ipud-ha -- Home Assistant entities for thingino-ipud, on the camera's own
+# HA device.
+#
+#   ipud-ha on REPORT LABELS   publish MQTT discovery: a binary sensor per
+#                              reported class ("Person detected", occupancy)
+#                              and an "Objects" sensor (how many, with the
+#                              boxes as attributes). REPORT and LABELS are
+#                              comma lists: ipud.report (empty: every class)
+#                              and the model's class names.
+#   ipud-ha off                clear what an earlier "on" published
+#   ipud-ha env                the broker and topic for S35ipud, as
+#                              IPUD_MQTT_*= and IPUD_HA_TOPIC= lines for eval
+#
+# It uses thingino-ha's library (/usr/share/ha-common): the camera id, the
+# broker (ha.mqtt, else mqtt_sub) and its publish helpers. The entities join
+# the device thingino-ha registers (identifiers thingino_<id>), and are
+# available while both the camera (cameras/<id>/status) and ipud
+# (cameras/<id>/ipud/status, ipud's will) are online. ipud publishes their
+# state under cameras/<id>/ipud/: <label> ON/OFF (retained) and detections
+# (one JSON line, the socket's).
+#
+# What was published is listed in /etc/ipud-ha.list, so "off" clears exactly
+# that, and a camera that never used it does no MQTT at all.
+
+HA_LIB=/usr/share/ha-common
+LIST="${IPUD_HA_LIST:-/etc/ipud-ha.list}"
+
+[ -f "$HA_LIB" ] || {
+	echo "ipud-ha: thingino-ha is not installed ($HA_LIB)" >&2
+	exit 1
+}
+. "$HA_LIB"
+
+T="cameras/${HA_CAMERA_ID}/ipud"
+
+need_broker() {
+	[ -n "$HA_MQTT_HOST" ] && return 0
+	echo "ipud-ha: no broker (ha.mqtt.host, or mqtt_sub.host)" >&2
+	return 1
+}
+
+in_list() {
+	case ",$1," in *,"$2",*) return 0 ;; esac
+	return 1
+}
+
+# The device as thingino-ha's ha-discovery describes it (name, model,
+# manufacturer from the same settings), so the entities join that device when
+# thingino-ha runs and make a properly named one when it does not.
+device_json() {
+	name=$(ha_cfg device_name)
+	name=${name:-$HA_CAMERA_HOSTNAME}
+	model=$(ha_cfg device_model)
+	[ -n "$model" ] || model=$(grep '^IMAGE_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"')
+	model=${model:-Thingino Camera}
+	printf '{"identifiers":["thingino_%s"],"name":"%s","model":"%s","manufacturer":"Thingino"}' \
+		"$HA_CAMERA_ID" "$(ha_json_escape "$name")" "$(ha_json_escape "$model")"
+}
+
+disc_on() {
+	report=$1 labels=$2
+	dev=$(device_json)
+	av="\"availability\":[{\"topic\":\"${HA_AVAIL_TOPIC}\"},{\"topic\":\"${T}/status\"}],\"availability_mode\":\"all\""
+	want=
+	ha_pub_begin
+	for l in $(echo "$labels" | tr ',' ' '); do
+		[ -n "$report" ] && ! in_list "$report" "$l" && continue
+		case "$l" in *[!a-zA-Z0-9_-]* | "") continue ;; esac
+		name=$(printf '%s' "$l" | awk '{print toupper(substr($0, 1, 1)) substr($0, 2)}')
+		ha_pub_disc binary_sensor "ipud_$l" \
+			"{\"name\":\"${name} detected\",\"unique_id\":\"thingino_${HA_CAMERA_ID}_ipud_${l}\",\"state_topic\":\"${T}/${l}\",\"payload_on\":\"ON\",\"payload_off\":\"OFF\",\"device_class\":\"occupancy\",${av},\"device\":${dev}}"
+		want="$want binary_sensor:ipud_$l"
+	done
+	ha_pub_disc sensor ipud_objects \
+		"{\"name\":\"Objects\",\"unique_id\":\"thingino_${HA_CAMERA_ID}_ipud_objects\",\"state_topic\":\"${T}/detections\",\"value_template\":\"{{ value_json.objects | count }}\",\"json_attributes_topic\":\"${T}/detections\",\"json_attributes_template\":\"{{ {'objects': value_json.objects} | tojson }}\",\"state_class\":\"measurement\",\"icon\":\"mdi:shape-outline\",${av},\"device\":${dev}}"
+	want="$want sensor:ipud_objects"
+
+	# entities of an earlier run that are not wanted now (another model, another report)
+	if [ -f "$LIST" ]; then
+		while read -r e; do
+			case " $want " in *" $e "*) ;; *) ha_clear_disc "${e%%:*}" "${e#*:}" ;; esac
+		done <"$LIST"
+	fi
+	ha_pub_flush
+	new=$(echo "$want" | tr ' ' '\n' | sed '/^$/d')
+	[ "$new" = "$(cat "$LIST" 2>/dev/null)" ] || printf '%s\n' "$new" >"$LIST"
+}
+
+disc_off() {
+	[ -f "$LIST" ] || return 0
+	ha_pub_begin
+	while read -r e; do
+		[ -n "$e" ] && ha_clear_disc "${e%%:*}" "${e#*:}"
+	done <"$LIST"
+	ha_pub_flush
+	rm -f "$LIST"
+}
+
+case "$1" in
+on)
+	need_broker || exit 1
+	disc_on "$2" "$3"
+	;;
+off)
+	[ -f "$LIST" ] || exit 0
+	need_broker || exit 1
+	disc_off
+	;;
+env)
+	need_broker || exit 1
+	[ "$HA_MQTT_SSL" = "true" ] &&
+		echo "ipud-ha: the broker uses TLS, which ipud's MQTT client does not support yet" >&2
+	echo "IPUD_MQTT_HOST=$(_sq "$HA_MQTT_HOST")"
+	echo "IPUD_MQTT_PORT=$(_sq "$HA_MQTT_PORT")"
+	echo "IPUD_MQTT_USER=$(_sq "$HA_MQTT_USER")"
+	echo "IPUD_MQTT_PASS=$(_sq "$HA_MQTT_PASS")"
+	echo "IPUD_MQTT_CLIENT_ID=$(_sq "${HA_MQTT_CLIENT_PREFIX}-ipud-${HA_CAMERA_ID}")"
+	echo "IPUD_HA_TOPIC=$(_sq "$T")"
+	;;
+*)
+	echo "usage: $0 on REPORT LABELS | off | env" >&2
+	exit 2
+	;;
+esac
diff --git a/package/thingino-ipud/files/ipud-onvif b/package/thingino-ipud/files/ipud-onvif
new file mode 100755
index 000000000..899ca766d
--- /dev/null
+++ b/package/thingino-ipud/files/ipud-onvif
@@ -0,0 +1,88 @@
+#!/bin/sh
+# ipud-onvif -- ONVIF object events for thingino-ipud.
+#
+#   ipud-onvif on GROUP...   one event per group (person, vehicle, pet) in
+#                            /etc/onvif.json; ipud events not named are dropped
+#   ipud-onvif off           drop every ipud event
+#
+# ipud -O /run/motion keeps /run/motion/ipud_<group> while any reported class
+# of the group is present; onvif_notify_server watches /run/motion and raises
+# an event while the file exists. The topics are the ones Home Assistant's
+# ONVIF integration turns into binary sensors (onvif-parsers' MyRuleDetector
+# set): Person, Vehicle and Pet Detection.
+#
+# The server takes at most 8 events, and each relay in onvif.json uses one
+# (MAX_EVENTS in thingino-onvif's utils.h): past that it refuses the whole
+# config and ONVIF stops, so a group that does not fit is skipped with a
+# warning. onvif_notify_server is restarted only when the events changed.
+
+CONF=/etc/onvif.json
+DIR=/run/motion
+MAX_EVENTS=8
+NOTIFY=/etc/init.d/S97onvif_notify
+
+topic() {
+	case "$1" in
+	person) echo "tns1:RuleEngine/MyRuleDetector/PeopleDetect" ;;
+	vehicle) echo "tns1:RuleEngine/MyRuleDetector/VehicleDetect" ;;
+	pet) echo "tns1:RuleEngine/MyRuleDetector/DogCatDetect" ;;
+	esac
+}
+
+# number of entries of a top-level array (jct prints ["$.x[0].k",...])
+count() {
+	jct "$CONF" path "\$.$1[*].$2" --mode paths 2>/dev/null | grep -o "\\\$\\.$1\\[" | wc -l
+}
+
+has() {
+	[ "$(jct "$CONF" path "\$.events[?(@.input_file == \"$DIR/ipud_$1\")]" --mode values 2>/dev/null)" != "[]" ]
+}
+
+drop() {
+	keep=$(jct "$CONF" path "\$.events[?(@.input_file != \"$DIR/ipud_$1\")]" --mode values) || return 1
+	tmp=/tmp/ipud-onvif.$$
+	printf '{"events":%s}\n' "$keep" >"$tmp" && jct "$CONF" import "$tmp" >/dev/null
+	rm -f "$tmp"
+}
+
+add() {
+	n=$(count events topic)
+	r=$(count relays token)
+	if [ $((n + r + 1)) -gt $MAX_EVENTS ]; then
+		echo "ipud-onvif: no room for the $1 event ($n events and $r relays of $MAX_EVENTS)" >&2
+		return 1
+	fi
+	jct "$CONF" set "events.$n.topic" "$(topic "$1")" >/dev/null &&
+		jct "$CONF" set "events.$n.input_file" "$DIR/ipud_$1" >/dev/null &&
+		jct "$CONF" set "events.$n.source_name" Source >/dev/null &&
+		jct "$CONF" set "events.$n.source_type" tt:ReferenceToken >/dev/null &&
+		jct "$CONF" set "events.$n.source_value" VideoSourceToken >/dev/null
+}
+
+[ -f "$CONF" ] || exit 0
+mode=$1
+[ $# -gt 0 ] && shift
+case "$mode" in
+on | off) ;;
+*)
+	echo "usage: $0 on GROUP... | off" >&2
+	exit 2
+	;;
+esac
+
+before=$(jct "$CONF" get events 2>/dev/null | md5sum)
+for g in person vehicle pet; do
+	want=
+	[ "$mode" = on ] && for w in "$@"; do [ "$w" = "$g" ] && want=1; done
+	if [ -n "$want" ]; then
+		has "$g" || add "$g"
+	else
+		has "$g" && drop "$g"
+	fi
+done
+after=$(jct "$CONF" get events 2>/dev/null | md5sum)
+
+if [ "$before" != "$after" ] && pidof onvif_notify_server >/dev/null && [ -x "$NOTIFY" ]; then
+	"$NOTIFY" restart >/dev/null 2>&1
+fi
+exit 0
diff --git a/package/thingino-ipud/files/ipud-paths b/package/thingino-ipud/files/ipud-paths
new file mode 100644
index 000000000..eb847668d
--- /dev/null
+++ b/package/thingino-ipud/files/ipud-paths
@@ -0,0 +1,89 @@
+# ipud-paths -- which IPU firmware, model and class names ipud runs with.
+# Sourced by S35ipud and /var/www/x/json-ipud.cgi, so both resolve the same way.
+#
+# ipud.source in /etc/thingino.json picks the model:
+#   builtin  /usr/share/ipud/model.img and ipu_firmware.bin, from the image (a
+#            private build stages them; a public one has none)
+#   sdcard   <ipud.sd_dir>/<ipud.sd_model> on the SD card (the first *.img there
+#            when sd_model is empty); the folder's ipu_firmware.bin if it has
+#            one, else the built-in firmware
+#   custom   the paths ipud.firmware and ipud.model
+# A config from before ipud.source that names its own ipud.model is custom.
+# Class names: a <model>.labels file beside the model (one line, comma-separated)
+# wins over ipud.labels. A key missing from thingino.json takes the package
+# default (45-ipud.json): thingino-core merges defaults only at build time.
+
+IPUD_CONFIG=${IPUD_CONFIG:-/etc/thingino.json}
+IPUD_DEFAULTS=/usr/share/thingino-defaults/45-ipud.json
+IPUD_BUILTIN=/usr/share/ipud
+
+ipud_get() {
+	_v=$(jct "$IPUD_CONFIG" get "ipud.$1" 2>/dev/null)
+	[ -n "$_v" ] || _v=$(jct "$IPUD_DEFAULTS" get "ipud.$1" 2>/dev/null)
+	printf '%s' "$_v"
+}
+
+# The *.img files of a folder, one per line.
+ipud_sd_models() {
+	[ -d "$1" ] && ls "$1" 2>/dev/null | grep '\.img$'
+}
+
+# Sets IPUD_SOURCE, IPUD_FW, IPUD_MODEL, IPUD_LABELS, IPUD_LABELS_FILE (1 when a
+# .labels file named them) and IPUD_MISSING (why it cannot run; empty if it can).
+ipud_resolve() {
+	IPUD_MISSING=
+	IPUD_FW=
+	IPUD_MODEL=
+	IPUD_SOURCE=$(jct "$IPUD_CONFIG" get ipud.source 2>/dev/null)
+	if [ -z "$IPUD_SOURCE" ]; then
+		if [ -n "$(jct "$IPUD_CONFIG" get ipud.model 2>/dev/null)" ]; then
+			IPUD_SOURCE=custom
+		else
+			IPUD_SOURCE=$(ipud_get source)
+		fi
+	fi
+	case "$IPUD_SOURCE" in
+	sdcard)
+		_d=$(ipud_get sd_dir)
+		_m=$(ipud_get sd_model)
+		if [ -z "$_d" ] || [ ! -d "$_d" ]; then
+			IPUD_MISSING="SD card folder ${_d:-(none set)} not found"
+		else
+			[ -n "$_m" ] || _m=$(ipud_sd_models "$_d" | head -n 1)
+			if [ -z "$_m" ]; then
+				IPUD_MISSING="no model (.img) in $_d"
+			else
+				IPUD_MODEL="$_d/$_m"
+			fi
+		fi
+		IPUD_FW="$_d/ipu_firmware.bin"
+		[ -f "$IPUD_FW" ] || IPUD_FW="$IPUD_BUILTIN/ipu_firmware.bin"
+		;;
+	custom)
+		IPUD_FW=$(ipud_get firmware)
+		IPUD_MODEL=$(ipud_get model)
+		[ -n "$IPUD_MODEL" ] || IPUD_MISSING="no model path set"
+		[ -n "$IPUD_FW" ] || IPUD_FW="$IPUD_BUILTIN/ipu_firmware.bin"
+		;;
+	*)
+		IPUD_SOURCE=builtin
+		IPUD_FW="$IPUD_BUILTIN/ipu_firmware.bin"
+		IPUD_MODEL="$IPUD_BUILTIN/model.img"
+		[ -f "$IPUD_MODEL" ] || IPUD_MISSING="this image has no built-in model"
+		;;
+	esac
+	if [ -z "$IPUD_MISSING" ]; then
+		if [ ! -f "$IPUD_MODEL" ]; then
+			IPUD_MISSING="model $IPUD_MODEL not found"
+		elif [ ! -f "$IPUD_FW" ]; then
+			IPUD_MISSING="IPU firmware $IPUD_FW not found"
+		fi
+	fi
+	IPUD_LABELS=
+	IPUD_LABELS_FILE=0
+	if [ -n "$IPUD_MODEL" ] && [ -f "${IPUD_MODEL%.*}.labels" ]; then
+		IPUD_LABELS=$(head -n 1 "${IPUD_MODEL%.*}.labels" | tr -d ' \r')
+		[ -n "$IPUD_LABELS" ] && IPUD_LABELS_FILE=1
+	fi
+	[ -n "$IPUD_LABELS" ] || IPUD_LABELS=$(ipud_get labels)
+}
diff --git a/package/thingino-ipud/files/ipud.c b/package/thingino-ipud/files/ipud.c
new file mode 100644
index 000000000..e03747a90
--- /dev/null
+++ b/package/thingino-ipud/files/ipud.c
@@ -0,0 +1,799 @@
+/* ipud.c - on-camera YOLO detection on the Infinity6C IPU.
+ *
+ * Frames come from a spare SCL output port at the model's input size (NV12,
+ * scl_src.c), run through MI_IPU (ipu_rt.c), and are decoded (yolo.c). Results
+ * go to up to four sinks:
+ *   status  a JSON file rewritten at most once a second (the WebUI reads it)
+ *   socket  a UNIX stream socket: one JSON line per inference to every client,
+ *           for low-latency local consumers (a PTZ tracker)
+ *   mqtt    <topic>/status online/offline, <topic>/<label> ON/OFF on presence
+ *           change (retained), <topic>/detections JSON while objects are present
+ *   onvif   (-O dir) one file per object group while present, for
+ *           onvif_notify_server's events (ipud-onvif maps them to topics)
+ * Box coordinates are normalised to the full frame (the SCL port scales the
+ * whole sensor image, so they map onto every stream).
+ *
+ * MQTT broker settings come from the environment (the init script reads them
+ * from /etc/send2.json): IPUD_MQTT_HOST, _PORT, _USER, _PASS, _CLIENT_ID.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <time.h>
+#include <unistd.h>
+#include <dlfcn.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include "ipu_rt.h"
+#include "scl_src.h"
+#include "yolo.h"
+
+#define MAX_DET     64
+#define MAX_CLASSES 16
+#define MAX_CLIENTS 4
+
+static volatile sig_atomic_t g_stop;
+static int g_verbose, g_foreground;
+
+static void lg(int pri, const char *fmt, ...)
+{
+    va_list ap;
+    if (pri == LOG_DEBUG && !g_verbose) return;
+    va_start(ap, fmt);
+    if (g_foreground) { vfprintf(stderr, fmt, ap); fputc('\n', stderr); }
+    else vsyslog(pri, fmt, ap);
+    va_end(ap);
+}
+
+static double now_ms(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1e3 + t.tv_nsec / 1e6;
+}
+
+static void on_signal(int sig) { (void)sig; g_stop = 1; }
+
+static void write_status(const char *path, const char *json);
+
+/* ---------------------------------------------------------------- config */
+
+typedef struct {
+    const char *fw, *model, *status_path, *sock_path, *topic, *save_frame, *ev_dir, *hook;
+    char labels[MAX_CLASSES][24];
+    int nlabels;
+    unsigned keep;                  /* bitmask of reported classes; 0 = all */
+    float conf, iou, max_fps;
+    int port, max_infer, print, zero_copy, depth;
+    int hold_ms, mqtt_min_ms, status_ms;
+} cfg_t;
+
+static int label_index(const cfg_t *c, const char *name)
+{
+    for (int i = 0; i < c->nlabels; i++) if (!strcmp(c->labels[i], name)) return i;
+    return -1;
+}
+
+static void parse_labels(cfg_t *c, const char *s)
+{
+    c->nlabels = 0;
+    while (*s && c->nlabels < MAX_CLASSES) {
+        size_t n = strcspn(s, ",");
+        snprintf(c->labels[c->nlabels++], sizeof c->labels[0], "%.*s", (int)n, s);
+        s += n + (s[n] == ',');
+    }
+}
+
+/* The classes to report. A name the model does not have is skipped with a
+ * warning (the setting outlives a model swap); none matching reports all. */
+static void parse_keep(cfg_t *c, const char *s);
+
+/* ---------------------------------------------------------------- mqtt (dlopen libmosquitto) */
+
+typedef struct {
+    void *h, *m;
+    int (*lib_init)(void);
+    void *(*new_)(const char *, int, void *);
+    int (*pw)(void *, const char *, const char *);
+    int (*will)(void *, const char *, int, const void *, int, int);
+    int (*connect)(void *, const char *, int, int);
+    int (*reconnect)(void *);
+    int (*publish)(void *, int *, const char *, int, const void *, int, int);
+    int (*loop)(void *, int, int);
+    const char *host;
+    int port, up;
+    double next_try;
+    char topic[128];
+} mqtt_t;
+
+static int mqtt_init(mqtt_t *q, const char *topic)
+{
+    memset(q, 0, sizeof q[0]);
+    q->host = getenv("IPUD_MQTT_HOST");
+    if (!topic || !*topic || !q->host || !*q->host) return 0;
+    q->port = getenv("IPUD_MQTT_PORT") ? atoi(getenv("IPUD_MQTT_PORT")) : 1883;
+    snprintf(q->topic, sizeof q->topic, "%s", topic);
+    if (!(q->h = dlopen("libmosquitto.so.1", RTLD_NOW))) {
+        lg(LOG_WARNING, "mqtt: %s; MQTT off", dlerror());
+        return 0;
+    }
+#define MQ(f, s) if (!(*(void **)&q->f = dlsym(q->h, s))) { lg(LOG_WARNING, "mqtt: no %s", s); return 0; }
+    MQ(lib_init, "mosquitto_lib_init"); MQ(new_, "mosquitto_new");
+    MQ(pw, "mosquitto_username_pw_set"); MQ(will, "mosquitto_will_set");
+    MQ(connect, "mosquitto_connect"); MQ(reconnect, "mosquitto_reconnect");
+    MQ(publish, "mosquitto_publish"); MQ(loop, "mosquitto_loop");
+#undef MQ
+    q->lib_init();
+    const char *id = getenv("IPUD_MQTT_CLIENT_ID");
+    char idbuf[64];
+    if (!id || !*id) {
+        char hn[40] = "cam";
+        gethostname(hn, sizeof hn - 1);
+        snprintf(idbuf, sizeof idbuf, "ipud-%s", hn);
+        id = idbuf;
+    }
+    if (!(q->m = q->new_(id, 1, NULL))) { lg(LOG_WARNING, "mqtt: mosquitto_new failed"); return 0; }
+    const char *u = getenv("IPUD_MQTT_USER"), *p = getenv("IPUD_MQTT_PASS");
+    if (u && *u) q->pw(q->m, u, p && *p ? p : NULL);
+    char t[160];
+    snprintf(t, sizeof t, "%s/status", q->topic);
+    q->will(q->m, t, 7, "offline", 1, 1);
+    return 1;
+}
+
+static void mqtt_pub(mqtt_t *q, const char *sub, const char *payload, int retain)
+{
+    char t[192];
+    if (!q->up) return;
+    snprintf(t, sizeof t, "%s/%s", q->topic, sub);
+    if (q->publish(q->m, NULL, t, (int)strlen(payload), payload, 0, retain)) q->up = 0;
+}
+
+/* 1 when it has just (re)connected: the caller then republishes its state,
+ * which may differ from what a previous run left retained */
+static int mqtt_service(mqtt_t *q, double now)
+{
+    int fresh = 0;
+    if (!q->m) return 0;
+    if (!q->up) {
+        if (now < q->next_try) return 0;
+        int first = q->next_try == 0;
+        int r = first ? q->connect(q->m, q->host, q->port, 30) : q->reconnect(q->m);
+        q->next_try = now + 15000;
+        if (r) { lg(LOG_DEBUG, "mqtt: connect %s:%d = %d", q->host, q->port, r); return 0; }
+        q->up = fresh = 1;
+        lg(LOG_INFO, "mqtt: connected to %s:%d, topic %s", q->host, q->port, q->topic);
+        mqtt_pub(q, "status", "online", 1);
+    }
+    if (q->loop(q->m, 0, 1)) q->up = 0;
+    return fresh;
+}
+
+/* ---------------------------------------------------------------- socket */
+
+typedef struct { int lfd, cfd[MAX_CLIENTS]; } sock_t;
+
+static int sock_init(sock_t *s, const char *path)
+{
+    struct sockaddr_un a;
+    s->lfd = -1;
+    for (int i = 0; i < MAX_CLIENTS; i++) s->cfd[i] = -1;
+    if (!path || !*path) return 0;
+    unlink(path);
+    if ((s->lfd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0)) < 0) return -1;
+    memset(&a, 0, sizeof a);
+    a.sun_family = AF_UNIX;
+    snprintf(a.sun_path, sizeof a.sun_path, "%s", path);
+    if (bind(s->lfd, (struct sockaddr *)&a, sizeof a) || listen(s->lfd, MAX_CLIENTS)) {
+        lg(LOG_WARNING, "socket %s: %s", path, strerror(errno));
+        close(s->lfd);
+        s->lfd = -1;
+        return -1;
+    }
+    return 0;
+}
+
+static void sock_send(sock_t *s, const char *line, size_t n)
+{
+    if (s->lfd < 0) return;
+    int c;
+    while ((c = accept4(s->lfd, NULL, NULL, SOCK_NONBLOCK | SOCK_CLOEXEC)) >= 0) {
+        int i;
+        for (i = 0; i < MAX_CLIENTS && s->cfd[i] >= 0; i++) ;
+        if (i == MAX_CLIENTS) close(c); else s->cfd[i] = c;
+    }
+    for (int i = 0; i < MAX_CLIENTS; i++)
+        if (s->cfd[i] >= 0 && send(s->cfd[i], line, n, MSG_NOSIGNAL) != (ssize_t)n) {
+            close(s->cfd[i]);          /* gone, or too slow to keep up: drop it */
+            s->cfd[i] = -1;
+        }
+}
+
+/* ---------------------------------------------------------------- ONVIF event files */
+
+/* -O dir: one file per object group in dir (/run/motion, which
+ * onvif_notify_server watches), there while any reported class of the group
+ * is present. The server raises an event when a file appears and clears it
+ * when it goes; ipud-onvif maps each file to a topic in /etc/onvif.json. The
+ * file is created empty and never written: a write would send the event
+ * again. */
+static const struct { const char *file, *members; } GROUPS[] = {
+    { "ipud_person",  "person" },
+    { "ipud_vehicle", "bicycle,car,motorcycle,bus,truck" },
+    { "ipud_pet",     "cat,dog" },
+};
+#define NGROUPS (int)(sizeof GROUPS / sizeof GROUPS[0])
+
+typedef struct { const char *dir; unsigned mask[NGROUPS]; int on[NGROUPS]; } evfiles_t;
+
+static int in_list(const char *list, const char *name)
+{
+    size_t n = strlen(name);
+    for (const char *p = list; *p; p += strcspn(p, ",") + (p[strcspn(p, ",")] == ',')) {
+        if (strcspn(p, ",") == n && !strncmp(p, name, n)) return 1;
+    }
+    return 0;
+}
+
+static void evfile_set(const evfiles_t *e, int g, int on)
+{
+    char path[256];
+    snprintf(path, sizeof path, "%s/%s", e->dir, GROUPS[g].file);
+    if (on) {
+        int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0644);
+        if (fd >= 0) close(fd);
+        else if (errno != EEXIST) lg(LOG_WARNING, "event file %s: %s", path, strerror(errno));
+    } else if (unlink(path) && errno != ENOENT) {
+        lg(LOG_WARNING, "event file %s: %s", path, strerror(errno));
+    }
+}
+
+static void evfiles_init(evfiles_t *e, const char *dir, const char labels[][24], int nlabels)
+{
+    memset(e, 0, sizeof *e);
+    e->dir = dir;
+    if (!dir) return;
+    mkdir(dir, 0755);
+    for (int g = 0; g < NGROUPS; g++) {
+        for (int k = 0; k < nlabels; k++)
+            if (in_list(GROUPS[g].members, labels[k])) e->mask[g] |= 1u << k;
+        evfile_set(e, g, 0);                /* a crash may have left one behind */
+    }
+}
+
+/* present: bit k set while class k is present (after the hold) */
+static void evfiles_update(evfiles_t *e, unsigned present)
+{
+    if (!e->dir) return;
+    for (int g = 0; g < NGROUPS; g++) {
+        int on = (present & e->mask[g]) != 0;
+        if (on != e->on[g]) {
+            e->on[g] = on;
+            evfile_set(e, g, on);
+            lg(LOG_INFO, "ONVIF %s %s", GROUPS[g].file + 5, on ? "ON" : "OFF");
+        }
+    }
+}
+
+static void evfiles_clear(evfiles_t *e)
+{
+    if (!e->dir) return;
+    for (int g = 0; g < NGROUPS; g++) evfile_set(e, g, 0);
+}
+
+/* ---------------------------------------------------------------- presence hook */
+
+/* -x cmd: run "cmd <label> ON|OFF" on each presence change of a reported
+ * class, in the background, with IPUD_SCORE (the best score of the class in
+ * this inference, 0-1) and IPUD_DRAW (Frigate's manual-event draw object:
+ * {"boxes":[{"box":[x,y,w,h],"score":<percent>}]}, fractions of the frame)
+ * in its environment. ipud-frigate opens and ends a Frigate event with it. */
+static void run_hook(const char *hook, const char *label, int on, const yolo_det *d, int n,
+                     int cls, float iw, float ih)
+{
+    char score[32], draw[1024];
+    float best = 0;
+    size_t o = (size_t)snprintf(draw, sizeof draw, "{\"boxes\":[");
+    int first = 1;
+    for (int i = 0; i < n && on; i++) {
+        if (d[i].cls != cls) continue;
+        float x0 = d[i].x0 / iw, y0 = d[i].y0 / ih, x1 = d[i].x1 / iw, y1 = d[i].y1 / ih;
+        x0 = x0 < 0 ? 0 : x0; y0 = y0 < 0 ? 0 : y0; x1 = x1 > 1 ? 1 : x1; y1 = y1 > 1 ? 1 : y1;
+        if (d[i].score > best) best = d[i].score;
+        if (o < sizeof draw)
+            o += (size_t)snprintf(draw + o, sizeof draw - o, "%s{\"box\":[%.4f,%.4f,%.4f,%.4f],\"score\":%d}",
+                                  first ? "" : ",", (double)x0, (double)y0, (double)(x1 - x0),
+                                  (double)(y1 - y0), (int)(d[i].score * 100 + 0.5f));
+        first = 0;
+    }
+    if (o + 3 >= sizeof draw) o = (size_t)snprintf(draw, sizeof draw, "{\"boxes\":[");   /* too many: none */
+    snprintf(draw + o, sizeof draw - o, "]}");
+    snprintf(score, sizeof score, "%.3f", (double)best);
+
+    pid_t p = fork();
+    if (p == 0) {
+        setenv("IPUD_SCORE", score, 1);
+        setenv("IPUD_DRAW", draw, 1);
+        execl(hook, hook, label, on ? "ON" : "OFF", (char *)NULL);
+        _exit(127);
+    }
+    if (p < 0) lg(LOG_WARNING, "hook %s: fork: %s", hook, strerror(errno));
+}
+
+/* ---------------------------------------------------------------- output */
+
+static size_t objects_json(char *b, size_t cap, const cfg_t *c, const yolo_det *d, int n,
+                           float iw, float ih)
+{
+    size_t o = 0;
+    o += (size_t)snprintf(b + o, cap - o, "[");
+    for (int i = 0; i < n && o < cap; i++) {
+        float x0 = d[i].x0 / iw, y0 = d[i].y0 / ih, x1 = d[i].x1 / iw, y1 = d[i].y1 / ih;
+        x0 = x0 < 0 ? 0 : x0; y0 = y0 < 0 ? 0 : y0; x1 = x1 > 1 ? 1 : x1; y1 = y1 > 1 ? 1 : y1;
+        o += (size_t)snprintf(b + o, cap - o, "%s{\"label\":\"%s\",\"score\":%.3f,\"box\":[%.4f,%.4f,%.4f,%.4f]}",
+                              i ? "," : "", c->labels[d[i].cls], (double)d[i].score,
+                              (double)x0, (double)y0, (double)x1, (double)y1);
+    }
+    if (o < cap) o += (size_t)snprintf(b + o, cap - o, "]");
+    return o < cap ? o : cap - 1;
+}
+
+static void write_status(const char *path, const char *json)
+{
+    char tmp[256];
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    FILE *f = fopen(tmp, "w");
+    if (!f) return;
+    fputs(json, f);
+    fclose(f);
+    rename(tmp, path);
+}
+
+static void parse_keep(cfg_t *c, const char *s)
+{
+    int matched = 0;
+    c->keep = 0;
+    while (*s) {
+        char name[24];
+        size_t n = strcspn(s, ",");
+        snprintf(name, sizeof name, "%.*s", (int)n, s);
+        int k = label_index(c, name);
+        if (k < 0) {
+            if (*name) lg(LOG_WARNING, "report: the model has no class '%s'; skipped", name);
+        } else {
+            c->keep |= 1u << k;
+            matched++;
+        }
+        s += n + (s[n] == ',');
+    }
+    if (!matched && c->keep == 0) lg(LOG_WARNING, "report: no listed class is in this model; reporting every class");
+}
+
+/* A start-up failure, said where the web UI looks, then the exit code. */
+static int fail(const cfg_t *c, const char *reason)
+{
+    char st[512];
+    lg(LOG_ERR, "%s", reason);
+    if (c->status_path) {
+        snprintf(st, sizeof st, "{\"running\":false,\"reason\":\"%s\"}\n", reason);
+        write_status(c->status_path, st);
+    }
+    return 1;
+}
+
+/* ---------------------------------------------------------------- IPU helpers */
+
+/* The decoder reads the output tensors in place; they move when the channel
+ * is re-created. */
+static void bind_heads(yolo_head *h, int nh, const ipu_rt *rt)
+{
+    for (int k = 0; k < nh; k++) h[k].data = rt->out.tensor[k].data[0];
+}
+
+static size_t out_size(const ipu_rt *rt)
+{
+    size_t n = 0;
+    for (unsigned k = 0; k < rt->desc.outCnt; k++) n += rt->desc.outDesc[k].bufSize;
+    return n;
+}
+
+static void out_copy(const ipu_rt *rt, unsigned char *dst)
+{
+    for (unsigned k = 0; k < rt->desc.outCnt; k++) {
+        memcpy(dst, rt->out.tensor[k].data[0], rt->desc.outDesc[k].bufSize);
+        dst += rt->desc.outDesc[k].bufSize;
+    }
+}
+
+static long out_diff(const ipu_rt *rt, const unsigned char *ref)
+{
+    long diff = 0;
+    if (!ref) return -1;
+    for (unsigned k = 0; k < rt->desc.outCnt; k++) {
+        const unsigned char *o = rt->out.tensor[k].data[0];
+        for (unsigned b = 0; b < rt->desc.outDesc[k].bufSize; b++) diff += ref[b] != o[b];
+        ref += rt->desc.outDesc[k].bufSize;
+    }
+    return diff;
+}
+
+/* Invoke on the SCL frame in place: mode 1 hands the IPU plane 0 only (Y and
+ * UV contiguous), mode 2 both planes. */
+static int invoke_zc(ipu_rt *rt, const scl_frame *fr, int mode)
+{
+    MI_IPU_Tensor keep = rt->in.tensor[0];
+    rt->in.tensor[0].data[0] = fr->y;
+    rt->in.tensor[0].phyAddr[0] = fr->phy_y;
+    if (mode == 2) { rt->in.tensor[0].data[1] = fr->uv; rt->in.tensor[0].phyAddr[1] = fr->phy_uv; }
+    int r = ipu_rt_invoke(rt);
+    rt->in.tensor[0] = keep;
+    return r;
+}
+
+/* ---------------------------------------------------------------- main */
+
+static void usage(const char *a0)
+{
+    fprintf(stderr,
+        "usage: %s -f ipu_firmware.bin -m model.img [options]\n"
+        "  -L labels   class names in model order (person,bicycle,car,motorcycle,bus,truck)\n"
+        "  -k labels   report only these (default all)\n"
+        "  -c score    threshold (0.40)       -i iou      NMS IoU (0.45)\n"
+        "  -r fps      max inferences/s (0 = every frame)\n"
+        "  -p port     SCL output port (-1 = highest free, default)\n"
+        "  -D n        SCL port user depth; MI keeps n+1 frames of the model's size\n"
+        "              (default 1 for a cap of 12/s or less, else 2)\n"
+        "  -s path     status JSON (/run/ipud/status.json)  -S path  socket (/run/ipud.sock)\n"
+        "  -I ms       status rewrite interval (1000)\n"
+        "  -q topic    MQTT base topic (broker from IPUD_MQTT_*)\n"
+        "  -H ms       presence hold before OFF (3000)  -M ms  min MQTT detections interval (500)\n"
+        "  -O dir      ONVIF event files: dir/ipud_person, ipud_vehicle, ipud_pet while present\n"
+        "  -x cmd      run 'cmd LABEL ON|OFF' on each presence change (IPUD_SCORE, IPUD_DRAW)\n"
+        "  -Z          zero-copy: feed the SCL buffer to the IPU directly (self-tested first)\n"
+        "  -n N        stop after N inferences      -t  print each inference\n"
+        "  -o file     save one live NV12 frame (after the 10th inference)\n"
+        "  -F          foreground, log to stderr    -v  verbose\n", a0);
+}
+
+int main(int argc, char **argv)
+{
+    static ipu_rt rt;
+    scl_src src;
+    sock_t sk;
+    mqtt_t mq;
+    cfg_t c;
+    int opt;
+
+    memset(&c, 0, sizeof c);
+    c.conf = 0.40f; c.iou = 0.45f; c.port = -1;
+    c.hold_ms = 3000; c.mqtt_min_ms = 500; c.status_ms = 1000;
+    c.status_path = "/run/ipud/status.json"; c.sock_path = "/run/ipud.sock";
+    parse_labels(&c, "person,bicycle,car,motorcycle,bus,truck");
+    const char *keep = NULL;
+
+    while ((opt = getopt(argc, argv, "f:m:L:k:c:i:r:p:D:s:S:I:q:H:M:O:x:Zn:to:Fvh")) != -1) {
+        switch (opt) {
+        case 'f': c.fw = optarg; break;
+        case 'm': c.model = optarg; break;
+        case 'L': parse_labels(&c, optarg); break;
+        case 'k': keep = optarg; break;
+        case 'c': c.conf = strtof(optarg, NULL); break;
+        case 'i': c.iou = strtof(optarg, NULL); break;
+        case 'r': c.max_fps = strtof(optarg, NULL); break;
+        case 'p': c.port = atoi(optarg); break;
+        case 'D': c.depth = atoi(optarg) < 1 ? 1 : atoi(optarg); break;
+        case 's': c.status_path = optarg; break;
+        case 'S': c.sock_path = optarg; break;
+        case 'I': c.status_ms = atoi(optarg); break;
+        case 'q': c.topic = optarg; break;
+        case 'H': c.hold_ms = atoi(optarg); break;
+        case 'M': c.mqtt_min_ms = atoi(optarg); break;
+        case 'O': c.ev_dir = *optarg ? optarg : NULL; break;
+        case 'x': c.hook = *optarg ? optarg : NULL; break;
+        case 'Z': c.zero_copy = 1; break;
+        case 'n': c.max_infer = atoi(optarg); break;
+        case 't': c.print = 1; break;
+        case 'o': c.save_frame = optarg; break;
+        case 'F': g_foreground = 1; break;
+        case 'v': g_verbose = 1; break;
+        default: usage(argv[0]); return 2;
+        }
+    }
+    if (!c.fw || !c.model) { usage(argv[0]); return 2; }
+    /* Each SCL port frame is the model's input size in MMA (576000 B at
+     * 800x480). Depth 1 (two frames) keeps up with a 10/s cap; full rate
+     * needs depth 2 (three): with one frame held through Invoke and one
+     * queued, depth 1 ran 15/s against 24.7/s (an MC-A85, 2026-11-10). */
+    if (!c.depth) c.depth = c.max_fps > 0 && c.max_fps <= 12 ? 1 : 2;
+    if (c.status_path && !*c.status_path) c.status_path = NULL;     /* -s '' : no status file */
+    if (!g_foreground) openlog("ipud", LOG_PID, LOG_DAEMON);
+    if (c.status_path) {
+        char dir[200];
+        snprintf(dir, sizeof dir, "%s", c.status_path);
+        char *sl = strrchr(dir, '/');
+        if (sl) { *sl = 0; mkdir(dir, 0755); }
+    }
+
+    signal(SIGINT, on_signal);
+    signal(SIGTERM, on_signal);
+    signal(SIGPIPE, SIG_IGN);
+    signal(SIGCHLD, SIG_IGN);           /* hook runs reap themselves */
+
+    if (ipu_rt_open(&rt, c.fw, c.model, 0)) {
+        ipu_rt_close(&rt);
+        return fail(&c, "the IPU refused the firmware or the model (a model built for another SGS release?)");
+    }
+    const MI_IPU_TensorDesc *in = &rt.desc.inDesc[0];
+    unsigned in_h = in->shape[1], in_w = in->shape[2];
+    int nh = (int)rt.desc.outCnt;
+    yolo_head heads[3];
+    if (in->format != 1 || nh < 1 || nh > 3) {
+        lg(LOG_ERR, "model: want an NV12 input and 1-3 anchor-based heads (fmt %u, %d outputs)", in->format, nh);
+        ipu_rt_close(&rt);
+        return fail(&c, "the model is not an NV12 YOLO model with 1-3 heads");
+    }
+    for (int k = 0; k < nh; k++) {
+        const MI_IPU_TensorDesc *d = &rt.desc.outDesc[k];
+        yolo_head *h = &heads[k];
+        memset(h, 0, sizeof *h);
+        if (d->dimension != 5) { ipu_rt_close(&rt); return fail(&c, "the model's heads are not anchor-based [1,na,H,W,5+nc]"); }
+        h->data = rt.out.tensor[k].data[0];
+        h->elem = 2;
+        h->na = (int)d->shape[1]; h->h = (int)d->shape[2]; h->w = (int)d->shape[3]; h->nch = (int)d->shape[4];
+        h->inner = (int)(d->bufSize / (unsigned)(h->na * h->h * h->w * h->elem));
+        h->scale = d->scalar; h->zp = d->zeroPnt;
+        h->stride = (int)in_w / h->w;
+        int lvl = h->stride == 8 ? 0 : h->stride == 16 ? 1 : 2;
+        memcpy(h->anchors, yolo_v5_default_anchors[lvl], sizeof h->anchors);
+        if (h->inner < h->nch || h->nch - 5 > MAX_CLASSES) { ipu_rt_close(&rt); return fail(&c, "the model's head geometry is not supported"); }
+    }
+    for (int k = c.nlabels; k < heads[0].nch - 5; k++) snprintf(c.labels[k], sizeof c.labels[0], "c%d", k);
+    if (c.nlabels < heads[0].nch - 5) c.nlabels = heads[0].nch - 5;
+    if (keep) parse_keep(&c, keep);
+    lg(LOG_INFO, "model %s: %ux%u NV12 in, %d heads, %d classes, variable buffer %u B",
+       c.model, in_w, in_h, nh, heads[0].nch - 5, rt.dynbuf);
+    lg(LOG_DEBUG, "input tensor va %p/%p pa 0x%llx/0x%llx", rt.in.tensor[0].data[0], rt.in.tensor[0].data[1],
+       rt.in.tensor[0].phyAddr[0], rt.in.tensor[0].phyAddr[1]);
+
+    if (scl_src_load(&src)) { ipu_rt_close(&rt); return fail(&c, "the MI SCL library could not be loaded"); }
+    sock_init(&sk, c.sock_path);
+    mqtt_init(&mq, c.topic);
+    evfiles_t ev;
+    evfiles_init(&ev, c.ev_dir, (const char (*)[24])c.labels, c.nlabels);
+
+    const char *fatal = NULL;
+    yolo_params yp = { c.conf, c.iou, 0, 0 };
+    yolo_det det[MAX_DET], rep[MAX_DET];
+    double next_due = 0, last_status = 0, last_mqtt = 0, seen[MAX_CLASSES] = { 0 }, retry_at = 0;
+    int present[MAX_CLASSES] = { 0 }, port = -1, timeouts = 0, zc = 0, zc_tested = 0, mq_had = 0, mq_resync = 0;
+    long n_infer = 0, n_frames = 0, n_drop = 0;
+    double t_inv = 0, t_dec = 0, t_win = now_ms();
+    long win_n = 0;
+    float fps = 0, inv_ms = 0, dec_ms = 0;
+    char line[4096], objs[3500];
+
+    while (!g_stop) {
+        double now = now_ms();
+        if (mqtt_service(&mq, now)) mq_resync = 1;
+
+        if (port < 0) {
+            if (now < retry_at) { usleep(200000); continue; }
+            port = scl_src_open(&src, c.port, in_w, in_h, (unsigned)c.depth);
+            if (port < 0) { retry_at = now + 3000; continue; }
+            lg(LOG_INFO, "frames from SCL port %d, %ux%u NV12", port, in_w, in_h);
+            timeouts = 0;
+        }
+
+        scl_frame fr;
+        int r = scl_src_get(&src, &fr, 1000);
+        if (r && g_stop) break;
+        if (r) {
+            if (r < 0 || ++timeouts >= 5) {
+                lg(LOG_WARNING, "SCL port %d stopped delivering (raptor restart?); reopening", port);
+                scl_src_close(&src);
+                port = -1;
+                retry_at = now_ms() + 2000;
+            }
+            continue;
+        }
+        timeouts = 0;
+        n_frames++;
+        /* A running deadline, not "too soon since the last one": with frames
+         * every 40 ms the latter takes every third frame for a 10/s cap
+         * (8.3/s); the deadline alternates two and three and averages 10. */
+        if (c.max_fps > 0) {
+            double period = 1000.0 / c.max_fps;
+            if (now < next_due - 5) {
+                scl_src_put(&src, &fr);
+                n_drop++;
+                continue;
+            }
+            next_due = next_due + period > now - period ? next_due + period : now + period;
+        }
+
+        if (c.save_frame && n_infer == 10) {
+            FILE *f = fopen(c.save_frame, "wb");
+            if (f) {
+                for (unsigned y = 0; y < in_h; y++) fwrite(fr.y + (size_t)y * fr.stride_y, 1, in_w, f);
+                for (unsigned y = 0; y < in_h / 2; y++) fwrite(fr.uv + (size_t)y * fr.stride_uv, 1, in_w, f);
+                fclose(f);
+                lg(LOG_INFO, "saved frame %ld to %s", n_infer, c.save_frame);
+            }
+        }
+
+        /* Zero-copy needs a packed frame. On the first frame run both paths and
+         * keep zero-copy only if the outputs are byte-identical. */
+        int packed = fr.stride_y == in_w && fr.stride_uv == in_w;
+        int contig = packed && fr.uv == fr.y + (size_t)in_w * in_h &&
+                     fr.phy_uv == fr.phy_y + (unsigned long long)in_w * in_h;
+        double t0 = now_ms();
+        if (c.zero_copy && packed && !zc_tested) {
+            /* mode 1: plane 0 only, the frame's Y and UV contiguous (the model's
+             * input tensor is one plane: data[1] is NULL); mode 2: both planes */
+            zc_tested = 1;
+            size_t tot = out_size(&rt);
+            unsigned char *ref = malloc(tot);
+            ipu_rt_load_nv12(&rt, fr.y, in_w, in_h, 0);   /* fr is packed: plain copy */
+            int r0 = ipu_rt_invoke(&rt);
+            if (ref) out_copy(&rt, ref);
+            for (int mode = 1; mode <= 3 && ref && !r0 && !zc; mode++) {
+                if (mode == 1 && !contig) continue;
+                int r2;
+                if (mode == 3) {                      /* control: the copy path again */
+                    ipu_rt_load_nv12(&rt, fr.y, in_w, in_h, 0);
+                    r2 = ipu_rt_invoke(&rt);
+                } else {
+                    r2 = invoke_zc(&rt, &fr, mode);
+                }
+                long diff = out_diff(&rt, ref);
+                lg(LOG_INFO, "zero-copy self-test mode %d (%s): Invoke=%d, %ld of %zu output bytes differ",
+                   mode, mode == 1 ? "plane 0" : mode == 2 ? "two planes" : "copy control", r2, diff, tot);
+                if (!r2 && !diff && mode < 3) zc = mode;
+            }
+            /* MI allocates the input buffer with the channel and holds it until
+             * the channel goes (PutInputTensors keeps it). Zero copy never uses
+             * it: re-create the channel without one, and check the new channel
+             * on this same frame before trusting it. */
+            if (zc) {
+                long diff = -1;
+                int r2 = ipu_rt_rechannel(&rt, 0);
+                if (!r2) {
+                    bind_heads(heads, nh, &rt);
+                    if (!(r2 = invoke_zc(&rt, &fr, zc))) diff = out_diff(&rt, ref);
+                }
+                lg(LOG_INFO, "zero-copy self-test without an input buffer: Invoke=%d, %ld of %zu output bytes differ",
+                   r2, diff, tot);
+                if (!r2 && !diff) {
+                    lg(LOG_INFO, "input buffer dropped (%u B of MMA)", rt.desc.inDesc[0].bufSize);
+                } else if (ipu_rt_rechannel(&rt, 1)) {
+                    fatal = "the IPU channel could not be re-created";
+                } else {
+                    bind_heads(heads, nh, &rt);
+                }
+            }
+            free(ref);
+            if (fatal) { scl_src_put(&src, &fr); break; }
+            lg(LOG_INFO, "input path: %s", zc ? (zc == 1 ? "zero-copy, plane 0" : "zero-copy, two planes") : "copy");
+        }
+        if (zc && !(packed && (zc == 2 || contig))) {
+            /* the port's layout changed under us: back to the copy path for good */
+            zc = 0;
+            lg(LOG_WARNING, "frame not packed (stride %u/%u); input path: copy", fr.stride_y, fr.stride_uv);
+            if (!rt.in_depth) {
+                if (ipu_rt_rechannel(&rt, 1)) {
+                    fatal = "the IPU channel could not be re-created";
+                    scl_src_put(&src, &fr);
+                    break;
+                }
+                bind_heads(heads, nh, &rt);
+            }
+        }
+        if (zc) {
+            r = invoke_zc(&rt, &fr, zc);
+            scl_src_put(&src, &fr);
+        } else {
+            /* the frame rows may be padded: copy row by row via a packed view */
+            if (packed) {
+                ipu_rt_load_nv12(&rt, fr.y, in_w, in_h, 0);
+            } else {
+                unsigned char *dst = rt.in.tensor[0].data[0];
+                for (unsigned y = 0; y < in_h; y++) memcpy(dst + (size_t)y * in_w, fr.y + (size_t)y * fr.stride_y, in_w);
+                dst += (size_t)in_w * in_h;
+                for (unsigned y = 0; y < in_h / 2; y++) memcpy(dst + (size_t)y * in_w, fr.uv + (size_t)y * fr.stride_uv, in_w);
+            }
+            scl_src_put(&src, &fr);
+            r = ipu_rt_invoke(&rt);
+        }
+        double t1 = now_ms();
+        if (r) { lg(LOG_ERR, "Invoke = %d", r); usleep(100000); continue; }
+        int n = yolo_v5_decode(heads, nh, &yp, det, MAX_DET);
+        double t2 = now_ms();
+        n_infer++; win_n++;
+        t_inv += t1 - t0; t_dec += t2 - t1;
+
+        int nr = 0;
+        for (int i = 0; i < n; i++)
+            if (det[i].cls < c.nlabels && (!c.keep || (c.keep >> det[i].cls) & 1)) rep[nr++] = det[i];
+
+        if (t2 - t_win >= 2000) {
+            fps = (float)(win_n * 1000.0 / (t2 - t_win));
+            inv_ms = (float)(t_inv / win_n); dec_ms = (float)(t_dec / win_n);
+            win_n = 0; t_inv = t_dec = 0; t_win = t2;
+        }
+
+        size_t ol = objects_json(objs, sizeof objs, &c, rep, nr, (float)in_w, (float)in_h);
+        int ll = snprintf(line, sizeof line, "{\"n\":%ld,\"pts\":%llu,\"ms\":%.1f,\"objects\":%.*s}\n",
+                          n_infer, fr.pts, t2 - t0, (int)ol, objs);
+        if (ll > 0 && (size_t)ll < sizeof line) sock_send(&sk, line, (size_t)ll);
+        if (c.print) fputs(line, stdout), fflush(stdout);
+
+        /* presence per label, with a hold so a missed frame does not flap */
+        for (int i = 0; i < nr; i++) seen[rep[i].cls] = t2;
+        unsigned pmask = 0;
+        for (int k = 0; k < c.nlabels; k++) {
+            int on = seen[k] > 0 && t2 - seen[k] < c.hold_ms;
+            if (on != present[k]) {
+                present[k] = on;
+                lg(LOG_INFO, "%s %s", c.labels[k], on ? "ON" : "OFF");
+                mqtt_pub(&mq, c.labels[k], on ? "ON" : "OFF", 1);
+                if (c.hook) run_hook(c.hook, c.labels[k], on, rep, nr, k, (float)in_w, (float)in_h);
+            }
+            if (on) pmask |= 1u << k;
+        }
+        evfiles_update(&ev, pmask);
+        /* after a (re)connect: every reported class's state, retained, over
+         * what an earlier run left; and one detections line on the next
+         * empty frame, so a consumer's count is right too */
+        if (mq_resync && mq.up) {
+            for (int k = 0; k < c.nlabels; k++)
+                if (!c.keep || (c.keep >> k) & 1) mqtt_pub(&mq, c.labels[k], present[k] ? "ON" : "OFF", 1);
+            mq_had = 1;
+            mq_resync = 0;
+        }
+        /* while objects are present at most every mqtt_min_ms, and one line
+         * with no objects once they are gone, so a consumer's count drops */
+        if ((nr && t2 - last_mqtt >= c.mqtt_min_ms) || (!nr && mq_had)) {
+            last_mqtt = t2;
+            mq_had = nr > 0;
+            if (ll > 0 && (size_t)ll < sizeof line) { line[ll - 1] = 0; mqtt_pub(&mq, "detections", line, 0); }
+        }
+
+        if (c.status_path && t2 - last_status >= c.status_ms) {
+            last_status = t2;
+            char st[4096];
+            time_t wall = time(NULL);
+            snprintf(st, sizeof st,
+                     "{\"running\":true,\"time\":%ld,\"model\":\"%s\",\"input\":[%u,%u],\"port\":%d,"
+                     "\"zero_copy\":%s,\"fps\":%.1f,\"invoke_ms\":%.1f,\"decode_ms\":%.2f,"
+                     "\"inferences\":%ld,\"frames\":%ld,\"skipped\":%ld,\"mqtt\":%s,\"objects\":%.*s}\n",
+                     (long)wall, c.model, in_w, in_h, port, zc ? "true" : "false", (double)fps,
+                     (double)inv_ms, (double)dec_ms, n_infer, n_frames, n_drop,
+                     mq.up ? "true" : "false", (int)ol, objs);
+            write_status(c.status_path, st);
+            lg(LOG_DEBUG, "fps %.1f invoke %.1f ms decode %.2f ms objects %d", (double)fps, (double)inv_ms, (double)dec_ms, nr);
+        }
+        if (c.max_infer && n_infer >= c.max_infer) break;
+    }
+
+    lg(LOG_INFO, "stopping after %ld inferences", n_infer);
+    if (c.status_path) write_status(c.status_path, "{\"running\":false}\n");
+    evfiles_clear(&ev);
+    for (int k = 0; k < c.nlabels; k++)
+        if (present[k]) {
+            mqtt_pub(&mq, c.labels[k], "OFF", 1);
+            if (c.hook) run_hook(c.hook, c.labels[k], 0, NULL, 0, k, 1, 1);
+        }
+    mqtt_pub(&mq, "status", "offline", 1);
+    if (mq.up) mq.loop(mq.m, 100, 1);
+    if (port >= 0) scl_src_close(&src);
+    if (sk.lfd >= 0) { close(sk.lfd); unlink(c.sock_path); }
+    ipu_rt_close(&rt);
+    return fatal ? fail(&c, fatal) : 0;
+}
