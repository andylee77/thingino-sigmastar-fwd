index 000000000..ffc85284b
--- /dev/null
+++ b/board/sigmastar/infinity6c/patches/linux/0002-ARM-dts-infinity6c-add-the-JL12D2-module.patch
@@ -0,0 +1,162 @@
+From: Andy <andylee77@users.noreply.github.com>
+Subject: [PATCH] ARM: dts: infinity6c: add the Anjvision MCL12D2 / JL12D2 module
+
+Generated from infinity6c-ssc377d-anjvision.dtsi, infinity6c-ssc377d-jl12d2.dts by gen-board-dts-patch.sh (auto hunk count).
+
+---
+--- /dev/null
++++ b/arch/arm/boot/dts/infinity6c-ssc377d-anjvision.dtsi
+@@ -0,0 +1,102 @@
++/*
++ * infinity6c-ssc377d-anjvision.dtsi - the Anjvision SSC377D module board
++ *
++ * The board wiring two Anjvision SSC377D (Infinity6C) modules share: the
++ * MCL12D2 / Jennov JL12D2 PTZ (Sony IMX335) and the YMF46D / Anpviz
++ * IPC-B8A63WD-S bullet (GalaxyCore GC4653). Both OEM device trees (stock
++ * flash dumps) carry the same 15 padmux triplets, only reordered, and
++ * byte-identical csi/vif sr0 properties; everything else that differs is the
++ * BSP (2023-06 on the YMF46D, 2024-12 on the JL12D2). Each board's .dts
++ * includes this file and adds its model string and its lights: the pads of
++ * its LED banks and Ethernet LED, and the frame-sync PWM those depend on.
++ * The padmux schematic is one property, so a board's schematic lists its
++ * light pads and ends with ANJV_SSC377D_PADMUX, the shared lines below.
++ *
++ * This program is free software; you can redistribute it and/or modify it
++ * under the terms of the GNU General Public License version 2, as published
++ * by the Free Software Foundation.
++ *
++ * Shared padmux: the 2-wire FUART (ttyS2; the JL12D2's Pelco-D lens board),
++ * the sensor on I2C1, and a microSD slot (SDIO1).
++ *
++ * Sensor MIPI (sr0), from the OEM device tree. The SSC027D base is the eval
++ * board's wiring and is wrong here in three properties:
++ *   - csi_sr0_lane_pn_swap: the eval board swaps every lane's P/N, this PCB
++ *     does not. With the base value the D-PHY never sees a start of
++ *     transmission -- every CSI counter stays at 0 and the VIF never gets a
++ *     frame start.
++ *   - vif_sr0_mipi_rst_mode: the IMX335 XCLR is on PAD_SR_IO16 (SR00_RST
++ *     mode 3). The base's mode 1 drives PAD_SR_IO13 instead and never resets
++ *     the sensor.
++ *   - vif_sr0_mipi_pdn_mode: the IMX335 has no power-down pin; the base's
++ *     mode 1 drives PAD_SR_IO12 for nothing.
++ * Verified on the JL12D2 bench unit (2026-10-25) by patching these three in
++ * the live tree before the first mi.ko insmod: CSI traffic with no ECC/CRC
++ * errors, VIF frame starts at 25 fps, Recv_size 2616x1964 (identical to the
++ * stock OEM firmware), and the full pipeline streaming H.264 1080p25 +
++ * 360p25. lane_num, lane_select, mipi_mode/ctrl_mode/mclk_mode and
++ * mclk_37p125 already match the OEM and are left alone.
++ *
++ * microSD: one slot, on SDIO IP 1 and pad set 1, card detect on PAD_PM_SD_CDZ
++ * (0x16) and power on PAD_FUART_RTS (0x2d) -- the padmux's SDIO1 lines. The
++ * base node is the eval board's two slots, the first on IP 0 with detect and
++ * power on pads 0x06 / 0x21, which this board does not wire that way. Both
++ * the JL12D2's and the YMF46D's OEM trees say the same. Verified on the
++ * YMF46D bench unit (2026-10-25) with these values patched into the live
++ * tree before the module load: the host comes up on IP 1's interrupt (86)
++ * with slot 1's card-detect (184), probing exactly as the OEM does.
++ *
++ * Earlier attempts at these same values were blamed for "bricking" the
++ * board. They did not: the image's fw_env.config pointed fw_setenv at mtd1,
++ * which is the kernel on this layout, so S97sysupgrade overwrote the uImage
++ * header on the first boot after each flash (fixed in the camera overlay).
++ *
++ * core_power is left as the SSC027D base has it: a 1-bit VID on PAD_PM_GPIO8
++ * (900 / 1000 mV). Both OEM trees name the SSC027A-S01A reference board and
++ * have no core_power node; that reference puts the VID on PAD_PM_GPIO4, and
++ * the YMF46D's OEM app drives gpio 30 (PAD_PM_GPIO4) high when it raises the
++ * CPU to 1 GHz. Which pin the core regulator reads is not measured yet, so
++ * this file does not change it.
++ */
++
++#include "infinity6c-ssc027d-s01a.dts"
++
++#define ANJV_SSC377D_PADMUX \
++	/* 2-wire FUART -> ttyS2 (the JL12D2's PTZ lens/motor board) */ \
++	<PAD_FUART_RX    PINMUX_FOR_FUART_2W_MODE_1    MDRV_PUSE_FUART_RX>, \
++	<PAD_FUART_TX    PINMUX_FOR_FUART_2W_MODE_1    MDRV_PUSE_FUART_TX>, \
++	/* sensor I2C (adapter 1) */ \
++	<PAD_I2C1_SCL    PINMUX_FOR_I2C1_MODE_1        MDRV_PUSE_I2C1_SCL>, \
++	<PAD_I2C1_SDA    PINMUX_FOR_I2C1_MODE_1        MDRV_PUSE_I2C1_SDA>, \
++	/* microSD slot (SDIO1 on the SD0 pads) */ \
++	<PAD_SD_D1       PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_D1>, \
++	<PAD_SD_D0       PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_D0>, \
++	<PAD_SD_CLK      PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_CLK>, \
++	<PAD_SD_CMD      PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_CMD>, \
++	<PAD_SD_D3       PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_D3>, \
++	<PAD_SD_D2       PINMUX_FOR_SD0_MODE_1         MDRV_PUSE_SDIO1_D2>, \
++	<PAD_FUART_RTS   PINMUX_FOR_GPIO_MODE          MDRV_PUSE_SDIO1_PWR>, \
++	<PAD_PM_SD_CDZ   PINMUX_FOR_SD0_CDZ_MODE_1     MDRV_PUSE_SDIO1_CDZ>
++
++/ {
++	soc {
++		/* One microSD slot on SDIO IP 1 (see above); the per-slot arrays keep
++		 * the base's three cells, only the first is read. */
++		sdmmc {
++			slotnum = <1>;
++			slot-ip-orders = <1 1 2>;
++			slot-pad-orders = <1 1 2>;
++			slot-cdzs-pad = <0x16 0x16 0x16>;
++			slot-pwr-pad = <0x2d 0x2d 0x2d>;
++		};
++	};
++};
++
++&csi {
++	csi_sr0_lane_pn_swap = <0x00 0x00 0x00 0x00 0x00>;
++};
++
++&vif {
++	vif_sr0_mipi_rst_mode = <0x03>;
++	vif_sr0_mipi_pdn_mode = <0x00>;
++};
+--- /dev/null
++++ b/arch/arm/boot/dts/infinity6c-ssc377d-jl12d2.dts
+@@ -0,0 +1,48 @@
++/*
++ * infinity6c-ssc377d-jl12d2.dts - Anjvision MCL12D2 / Jennov JL12D2 PTZ module
++ *
++ * SigmaStar SSC377D (Infinity6C) + Sony IMX335 (MIPI), 16 MB SPI NOR, 128 MB
++ * DDR. A 20x-zoom pan/tilt dome whose pan/tilt/zoom/focus is a Pelco-D
++ * lens/motor controller on the FUART. Sold as the Jennov JL12D2.
++ *
++ * This program is free software; you can redistribute it and/or modify it
++ * under the terms of the GNU General Public License version 2, as published
++ * by the Free Software Foundation.
++ *
++ * The board wiring it shares with the YMF46D (FUART, sensor MIPI and I2C,
++ * microSD) is in infinity6c-ssc377d-anjvision.dtsi. This file has the model
++ * string and the lights, decoded from this unit's OEM device tree (a stock
++ * flash dump): two LED banks (PAD_PWM0, PAD_SPI0_CZ) and ETH1_LED on
++ * PAD_PWM1.
++ *
++ * One deliberate difference from the OEM padmux: on this single-sensor board
++ * infinity6c.dtsi still enables the dual-sensor frame-sync wave on PWM0
++ * (vif_ds_rt_pwm_sync = <1>, pin <0>). We keep sync = <1> -- forcing it to 0
++ * left the ISP IQ semaphore uninitialised and crashed rvd on the MC-A85 -- so
++ * instead move the wave to the unconnected PWM2 (vif_ds_rt_pwm_pin = <2>, in
++ * &vif below). That frees PWM0 so PAD_PWM0 carries the white LED bank on PWM0,
++ * exactly as the OEM device tree does.
++ */
++
++#include "infinity6c-ssc377d-anjvision.dtsi"
++
++/ {
++	model = "Anjvision MCL12D2 / Jennov JL12D2 (SSC377D + IMX335)";
++
++	soc {
++		padmux {
++			schematic =
++				<GPIO_NR         PINMUX_FOR_UNKNOWN_MODE       MDRV_PUSE_NA>,
++				/* LED banks; PAD_PWM0 on PWM0 (OEM routing); frame-sync moved off PWM0 in &vif */
++				<PAD_PWM0        PINMUX_FOR_PWM0_MODE_1        MDRV_PUSE_PWM0>,
++				<PAD_SPI0_CZ     PINMUX_FOR_PWM4_MODE_2        MDRV_PUSE_PWM4>,
++				/* Ethernet activity LED */
++				<PAD_PWM1        PINMUX_FOR_LED1_MODE_2        MDRV_PUSE_ETH1_LED>,
++				ANJV_SSC377D_PADMUX;
++		};
++	};
++};
++
++&vif {
++	vif_ds_rt_pwm_pin = <0x02>;	/* frame-sync off PWM0 -> unconnected PWM2, freeing PWM0 for the white LED */
++};
diff --git a/configs/cameras/mcl12d2_ssc377d_imx335/mcl12d2_ssc377d_imx335.kernel.config b/configs/cameras/mcl12d2_ssc377d_imx335/mcl12d2_ssc377d_imx335.kernel.config
new file mode 100644
index 000000000..12ddee535
--- /dev/null
+++ b/configs/cameras/mcl12d2_ssc377d_imx335/mcl12d2_ssc377d_imx335.kernel.config
@@ -0,0 +1,42 @@
+# Kernel config fragment for the Anjvision MCL12D2 / Jennov JL12D2
+# (mcl12d2_ssc377d_imx335), merged over
+# board/sigmastar/infinity6c/kernel/5.10/infinity6c.config.
+#
+# Same approach as the MC-A85 fragment: boot under the OEM U-Boot (the
+# ANJOY888 .bin install keeps it) and force the kernel command line, because this
+# kernel names the NOR device NOR_FLASH (the vendor BSP said nor0), uses /init
+# (there is no /linuxrc), and wants the overlay partition as lowercase "data".
+# Our fdt.c puts CONFIG_CMDLINE before the bootloader's, so FORCE is required.
+#
+# The memory split is THIS board's, read from a running OEM kernel
+# (/proc/cmdline): LX_MEM=0x8000000 (128 MB) and a 71 MB MMA (sz=0x4750000).
+# /proc/iomem agrees: System RAM 0x20000000-0x238affff and the MMA heap at
+# 0x238b0000 end exactly at 0x28000000. The OEM 5 MP pipeline holds 55 MB of
+# that heap (high-water ~71 MB), so a smaller heap cannot run it. Do not take
+# the split from the bootargs strings in boot.bin: those are U-Boot's built-in
+# defaults (LX_MEM=4000000, sz=0x1c00000); the bootargs it actually boots with
+# are built at run time from ${mem_lx}/${mem_mma}.
+# Partition offsets are identical to the MC-A85 and to the dump:
+#   nor0:0x30000(BOOT),0x200000(kernel),0xCD0000(rootfs),0x100000(DATA)
+CONFIG_CMDLINE="console=ttyS0,115200 panic=20 root=/dev/mtdblock2 rootfstype=squashfs ro init=/init mtdparts=NOR_FLASH:0x30000(BOOT),0x200000(kernel),0xCD0000(rootfs),0x100000(data) LX_MEM=0x8000000 mma_heap=mma_heap_name0,miu=0,sz=0x4750000 mma_memblock_remove=1 cma=2M"
+CONFIG_CMDLINE_FORCE=y
+# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
+# CONFIG_CMDLINE_EXTEND is not set
+
+# JL12D2 board device tree (patch 0002), decoded from this unit's OEM device
+# tree (a stock flash dump): PWM0 + PWM4 LED banks, ETH1_LED on PAD_PWM1, the Pelco-D
+# lens UART on the 2-wire FUART (ttyS2), the IMX335 on I2C1, and a microSD slot.
+# Ethernet comes from the base dtsi's emac0, which is byte-identical to the OEM's
+# (internal MII PHY), so first boot should reach the network. This is a FIRST
+# DRAFT: validate it on the bench over UART before flashing a mounted unit
+# (sensor/video and the LED pads are the likely iteration points).
+CONFIG_SS_DTB_NAME="infinity6c-ssc377d-jl12d2"
+
+# microSD (one slot on SDIO IP 1, the board DTS's sdmmc node). Modules, not
+# built in, as the OEM loads kdrv_sdmmc.ko: a probe that goes wrong then
+# cannot stop the boot or the network. exFAT for cards over 32 GB. Same
+# lines as the YMF46D, whose board wiring this is.
+CONFIG_MMC=m
+CONFIG_MMC_BLOCK=m
+CONFIG_MS_SDMMC=m
+CONFIG_EXFAT_FS=m
diff --git a/configs/cameras/mcl12d2_ssc377d_imx335/mcl12d2_ssc377d_imx335_defconfig b/configs/cameras/mcl12d2_ssc377d_imx335/mcl12d2_ssc377d_imx335_defconfig
new file mode 100644
index 000000000..51ae58a93
--- /dev/null
+++ b/configs/cameras/mcl12d2_ssc377d_imx335/mcl12d2_ssc377d_imx335_defconfig
@@ -0,0 +1,216 @@
+# NAME: Anjvision MCL12D2 / Jennov JL12D2 (UVision L12D2) — SSC377D, Infinity6C, IMX335
+#
+# Streams on the bench unit (2026-10-25): H.264 2592x1944 + 1280x960 @ 25 fps
+# from a cold boot. A second Infinity6C target, cloned from johnchia's
+# noname_ssc377qe_imx335 (thingino-firmware@sigmastar-6b0-platform).
+#
+# Board:  SigmaStar SSC027A-S01A reference design, die SSC377D (Infinity6C).
+#         UVision L12D2 module, sold as Anjvision MCL12D2 / Jennov JL12D2.
+# Sensor: Sony IMX335, MIPI 2-lane — same sensor as the SSC377QE target.
+# Flash:  16 MB SPI NOR (15.5 MB usable). CPU: ARMv7-A / Cortex-A7 (see
+#         infinity6c.mk — built v7 despite the ARMv8 die).
+#
+# Differs from noname_ssc377qe_imx335 only in the SoC model: ssc377d (128 MB)
+# vs ssc377qe (256 MB). infinity6c.mk already covers ssc377d in its family
+# filter, and the kernel command line is forced per board (the fragment), so
+# the family kernel + U-Boot serve this part unchanged. The memory split is the
+# OEM's running one, LX_MEM=0x8000000 + a 71 MB MMA (sz=0x4750000), read from
+# a stock unit's /proc/cmdline -- not the 64 MB / 28 MB default strings in boot.bin.
+#
+# MI drop: infinity6c.mk selects SIGMASTAR_DROP := 1230 (ships prebuilt imx335
+# AND imx307 drivers; the prebuilt imx335 is the one installed, over the
+# source-built one every board's sensor-src build also makes). That is
+# johnchia's set, proven on SSC377QE. The OEM unit is NOT on plain 0907: its
+# /config/modules/5.10 is release_0907 (project 3a7aec9 / sdk 3dcd67a / mhal
+# a7acd5c) with vendor hotfix builds of mi_sys (2022-11-10), mi_scl
+# (2022-12-19), mi_isp + mi_ldc (2023-04-18) and mi_sensor (2023-05-16), and
+# Anjvision's own imx335_MIPI_2lane.ko (2024-10-12, lane_num=2). The 0907 set
+# in sigmastar-sdk/sigmastar-lib is the unpatched release, so it is not the
+# OEM's stack either. None of that matters in practice: 1230 streams on this
+# board once the device tree and memory split are the board's own.
+#
+# ISP tuning: there is no OEM IMX335 tuning to harvest -- the stock firmware
+# runs the IMX335 on the IMX307's (iqfile0-3 -> imx307_iqfile.bin). With
+# BR2_SENSOR_1_IQ_FILE unset, sigmastar-sdk installs its own IMX335 tuning for
+# drop 1230 (infinity6c/sensor-iq/1230/imx335.bin) as usr/share/sensor/imx335.bin.
+# CONTRACT-NA: BR2_SENSOR_1_IQ_FILE no OEM IMX335 tuning; the build ships the SDK's drop-1230 imx335.bin
+#
+# No UART was needed: the board networks before the camera stack starts, and
+# the sensor path was brought up over SSH. The D7 5-pin connector is the PTZ
+# lens/motor board (FUART, ttyS2), not a console; the console UART is on pads
+# next to the SoC. Shares its SoC enablement with the SSC377QE target.
+# FRAG: soc-sigmastar core-sigmastar
+
+# board.mk includes this file as a makefile before thingino.mk runs, so the
+# vendor/model are readable there and drive SOC_VENDOR / SOC_MODEL / SOC_FAMILY
+# / SOC_ARCH / SOC_CPU / KERNEL_VERSION.
+BR2_SOC_VENDOR_SIGMASTAR=y
+BR2_SIGMASTAR_SOC_MODEL="ssc377d"
+
+# Driver is prebuilt in the 1230 drop; no imx335.bin ships (see header). The
+# sensor-src build every board runs adds the other sensors' drivers; the
+# drop's prebuilt imx335 is the one installed.
+BR2_SENSOR_1_NAME="imx335"
+BR2_SIGMASTAR_SENSOR_SOURCE=y
+
+FLASH_SIZE_MB=16
+
+# Wired Ethernet: installs the eth0 DHCP stanza (thingino-ethernet). The board
+# device tree must also declare the Ethernet PHY -- see the kernel fragment's
+# TODO; the reference DTB does not, so this stanza alone is not enough to get a
+# link on the real board.
+BR2_ETHERNET=y
+
+# Force the kernel command line (OEM U-Boot layout + this board's memory split).
+# See the fragment; it also documents the board-DTS work that gates first boot.
+BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THINGINO_PATH)/configs/cameras/mcl12d2_ssc377d_imx335/mcl12d2_ssc377d_imx335.kernel.config"
+
+# Toolchain — identical to the Infinity6E/6C targets. A generic
+# arm-thingino-linux-uclibcgnueabihf; Cortex-A35 runs the same aarch32 code,
+# and nothing in it is 6E-specific. uClibc (not glibc): every libmi_*.so in the
+# hardware's vendor drop is NEEDED libc.so.0, which no glibc rootfs satisfies.
+# This matches our own OEM toolchain reference (arm-sigmastar-...-uclibcgnueabihf
+# 9.1.0). Re-pointed here because the toolchain fragment is resolved from
+# TYPE/GCC/LIBC alone, with no architecture in it, so the appended default is
+# thingino's mipsel one; the camera defconfig is appended after the fragments,
+# so these win.
+BR2_THINGINO_TOOLCHAIN_LIBC_UCLIBC=y
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
+BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
+BR2_TOOLCHAIN_EXTERNAL_URL="file://$(HOME)/src/mirrors/releases/johnchia__thingino-firmware/toolchain-x86_64/thingino-toolchain-x86_64_infinity6e_uclibc_gcc16-linux-arm.tar.gz"
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-thingino-linux-uclibcgnueabihf"
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM_UCLIBC=y
+BR2_TOOLCHAIN_EXTERNAL_GCC_16=y
+BR2_TOOLCHAIN_EXTERNAL_CXX=y
+BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
+BR2_TOOLCHAIN_EXTERNAL_LOCALE=y
+BR2_TOOLCHAIN_EXTERNAL_HAS_THREADS_DEBUG=y
+# Vendor blobs need __stack_chk_fail, so the producer builds uClibc with SSP and
+# Buildroot requires this stated for an external toolchain.
+BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
+# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
+# Toolchain is built against 4.9 headers regardless of the 5.10 kernel; headers
+# older than the kernel is the supported direction.
+BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
+
+# Build U-Boot. sigmastar-uboot is already family-generic (configures
+# $(SOC_FAMILY)_defconfig, passes the model as -DPRODUCT_SOC) and OpenIPC's tree
+# carries infinity6c_defconfig + ipl/infinity6c + the GCIS-at-36k NOR branch, so
+# ssc377d needs no package change. NB: producing BOOT.bin is not flashing it —
+# on this board mtd0 is the one place a bad write cannot be undone in software.
+BR2_PACKAGE_SIGMASTAR_UBOOT=y
+
+BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_THINGINO_PATH)/board/sigmastar/post-image.sh"
+
+# Gates the camera stack in Config.soc.in; pulls in raptor/raptor-common/
+# raptor-hal by default (INFINITY6C is a raptor-hal platform).
+BR2_THINGINO_DEV_IPCAM=y
+
+BR2_PACKAGE_DROPBEAR=y
+
+# No VPN: core-sigmastar.fragment selects WireGuard, but thingino-vpn selects
+# the out-of-tree wireguard-linux-compat under a guard (KERNEL_VERSION_7) that
+# is undefined and always reads n, so it tries to build the compat module on
+# this 5.10 kernel where WireGuard is already mainline and it does not compile.
+# A select cannot be declined by a defconfig, so choose None.
+BR2_PACKAGE_THINGINO_VPN_NONE=y
+
+# The external toolchain's bundled libz is not copied to target; anything
+# linking -lz needs a real target zlib.
+BR2_PACKAGE_ZLIB=y
+
+# Upstream rvd reads the sensor's name and I2C address from /proc/jz/sensor, an
+# Ingenic driver node, and will not start without them, so on SigmaStar they
+# come from [sensor]. 7-bit address, raptor.conf's convention (the driver's
+# 8-bit slave is 0x34); the Infinity6C backend does not use it.
+
+# ---- STREAMS / OSD: native 4:3 in the 71 MB MMA ----
+# The IMX335 is 2592x1944 (4:3) and the Infinity6C backend scales the whole
+# frame to the stream size with no crop, so rvd's 1920x1080 / 640x360 default
+# squashes the picture by a third. Both streams are 4:3 instead. raptor makes
+# one JPEG encoder per stream at that stream's size; a 5 MP JPEG on the main
+# leaves ~6 MB of MMA, so the main runs without one and snapshots/MJPEG come
+# off the 1280x960 sub, as on the MC-A85. Verified on the bench unit
+# (2026-10-25): ch0 H.264 2592x1944 @ 25, ch1 H.264 1280x960 @ 25, snapshot
+# 1280x960, ~28 MB MMA free, no allocation failures. OSD is timestamp-only,
+# matching the MC-A85.
+# Rates as on a JL12D2 in service since 2026-10-26:
+# sensor and both streams at 20 fps (the sub's rate must divide the main's,
+# fwd 0070), 1 s GOPs, main CBR 3 Mbit/s capped at 4 (open item 3's CBR
+# choice), sub VBR 1 Mbit/s capped at 1.5.
+
+# ---- RTSP ----
+# Four clients is not enough: Frigate holds two (main + sub), an NVR two
+# more, and a live view or snapshot client then gets refused (as on the
+# YMF46D).
+
+# ---- WEBUI STREAM CHOICES ----
+# 4:3 sizes only (the backend scales without cropping); the sub is a cascade
+# off the main and cannot be larger. Every 5 fps up to the IMX335's 25 (the
+# bench unit ran 25, 2026-10-25): the main's rate sets the sensor's, and the
+# sub offers only rates that divide the main's.
+BR2_PACKAGE_THINGINO_RAPTOR_UI_STREAM0_RESOLUTIONS="2592x1944 2048x1536"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_STREAM1_RESOLUTIONS="640x480 800x600 1280x960"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_FPS="5 10 15 20 25"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_STREAM0_BITRATES="1000 2000 3000 4000 6000 8000"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_STREAM1_BITRATES="256 512 768 1000 1500 2000 3000"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_CODECS="h264 h265"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_PROFILES="baseline main high"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_RC_MODES="cbr vbr capped_vbr"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_GOP_SECONDS="1 2 4"
+BR2_PACKAGE_THINGINO_RAPTOR_UI_JPEG_QUALITIES="50 60 75 85 95"
+# The quarter-frame SCL->VENC ring, the HAL's default, written out: it has run
+# this profile's 5 MP main and 1280x960 sub for days without an encoder wedge.
+# The YMF46D's whole-frame ring with a 720p sub is where the encoder wedged.
+BR2_PACKAGE_THINGINO_RAPTOR_SCL_RING_DIV="4"
+
+# ---- LENS / PTZ BOARD ----
+# The zoom/focus board on D7 (ttyS2) focuses only while the SoC streams it the
+# AF frame every video frame; lensd does that and takes PTZ commands. Started
+# after raptor (S33), it waits for rvd's ISP channel. No vendor wake-up
+# sequence is sent: autofocus works without it from a cold power-on (bench,
+# 2026-10-25). The head also moves the IR-cut filter, from the frame's
+# day/night byte (see DAY / NIGHT).
+BR2_PACKAGE_THINGINO_LENSD_MODE_AF=y
+# Its measured motion (package/thingino-lensd/files/heads/ys183.conf), which
+# ONVIF RelativeMove (Frigate autotracking) needs.
+BR2_PACKAGE_THINGINO_LENSD_HEAD="ys183"
+
+# ---- AUDIO ----
+# One AI device on the SSC377D (as on the YMF46D); rad's default device 1 does
+# not exist. Off, as a deployed unit runs it; flip to TRUE to use the mic.
+
+# ---- MICRO SD ----
+# MMC core, block, the SigmaStar SDIO driver and exFAT are kernel modules
+# (see the kernel fragment), loaded at S11 from overlay/etc/modules.d/sdcard;
+# thingino's mdev rule mounts each partition at /mnt/<dev>. The slot is SDIO
+# IP 1 (the sdmmc node of the board include it shares with the YMF46D, from
+# the OEM tree; the YMF46D has this board's wiring and was verified with a
+# card). The mdev handler is BR2_PACKAGE_THINGINO_SYSTEM_AUTOMOUNT, which every board ships
+# (core-sigmastar.fragment); BR2_THINGINO_SDCARD would pull in the Ingenic MMC
+# kernel options and U-Boot SD settings instead.
+# OVERLAY-HW: etc/modules.d/sdcard the microSD slot's modules, the same on every board with the slot
+
+# ---- DAY / NIGHT + IR/WHITE LEDS ----
+# Ported from the B8A63 (ymf46d_ssc377d_gc4653), which shares this board's
+# wiring (infinity6c-ssc377d-anjvision.dtsi). ric's day line is gpio_ircut (80),
+# its night line gpio_ircut2 (11), as on the B8A63, where they drive the
+# IR-cut coil. On this PTZ they reach no coil (the D5 IR-cut header is
+# unpopulated): the integrated lens head moves its own filter from byte 11 of
+# the AF frame, as the OEM's comm_server sends it. lensd reads ric's two pins
+# (S33lensd passes them from raptor.conf) and sets that byte, so the filter
+# follows ric. Without it the filter stays in its power-on (night / out)
+# position and daylight IR makes the picture pink. Trigger is luma (ric has no
+# GPIO trigger for the OEM's IRDET on GPIO 23 -- an R/G-ratio trigger is a
+# possible later refinement). Same ladder/gains as the siblings; retune at dusk
+# if needed. The OEM-reference IR-cut RE note has the evidence.
+#
+# LEDs: IR on PWM4 (PAD_SPI0_CZ), white on PWM0 (PAD_PWM0, PINMUX_FOR_PWM0_MODE_1,
+# the OEM routing; the board DTB moves the sensor's frame-sync wave to the
+# unconnected PWM2, which used to strobe this bank on PWM0). Which bank is which
+# was measured on the bench from the AE (2026-10-25). sigmastar-light sets the
+# channels up before raptor (S30light) and is the web UI's light CLI.
+BR2_PACKAGE_SIGMASTAR_LIGHT_IR_PWM=4
+BR2_PACKAGE_SIGMASTAR_LIGHT_WHITE_PWM=0
+
+# 50 Hz mains anti-flicker, as on both sibling profiles.
diff --git a/configs/cameras/mcl12d2_ssc377d_imx335/overlay/etc/modules.d/sdcard b/configs/cameras/mcl12d2_ssc377d_imx335/overlay/etc/modules.d/sdcard
new file mode 100644
index 000000000..4f75b6c17
--- /dev/null
+++ b/configs/cameras/mcl12d2_ssc377d_imx335/overlay/etc/modules.d/sdcard
@@ -0,0 +1,5 @@
+# microSD: the SigmaStar SDIO driver (pulls in mmc_core), the block
+# layer, and exFAT for cards over 32 GB. See the camera defconfig.
+kdrv_sdmmc
+mmc_block
+exfat
