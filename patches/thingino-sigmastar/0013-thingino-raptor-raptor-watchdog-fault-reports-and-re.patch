diff --git a/package/thingino-raptor/files/S34raptor-watchdog b/package/thingino-raptor/files/S34raptor-watchdog
new file mode 100755
index 000000000..eff877f27
--- /dev/null
+++ b/package/thingino-raptor/files/S34raptor-watchdog
@@ -0,0 +1,39 @@
+#!/bin/sh
+# S34raptor-watchdog -- start/stop the video pipeline watchdog: fault reports
+# in /root/raptor-faults, raptor restart on an encoder stall, reboot if that
+# fails. RAPTOR_WATCHDOG=0 in /etc/default/raptor-watchdog turns it off.
+
+DAEMON=/usr/sbin/raptor-watchdog
+PIDFILE=/run/raptor-watchdog.pid
+NAME=raptor-watchdog
+
+start() {
+	[ -x "$DAEMON" ] || return 0
+	[ -x /usr/bin/rvd ] || return 0
+	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
+		echo "$NAME already running"
+		return 0
+	fi
+	echo "Starting $NAME..."
+	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
+}
+
+stop() {
+	echo "Stopping $NAME..."
+	# By pidfile only: -x would compare /bin/sh, not this script.
+	[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
+	rm -f "$PIDFILE"
+}
+
+case "$1" in
+start) start ;;
+stop) stop ;;
+restart)
+	stop
+	start
+	;;
+*)
+	echo "Usage: $0 {start|stop|restart}"
+	exit 1
+	;;
+esac
diff --git a/package/thingino-raptor/files/agent-adapter b/package/thingino-raptor/files/agent-adapter
index 0c06f8938..c49cc96b4 100644
--- a/package/thingino-raptor/files/agent-adapter
+++ b/package/thingino-raptor/files/agent-adapter
@@ -4,6 +4,17 @@
 AGENT_CONFIG="${AGENT_CONFIG:-/etc/raptor.conf}"
 THINGINO_AGENT_SEND2_CONFIG="${THINGINO_AGENT_SEND2_CONFIG:-/etc/send2.json}"
 AGENT_PRIVACY_STATE="${AGENT_PRIVACY_STATE:-/run/agent/raptor-privacy}"
+# Stream choices the WebUI offers: the camera profile's, built into the image,
+# then any key overridden on the camera. See agent_stream_options_load.
+AGENT_STREAM_OPTIONS="${AGENT_STREAM_OPTIONS:-/usr/share/raptor/streams.conf}"
+AGENT_STREAM_OPTIONS_LOCAL="${AGENT_STREAM_OPTIONS_LOCAL:-/etc/raptor-streams.conf}"
+AGENT_STREAM_LOCK="${AGENT_STREAM_LOCK:-/run/agent/stream-apply.lock}"
+AGENT_STREAM_BACKUP="${AGENT_STREAM_BACKUP:-/run/agent/raptor.conf.before-apply}"
+
+# The per-invocation caches below (get-isp, stream section dumps) are keyed by
+# this shell's PID so command substitutions share them; drop them on exit, or
+# every agent request leaves its files behind in /tmp.
+trap 'rm -f /tmp/agent-raptor-isp.$$ /tmp/agent-raptor-stream0.$$ /tmp/agent-raptor-stream1.$$' EXIT
 
 agent_name() {
 	printf 'raptor'
@@ -87,7 +98,19 @@ agent_ctl() {
 		echo "raptorctl is not available" >&2
 		return 1
 	}
-	raptorctl "$@"
+	# raptorctl exits 0 whenever the daemon answers, even when the answer is
+	# {"status":"error","reason":...} (not supported on this SoC, a bad value),
+	# so read the reply: the callers' "|| return 1" must see the failure, and
+	# the setting must not be saved as if it had been applied.
+	_ctl_out=$(raptorctl "$@") || return 1
+	case "$_ctl_out" in
+	*'"status":"error"'* | *'"status": "error"'*)
+		_ctl_reason=$(printf '%s' "$_ctl_out" | sed -n 's/.*"reason": *"\([^"]*\)".*/\1/p')
+		echo "$1 $2: ${_ctl_reason:-error}" >&2
+		return 1
+		;;
+	esac
+	[ -z "$_ctl_out" ] || printf '%s\n' "$_ctl_out"
 }
 
 agent_daemon_status() {
@@ -364,6 +387,57 @@ agent_image_bool() {
 	agent_bool01_to_json "$(agent_image_raw "$1")" false
 }
 
+# Which ISP controls the HAL publishes (rvd get-isp-caps), cached per rvd
+# process, since a restart can bring up another HAL. Empty when rvd is down or
+# too old to answer; every control then counts as present, as before.
+agent_isp_caps_json() {
+	_rvd=$(pidof rvd 2>/dev/null | awk '{ print $1 }')
+	[ -n "$_rvd" ] || return 0
+	_caps="/tmp/agent-isp-caps.$_rvd"
+	if [ ! -s "$_caps" ]; then
+		command -v raptorctl >/dev/null 2>&1 || return 0
+		_caps_out=$(raptorctl rvd get-isp-caps 2>/dev/null | tr -d ' \t\r\n') || return 0
+		case "$_caps_out" in
+			*'"status":"ok"'*) ;;
+			*) return 0 ;;
+		esac
+		rm -f /tmp/agent-isp-caps.*
+		printf '%s\n' "$_caps_out" >"$_caps"
+	fi
+	cat "$_caps" 2>/dev/null
+}
+
+# agent_isp_has <control>: false only when rvd says the HAL lacks it.
+agent_isp_has() {
+	case "$(agent_isp_caps_json)" in
+		*"\"$1\":false"*) return 1 ;;
+	esac
+	return 0
+}
+
+# An image knob for the config block: its value, or null when the HAL lacks it
+# (the web UI hides those rather than offering a control that does nothing).
+agent_image_knob() {
+	if agent_isp_has "$1"; then
+		agent_json_value_or "$(agent_image_raw "$2")" null
+	else
+		printf 'null'
+	fi
+}
+
+agent_print_image_capabilities() {
+	printf '{'
+	_sep=
+	for _pair in brightness:brightness contrast:contrast saturation:saturation \
+		sharpness:sharpness temper:temper drc_strength:drc defog_strength:defog \
+		ae_compensation:ae_comp anti_flicker:antiflicker hflip:hflip vflip:vflip wb:wb; do
+		if agent_isp_has "${_pair#*:}"; then _has=true; else _has=false; fi
+		printf '%s"%s":%s' "$_sep" "${_pair%%:*}" "$_has"
+		_sep=,
+	done
+	printf '}'
+}
+
 # Map UI / prudynt-style WB mode integers onto raptor set-wb names (and back).
 agent_wb_mode_to_int() {
 	mode=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr '-' '_')
@@ -678,9 +752,42 @@ agent_stream_audio_enabled() {
 	agent_config_bool audio enabled true
 }
 
+agent_stream_section_dump() {
+	# Cache one `raptorctl config get streamN` per adapter invocation. The
+	# section dump carries the EFFECTIVE config -- every key with its running
+	# value, defaults merged in -- unlike a per-key `config get streamN fps`,
+	# which returns "Key not found" for any key left commented out in
+	# raptor.conf. Reading the dump is what lets the WebUI streamer pages
+	# hydrate fields (fps/gop/bitrate/rc_mode/codec/profile/buffers) that sit at
+	# their rvd defaults, instead of showing blank.
+	stream_id=$1
+	_sd_cache="/tmp/agent-raptor-stream$stream_id.$$"
+	if [ ! -s "$_sd_cache" ]; then
+		command -v raptorctl >/dev/null 2>&1 || return 0
+		raptorctl config get "$(agent_stream_section "$stream_id")" >"$_sd_cache" 2>/dev/null || {
+			rm -f "$_sd_cache"
+			return 0
+		}
+	fi
+	cat "$_sd_cache" 2>/dev/null
+}
+
 agent_stream_field() {
 	stream_id=$1
 	field=$2
+	# Prefer the effective value from the section dump so a key left at its rvd
+	# default still populates; fall back to a direct get for anything the dump
+	# does not carry.
+	dump=$(agent_stream_section_dump "$stream_id")
+	if [ -n "$dump" ]; then
+		value=$(printf '%s\n' "$dump" |
+			sed -n 's/^[[:space:]]*'"$field"'[[:space:]]*=[[:space:]]*\(.*\)$/\1/p' |
+			head -n 1 | sed 's/[[:space:]]*$//' | tr -d '\r"')
+		if [ -n "$value" ]; then
+			printf '%s' "$value"
+			return 0
+		fi
+	fi
 	agent_config_get "$(agent_stream_section "$stream_id")" "$field"
 }
 
@@ -701,6 +808,521 @@ agent_stream_mode() {
 	esac
 }
 
+# ---- Stream settings: choices, video memory, apply -------------------------
+#
+# The Streamer pages change a stream as one request, and every change is
+# applied the same way: the keys are written to /etc/raptor.conf and the stack
+# restarts (about 6 s; RTSP clients reconnect). rvd's in-place paths --
+# set-resolution, set-codec, set-bitrate and the rest -- rebuild one encoder
+# channel inside the running pipeline. On Infinity6C the sub is a VENC cascade
+# off the main and the JPEG channel holds an SCL port of its own, and rebuilding
+# one of them in place disturbs the others: a live bitrate change on the main
+# alone was measured dropping the sub from 25 to 17 fps. A clean start is the
+# path every boot takes.
+#
+# The values the pages offer come from the camera profile, built into
+# AGENT_STREAM_OPTIONS; any key can be overridden on the camera in
+# AGENT_STREAM_OPTIONS_LOCAL. An empty list offers no choice: the page shows the
+# current value only.
+
+agent_stream_options_load() {
+	UI_STREAM0_RESOLUTIONS=
+	UI_STREAM1_RESOLUTIONS=
+	UI_FPS=
+	UI_STREAM0_BITRATES=
+	UI_STREAM1_BITRATES=
+	UI_CODECS=
+	UI_PROFILES=
+	UI_RC_MODES=
+	UI_GOP_SECONDS=
+	UI_JPEG_QUALITIES=
+	UI_MMA_RESERVE_KIB=
+	UI_MMA_MAIN_MBPP=
+	UI_MMA_SUB_MBPP=
+	UI_MMA_JPEG_MBPP=
+	# shellcheck disable=SC1090
+	[ -r "$AGENT_STREAM_OPTIONS" ] && . "$AGENT_STREAM_OPTIONS"
+	# shellcheck disable=SC1090
+	[ -r "$AGENT_STREAM_OPTIONS_LOCAL" ] && . "$AGENT_STREAM_OPTIONS_LOCAL"
+	# Video memory a stream costs, in thousandths of a byte per pixel, measured
+	# from the MI heap table (/proc/mi_modules/mi_sys_mma/mma_heap_name0) on the
+	# YMF46D and the JL12D2: the main's encoder buffers plus the SCL->VENC rings
+	# (~5.0), a cascade sub's encoder buffers (3.2-4.1), and a JPEG channel's
+	# three NV12 frames on its own SCL port plus its bitstream (6.5).
+	: "${UI_MMA_RESERVE_KIB:=4096}"
+	: "${UI_MMA_MAIN_MBPP:=5200}"
+	: "${UI_MMA_SUB_MBPP:=4100}"
+	: "${UI_MMA_JPEG_MBPP:=6600}"
+}
+
+agent_list_json() {
+	# A space-separated list as a JSON array; with "num", numbers only.
+	_lj=
+	for _li in $1; do
+		if [ "$2" = num ]; then
+			case "$_li" in '' | *[!0-9]*) continue ;; esac
+			_lj="$_lj${_lj:+,}$_li"
+		else
+			_lj="$_lj${_lj:+,}$(agent_json_string "$_li")"
+		fi
+	done
+	printf '[%s]' "$_lj"
+}
+
+agent_list_has() {
+	for _li in $1; do
+		[ "$_li" = "$2" ] && return 0
+	done
+	return 1
+}
+
+agent_bool_word() {
+	case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
+		1 | true | yes | on) printf 'true' ;;
+		0 | false | no | off) printf 'false' ;;
+		*) printf '%s' "$2" ;;
+	esac
+}
+
+agent_mma_kib() {
+	# "total_kib free_kib" of the MI heap the video pipeline allocates from.
+	_mma=$(awk '$1 ~ /^mma_heap_name/ { print $3, $4; exit }' \
+		/proc/mi_modules/mi_sys_mma/mma_heap_name0 2>/dev/null)
+	[ -n "$_mma" ] || return 1
+	set -- $_mma
+	printf '%s %s\n' $((0x$1 / 1024)) $((0x$2 / 1024))
+}
+
+agent_stream_mma_kib() {
+	# Video memory one stream holds, in KiB: <id> <width> <height> <jpeg> <enabled>.
+	if [ "$5" = false ]; then
+		printf '0'
+		return 0
+	fi
+	awk -v id="$1" -v w="$2" -v h="$3" -v j="$4" \
+		-v vm="$UI_MMA_MAIN_MBPP" -v vs="$UI_MMA_SUB_MBPP" -v vj="$UI_MMA_JPEG_MBPP" 'BEGIN {
+		px = w * h
+		c = px * (id == 0 ? vm : vs) / 1000
+		if (j == "true") c += px * vj / 1000
+		printf "%d", c / 1024 + 0.5
+	}'
+}
+
+agent_stream_state_load() {
+	# Effective settings of stream $1 (rvd's defaults merged) into _st_*.
+	_st_w=$(agent_stream_field "$1" width)
+	_st_h=$(agent_stream_field "$1" height)
+	_st_fps=$(agent_stream_field "$1" fps)
+	_st_bitrate=$(agent_stream_field "$1" bitrate)
+	_st_maxbr=$(agent_stream_field "$1" max_bitrate)
+	[ -n "$_st_maxbr" ] || _st_maxbr=0
+	_st_gop=$(agent_stream_field "$1" gop)
+	_st_codec=$(agent_stream_field "$1" codec | tr 'A-Z' 'a-z')
+	_st_profile=$(agent_profile_to_name "$(agent_stream_field "$1" profile)")
+	_st_rc=$(agent_stream_field "$1" rc_mode | tr 'A-Z' 'a-z')
+	# rvd pairs a JPEG channel with every stream unless [jpeg] or the stream
+	# says otherwise.
+	if [ "$(agent_config_bool jpeg enabled true)" = true ]; then
+		_st_jpeg=$(agent_bool_word "$(agent_stream_field "$1" jpeg)" true)
+	else
+		_st_jpeg=false
+	fi
+	_st_jq=$(agent_stream_field "$1" jpeg_quality)
+	[ -n "$_st_jq" ] || _st_jq=$(agent_config_get jpeg quality)
+	_st_enabled=$(agent_stream_enabled "$1")
+}
+
+agent_print_stream_state() {
+	agent_stream_options_load
+	agent_stream_state_load "$1"
+	printf '{"id":%s,"enabled":%s,' "$1" "$_st_enabled"
+	printf '"width":%s,"height":%s,' "$(agent_json_value_or "$_st_w" null)" "$(agent_json_value_or "$_st_h" null)"
+	printf '"fps":%s,"bitrate":%s,"max_bitrate":%s,"gop":%s,' "$(agent_json_value_or "$_st_fps" null)" \
+		"$(agent_json_value_or "$_st_bitrate" null)" "$_st_maxbr" "$(agent_json_value_or "$_st_gop" null)"
+	printf '"codec":%s,"profile":%s,"rc_mode":%s,' "$(agent_json_string_or_null "$_st_codec")" \
+		"$(agent_json_string_or_null "$_st_profile")" "$(agent_json_string_or_null "$_st_rc")"
+	printf '"jpeg":%s,"jpeg_quality":%s,' "$_st_jpeg" "$(agent_json_value_or "$_st_jq" null)"
+	printf '"rtsp_url":%s,' "$(agent_json_string_or_null "$(agent_stream_rtsp_url "$1")")"
+	printf '"mma_kib":%s}' "$(agent_stream_mma_kib "$1" "${_st_w:-0}" "${_st_h:-0}" "$_st_jpeg" "$_st_enabled")"
+}
+
+agent_print_stream_options() {
+	agent_stream_options_load
+	_mma=$(agent_mma_kib) || _mma="0 0"
+	set -- $_mma
+	printf '{"options":{"streams":['
+	for _s in 0 1; do
+		eval "_res=\$UI_STREAM${_s}_RESOLUTIONS _br=\$UI_STREAM${_s}_BITRATES"
+		[ "$_s" = 1 ] && printf ','
+		printf '{"id":%s,"resolutions":%s,"bitrates_kbps":%s}' "$_s" \
+			"$(agent_list_json "$_res")" "$(agent_list_json "$_br" num)"
+	done
+	printf '],"fps":%s,"codecs":%s,"profiles":%s,' "$(agent_list_json "$UI_FPS" num)" \
+		"$(agent_list_json "$UI_CODECS")" "$(agent_list_json "$UI_PROFILES")"
+	printf '"rc_modes":%s,"gop_seconds":%s,"jpeg_qualities":%s},' "$(agent_list_json "$UI_RC_MODES")" \
+		"$(agent_list_json "$UI_GOP_SECONDS" num)" "$(agent_list_json "$UI_JPEG_QUALITIES" num)"
+	printf '"mma":{"total_kib":%s,"free_kib":%s,"reserve_kib":%s,' "$1" "$2" "$UI_MMA_RESERVE_KIB"
+	printf '"main_mbpp":%s,"sub_mbpp":%s,"jpeg_mbpp":%s},' "$UI_MMA_MAIN_MBPP" "$UI_MMA_SUB_MBPP" "$UI_MMA_JPEG_MBPP"
+	printf '"streams":[%s,%s]}\n' "$(agent_print_stream_state 0)" "$(agent_print_stream_state 1)"
+}
+
+agent_stream_req() {
+	# A field of the request body as plain text; empty when absent.
+	agent_json_config_value "$1" "$2" | tr -d '"'
+}
+
+agent_stream_check() {
+	# <value> <min> <max> <name>: an integer in range, or a message and failure.
+	case "$1" in
+		'' | *[!0-9]*)
+			echo "$4 must be a whole number" >&2
+			return 1
+			;;
+	esac
+	if [ "$1" -lt "$2" ] || [ "$1" -gt "$3" ]; then
+		echo "$4 must be between $2 and $3" >&2
+		return 1
+	fi
+}
+
+agent_stream_offered() {
+	# <list> <value> <old value> <name>: a changed value must be one of the
+	# choices, when there are any. An unchanged one may be anything, so a value
+	# set outside the list does not block every other change.
+	[ "$2" = "$3" ] && return 0
+	[ -n "$1" ] || return 0
+	agent_list_has "$1" "$2" && return 0
+	echo "$4 $2 is not offered on this camera (choices: $1)" >&2
+	return 1
+}
+
+agent_streamer_restart_verified() {
+	# Restart the stack and wait for rvd to run stream <id> at <w>x<h>, or only
+	# to come up when <enabled> is false. Fails on a timeout, or when MI logged a
+	# buffer-allocation failure meanwhile -- the sign the pipeline does not fit.
+	_rv_errs=$(dmesg | grep -cE "Buf Allocation|Get Buffer Faild")
+	_rv_t0=$(cut -d ' ' -f 1 /proc/uptime)
+	/etc/init.d/S31raptor restart >/dev/null 2>&1
+	_rv_i=0
+	while [ "$_rv_i" -lt 60 ]; do
+		_rv_status=$(raptorctl rvd status 2>/dev/null)
+		case "$_rv_status" in
+			*'"status":"ok"'*)
+				[ "$4" = false ] && break
+				case "$_rv_status" in
+					*"\"chn\":$1,\"w\":$2,\"h\":$3,"*) break ;;
+				esac
+				;;
+		esac
+		usleep 250000
+		_rv_i=$((_rv_i + 1))
+	done
+	[ "$_rv_i" -lt 60 ] || return 1
+	sleep 2
+	[ "$(dmesg | grep -cE "Buf Allocation|Get Buffer Faild")" -gt "$_rv_errs" ] && return 2
+	_rv_t1=$(cut -d ' ' -f 1 /proc/uptime)
+	_sa_restart_ms=$(awk -v a="$_rv_t0" -v b="$_rv_t1" 'BEGIN { printf "%d", (b - a) * 1000 }')
+	return 0
+}
+
+agent_stream_unlock() {
+	rmdir "$AGENT_STREAM_LOCK" 2>/dev/null
+}
+
+agent_stream_apply() {
+	# Apply a stream change from a JSON body: any of resolution ("WxH") or
+	# width/height, fps, bitrate (bps), gop (frames), codec (format), profile,
+	# rc_mode (mode), jpeg, jpeg_quality, enabled. Absent fields keep their
+	# value. Sets _sa_changed (the keys written) and _sa_restarted.
+	_sa_id=$1
+	_sa_body=$2
+	_sa_changed=
+	_sa_restarted=false
+	_sa_restart_ms=0
+	case "$_sa_id" in
+		0 | 1) ;;
+		*)
+			echo "unsupported stream id" >&2
+			return 1
+			;;
+	esac
+	agent_stream_options_load
+	agent_stream_state_load "$_sa_id"
+
+	_sa_w=$_st_w
+	_sa_h=$_st_h
+	_v=$(agent_stream_req "$_sa_body" resolution)
+	if [ -n "$_v" ]; then
+		case "$_v" in
+			[0-9]*x[0-9]*)
+				_sa_w=${_v%%x*}
+				_sa_h=${_v#*x}
+				;;
+			*)
+				echo "resolution must be WIDTHxHEIGHT" >&2
+				return 1
+				;;
+		esac
+	fi
+	_v=$(agent_stream_req "$_sa_body" width)
+	[ -n "$_v" ] && _sa_w=$_v
+	_v=$(agent_stream_req "$_sa_body" height)
+	[ -n "$_v" ] && _sa_h=$_v
+	_v=$(agent_stream_req "$_sa_body" fps)
+	_sa_fps=${_v:-$_st_fps}
+	_v=$(agent_stream_req "$_sa_body" bitrate)
+	_sa_bitrate=${_v:-$_st_bitrate}
+	_v=$(agent_stream_req "$_sa_body" max_bitrate)
+	_sa_maxbr=${_v:-$_st_maxbr}
+	_v=$(agent_stream_req "$_sa_body" gop)
+	_sa_gop=${_v:-$_st_gop}
+	_v=$(agent_stream_req "$_sa_body" codec)
+	[ -n "$_v" ] || _v=$(agent_stream_req "$_sa_body" format)
+	_sa_codec=$(printf '%s' "${_v:-$_st_codec}" | tr 'A-Z' 'a-z')
+	_v=$(agent_stream_req "$_sa_body" profile)
+	if [ -n "$_v" ]; then
+		agent_profile_to_int "$_v" >/dev/null || return 1
+		_sa_profile=$(agent_profile_to_name "$_v")
+	else
+		_sa_profile=$_st_profile
+	fi
+	_v=$(agent_stream_req "$_sa_body" rc_mode)
+	[ -n "$_v" ] || _v=$(agent_stream_req "$_sa_body" mode)
+	_sa_rc=$(printf '%s' "${_v:-$_st_rc}" | tr 'A-Z' 'a-z')
+	_v=$(agent_stream_req "$_sa_body" jpeg)
+	_sa_jpeg=$(agent_bool_word "${_v:-$_st_jpeg}" invalid)
+	_v=$(agent_stream_req "$_sa_body" jpeg_quality)
+	_sa_jq=${_v:-$_st_jq}
+	_v=$(agent_stream_req "$_sa_body" enabled)
+	_sa_en=$(agent_bool_word "${_v:-$_st_enabled}" invalid)
+
+	agent_stream_check "$_sa_w" 64 4096 width || return 1
+	agent_stream_check "$_sa_h" 64 4096 height || return 1
+	if [ $((_sa_w % 2)) -ne 0 ] || [ $((_sa_h % 2)) -ne 0 ]; then
+		echo "width and height must be even" >&2
+		return 1
+	fi
+	agent_stream_check "$_sa_fps" 1 60 fps || return 1
+	agent_stream_check "$_sa_bitrate" 32000 20000000 bitrate || return 1
+	agent_stream_check "$_sa_gop" 1 1000 gop || return 1
+	[ -z "$_sa_jq" ] || agent_stream_check "$_sa_jq" 1 100 "JPEG quality" || return 1
+	case "$_sa_codec" in
+		h264 | h265) ;;
+		*)
+			echo "codec must be h264 or h265" >&2
+			return 1
+			;;
+	esac
+	case "$_sa_rc" in
+		cbr | vbr | capped_vbr | capped_quality | smart | fixqp) ;;
+		*)
+			echo "rate control must be cbr, vbr, capped_vbr, capped_quality, smart or fixqp" >&2
+			return 1
+			;;
+	esac
+	case "$_sa_jpeg$_sa_en" in
+		*invalid*)
+			echo "jpeg and enabled must be true or false" >&2
+			return 1
+			;;
+	esac
+	if [ "$_sa_id" = 0 ] && [ "$_sa_en" = false ]; then
+		echo "the main stream cannot be turned off" >&2
+		return 1
+	fi
+
+	# VBR and the capped modes are bounded by max_bitrate (by bitrate when it
+	# is 0). Write the cap out so the config says what the encoder does.
+	agent_stream_check "$_sa_maxbr" 0 20000000 "max bitrate" || return 1
+	if [ "$_sa_rc" != cbr ]; then
+		[ "$_sa_maxbr" -eq 0 ] && _sa_maxbr=$_sa_bitrate
+		if [ "$_sa_maxbr" -lt "$_sa_bitrate" ]; then
+			echo "max bitrate must be at least the bitrate" >&2
+			return 1
+		fi
+	fi
+
+	# The pipeline can only drop sensor frames, so a stream rate that does not
+	# divide the sensor's drops them unevenly: a stutter every few frames. The
+	# main stream's rate is the sensor's (setting it sets [sensor] fps), and the
+	# sub's must divide the main's.
+	if [ "$_sa_id" = 1 ] && [ "$_sa_en" = true ] &&
+		{ [ "$_sa_fps" != "$_st_fps" ] || [ "$_sa_en" != "$_st_enabled" ]; }; then
+		_sa_mfps=$(agent_stream_field 0 fps)
+		if [ "$_sa_fps" -gt "${_sa_mfps:-0}" ] || [ $((${_sa_mfps:-0} % _sa_fps)) -ne 0 ]; then
+			echo "$_sa_fps fps does not divide the main stream's $_sa_mfps fps, so frames would be dropped unevenly; use $_sa_mfps fps or a whole divisor of it" >&2
+			return 1
+		fi
+	fi
+
+	eval "_sa_list=\$UI_STREAM${_sa_id}_RESOLUTIONS _sa_brs=\$UI_STREAM${_sa_id}_BITRATES"
+	agent_stream_offered "$_sa_list" "${_sa_w}x${_sa_h}" "${_st_w}x${_st_h}" resolution || return 1
+	agent_stream_offered "$UI_FPS" "$_sa_fps" "$_st_fps" "frame rate" || return 1
+	agent_stream_offered "$_sa_brs" "$((_sa_bitrate / 1000))" "$((${_st_bitrate:-0} / 1000))" "bitrate (kbps)" || return 1
+	if [ "$_sa_maxbr" -ne 0 ]; then
+		agent_stream_offered "$_sa_brs" "$((_sa_maxbr / 1000))" "$((_st_maxbr / 1000))" "max bitrate (kbps)" || return 1
+	fi
+	agent_stream_offered "$UI_CODECS" "$_sa_codec" "$_st_codec" codec || return 1
+	agent_stream_offered "$UI_PROFILES" "$_sa_profile" "$_st_profile" profile || return 1
+	agent_stream_offered "$UI_RC_MODES" "$_sa_rc" "$_st_rc" "rate control" || return 1
+	agent_stream_offered "$UI_JPEG_QUALITIES" "$_sa_jq" "$_st_jq" "JPEG quality" || return 1
+
+	# The sub is a VENC cascade off the main, and the cascade only scales down.
+	if [ "$_sa_id" = 1 ]; then
+		_sa_ow=$(agent_stream_field 0 width)
+		_sa_oh=$(agent_stream_field 0 height)
+		if [ "$_sa_w" -gt "${_sa_ow:-4096}" ] || [ "$_sa_h" -gt "${_sa_oh:-4096}" ]; then
+			echo "the substream cannot be larger than the main stream (${_sa_ow}x${_sa_oh})" >&2
+			return 1
+		fi
+	elif [ "$(agent_stream_enabled 1)" = true ]; then
+		_sa_ow=$(agent_stream_field 1 width)
+		_sa_oh=$(agent_stream_field 1 height)
+		if [ "$_sa_w" -lt "${_sa_ow:-0}" ] || [ "$_sa_h" -lt "${_sa_oh:-0}" ]; then
+			echo "the main stream cannot be smaller than the substream (${_sa_ow}x${_sa_oh})" >&2
+			return 1
+		fi
+	fi
