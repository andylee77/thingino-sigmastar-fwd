+	# What would change, as raptor.conf keys.
+	_sa_set=
+	[ "$_sa_w" = "$_st_w" ] || _sa_set="$_sa_set width=$_sa_w"
+	[ "$_sa_h" = "$_st_h" ] || _sa_set="$_sa_set height=$_sa_h"
+	[ "$_sa_fps" = "$_st_fps" ] || _sa_set="$_sa_set fps=$_sa_fps"
+	[ "$_sa_bitrate" = "$_st_bitrate" ] || _sa_set="$_sa_set bitrate=$_sa_bitrate"
+	[ "$_sa_maxbr" = "$_st_maxbr" ] || _sa_set="$_sa_set max_bitrate=$_sa_maxbr"
+	[ "$_sa_gop" = "$_st_gop" ] || _sa_set="$_sa_set gop=$_sa_gop"
+	[ "$_sa_codec" = "$_st_codec" ] || _sa_set="$_sa_set codec=$_sa_codec"
+	[ "$_sa_profile" = "$_st_profile" ] || _sa_set="$_sa_set profile=$(agent_profile_to_int "$_sa_profile")"
+	[ "$_sa_rc" = "$_st_rc" ] || _sa_set="$_sa_set rc_mode=$_sa_rc"
+	[ "$_sa_jpeg" = "$_st_jpeg" ] || _sa_set="$_sa_set jpeg=$_sa_jpeg"
+	[ "$_sa_jq" = "$_st_jq" ] || _sa_set="$_sa_set jpeg_quality=$_sa_jq"
+	[ "$_sa_en" = "$_st_enabled" ] || _sa_set="$_sa_set enabled=$_sa_en"
+	[ -n "$_sa_set" ] || return 0
