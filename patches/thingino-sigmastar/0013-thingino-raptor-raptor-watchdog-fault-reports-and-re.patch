diff --git a/package/thingino-raptor/files/S34raptor-watchdog b/package/thingino-raptor/files/S34raptor-watchdog
new file mode 100755
index 000000000..eff877f27
--- /dev/null
+++ b/package/thingino-raptor/files/S34raptor-watchdog
@@ -0,0 +1,39 @@
+#!/bin/sh
+# S34raptor-watchdog -- start/stop the video pipeline watchdog: fault reports
+# in /root/raptor-faults, raptor restart on an encoder stall, reboot if that
+# fails. RAPTOR_WATCHDOG=0 in /etc/default/raptor-watchdog turns it off.
+
+DAEMON=/usr/sbin/raptor-watchdog
+PIDFILE=/run/raptor-watchdog.pid
+NAME=raptor-watchdog
+
+start() {
+	[ -x "$DAEMON" ] || return 0
+	[ -x /usr/bin/rvd ] || return 0
+	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
+		echo "$NAME already running"
+		return 0
+	fi
+	echo "Starting $NAME..."
+	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
+}
+
+stop() {
+	echo "Stopping $NAME..."
+	# By pidfile only: -x would compare /bin/sh, not this script.
+	[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
+	rm -f "$PIDFILE"
+}
+
+case "$1" in
+start) start ;;
+stop) stop ;;
+restart)
+	stop
+	start
+	;;
+*)
+	echo "Usage: $0 {start|stop|restart}"
+	exit 1
+	;;
+esac
diff --git a/package/thingino-raptor/files/raptor-watchdog b/package/thingino-raptor/files/raptor-watchdog
new file mode 100755
index 000000000..fee8ff318
--- /dev/null
+++ b/package/thingino-raptor/files/raptor-watchdog
@@ -0,0 +1,310 @@
+#!/bin/sh
+# raptor-watchdog -- keep the video pipeline alive, and keep the evidence when
+# it fails. Started by S34raptor-watchdog; every POLL seconds:
+#
+# - a new "[MI ERR]" line in the kernel log saves a fault report at once. The
+#   kernel ring is ~32 KB and the MI warning flood that follows a fault wraps
+#   it within minutes, long before anyone looks.
+# - an encoder output port whose finished-frame count (mi_venc FinishCnt)
+#   stands still for STALL seconds while rvd runs, or rvd stuck that long in the MI driver
+#   (state D, which no signal can end), saves a report and restarts raptor;
+# - if the restart does not bring frames back, it reboots, unless it has
+#   already rebooted MAX_REBOOTS times in the last hour.
+#
+# - rvd gone for GONE seconds while rsd still runs (killed or crashed) saves a
+#   report and restarts raptor, once.
+#
+# Deliberate stops are left alone: nothing is judged while the stack is stopped,
+# while S31raptor runs, while the web UI's stream apply holds its lock, or in
+# the first GRACE seconds after rvd starts.
+#
+# Reports: $DIR/<date>-<reason>.txt.gz, newest KEEP kept (the overlay is ~1 MB
+# of flash). "raptor-watchdog report [reason]" writes one by hand.
+# Tunables: /etc/default/raptor-watchdog; RAPTOR_WATCHDOG=0 turns it off.
+#
+# A poll that finds nothing wrong starts two processes, the sleep and one awk
+# over the encoder's table; the rest is read with the shell's own read. The
+# kernel log is searched every ERR_POLL seconds, not at every poll: it costs
+# four processes and a copy of the whole ring.
+
+[ -r /etc/default/raptor-watchdog ] && . /etc/default/raptor-watchdog
+: "${RAPTOR_WATCHDOG:=1}"
+: "${POLL:=5}"
+: "${STALL:=30}"
+: "${GRACE:=60}"
+: "${SETTLE:=45}"
+: "${KEEP:=5}"
+: "${MAX_REBOOTS:=3}"
+: "${ERR_GAP:=600}"
+: "${ERR_POLL:=15}"
+: "${GONE:=15}"
+: "${DIR:=/root/raptor-faults}"
+: "${VENC:=/proc/mi_modules/mi_venc/mi_venc0}"
+APPLY_LOCK=/run/agent/stream-apply.lock
+STATE=/run/raptor-watchdog.state
+
+log() {
+	logger -t raptor-watchdog "$*"
+}
+
+uptime_s() {
+	cut -d. -f1 /proc/uptime
+}
+
+rvd_pid() {
+	pidof rvd | awk '{ print $1 }'
+}
+
+# R, S, D, ... from /proc/<pid>/stat (rvd's comm has no spaces).
+rvd_state() {
+	awk '{ print $3 }' "/proc/$1/stat" 2>/dev/null
+}
+
+# Seconds since rvd started: field 22 is the start time in clock ticks.
+rvd_age() {
+	_t=$(awk '{ print $22 }' "/proc/$1/stat" 2>/dev/null)
+	[ -n "$_t" ] || _t=0
+	echo $(($(uptime_s) - _t / 100))
+}
+
+# "<chn>.<port> <frames finished>" per encoder output port that gets input:
+# FinishCnt of the output-port table, 4th column from the end ("0/   1"
+# splits in two). Not the input table's: in the 11-02 wedges input kept
+# arriving for 15 minutes after the encoder had stopped producing anything.
+# Ports that never got a frame (GetTotalCnt 0, e.g. the cascade's port 1.0)
+# are skipped.
+frames() {
+	awk '/GetTotalCnt/ { t = 1; next }
+		t && $1 ~ /^[0-9]+$/ && NF >= 8 { if ($(NF - 1) + 0 > 0) print $1 "." $3, $(NF - 3); next }
+		t && NF == 0 { exit }' "$VENC" 2>/dev/null
+}
+
+# Every output port finished at least one frame in the last 3 seconds.
+advancing() {
+	_a=$(frames)
+	sleep 3
+	_b=$(frames)
+	[ -n "$_b" ] || return 1
+	printf '%s\n--\n%s\n' "$_a" "$_b" | awk '
+		$1 == "--" { s = 1; next }
+		!s { a[$1] = $2; next }
+		{ n++; if ($2 + 0 > a[$1] + 0) ok++ }
+		END { exit !(n > 0 && ok == n) }'
+}
+
+# The same two for the poll loop, read without a process: after "pid (comm) "
+# the state is the first field and the start time the twentieth. Sets _state
+# and _age (seconds, from $now).
+rvd_stat() {
+	_state=
+	_age=$now
+	_s=
+	read -r _s <"/proc/$1/stat" || return 1
+	# shellcheck disable=SC2086
+	set -- ${_s##*) }
+	_state=$1
+	_age=$((now - ${20:-0} / 100))
+} 2>/dev/null
+
+# rvd's pid for the poll loop: the one already known while /proc still calls
+# it rvd, and pidof only when it is not.
+rvd_now() {
+	_c=
+	[ -n "$pid" ] && read -r _c <"/proc/$pid/comm"
+	[ "$_c" = rvd ] || pid=$(rvd_pid)
+} 2>/dev/null
+
+# A restart of raptor is under way, by S31raptor or the web UI's stream apply.
+# The command lines are read with the shell's read, which drops the NULs
+# between the words, in place of "ps | grep".
+busy() {
+	[ -d "$APPLY_LOCK" ] && return 0
+	for _d in /proc/[0-9]*; do
+		_c=
+		read -r _c <"$_d/cmdline"
+		case "$_c" in
+			*S31raptor*) return 0 ;;
+		esac
+	done
+	return 1
+} 2>/dev/null
+
+report() {
+	mkdir -p "$DIR"
+	_f="$DIR/$(date +%Y%m%d-%H%M%S)-$1.txt.gz"
+	_p=$(rvd_pid)
+	{
+		echo "raptor-watchdog report: $1"
+		echo "date: $(date)  uptime: $(cut -d' ' -f1 /proc/uptime) s"
+		grep -E '^(IMAGE_ID|BUILD_ID)=' /etc/os-release
+		echo
+		echo "== rvd pid ${_p:-none} state $(rvd_state "$_p")"
+		raptorctl rvd status
+		echo
+		raptorctl rsd status
+		echo
+		raptorctl ric status
+		echo
+		echo "== $VENC"
+		cat "$VENC"
+		echo "== mma heap"
+		head -n 12 /proc/mi_modules/mi_sys_mma/mma_heap_name0
+		echo "== meminfo"
+		head -n 5 /proc/meminfo
+		echo "== dmesg"
+		dmesg
+		echo "== logread (last 300 lines)"
+		logread | tail -n 300
+		echo "== ps"
+		ps
+	} 2>&1 | gzip -c >"$_f"
+	# Reboot reports are pruned on their own: reboot_now counts them, and with
+	# 2-3 reports per stall cycle the newest KEEP of all kinds would drop the
+	# reboot markers before MAX_REBOOTS were ever counted.
+	ls -1t "$DIR"/*.txt.gz 2>/dev/null | grep -v -- '-reboot\.txt\.gz$' |
+		tail -n +$((KEEP + 1)) | xargs rm -f
+	ls -1t "$DIR"/*-reboot.txt.gz 2>/dev/null | tail -n +$((MAX_REBOOTS + 3)) | xargs rm -f
+	log "saved $_f"
+}
+
+reboot_now() {
+	if [ "$(find "$DIR" -name '*-reboot.txt.gz' -mmin -60 2>/dev/null | wc -l)" -ge "$MAX_REBOOTS" ]; then
+		log "pipeline still down after a restart, but $MAX_REBOOTS watchdog reboots in the last hour: leaving it for someone to look at"
+		gave_up=1
+		return
+	fi
+	report reboot
+	log "rebooting: $1"
+	sync
+	reboot -f
+}
+
+recover() {
+	report "$1"
+	log "$1: restarting raptor"
+	/etc/init.d/S31raptor stop >/dev/null 2>&1
+	# A wedged encoder leaves rvd stuck in MI_SYS_IMPL_UnBindChnPort (state D)
+	# on every wedge seen so far: no start can follow, only a reboot clears it,
+	# so don't spend SETTLE finding that out.
+	_t=0
+	while [ -n "$(rvd_pid)" ] && [ "$_t" -lt 10 ]; do
+		sleep 1
+		_t=$((_t + 1))
+	done
+	if [ -n "$(rvd_pid)" ]; then
+		reboot_now "rvd did not exit after a stop, stuck in the driver ($1)"
+		return
+	fi
+	/etc/init.d/S31raptor start >/dev/null 2>&1
+	sleep "$SETTLE"
+	_p=$(rvd_pid)
+	if [ -z "$_p" ] || [ "$(rvd_state "$_p")" = D ] || ! advancing; then
+		reboot_now "a raptor restart did not bring frames back ($1)"
+	else
+		log "$1: frames are flowing again"
+	fi
+}
+
+if [ "$1" = report ]; then
+	report "${2:-manual}"
+	exit 0
+fi
+[ "$RAPTOR_WATCHDOG" = 0 ] && exit 0
+
+errors() {
+	dmesg | grep -F '[MI ERR]' | tail -n 3
+}
+
+# Errors already in the log when the watchdog starts are reported at its
+# first look, as before.
+errtext=
+err_at=-$ERR_POLL
+last_err=-$ERR_GAP
+pid=
+d_since=
+gave_up=
+gone_since=
+gone_tried=
+rm -f "$STATE"
+log "watching rvd: stall ${STALL}s, poll ${POLL}s, reports in $DIR"
+
+while :; do
+	sleep "$POLL"
+	read -r _u _ </proc/uptime
+	now=${_u%.*}
+
+	# Save the kernel log while it still holds the first errors.
+	if [ $((now - err_at)) -ge "$ERR_POLL" ]; then
+		err_at=$now
+		_e=$(errors)
+		if [ -n "$_e" ] && [ "$_e" != "$errtext" ] && [ $((now - last_err)) -ge "$ERR_GAP" ]; then
+			last_err=$now
+			report mi-error
+		fi
+		errtext=$_e
+	fi
+
+	rvd_now
+	# rvd gone while the rest of the stack still runs: it was killed (the OOM
+	# killer takes it first, it is the largest process) or it crashed. A stop
+	# by S31raptor takes rsd with it and is left alone. One restart per
+	# disappearance: a configuration rvd cannot start with is not looped on.
+	if [ -z "$pid" ] && ! busy && [ -n "$(pidof rsd)" ]; then
+		gone_since=${gone_since:-$now}
+		if [ -z "$gone_tried" ] && [ $((now - gone_since)) -ge "$GONE" ]; then
+			gone_tried=1
+			log "rvd is gone while rsd runs: restarting raptor"
+			report rvd-gone
+			/etc/init.d/S31raptor restart >/dev/null 2>&1
+		fi
+	else
+		gone_since=
+	fi
+	[ -n "$pid" ] && rvd_stat "$pid"
+	if [ -z "$pid" ] || busy || [ "$_age" -lt "$GRACE" ]; then
+		[ -e "$STATE" ] && rm -f "$STATE"
+		d_since=
+		continue
+	fi
+	gone_tried=
+
+	# Per channel: its frame count and when that count last moved, kept in
+	# $STATE; the channels whose count stood still for STALL seconds are
+	# printed. One awk does what frames() and two more did: the same rows of
+	# the same table.
+	stalled=$(awk -v now="$now" -v lim="$STALL" -v st="$STATE" '
+		BEGIN { while ((getline l < st) > 0) { split(l, f, " "); c[f[1]] = f[2]; s[f[1]] = f[3] }; close(st) }
+		/GetTotalCnt/ { t = 1; next }
+		t && $1 ~ /^[0-9]+$/ && NF >= 8 {
+			if ($(NF - 1) + 0 > 0) {
+				k = $1 "." $3; v = $(NF - 3); w = (k in c && c[k] == v) ? s[k] : now
+				keep = keep k " " v " " w "\n"
+				if (now - w >= lim) list = list (n++ ? "-" : "") k
+			}
+			next
+		}
+		t && NF == 0 { exit }
+		END { printf "%s", keep >st; close(st); printf "%s", list }' "$VENC" 2>/dev/null)
+
+	if [ "$_state" = D ]; then
+		d_since=${d_since:-$now}
+	else
+		d_since=
+	fi
+
+	if [ -z "$stalled" ] && [ -z "$d_since" ]; then
+		gave_up=
+		continue
+	fi
+	[ -n "$gave_up" ] && continue
+	if [ -n "$stalled" ]; then
+		log "encoder channel(s) $stalled: no frames for ${STALL}s"
+		recover "stall-chn$stalled"
+		rm -f "$STATE"
+	elif [ $((now - d_since)) -ge "$STALL" ]; then
+		log "rvd stuck in the driver (state D) for ${STALL}s"
+		recover rvd-stuck
+		rm -f "$STATE"
+		d_since=
+	fi
+done
-- 
