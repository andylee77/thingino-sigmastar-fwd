+		_sa_old_kib=$(agent_stream_mma_kib "$_sa_id" "${_st_w:-0}" "${_st_h:-0}" "$_st_jpeg" "$_st_enabled")
+		_sa_new_kib=$(agent_stream_mma_kib "$_sa_id" "$_sa_w" "$_sa_h" "$_sa_jpeg" "$_sa_en")
+		_sa_after=$(($2 + _sa_old_kib - _sa_new_kib))
+		if [ "$_sa_after" -lt "$UI_MMA_RESERVE_KIB" ]; then
+			echo "not enough video memory: this needs about $(((_sa_new_kib - _sa_old_kib + 1023) / 1024)) MiB more, $(($2 / 1024)) MiB is free and $((UI_MMA_RESERVE_KIB / 1024)) MiB is kept in reserve -- turn JPEG snapshots off or choose a smaller size" >&2
+			return 1
+		fi
+	fi
+
+	mkdir -p "$(dirname "$AGENT_STREAM_LOCK")"
+	if ! mkdir "$AGENT_STREAM_LOCK" 2>/dev/null; then
+		# A lock older than two minutes is left over from an apply that died.
+		if [ -n "$(find "$AGENT_STREAM_LOCK" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then
+			rmdir "$AGENT_STREAM_LOCK" 2>/dev/null
+			mkdir "$AGENT_STREAM_LOCK" 2>/dev/null
+		else
+			echo "another stream change is being applied; try again in a few seconds" >&2
+			return 1
+		fi
+	fi
+
+	cp /etc/raptor.conf "$AGENT_STREAM_BACKUP" || {
+		agent_stream_unlock
+		echo "could not back up /etc/raptor.conf" >&2
+		return 1
+	}
+	for _kv in $_sa_set; do
+		if ! agent_config_set "stream$_sa_id" "${_kv%%=*}" "${_kv#*=}"; then
+			cp "$AGENT_STREAM_BACKUP" /etc/raptor.conf
+			agent_stream_unlock
+			return 1
+		fi
+		_sa_changed="$_sa_changed ${_kv%%=*}"
+	done
+
+	# The main's rate is the sensor's. A sub that no longer divides it moves to
+	# the divisor closest to its rate (the lower on a tie), keeping its keyframe
+	# interval in seconds -- so 25 -> 20 -> 25 on the main brings it back.
+	_sa_sub_fps=
+	if [ "$_sa_id" = 0 ] && [ "$_sa_fps" != "$_st_fps" ]; then
+		_sf=$(agent_stream_field 1 fps)
+		_sg=$(agent_stream_field 1 gop)
+		if ! agent_config_set sensor fps "$_sa_fps"; then
+			cp "$AGENT_STREAM_BACKUP" /etc/raptor.conf
+			agent_stream_unlock
+			return 1
+		fi
+		if [ "$(agent_stream_enabled 1)" = true ] && [ -n "$_sf" ] && [ "$_sf" -gt 0 ] &&
+			{ [ "$_sf" -gt "$_sa_fps" ] || [ $((_sa_fps % _sf)) -ne 0 ]; }; then
+			_d=
+			_dd=
+			_c=1
+			while [ "$_c" -le "$_sa_fps" ]; do
+				if [ $((_sa_fps % _c)) -eq 0 ]; then
+					_e=$((_c - _sf))
+					[ "$_e" -lt 0 ] && _e=$((-_e))
+					if [ -z "$_d" ] || [ "$_e" -lt "$_dd" ]; then
+						_d=$_c
+						_dd=$_e
+					fi
+				fi
+				_c=$((_c + 1))
+			done
+			_gs=$(((${_sg:-$_sf} + _sf / 2) / _sf))
+			[ "$_gs" -ge 1 ] || _gs=1
+			if ! agent_config_set stream1 fps "$_d" || ! agent_config_set stream1 gop $((_gs * _d)); then
+				cp "$AGENT_STREAM_BACKUP" /etc/raptor.conf
+				agent_stream_unlock
+				return 1
+			fi
+			_sa_sub_fps=$_d
+		fi
+	fi
+	rm -f "/tmp/agent-raptor-stream0.$$" "/tmp/agent-raptor-stream1.$$"
+
+	_sa_check_w=$_sa_w
+	_sa_check_h=$_sa_h
+	_sa_check_en=$_sa_en
+	agent_streamer_restart_verified "$_sa_id" "$_sa_check_w" "$_sa_check_h" "$_sa_check_en"
+	_sa_rc_restart=$?
+	if [ "$_sa_rc_restart" -ne 0 ]; then
+		# Put the old settings back and bring the stack up on them.
+		cp "$AGENT_STREAM_BACKUP" /etc/raptor.conf
+		rm -f "/tmp/agent-raptor-stream0.$$" "/tmp/agent-raptor-stream1.$$"
+		agent_streamer_restart_verified "$_sa_id" "${_st_w:-0}" "${_st_h:-0}" "$_st_enabled"
+		agent_stream_unlock
+		if [ "$_sa_rc_restart" -eq 2 ]; then
+			echo "the video pipeline ran out of memory with these settings; the previous settings are back" >&2
+		else
+			echo "the streamer did not come up with these settings; the previous settings are back" >&2
+		fi
+		return 1
+	fi
+	_sa_restarted=true
+
+	# ONVIF tells clients each profile's size; S96onvif_discovery writes it from
+	# raptor.conf.
+	case "$_sa_set" in
+		*width=* | *height=* | *enabled=*)
+			[ -x /etc/init.d/S96onvif_discovery ] &&
+				/etc/init.d/S96onvif_discovery restart >/dev/null 2>&1
+			;;
+	esac
+	agent_stream_unlock
+	return 0
+}
