+    .isp_set_vflip = hal_isp_set_vflip,
+    .isp_get_hvflip = hal_isp_get_hvflip,
+    .isp_set_sensor_fps = hal_isp_set_sensor_fps,
+    .isp_get_sensor_fps = hal_isp_get_sensor_fps,
