+
+/* ================================================================
+ * RATE-CONTROL EXTRAS
+ *
+ * The I-frame cap, the I-frame and per-frame QP bounds, the I/P QP
+ * delta and the super-frame handling: MI_VENC_SetRcParam,
+ * SetSuperFrameCfg and SetRcPriority, none of which the channel
+ * attribute carries. The ABI, the driver behaviour that shapes this
+ * code and the pure builders are in i6c_venc_rc.h.
+ * ================================================================ */
+
+/* The pure header spells the UBR mode numbers out; hold it to the enum. */
+_Static_assert((int)I6C_RC_MODE_H264CBR == (int)I6C_VENC_RATEMODE_UBR_H264CBR, "UBR H.264 CBR");
+_Static_assert((int)I6C_RC_MODE_H264VBR == (int)I6C_VENC_RATEMODE_UBR_H264VBR, "UBR H.264 VBR");
+_Static_assert((int)I6C_RC_MODE_H264AVBR == (int)I6C_VENC_RATEMODE_UBR_H264AVBR, "UBR H.264 AVBR");
+_Static_assert((int)I6C_RC_MODE_H265CBR == (int)I6C_VENC_RATEMODE_UBR_H265CBR, "UBR H.265 CBR");
+_Static_assert((int)I6C_RC_MODE_H265VBR == (int)I6C_VENC_RATEMODE_UBR_H265VBR, "UBR H.265 VBR");
+_Static_assert((int)I6C_RC_MODE_H265AVBR == (int)I6C_VENC_RATEMODE_UBR_H265AVBR, "UBR H.265 AVBR");
+_Static_assert(RSS_SUPERFRM_DISCARD == (int)I6C_VENC_SUPERFRM_DISCARD &&
+                   RSS_SUPERFRM_REENCODE == (int)I6C_VENC_SUPERFRM_REENCODE,
+               "raptor's super-frame modes are MI's numerically");
+
+/* Say each I6C_RC_F_* outcome once per channel; the record outlives a re-create. */
+static void i6c_enc_rc_note(infinity6c_state_t *st, int chn, unsigned flags)
+{
+    i6c_venc_rcx_t *x = &st->enc_rcx[chn];
+
+    if ((flags & I6C_RC_F_RANGE) && !x->warned_range) {
+        x->warned_range = true;
+        HAL_LOG_WARN("venc chn %d: a QP outside MI's [%d, %d] or an I/P QP delta outside [%d, %d] "
+                     "was clamped into range",
+                     chn, I6C_RC_QP_MIN, I6C_RC_QP_MAX, I6C_RC_DELTA_MIN, I6C_RC_DELTA_MAX);
+    }
+    if ((flags & I6C_RC_F_SWAP) && !x->warned_swap) {
+        x->warned_swap = true;
+        HAL_LOG_WARN("venc chn %d: min_qp is above max_qp in the config; the two were swapped "
+                     "rather than pinning QP to the ceiling",
+                     chn);
+    }
+    if ((flags & I6C_RC_F_NEST) && !x->warned_nest) {
+        x->warned_nest = true;
+        HAL_LOG_WARN("venc chn %d: the I-frame QP bounds were pulled inside the frame QP bounds, "
+                     "which VBR and AVBR require",
+                     chn);
+    }
+}
+
+/*
+ * An MI error code is 0xA0 | module | level | id; id 8 is NOT_SUPPORT. The
+ * driver answers that for a setting this part does not do (super-frame
+ * re-encode on the SSC377D), which raptor should hear as "not supported", not
+ * as an I/O fault.
+ */
+static int i6c_enc_mi_err(int mi)
+{
+    return ((unsigned int)mi & 0xff000000u) == 0xa0000000u && ((unsigned int)mi & 0xfffu) == 8u
+               ? RSS_ERR_NOTSUP
+               : RSS_ERR_IO;
+}
+
+/*
+ * i6c_enc_rate_now -- the rate half this channel's config produces, without
+ * writing it: the one place that knows the mode and the VBR/AVBR frame bounds,
+ * so the RcParam push and the ops read them from it rather than repeat it.
+ */
+static i6c_rc_arm i6c_enc_rate_now(infinity6c_state_t *st, int chn, int *attr_min, int *attr_max)
+{
+    infinity6c_venc_chn_t *enc = &st->enc[chn];
+    i6c_venc_codec codec;
+    i6c_venc_rate rate;
+    i6c_rc_arm arm;
+
+    *attr_min = *attr_max = -1;
+    if (i6c_enc_codec(enc->codec, &codec) != RSS_OK || codec == I6C_VENC_CODEC_MJPG)
+        return I6C_RC_ARM_NONE;
+
+    (void)i6c_enc_fill_rate(&rate, &enc->cfg, codec, &st->enc_rcx[chn]);
+    arm = i6c_rc_arm_of(rate.mode);
+    if (arm == I6C_RC_ARM_VBR) {
+        *attr_min = (int)rate.h264Vbr.minQual;
+        *attr_max = (int)rate.h264Vbr.maxQual;
+    } else if (arm == I6C_RC_ARM_AVBR) {
+        *attr_min = (int)rate.h264Avbr.minQual;
+        *attr_max = (int)rate.h264Avbr.maxQual;
+    }
+
+    return arm;
+}
+
+static void i6c_enc_rc_log(int chn, i6c_rc_arm arm, const i6c_venc_rcparam *p)
+{
+    i6c_rc_fields f;
+
+    i6c_rc_decode(arm, p, &f);
+    if (arm == I6C_RC_ARM_CBR)
+        HAL_LOG_INFO("venc chn %d: RcParam %s: QP [%d, %d], I QP [%d, %d], I/P delta %d, "
+                     "I/P prop %d, max I %u, max P %u (applies with the next frame)",
+                     chn, i6c_rc_arm_name(arm), f.min_qp, f.max_qp, f.min_iqp, f.max_iqp,
+                     f.ip_delta, f.max_ip_prop, f.max_i_size, f.max_p_size);
+    else
+        HAL_LOG_INFO("venc chn %d: RcParam %s: I QP [%d, %d], I/P delta %d, change pos %d, "
+                     "I/P prop %d, max I %u, max P %u (applies with the next frame)",
+                     chn, i6c_rc_arm_name(arm), f.min_iqp, f.max_iqp, f.ip_delta, f.change_pos,
+                     f.max_ip_prop, f.max_i_size, f.max_p_size);
+}
+
+/*
+ * i6c_enc_push_rc -- send this channel's RcParam, if it has one to send.
+ *
+ * Nothing at all for a channel nobody configured, for MJPEG and for fixed QP
+ * (which has no arm: its I/P pair is in the channel attribute). Otherwise
+ * GetRcParam for the driver's live values, the record over them
+ * (i6c_rc_build), and SetRcParam. Get is synchronous; Set is deferred to the
+ * next frame and checks nothing, so its return proves only that the call
+ * arrived.
+ *
+ * Called at the end of every create and every rate reapply, and from each op.
+ * Whether a channel-attribute write resets RcParam is not known, and the mode
+ * may have changed which arm applies, so the push after a reapply is
+ * unconditional.
+ */
+static int i6c_enc_push_rc(infinity6c_state_t *st, int chn)
+{
+    infinity6c_venc_chn_t *enc = &st->enc[chn];
+    i6c_venc_rcx_t *x = &st->enc_rcx[chn];
+    i6c_venc_rcparam base, out;
+    i6c_rc_want want;
+    i6c_rc_arm arm;
+    int attr_min, attr_max;
+    int ret;
+
+    if (!enc->created)
+        return RSS_OK;
+
+    arm = i6c_enc_rate_now(st, chn, &attr_min, &attr_max);
+    if (!i6c_rc_want_of(x, arm, enc->cfg.min_qp, enc->cfg.max_qp, enc->cfg.ip_delta, attr_min,
+                        attr_max, &want))
+        return RSS_OK;
+
+    if (!st->venc.get_rc_param || !st->venc.set_rc_param) {
+        if (!x->warned_nosym) {
+            x->warned_nosym = true;
+            HAL_LOG_WARN("venc chn %d: this libmi_venc.so has no MI_VENC_Get/SetRcParam, so the "
+                         "QP bounds, the I/P delta and the frame-size cap are not applied",
+                         chn);
+        }
+        return RSS_ERR_NOTSUP;
+    }
+
+    memset(&base, 0, sizeof(base));
+    if ((ret = st->venc.get_rc_param(enc->device, (unsigned int)chn, &base)) != 0) {
+        HAL_LOG_ERR("MI_VENC_GetRcParam(chn %d) failed: %d", chn, ret);
+        return RSS_ERR_IO;
+    }
+
+    i6c_enc_rc_note(st, chn, i6c_rc_build(arm, &base, &want, &out));
+
+    if ((ret = st->venc.set_rc_param(enc->device, (unsigned int)chn, &out)) != 0) {
+        HAL_LOG_ERR("MI_VENC_SetRcParam(chn %d) failed: %#x", chn, (unsigned int)ret);
+        return i6c_enc_mi_err(ret);
+    }
+
+    i6c_enc_rc_log(chn, arm, &out);
+    return RSS_OK;
+}
+
+/*
+ * i6c_enc_push_superfrm -- the super-frame config and its RC priority, as last
+ * asked. The config first: the driver may refuse it (re-encode is
+ * NOT_SUPPORT on the SSC377D), and a priority already changed would then be
+ * left behind for a mode that never took.
+ */
+static int i6c_enc_push_superfrm(infinity6c_state_t *st, int chn)
+{
+    infinity6c_venc_chn_t *enc = &st->enc[chn];
+    i6c_venc_rcx_t *x = &st->enc_rcx[chn];
+    i6c_venc_superfrm sf;
+    uint32_t prio;
+    int ret;
+
+    if (!enc->created || !x->superfrm_set || enc->device == I6C_VENC_DEV_MJPG_0)
+        return RSS_OK;
+
+    if (!st->venc.set_superfrm || !st->venc.set_rc_prio) {
+        if (!x->warned_nosym) {
+            x->warned_nosym = true;
+            HAL_LOG_WARN("venc chn %d: this libmi_venc.so has no MI_VENC_SetSuperFrameCfg or "
+                         "SetRcPriority, so the super-frame setting is not applied",
+                         chn);
+        }
+        return RSS_ERR_NOTSUP;
+    }
+
+    sf = x->superfrm;
+    if ((ret = st->venc.set_superfrm(enc->device, (unsigned int)chn, &sf)) != 0) {
+        HAL_LOG_ERR("MI_VENC_SetSuperFrameCfg(chn %d, mode %u) failed: %#x", chn, sf.mode,
+                    (unsigned int)ret);
+        return i6c_enc_mi_err(ret);
+    }
+
+    prio = x->priority;
+    if ((ret = st->venc.set_rc_prio(enc->device, (unsigned int)chn, &prio)) != 0) {
+        HAL_LOG_ERR("MI_VENC_SetRcPriority(chn %d, %u) failed: %#x", chn, prio, (unsigned int)ret);
+        return i6c_enc_mi_err(ret);
+    }
+
+    HAL_LOG_INFO("venc chn %d: super frame mode %u, I %u bits, P %u bits, priority %s", chn,
+                 sf.mode, sf.iBitsThr, sf.pBitsThr,
+                 prio == I6C_VENC_RCPRIO_FRAMEBITS ? "frame bits" : "bitrate");
+    return RSS_OK;
+}
+
+/*
+ * Both pushes, for the create and reapply paths. Failures are logged by the
+ * pushes and not propagated: a stream whose extras could not be applied still
+ * runs, as it did before they existed.
+ */
+static void i6c_enc_push_extras(infinity6c_state_t *st, int chn)
+{
+    (void)i6c_enc_push_rc(st, chn);
+    (void)i6c_enc_push_superfrm(st, chn);
 }
 
 /* ================================================================
@@ -1067,6 +1306,8 @@ static int i6c_enc_pool(infinity6c_state_t *st, unsigned int device, const rss_v
 int hal_enc_create_channel(void *ctx, int chn, const rss_video_config_t *cfg)
