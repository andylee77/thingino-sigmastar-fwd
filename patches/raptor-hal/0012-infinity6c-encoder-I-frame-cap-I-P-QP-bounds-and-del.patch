+/*
+ * t_venc_rc_i6c.c -- host test for the infinity6c encoder rate-control extras
+ * (src/infinity6c/i6c_venc_rc.h). No HAL, no MI, no target:
+ *
+ *   cc -std=c11 -Wall -Wextra -Werror -Iinclude -Isrc/infinity6c -o /tmp/t_venc_rc_i6c \
+ *      tests/t_venc_rc_i6c.c && /tmp/t_venc_rc_i6c
+ *
+ * Offsets are checked as raw words, the way the driver reads them, not through
+ * the struct that defines them.
+ */
+#include <stdio.h>
+
+#include "i6c_venc_rc.h"
+
+static int failures;
+
+#define CHECK(cond, ...)                                                        \
+    do {                                                                        \
+        if (!(cond)) {                                                          \
+            printf("FAIL %s:%d: ", __FILE__, __LINE__);                         \
+            printf(__VA_ARGS__);                                                \
+            printf("\n");                                                       \
+            failures++;                                                         \
+        }                                                                       \
+    } while (0)
+
+static uint32_t word(const i6c_venc_rcparam *p, unsigned off)
+{
+    uint32_t v;
+
+    memcpy(&v, (const char *)p + off, sizeof(v));
+    return v;
+}
+
+static void put(i6c_venc_rcparam *p, unsigned off, uint32_t v)
+{
+    memcpy((char *)p + off, &v, sizeof(v));
+}
+
+/* A base as GetRcParam returns it: the arm's words up to `upto`, the rest 0. */
+static void base_words(i6c_venc_rcparam *p, const uint32_t *w, unsigned n)
+{
+    unsigned i;
+
+    memset(p, 0, sizeof(*p));
+    for (i = 0; i < n; i++)
+        put(p, 12 + 4 * i, w[i]);
+}
+
+static void test_layout(void)
+{
+    CHECK(sizeof(i6c_venc_rcparam) == 56, "rcparam is %zu", sizeof(i6c_venc_rcparam));
+    CHECK(sizeof(i6c_venc_superfrm) == 16, "superfrm is %zu", sizeof(i6c_venc_superfrm));
+    CHECK(offsetof(i6c_venc_rcparam, avbr.minStillPercent) == 40, "AVBR still%% at +40");
+    CHECK(offsetof(i6c_venc_rcparam, vbr.minIQp) == 24, "VBR MinIQp at +24");
+    CHECK(offsetof(i6c_venc_rcparam, avbr.minIQp) == 20, "AVBR MinIQp at +20");
+    CHECK(offsetof(i6c_venc_rcparam, cbr.ipQpDelta) == 20, "CBR delta at +20");
+}
+
+static void test_arm_of(void)
+{
+    int m;
+
+    for (m = -1; m < 20; m++) {
+        i6c_rc_arm want = I6C_RC_ARM_NONE;
+
+        if (m == 1 || m == 10)
+            want = I6C_RC_ARM_CBR;
+        else if (m == 2 || m == 11)
+            want = I6C_RC_ARM_VBR;
+        else if (m == 6 || m == 14)
+            want = I6C_RC_ARM_AVBR;
+        CHECK(i6c_rc_arm_of(m) == want, "mode %d -> arm %d", m, i6c_rc_arm_of(m));
+    }
+}
+
+static void test_take_pair(void)
+{
+    int16_t lo, hi;
+    unsigned f;
+
+    f = 0;
+    CHECK(i6c_rc_take_pair(20, 40, &lo, &hi, &f) == RSS_OK && lo == 20 && hi == 40 && !f,
+          "plain pair");
+    f = 0;
+    CHECK(i6c_rc_take_pair(15, 51, &lo, &hi, &f) == RSS_OK && lo == 15 && hi == 48 &&
+              f == I6C_RC_F_RANGE,
+          "raptor's CBR default 15..51 clamps to 15..48");
+    f = 0;
+    CHECK(i6c_rc_take_pair(0, 5, &lo, &hi, &f) == RSS_OK && lo == 12 && hi == 12, "low clamps");
+    f = 0;
+    CHECK(i6c_rc_take_pair(-1, 30, &lo, &hi, &f) == RSS_OK && lo == -1 && hi == 30 && !f,
+          "negative releases a side");
+    f = 0;
+    lo = hi = 99;
+    CHECK(i6c_rc_take_pair(40, 20, &lo, &hi, &f) == RSS_ERR_INVAL && lo == 99 && hi == 99,
+          "inverted pair refused, nothing stored");
+    f = 0;
+    CHECK(i6c_rc_take_pair(50, 49, &lo, &hi, &f) == RSS_OK && lo == 48 && hi == 48,
+          "inverted only before clamping is accepted");
+}
+
+static void test_sizes(void)
+{
+    CHECK(i6c_rc_size_of_kbits(0, 1) == 0, "0 is no cap");
+    CHECK(i6c_rc_size_of_kbits(2700, I6C_RC_SIZE_UNIT_BITS) == 337500,
+          "2700 kbit in the driver's bytes");
+    CHECK(i6c_rc_size_of_kbits(2700, 1) == 2700000, "in bits");
+    CHECK(i6c_rc_size_of_kbits(2700, 1000) == 2700, "in kbits");
+    CHECK(i6c_rc_size_of_kbits(457, 8000) == 57, "in kB, rounded down");
+    CHECK(i6c_rc_size_of_kbits(1, 8000) == 1, "a cap never rounds to 0, which is no cap");
+    CHECK(i6c_rc_size_of_kbits(UINT32_MAX, 1) == UINT32_MAX, "saturates");
+    CHECK(i6c_rc_size_of_kbits(5, 0) == 5000, "a 0 unit is taken as bits");
+}
+
+static void test_frame_bounds(void)
+{
+    unsigned int lo, hi, f;
+
+    f = i6c_rc_frame_bounds(-1, -1, &lo, &hi);
+    CHECK(lo == 20 && hi == 48 && !f, "defaults 20..48 unchanged: %u..%u", lo, hi);
+    f = i6c_rc_frame_bounds(26, 30, &lo, &hi);
+    CHECK(lo == 26 && hi == 30 && !f, "config pair passes");
+    f = i6c_rc_frame_bounds(-1, 15, &lo, &hi);
+    CHECK(lo == 15 && hi == 15 && !f, "default floor yields to a low ceiling: %u..%u", lo, hi);
+    f = i6c_rc_frame_bounds(5, 51, &lo, &hi);
+    CHECK(lo == 12 && hi == 48 && f == I6C_RC_F_RANGE, "out of range clamps");
+    f = i6c_rc_frame_bounds(48, 20, &lo, &hi);
+    CHECK(lo == 20 && hi == 48 && (f & I6C_RC_F_SWAP), "inverted config swapped");
+}
+
+static void test_fixqp(void)
+{
+    i6c_venc_rcx_t x;
+    unsigned int i, p, f;
+
+    memset(&x, 0, sizeof(x));
+    f = i6c_rc_fixqp(-1, &x, -1, &i, &p);
+    CHECK(i == 30 && p == 30 && !f, "default 30/30");
+    f = i6c_rc_fixqp(50, &x, -1, &i, &p);
+    CHECK(i == 50 && p == 50 && !f, "nothing asked: init_qp as it always was, unclamped");
+
+    f = i6c_rc_fixqp(30, &x, 3, &i, &p);
+    CHECK(p == 30 && i == 27 && !f, "config ip_delta splits: I %u P %u", i, p);
+
+    x.delta_set = true;
+    x.ip_delta = -4;
+    f = i6c_rc_fixqp(30, &x, 3, &i, &p);
+    CHECK(p == 30 && i == 34, "runtime delta wins over the config's: I %u P %u", i, p);
+
+    x.qp_set = true;
+    x.qp = 46;
+    f = i6c_rc_fixqp(30, &x, -1, &i, &p);
+    CHECK(p == 46 && i == 48 && f == I6C_RC_F_RANGE, "I clamps to 48: I %u P %u", i, p);
+
+    x.delta_set = false;
+    x.qp = 20;
+    f = i6c_rc_fixqp(30, &x, -1, &i, &p);
+    CHECK(p == 20 && i == 20 && !f, "qp alone sets both");
+}
+
+static void test_priority(void)
+{
+    bool forced;
+
+    CHECK(i6c_rc_priority(RSS_SUPERFRM_REENCODE, RSS_RC_PRIO_BITRATE, &forced) ==
+                  I6C_VENC_RCPRIO_FRAMEBITS &&
+              forced,
+          "re-encode forces frame bits over rvd's bitrate");
+    CHECK(i6c_rc_priority(RSS_SUPERFRM_REENCODE, RSS_RC_PRIO_FRAMEBITS, &forced) ==
+                  I6C_VENC_RCPRIO_FRAMEBITS &&
+              !forced,
+          "frame bits asked: not forced");
+    CHECK(i6c_rc_priority(RSS_SUPERFRM_DISCARD, RSS_RC_PRIO_BITRATE, &forced) ==
+                  I6C_VENC_RCPRIO_BITRATE &&
+              !forced,
+          "discard keeps bitrate");
+    CHECK(i6c_rc_priority(RSS_SUPERFRM_NONE, RSS_RC_PRIO_RDO, &forced) == I6C_VENC_RCPRIO_BITRATE,
+          "RDO maps to bitrate");
+}
+
+static void test_want_of(void)
+{
+    i6c_venc_rcx_t x;
+    i6c_rc_want w;
+
+    memset(&x, 0, sizeof(x));
+    CHECK(!i6c_rc_want_of(&x, I6C_RC_ARM_CBR, -1, -1, -1, -1, -1, &w),
+          "nobody configured CBR: no push");
+    CHECK(!i6c_rc_want_of(&x, I6C_RC_ARM_VBR, 20, 40, -1, 20, 40, &w),
+          "VBR config bounds live in the attribute: no push");
+    CHECK(i6c_rc_want_of(&x, I6C_RC_ARM_CBR, 20, -1, -1, -1, -1, &w) && w.min_qp == 20 &&
+              w.max_qp == -1,
+          "CBR config bounds have nowhere else to go: push");
+    CHECK(i6c_rc_want_of(&x, I6C_RC_ARM_AVBR, -1, -1, 0, 20, 48, &w) && w.has_delta &&
+              w.ip_delta == 0,
+          "config ip_delta 0 is a real request");
+    CHECK(!i6c_rc_want_of(&x, I6C_RC_ARM_NONE, 20, 40, 2, -1, -1, &w), "fixed QP has no arm");
+
+    x.any = true;
+    x.max_i_size = 800000;
+    CHECK(i6c_rc_want_of(&x, I6C_RC_ARM_VBR, -1, -1, -1, 20, 48, &w) && w.min_qp == 20 &&
+              w.max_qp == 48 && w.max_i_size == 800000 && w.min_iqp == -1 && !w.has_delta,
+          "VBR request carries the attribute bounds and the cap");
+
+    /* Released by an op: MI's full range, not the driver's last value. */
+    x.frame_set = true;
+    x.min_qp = x.max_qp = -1;
+    x.iframe_set = true;
+    x.min_iqp = -1;
+    x.max_iqp = 34;
+    CHECK(i6c_rc_want_of(&x, I6C_RC_ARM_CBR, -1, -1, -1, -1, -1, &w) && w.min_qp == 12 &&
+              w.max_qp == 48 && w.min_iqp == 12 && w.full_min_i && w.max_iqp == 34 &&
+              !w.full_max_i,
+          "released sides: %d..%d, I %d..%d", w.min_qp, w.max_qp, w.min_iqp, w.max_iqp);
+}
+
+static void test_build_cbr(void)
+{
+    /* Get's six CBR words: MaxQp, MinQp, delta, MaxIQp, MinIQp, MaxIPProp. */
+    static const uint32_t get[] = {48, 12, 0, 48, 12, 80};
+    i6c_venc_rcparam base, out;
+    i6c_rc_want w;
+    unsigned f;
+
+    base_words(&base, get, 6);
+    put(&base, 0, 7); /* a common word the driver says it does not support */
+    put(&base, 52, 0xdeadbeef);
+    memset(&w, 0, sizeof(w));
+    w.min_qp = 20;
+    w.max_qp = 40;
+    w.min_iqp = 25;
+    w.max_iqp = 45;
+    w.has_delta = true;
+    w.ip_delta = 2;
+    w.max_i_size = 640000;
+    w.max_p_size = 0;
+
+    f = i6c_rc_build(I6C_RC_ARM_CBR, &base, &w, &out);
+    CHECK(!f, "clean CBR build, flags %#x", f);
+    CHECK(word(&out, 12) == 40 && word(&out, 16) == 20, "frame bounds at +12/+16");
+    CHECK((int32_t)word(&out, 20) == 2, "delta at +20");
+    CHECK(word(&out, 24) == 45 && word(&out, 28) == 25,
+          "CBR I bounds independent of the frame pair");
+    CHECK(word(&out, 32) == 80, "MaxIPProp kept from the driver");
+    CHECK(word(&out, 36) == 640000 && word(&out, 40) == 0,
+          "cap written though Get never returns it");
+    CHECK(word(&out, 0) == 0 && word(&out, 4) == 0 && word(&out, 8) == 0 && word(&out, 52) == 0,
+          "common words and the reserved pointer go out zero");
+
+    /* One side asked, the driver's other side in the way: the asked side wins. */
+    {
+        static const uint32_t get2[] = {40, 30, 0, 48, 12, 80};
+
+        base_words(&base, get2, 6);
+        memset(&w, 0, sizeof(w));
+        w.min_qp = -1;
+        w.max_qp = 25;
+        w.min_iqp = w.max_iqp = -1;
+        f = i6c_rc_build(I6C_RC_ARM_CBR, &base, &w, &out);
+        CHECK(word(&out, 12) == 25 && word(&out, 16) == 25 && !f, "min follows an asked max");
+    }
+
+    /* Asked values clamp; a wild delta clamps; size 0 clears a cap. */
+    base_words(&base, get, 6);
+    memset(&w, 0, sizeof(w));
+    w.min_qp = 10;
+    w.max_qp = 51;
+    w.min_iqp = w.max_iqp = -1;
+    w.has_delta = true;
+    w.ip_delta = 20;
+    f = i6c_rc_build(I6C_RC_ARM_CBR, &base, &w, &out);
+    CHECK(f == I6C_RC_F_RANGE, "flags %#x", f);
+    CHECK(word(&out, 12) == 48 && word(&out, 16) == 12 && (int32_t)word(&out, 20) == 12,
+          "clamped: %u %u %d", word(&out, 12), word(&out, 16), (int32_t)word(&out, 20));
+    CHECK(word(&out, 36) == 0, "no cap asked, none sent");
+}
+
+static void test_build_vbr(void)
+{
+    /* Get's five VBR words: delta, ChangePos, MaxIQp, MinIQp, MaxIPProp. */
+    static const uint32_t get[] = {0, 90, 48, 12, 80};
+    i6c_venc_rcparam base, out;
+    i6c_rc_want w;
+    unsigned f;
+
+    base_words(&base, get, 5);
+    put(&base, 32, 0x55555555); /* whatever sits past Get's five words */
+    memset(&w, 0, sizeof(w));
+    w.min_qp = 20; /* the channel attribute's */
+    w.max_qp = 40;
+    w.min_iqp = w.max_iqp = -1;
+    w.max_i_size = 1000000;
+
+    f = i6c_rc_build(I6C_RC_ARM_VBR, &base, &w, &out);
+    CHECK(!f, "flags %#x", f);
+    CHECK(word(&out, 16) == 90, "ChangePos kept at +16");
+    CHECK(word(&out, 20) == 48 && word(&out, 24) == 12,
+          "the driver's own I bounds go back untouched: max %u min %u", word(&out, 20),
+          word(&out, 24));
+    CHECK(word(&out, 32) == 1000000 && word(&out, 36) == 0, "VBR cap at +32, P at +36");
+
+    /*
+     * The bench case: MaxIPProp reported as 0, outside the doc's [5, 100]. It
+     * must go back as 0 -- raised to 5 it halved the I-frames.
+     */
+    put(&base, 28, 0);
+    f = i6c_rc_build(I6C_RC_ARM_VBR, &base, &w, &out);
+    CHECK(!f && word(&out, 28) == 0, "MaxIPProp 0 passes through: %u, flags %#x",
+          word(&out, 28), f);
+    put(&base, 28, 80);
+
+    /* A released I side is the full range, nested without a warning. */
+    w.min_iqp = 12;
+    w.full_min_i = true;
+    w.max_iqp = 45;
+    f = i6c_rc_build(I6C_RC_ARM_VBR, &base, &w, &out);
+    CHECK(f == I6C_RC_F_NEST && word(&out, 24) == 20 && word(&out, 20) == 40,
+          "released min nests quietly, asked max warns: flags %#x", f);
+    w.full_min_i = false;
+
+    w.min_iqp = 10;
+    w.max_iqp = 45;
+    f = i6c_rc_build(I6C_RC_ARM_VBR, &base, &w, &out);
+    CHECK((f & I6C_RC_F_NEST) && (f & I6C_RC_F_RANGE), "asked I bounds pulled in, flags %#x", f);
+    CHECK(word(&out, 20) == 40 && word(&out, 24) == 20, "max %u min %u", word(&out, 20),
+          word(&out, 24));
+
+    w.min_iqp = 28;
+    w.max_iqp = 34;
+    f = i6c_rc_build(I6C_RC_ARM_VBR, &base, &w, &out);
+    CHECK(!f && word(&out, 20) == 34 && word(&out, 24) == 28, "I bounds inside pass");
+
+    /* Any driver value nobody asked about goes back as reported. */
+    put(&base, 16, 0);
+    f = i6c_rc_build(I6C_RC_ARM_VBR, &base, &w, &out);
+    CHECK(!f && word(&out, 16) == 0, "ChangePos 0 kept, flags %#x", f);
+}
+
+static void test_build_avbr(void)
+{
+    /* All ten AVBR words come back. */
+    static const uint32_t get[] = {0, 80, 12, 70, 48, 0, 0, 30, 0, 100};
+    i6c_venc_rcparam base, out;
+    i6c_rc_want w;
+    unsigned f;
+
+    base_words(&base, get, 10);
+    memset(&w, 0, sizeof(w));
+    w.min_qp = 22;
+    w.max_qp = 44;
+    w.min_iqp = 30;
+    w.max_iqp = 40;
+    w.has_delta = true;
+    w.ip_delta = -3;
+    w.max_i_size = 500000;
+    w.max_p_size = 60000;
+
+    f = i6c_rc_build(I6C_RC_ARM_AVBR, &base, &w, &out);
+    CHECK(!f, "flags %#x", f);
+    CHECK((int32_t)word(&out, 12) == -3 && word(&out, 16) == 80, "delta, ChangePos");
+    CHECK(word(&out, 20) == 30 && word(&out, 24) == 70 && word(&out, 28) == 40,
+          "AVBR order: MinIQp +20, MaxIPProp +24, MaxIQp +28");
+    CHECK(word(&out, 32) == 500000 && word(&out, 36) == 60000, "caps at +32/+36");
+    CHECK(word(&out, 40) == 30 && word(&out, 48) == 100, "still%% and motion kept");
+}
