+        (int (*)(unsigned int, unsigned int, uint32_t *))dlsym(venc->lib, "MI_VENC_GetRcPriority");
+
+    if (!venc->set_rc_param || !venc->get_rc_param || !venc->set_superfrm ||
+        !venc->get_superfrm || !venc->set_rc_prio || !venc->get_rc_prio)
+        HAL_LOG_INFO("i6c_venc: no RcParam/SuperFrameCfg/RcPriority calls in libmi_venc.so; "
+                     "the encoder's rate-control extras answer not supported");
+
     return RSS_OK;
 }
 
diff --git a/src/infinity6c/i6c_venc_rc.h b/src/infinity6c/i6c_venc_rc.h
new file mode 100644
index 0000000..066ee9a
--- /dev/null
+++ b/src/infinity6c/i6c_venc_rc.h
@@ -0,0 +1,663 @@
+/*
+ * infinity6c/i6c_venc_rc.h -- MI_VENC rate-control extras for MI 3.0: the
+ * RcParam arms, the super-frame config and the RC priority, and the pure logic
+ * that turns raptor's settings into them.
+ *
+ * Local rather than in sigmastar-headers/, which is vendored verbatim and never
+ * edited in place (FORK.md). The ABI half is a candidate for
+ * johnchia/sigmastar-headers once the bench has proven it.
+ *
+ * Pure: no HAL, no MI, no dlopen, so tests/t_venc_rc_i6c.c includes it on the
+ * build host. hal_encoder.c makes the MI calls.
+ *
+ * THE ABI, and where it was checked
+ *
+ * Against what the images ship: the monolithic mi.ko (the SDK's 1230 drop) and
+ * libmi_venc.so. The SDK tree's 0907 mi_venc.ko numbers rate modes differently
+ * and is not shipped; do not take offsets or mode numbers from it.
+ *
+ * - MI_VENC_RcParam_t is 56 bytes: SetRcParam's ioctl (0x40406936) carries 64,
+ *   two id words and the struct, and the library copies 3 x 16 + 8 bytes.
+ *   RC_TEXTURE_THR_SIZE is 1, so the arms start at +12.
+ * - The arms are as the SigmaStar MI V2 VENC doc prints them, and the driver's
+ *   apply (mi.ko 0x87520) confirms the order: H.264 CBR (mode 1) forwards
+ *   +12..+40, VBR (2) +12..+36 reordered into its internal AVBR shape, AVBR (6)
+ *   +12..+48; H.265 CBR, VBR and AVBR (10, 11, 14) are identical.
+ * - MI_VENC_SuperFrameCfg_t is 16 bytes {mode, I, P, B thresholds}, the
+ *   thresholds in bits (doc; ioctl 0x4018693e and the driver's trace string).
+ * - MI_VENC_SetRcPriority takes a *pointer* to the enum on MI 3.0, where the V2
+ *   doc's prototype passes it by value: the shipped library NULL-checks its
+ *   third argument and loads the priority through it (ioctl 0x400c6940). The
+ *   driver accepts 1..2 only.
+ *
+ * Two driver behaviours shape hal_encoder.c rather than this file:
+ *
+ * - SetRcParam is deferred. MI_VENC_IMPL_SetRcParam checks only the codec,
+ *   copies the 56 bytes into the channel context and sets a dirty byte; the
+ *   encode task applies them when the next frame is queued. A successful return
+ *   proves nothing about the values, which is why i6c_rc_build keeps every
+ *   asked-for field inside its documented range itself.
+ * - GetRcParam returns six CBR words and five VBR words: MaxISize and MaxPSize
+ *   never come back for those two modes, although the apply forwards them. A
+ *   Get-modify-Set round trip would zero the cap, so the HAL owns both fields
+ *   and writes them from its own record every time.
+ */
+#ifndef INFINITY6C_I6C_VENC_RC_H
+#define INFINITY6C_I6C_VENC_RC_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "raptor_hal.h"
+
+/* ================================================================
+ * ABI
+ * ================================================================ */
+
+/*
+ * The rate modes the RcParam arms belong to, in the UBR numbering the shipped
+ * driver speaks (see i6c_enc_fill_rate). Spelled out here so this header stays
+ * pure; hal_encoder.c asserts each against i6c_venc_ratemode_ubr.
+ */
+enum {
+    I6C_RC_MODE_H264CBR = 1,
+    I6C_RC_MODE_H264VBR = 2,
+    I6C_RC_MODE_H264AVBR = 6,
+    I6C_RC_MODE_H265CBR = 10,
+    I6C_RC_MODE_H265VBR = 11,
+    I6C_RC_MODE_H265AVBR = 14,
+};
+
+/* MI_VENC_ParamH264Cbr_t and ParamH265Cbr_t. */
+typedef struct {
+    uint32_t maxQp;     /* frame bounds: CBR's channel attribute has none */
+    uint32_t minQp;
+    int32_t ipQpDelta;  /* [-12, 12] */
+    uint32_t maxIQp;    /* independent of the frame pair in CBR */
+    uint32_t minIQp;
+    uint32_t maxIPProp; /* [5, 100] */
+    uint32_t maxISize;  /* 0 = no cap; the unit is undocumented, see I6C_RC_SIZE_PER_KBIT */
+    uint32_t maxPSize;
+} i6c_venc_rc_cbr;
+
+/* MI_VENC_ParamH264Vbr_t and ParamH265Vbr_t. */
+typedef struct {
+    int32_t ipQpDelta;
+    int32_t changePos;  /* [5, 100] */
+    uint32_t maxIQp;    /* (MinQp, MaxQp]: inside the channel attribute's frame bounds */
+    uint32_t minIQp;    /* [MinQp, MaxQp) */
+    uint32_t maxIPProp;
+    uint32_t maxISize;
+    uint32_t maxPSize;
+} i6c_venc_rc_vbr;
+
+/*
+ * MI_VENC_ParamH264Avbr_t and ParamH265Avbr_t. MinIQp and MaxIQp sit the other
+ * way round from VBR's, with MaxIPProp between them -- the vendor's order, which
+ * the driver's own VBR reorder confirms.
+ */
+typedef struct {
+    int32_t ipQpDelta;          /* default 0 */
+    int32_t changePos;          /* default 80 */
+    uint32_t minIQp;            /* default 12 */
+    uint32_t maxIPProp;
+    uint32_t maxIQp;            /* default 48 */
+    uint32_t maxISize;
+    uint32_t maxPSize;
+    uint32_t minStillPercent;   /* [5, 100] */
+    uint32_t maxStillQp;        /* "not supported yet" */
+    uint32_t motionSensitivity; /* [0, 100], default 100 */
+} i6c_venc_rc_avbr;
+
+typedef struct {
+    uint32_t thrdI[1];   /* "not supported yet": written 0 */
+    uint32_t thrdP[1];
+    uint32_t rowQpDelta;
+    union {
+        i6c_venc_rc_cbr cbr;
+        i6c_venc_rc_vbr vbr;
+        i6c_venc_rc_avbr avbr;
+    };
+    /*
+     * MI_VOID *pRcParam, reserved and written NULL. A u32 rather than a pointer:
+     * on the 32-bit target the two are the same four bytes, and this way the
+     * layout -- and the asserts below -- hold on the build host too.
+     */
+    uint32_t rcParamPtr;
+} i6c_venc_rcparam;
+
+#define I6C_VENC_SUPERFRM_NONE 0u
+#define I6C_VENC_SUPERFRM_DISCARD 1u
+/* Raise QP by 4 and encode again, up to four times, then discard (vendor doc). */
+#define I6C_VENC_SUPERFRM_REENCODE 2u
+
+typedef struct {
+    uint32_t mode;
+    uint32_t iBitsThr; /* bits */
+    uint32_t pBitsThr;
+    uint32_t bBitsThr; /* no B frames on this backend: 0 */
+} i6c_venc_superfrm;
+
+/* MI_VENC_RcPriority_e. Under bitrate-first, an oversized frame is not re-encoded. */
+#define I6C_VENC_RCPRIO_BITRATE 1u
+#define I6C_VENC_RCPRIO_FRAMEBITS 2u
+
+_Static_assert(sizeof(i6c_venc_rcparam) == 56, "SetRcParam's ioctl carries two ids and 56 bytes");
+_Static_assert(offsetof(i6c_venc_rcparam, cbr) == 12, "the arms follow ThrdI, ThrdP and RowQpDelta");
+_Static_assert(offsetof(i6c_venc_rcparam, cbr.maxISize) == 36, "CBR's apply forwards up to +40");
+_Static_assert(offsetof(i6c_venc_rcparam, cbr.maxPSize) == 40, "CBR's last forwarded word");
+_Static_assert(offsetof(i6c_venc_rcparam, vbr.maxISize) == 32, "VBR's apply forwards up to +36");
+_Static_assert(offsetof(i6c_venc_rcparam, vbr.maxPSize) == 36, "VBR's last forwarded word");
+_Static_assert(offsetof(i6c_venc_rcparam, avbr.maxIQp) == 28, "AVBR puts MaxIQp after MaxIPProp");
+_Static_assert(offsetof(i6c_venc_rcparam, avbr.motionSensitivity) == 48, "AVBR forwards up to +48");
+_Static_assert(offsetof(i6c_venc_rcparam, rcParamPtr) == 52, "the reserved pointer closes the 56");
+_Static_assert(sizeof(i6c_venc_superfrm) == 16, "SetSuperFrameCfg's ioctl carries two ids and 16");
+
+/* ================================================================
+ * RANGES AND UNITS
+ * ================================================================ */
+
+/* Every QP field's documented range, frame and I-frame bounds and fixed QP alike. */
+#define I6C_RC_QP_MIN 12
+#define I6C_RC_QP_MAX 48
+#define I6C_RC_DELTA_MIN (-12)
+#define I6C_RC_DELTA_MAX 12
+/* ChangePos, MaxIPProp and MinStillPercent. */
+#define I6C_RC_PCT_MIN 5
+#define I6C_RC_PCT_MAX 100
+
+/* The VBR/AVBR frame bounds this HAL has always used when the config names none. */
+#define I6C_RC_VBR_MIN_QP 20
+#define I6C_RC_VBR_MAX_QP 48
+
+/* The fixed QP when init_qp is unset, likewise long-standing. */
+#define I6C_RC_FIXQP_DEFAULT 30
+
+/*
+ * Bits per driver unit of MaxISize/MaxPSize: 8, the fields count bytes.
+ * raptor's set-max-pic-size speaks kbits, and the doc gives these two fields
+ * no unit (the super-frame thresholds, the only sizes it does, are bits).
+ * Measured on an SSC377D, VBR, 232 KB natural keyframes: 300,000 units changed
+ * nothing and 100,000 settled them at ~130 KB, which only bytes explains (as
+ * bits both caps sit far below the frame, as kbits both far above). The cap is
+ * soft -- rate control "tries", landing ~1.3x over -- and a cap of a few
+ * hundred units does no more than one just under the frame.
+ * RSS_VENC_SIZE_UNIT_BITS overrides it for another driver drop.
+ */
+#define I6C_RC_SIZE_UNIT_BITS 8u
+
+/* ================================================================
+ * THE PER-CHANNEL RECORD
+ * ================================================================ */
+
+/*
+ * What the extras ops were asked, per encoder channel.
+ *
+ * Kept apart from infinity6c_venc_chn_t because rvd destroys and re-creates a
+ * channel on set-resolution and set-codec, and hal_enc_destroy_channel clears
+ * that struct. This one is cleared only by i6c_teardown_all, so a re-created
+ * channel gets its settings back. After an rvd restart it starts empty and the
+ * config file rules again.
+ *
+ * All zero is "nothing asked", so the calloc'd state needs no initialiser.
+ */
+typedef struct {
+    /* An RcParam op was called: push RcParam on every create and reapply from now on. */
+    bool any;
+
+    /*
+     * Frame bounds from set-qp-bounds or the P pair of set-qp-bounds-per-frame,
+     * -1 for a side released back to the config. They override the config's at
+     * create, because rvd's per-frame handler does not update its own copy.
+     */
+    bool frame_set;
+    int16_t min_qp, max_qp;
+
+    /* I-frame bounds from set-qp-bounds-per-frame; -1 = released, MI's full range. */
+    bool iframe_set;
+    int16_t min_iqp, max_iqp;
+
+    /* s32IPQPDelta from enc-set qp_ip_delta; also splits the fixed-QP pair. */
+    bool delta_set;
+    int16_t ip_delta;
+
+    /* The fixed-QP P-frame QP from enc-set qp; unset = init_qp. */
+    bool qp_set;
+    int16_t qp;
+
+    /* MaxISize and MaxPSize in driver units, 0 = no cap. Owned here, see above. */
+    uint32_t max_i_size;
+    uint32_t max_p_size;
+
+    /* The super-frame config and RC priority exactly as sent. */
+    bool superfrm_set;
+    i6c_venc_superfrm superfrm;
+    uint32_t priority;
+
+    /* Each warning once per channel, not per push. */
+    bool warned_range;
+    bool warned_swap;
+    bool warned_nest;
+    bool warned_prio;
+    bool warned_nosym;
+} i6c_venc_rcx_t;
+
+/* ================================================================
+ * PURE LOGIC
+ * ================================================================ */
+
+/* Which arm a rate mode fills; NONE for fixed QP, MJPEG and anything unknown. */
+typedef enum {
+    I6C_RC_ARM_NONE = 0,
+    I6C_RC_ARM_CBR,
+    I6C_RC_ARM_VBR,
+    I6C_RC_ARM_AVBR,
+} i6c_rc_arm;
+
+static inline i6c_rc_arm i6c_rc_arm_of(int mode)
+{
+    switch (mode) {
+    case I6C_RC_MODE_H264CBR:
+    case I6C_RC_MODE_H265CBR:
+        return I6C_RC_ARM_CBR;
+    case I6C_RC_MODE_H264VBR:
+    case I6C_RC_MODE_H265VBR:
+        return I6C_RC_ARM_VBR;
+    case I6C_RC_MODE_H264AVBR:
+    case I6C_RC_MODE_H265AVBR:
+        return I6C_RC_ARM_AVBR;
+    default:
+        return I6C_RC_ARM_NONE;
+    }
+}
+
+static inline const char *i6c_rc_arm_name(i6c_rc_arm arm)
+{
+    return arm == I6C_RC_ARM_CBR ? "CBR" : arm == I6C_RC_ARM_VBR ? "VBR" :
+           arm == I6C_RC_ARM_AVBR ? "AVBR" : "none";
+}
+
+/*
+ * Flags the builders return, so the caller can say each thing once.
+ *   RANGE: a value raptor asked for was pulled into MI's range.
+ *   SWAP:  a config QP pair was the wrong way round and was swapped.
+ *   NEST:  asked-for I-frame bounds were pulled inside VBR/AVBR's frame bounds.
+ */
+#define I6C_RC_F_RANGE 0x1u
+#define I6C_RC_F_SWAP 0x2u
+#define I6C_RC_F_NEST 0x4u
+
+static inline int i6c_rc_clamp(int v, int lo, int hi, unsigned *flags, unsigned flag)
+{
+    if (v < lo) {
+        *flags |= flag;
+        return lo;
+    }
+    if (v > hi) {
+        *flags |= flag;
+        return hi;
+    }
+    return v;
+}
+
+/*
+ * i6c_rc_take_pair -- a QP pair as an op gave it.
+ *
+ * A negative side releases that side; the others clamp to [12, 48]. raptor's
+ * documented CBR defaults (15..51) reach past 48, so rejecting out-of-range
+ * values would break stock configs. A pair still the wrong way round after
+ * clamping is RSS_ERR_INVAL, and nothing is stored.
+ */
+static inline int i6c_rc_take_pair(int min, int max, int16_t *out_min, int16_t *out_max,
+                                   unsigned *flags)
+{
+    int lo = min < 0 ? -1 : i6c_rc_clamp(min, I6C_RC_QP_MIN, I6C_RC_QP_MAX, flags, I6C_RC_F_RANGE);
+    int hi = max < 0 ? -1 : i6c_rc_clamp(max, I6C_RC_QP_MIN, I6C_RC_QP_MAX, flags, I6C_RC_F_RANGE);
+
+    if (lo >= 0 && hi >= 0 && lo > hi)
+        return RSS_ERR_INVAL;
+
+    *out_min = (int16_t)lo;
+    *out_max = (int16_t)hi;
+    return RSS_OK;
+}
+
+/*
+ * set-max-pic-size's kbits in driver units of unit_bits bits each: saturating
+ * rather than wrapping, and never rounding a cap down to 0, which is "no cap".
+ */
+static inline uint32_t i6c_rc_size_of_kbits(uint32_t kbits, uint32_t unit_bits)
+{
+    uint64_t units;
+
+    if (!kbits)
+        return 0;
+    units = (uint64_t)kbits * 1000u / (unit_bits ? unit_bits : 1u);
+    if (!units)
+        return 1;
+    return units > UINT32_MAX ? UINT32_MAX : (uint32_t)units;
+}
+
+/*
+ * i6c_rc_frame_bounds -- VBR/AVBR's frame bounds for the channel attribute.
+ *
+ * The config's pair, clamped to [12, 48]; an unset side takes this HAL's
+ * long-standing default, and the default floor yields to a ceiling set below
+ * it. A pair the config gave the wrong way round is swapped and flagged: the
+ * driver accepts it as it is and pins QP to the ceiling, and failing the create
+ * instead would take the stream down over a config typo.
+ */
+static inline unsigned i6c_rc_frame_bounds(int cfg_min, int cfg_max, unsigned int *min,
+                                           unsigned int *max)
+{
+    unsigned flags = 0;
+    int hi = cfg_max >= 0 ? i6c_rc_clamp(cfg_max, I6C_RC_QP_MIN, I6C_RC_QP_MAX, &flags,
+                                         I6C_RC_F_RANGE)
+                          : I6C_RC_VBR_MAX_QP;
+    int lo = cfg_min >= 0 ? i6c_rc_clamp(cfg_min, I6C_RC_QP_MIN, I6C_RC_QP_MAX, &flags,
+                                         I6C_RC_F_RANGE)
+                          : (I6C_RC_VBR_MIN_QP < hi ? I6C_RC_VBR_MIN_QP : hi);
+
+    if (lo > hi) {
+        int t = lo;
+
+        lo = hi;
+        hi = t;
+        flags |= I6C_RC_F_SWAP;
+    }
+
+    *min = (unsigned int)lo;
+    *max = (unsigned int)hi;
+    return flags;
+}
+
+/*
+ * i6c_rc_fixqp -- the fixed-QP pair.
+ *
+ * With nothing asked this is exactly the old path: init_qp, or 30, for both
+ * frames. Otherwise the P-frame QP is enc-set qp (or init_qp) and the I-frame QP
+ * is that less the I/P delta, the delta coming from enc-set qp_ip_delta or the
+ * config's ip_delta (where -1 means "the SDK default", i.e. none). Both clamp to
+ * the fixed-QP range [12, 48].
+ */
+static inline unsigned i6c_rc_fixqp(int init_qp, const i6c_venc_rcx_t *x, int cfg_ip_delta,
+                                    unsigned int *iqp, unsigned int *pqp)
+{
+    unsigned flags = 0;
+    int p = x->qp_set ? x->qp : init_qp > 0 ? init_qp : I6C_RC_FIXQP_DEFAULT;
+    int d = x->delta_set ? x->ip_delta : cfg_ip_delta >= 0 ? cfg_ip_delta : 0;
+
+    if (!x->qp_set && !x->delta_set && cfg_ip_delta < 0) {
+        *iqp = *pqp = (unsigned int)p;
+        return 0;
+    }
+
+    p = i6c_rc_clamp(p, I6C_RC_QP_MIN, I6C_RC_QP_MAX, &flags, I6C_RC_F_RANGE);
+    *pqp = (unsigned int)p;
+    *iqp = (unsigned int)i6c_rc_clamp(p - d, I6C_RC_QP_MIN, I6C_RC_QP_MAX, &flags, I6C_RC_F_RANGE);
+    return flags;
+}
+
+/*
+ * i6c_rc_priority -- the MI priority for a super-frame request.
+ *
+ * Re-encode never fires under bitrate-first ("the oversized frame will not be
+ * reprogrammed"), and rvd's set-super-frame always sends bitrate-first. So
+ * REENCODE forces frame-bits-first and says so through *forced. RDO has no MI
+ * twin and maps to bitrate-first.
+ */
+static inline uint32_t i6c_rc_priority(rss_super_frame_mode_t mode, rss_rc_priority_t asked,
+                                       bool *forced)
+{
+    *forced = false;
+    if (mode == RSS_SUPERFRM_REENCODE) {
+        *forced = asked != RSS_RC_PRIO_FRAMEBITS;
+        return I6C_VENC_RCPRIO_FRAMEBITS;
+    }
+    return asked == RSS_RC_PRIO_FRAMEBITS ? I6C_VENC_RCPRIO_FRAMEBITS : I6C_VENC_RCPRIO_BITRATE;
+}
+
+/* RcParam as fields with one meaning each, whatever arm they came from. */
+typedef struct {
+    int max_qp, min_qp; /* CBR only */
+    int ip_delta;
+    int change_pos;     /* VBR and AVBR */
+    int max_iqp, min_iqp;
+    int max_ip_prop;
+    uint32_t max_i_size, max_p_size;
+    int min_still_pct, max_still_qp, motion_sens; /* AVBR only */
+} i6c_rc_fields;
+
+static inline void i6c_rc_decode(i6c_rc_arm arm, const i6c_venc_rcparam *p, i6c_rc_fields *f)
+{
+    memset(f, 0, sizeof(*f));
+    switch (arm) {
+    case I6C_RC_ARM_CBR:
+        f->max_qp = (int)p->cbr.maxQp;
+        f->min_qp = (int)p->cbr.minQp;
+        f->ip_delta = p->cbr.ipQpDelta;
+        f->max_iqp = (int)p->cbr.maxIQp;
+        f->min_iqp = (int)p->cbr.minIQp;
+        f->max_ip_prop = (int)p->cbr.maxIPProp;
+        f->max_i_size = p->cbr.maxISize;
+        f->max_p_size = p->cbr.maxPSize;
+        break;
+    case I6C_RC_ARM_VBR:
+        f->ip_delta = p->vbr.ipQpDelta;
+        f->change_pos = p->vbr.changePos;
+        f->max_iqp = (int)p->vbr.maxIQp;
+        f->min_iqp = (int)p->vbr.minIQp;
+        f->max_ip_prop = (int)p->vbr.maxIPProp;
+        f->max_i_size = p->vbr.maxISize;
+        f->max_p_size = p->vbr.maxPSize;
+        break;
+    case I6C_RC_ARM_AVBR:
+        f->ip_delta = p->avbr.ipQpDelta;
+        f->change_pos = p->avbr.changePos;
+        f->min_iqp = (int)p->avbr.minIQp;
+        f->max_ip_prop = (int)p->avbr.maxIPProp;
+        f->max_iqp = (int)p->avbr.maxIQp;
+        f->max_i_size = p->avbr.maxISize;
+        f->max_p_size = p->avbr.maxPSize;
+        f->min_still_pct = (int)p->avbr.minStillPercent;
+        f->max_still_qp = (int)p->avbr.maxStillQp;
+        f->motion_sens = (int)p->avbr.motionSensitivity;
+        break;
+    default:
+        break;
+    }
+}
+
+/* The common words and the reserved pointer go out as zero. */
+static inline void i6c_rc_encode(i6c_rc_arm arm, const i6c_rc_fields *f, i6c_venc_rcparam *p)
+{
+    memset(p, 0, sizeof(*p));
+    switch (arm) {
+    case I6C_RC_ARM_CBR:
+        p->cbr.maxQp = (uint32_t)f->max_qp;
+        p->cbr.minQp = (uint32_t)f->min_qp;
+        p->cbr.ipQpDelta = f->ip_delta;
+        p->cbr.maxIQp = (uint32_t)f->max_iqp;
+        p->cbr.minIQp = (uint32_t)f->min_iqp;
+        p->cbr.maxIPProp = (uint32_t)f->max_ip_prop;
+        p->cbr.maxISize = f->max_i_size;
+        p->cbr.maxPSize = f->max_p_size;
+        break;
+    case I6C_RC_ARM_VBR:
+        p->vbr.ipQpDelta = f->ip_delta;
+        p->vbr.changePos = f->change_pos;
+        p->vbr.maxIQp = (uint32_t)f->max_iqp;
+        p->vbr.minIQp = (uint32_t)f->min_iqp;
+        p->vbr.maxIPProp = (uint32_t)f->max_ip_prop;
+        p->vbr.maxISize = f->max_i_size;
+        p->vbr.maxPSize = f->max_p_size;
+        break;
+    case I6C_RC_ARM_AVBR:
+        p->avbr.ipQpDelta = f->ip_delta;
+        p->avbr.changePos = f->change_pos;
+        p->avbr.minIQp = (uint32_t)f->min_iqp;
+        p->avbr.maxIPProp = (uint32_t)f->max_ip_prop;
+        p->avbr.maxIQp = (uint32_t)f->max_iqp;
+        p->avbr.maxISize = f->max_i_size;
+        p->avbr.maxPSize = f->max_p_size;
+        p->avbr.minStillPercent = (uint32_t)f->min_still_pct;
+        p->avbr.maxStillQp = (uint32_t)f->max_still_qp;
+        p->avbr.motionSensitivity = (uint32_t)f->motion_sens;
+        break;
+    default:
+        break;
+    }
+}
+
+/* What one push asks of RcParam. */
+typedef struct {
+    /*
+     * CBR: the frame bounds to write, -1 for a side the driver keeps. VBR/AVBR:
+     * the channel attribute's frame bounds, which the I-frame pair nests in.
+     */
+    int min_qp, max_qp;
+    int min_iqp, max_iqp; /* -1 = the driver's */
+    /* A side an op released: it goes out as MI's full range, and nesting it is no news. */
+    bool full_min_i, full_max_i;
+    bool has_delta;
+    int ip_delta;
+    uint32_t max_i_size, max_p_size; /* always written: see the header comment */
+} i6c_rc_want;
+
+/*
+ * i6c_rc_want_of -- the record and the channel's config as one request.
+ *
+ * cfg_* are the channel's live config (frame bounds already overlaid from the
+ * record); attr_* the frame bounds its VBR/AVBR channel attribute carries.
+ * Returns whether there is anything to push. A channel nobody configured never
+ * sees SetRcParam, so the default path is exactly what it was. Config values
+ * alone count when they have nowhere else to go: CBR's frame bounds, which its
+ * channel attribute lacks, and ip_delta (where -1 is "the SDK default").
+ *
+ * A side an op released (-1) goes out as MI's full range, 12 or 48. Leaving it
+ * to the driver would keep the last value written: GetRcParam reports the live
+ * state, not a default (seen on the bench).
+ */
+static inline bool i6c_rc_want_of(const i6c_venc_rcx_t *x, i6c_rc_arm arm, int cfg_min_qp,
+                                  int cfg_max_qp, int cfg_ip_delta, int attr_min_qp,
+                                  int attr_max_qp, i6c_rc_want *w)
+{
+    memset(w, 0, sizeof(*w));
+    if (arm == I6C_RC_ARM_NONE)
+        return false;
+
+    if (arm == I6C_RC_ARM_CBR) {
+        w->min_qp = cfg_min_qp >= 0 ? cfg_min_qp : x->frame_set ? I6C_RC_QP_MIN : -1;
+        w->max_qp = cfg_max_qp >= 0 ? cfg_max_qp : x->frame_set ? I6C_RC_QP_MAX : -1;
+    } else {
+        w->min_qp = attr_min_qp;
+        w->max_qp = attr_max_qp;
+    }
+    w->min_iqp = -1;
+    w->max_iqp = -1;
+    if (x->iframe_set) {
+        w->full_min_i = x->min_iqp < 0;
+        w->full_max_i = x->max_iqp < 0;
+        w->min_iqp = w->full_min_i ? I6C_RC_QP_MIN : x->min_iqp;
+        w->max_iqp = w->full_max_i ? I6C_RC_QP_MAX : x->max_iqp;
+    }
+    if (x->delta_set) {
+        w->has_delta = true;
+        w->ip_delta = x->ip_delta;
+    } else if (cfg_ip_delta >= 0) {
+        w->has_delta = true;
+        w->ip_delta = cfg_ip_delta;
+    }
+    w->max_i_size = x->max_i_size;
+    w->max_p_size = x->max_p_size;
+
+    return x->any || cfg_ip_delta >= 0 ||
+           (arm == I6C_RC_ARM_CBR && (cfg_min_qp >= 0 || cfg_max_qp >= 0));
+}
+
+/*
+ * i6c_rc_build -- the RcParam to send.
+ *
+ * base is what GetRcParam returned: the driver's live values, which stand for
+ * every field nobody asked about and go back exactly as reported, in range or
+ * not. Clamping them changes the encoder: this driver reports MaxIPProp outside
+ * the doc's [5, 100] (0, by every sign), and raising it to 5 halved the I-frames
+ * of a VBR channel that had asked only for a size cap. The asked-for fields go
+ * over the base, clamped to MI's ranges (RANGE). MaxISize and MaxPSize always
+ * come from the request.
+ *
+ * In CBR the frame and I-frame pairs are independent. In VBR and AVBR an
+ * asked-for I-frame side sits inside the frame pair, as the doc's ranges
+ * require (NEST when that moved it). Within each pair the side that was asked
+ * for wins over the driver's.
+ */
+static inline unsigned i6c_rc_build(i6c_rc_arm arm, const i6c_venc_rcparam *base,
+                                    const i6c_rc_want *w, i6c_venc_rcparam *out)
+{
+    unsigned flags = 0;
+    bool ask_min_i = w->min_iqp >= 0, ask_max_i = w->max_iqp >= 0;
+    i6c_rc_fields f;
+
+    i6c_rc_decode(arm, base, &f);
+
+    if (arm == I6C_RC_ARM_CBR) {
+        bool ask_min = w->min_qp >= 0, ask_max = w->max_qp >= 0;
+
+        if (ask_min)
+            f.min_qp = i6c_rc_clamp(w->min_qp, I6C_RC_QP_MIN, I6C_RC_QP_MAX, &flags, I6C_RC_F_RANGE);
+        if (ask_max)
+            f.max_qp = i6c_rc_clamp(w->max_qp, I6C_RC_QP_MIN, I6C_RC_QP_MAX, &flags, I6C_RC_F_RANGE);
+        /* Neither side asked: the driver's pair goes back as it is. */
+        if (f.min_qp > f.max_qp && (ask_min || ask_max)) {
+            if (ask_min && !ask_max)
+                f.max_qp = f.min_qp;
+            else if (ask_max && !ask_min)
+                f.min_qp = f.max_qp;
+            else {
+                int t = f.min_qp;
+
+                f.min_qp = f.max_qp;
+                f.max_qp = t;
+                flags |= I6C_RC_F_SWAP;
+            }
+        }
+    }
+
+    if (ask_min_i)
+        f.min_iqp = i6c_rc_clamp(w->min_iqp, I6C_RC_QP_MIN, I6C_RC_QP_MAX, &flags, I6C_RC_F_RANGE);
+    if (ask_max_i)
+        f.max_iqp = i6c_rc_clamp(w->max_iqp, I6C_RC_QP_MIN, I6C_RC_QP_MAX, &flags, I6C_RC_F_RANGE);
+    if (w->has_delta)
+        f.ip_delta = i6c_rc_clamp(w->ip_delta, I6C_RC_DELTA_MIN, I6C_RC_DELTA_MAX, &flags,
+                                  I6C_RC_F_RANGE);
+    f.max_i_size = w->max_i_size;
+    f.max_p_size = w->max_p_size;
+
+    /* Only an asked side nests; a released one (full range) nests without news. */
+    if (arm != I6C_RC_ARM_CBR && w->min_qp >= 0 && w->max_qp >= w->min_qp) {
+        unsigned nest = 0, quiet = 0;
+
+        if (ask_min_i)
+            f.min_iqp = i6c_rc_clamp(f.min_iqp, w->min_qp, w->max_qp,
+                                     w->full_min_i ? &quiet : &nest, 1);
+        if (ask_max_i)
+            f.max_iqp = i6c_rc_clamp(f.max_iqp, w->min_qp, w->max_qp,
+                                     w->full_max_i ? &quiet : &nest, 1);
+        flags |= nest ? I6C_RC_F_NEST : 0;
+    }
+
+    /* Neither side asked: the driver's pair goes back as it is. */
+    if (f.min_iqp > f.max_iqp && (ask_min_i || ask_max_i)) {
+        if (ask_min_i && !ask_max_i)
+            f.max_iqp = f.min_iqp;
+        else
+            f.min_iqp = f.max_iqp;
+    }
+
+    i6c_rc_encode(arm, &f, out);
+    return flags;
+}
