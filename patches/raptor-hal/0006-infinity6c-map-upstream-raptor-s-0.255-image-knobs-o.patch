diff --git a/src/infinity6c/i6c_upstream_compat.c b/src/infinity6c/i6c_upstream_compat.c
new file mode 100644
index 0000000..478d2f6
--- /dev/null
+++ b/src/infinity6c/i6c_upstream_compat.c
@@ -0,0 +1,98 @@
+/*
+ * infinity6c/i6c_upstream_compat.c -- the knob scale map's ops.
+ *
+ * Each op asks hal_isp_get_knob_caps for the knob's range, maps through
+ * i6c_knob_to_native / i6c_knob_from_native (i6c_upstream_compat.h says why
+ * and how), and calls John Chia's native op unchanged. Asking for the caps on
+ * every call, rather than caching them, is what lets temper's and ae_comp's
+ * neutral follow the tuning once the first frame has read it.
+ *
+ * Compiles to nothing against John's interface, where rvd already speaks the
+ * native units.
+ */
+#include "infinity6c_state.h"
+
+#ifdef I6C_UPSTREAM_HAL_IFACE
+
+int hal_isp_get_knob_caps(void *ctx, const char *name, rss_isp_knob_t *caps);
+int hal_isp_set_brightness(void *ctx, int val);
+int hal_isp_get_brightness(void *ctx, int *val);
+int hal_isp_set_contrast(void *ctx, int val);
+int hal_isp_get_contrast(void *ctx, int *val);
+int hal_isp_set_saturation(void *ctx, int val);
+int hal_isp_get_saturation(void *ctx, int *val);
+int hal_isp_set_drc_strength(void *ctx, int val);
+int hal_isp_get_drc_strength(void *ctx, int *val);
+int hal_isp_set_temper_strength(void *ctx, int val);
+int hal_isp_get_temper_strength(void *ctx, int *val);
+int hal_isp_set_defog_strength(void *ctx, int val);
+int hal_isp_get_defog_strength(void *ctx, int *val);
+int hal_isp_set_ae_comp(void *ctx, int val);
+int hal_isp_get_ae_comp(void *ctx, int *val);
+
+static int set_mapped(void *ctx, const char *key, int val, int (*set)(void *, int))
+{
+    rss_isp_knob_t caps;
+    int ret = hal_isp_get_knob_caps(ctx, key, &caps);
+
+    if (ret != RSS_OK)
+        return ret;
+    return set(ctx, i6c_knob_to_native(val, &caps));
+}
+
+static int get_mapped(void *ctx, const char *key, int *val, int (*get)(void *, int *))
+{
+    rss_isp_knob_t caps;
+    int native, ret;
+
+    if (!val)
+        return RSS_ERR_INVAL;
+    ret = hal_isp_get_knob_caps(ctx, key, &caps);
+    if (ret == RSS_OK)
+        ret = get(ctx, &native);
+    if (ret == RSS_OK)
+        *val = i6c_knob_from_native(native, &caps);
+    return ret;
+}
+
+/* One knob: its caps key, and the native setter/getter pair it wraps. */
+#define I6C_MAPPED_KNOB(op, key)                                                 \
+    int hal_isp_set_##op##_up(void *ctx, int val)                                \
+    {                                                                            \
+        return set_mapped(ctx, key, val, hal_isp_set_##op);                      \
+    }                                                                            \
+    int hal_isp_get_##op##_up(void *ctx, uint8_t *val)                           \
+    {                                                                            \
+        int v = 0, ret = val ? get_mapped(ctx, key, &v, hal_isp_get_##op) : RSS_ERR_INVAL; \
+        if (ret == RSS_OK)                                                       \
+            *val = (uint8_t)v;                                                   \
+        return ret;                                                              \
+    }
+
+I6C_MAPPED_KNOB(brightness, "brightness")
+I6C_MAPPED_KNOB(contrast, "contrast")
+I6C_MAPPED_KNOB(saturation, "saturation")
+I6C_MAPPED_KNOB(drc_strength, "drc_strength")
+I6C_MAPPED_KNOB(temper_strength, "temper")
+I6C_MAPPED_KNOB(defog_strength, "defog_strength")
+
+/* rvd's [image] block reaches defog through the _adv op, passing a uint8_t *. */
+int hal_isp_set_defog_strength_adv_up(void *ctx, const void *defog_attr)
+{
+    if (!defog_attr)
+        return RSS_ERR_INVAL;
+    return hal_isp_set_defog_strength_up(ctx, *(const uint8_t *)defog_attr);
+}
+
+/* ae_comp has no auto; 128 lands on its neutral (the tuning's EV, once read). */
+int hal_isp_set_ae_comp_up(void *ctx, int val)
+{
+    return set_mapped(ctx, "ae_comp", val, hal_isp_set_ae_comp);
+}
+
+int hal_isp_get_ae_comp_up(void *ctx, int *val)
+{
+    return get_mapped(ctx, "ae_comp", val, hal_isp_get_ae_comp);
+}
+
+#endif /* I6C_UPSTREAM_HAL_IFACE */
