 src/infinity6c/hal_common.c          | 27 +++++++++++++++++++------
 src/infinity6c/hal_isp.c             | 15 ++++++++++++++
 src/infinity6c/i6c_upstream_compat.h | 30 ++++++++++++++++++++++++++++
 src/infinity6c/infinity6c_state.h    |  1 +
 5 files changed, 71 insertions(+), 6 deletions(-)
 create mode 100644 src/infinity6c/i6c_upstream_compat.h

