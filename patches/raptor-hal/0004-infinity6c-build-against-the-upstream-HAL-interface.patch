diff --git a/src/infinity6c/i6c_upstream_compat.h b/src/infinity6c/i6c_upstream_compat.h
new file mode 100644
index 0000000..b170dbb
--- /dev/null
+++ b/src/infinity6c/i6c_upstream_compat.h
@@ -0,0 +1,30 @@
+/* Build the infinity6c backend against gtxaspec raptor-hal's interface.
+ * The fork's raptor_hal.h defines RSS_ISP_AUTO; upstream's does not, so its
+ * absence selects this compat layer. */
+#ifndef I6C_UPSTREAM_COMPAT_H
+#define I6C_UPSTREAM_COMPAT_H
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#ifndef RSS_ISP_AUTO
+#define I6C_UPSTREAM_HAL_IFACE 1
+#define RSS_ISP_AUTO INT_MIN
+typedef struct {
+    int min, max, neutral;
+    bool has_auto, enabled;
+} rss_isp_knob_t;
+/* upstream getters take uint8_t*; wrap the native-int ones */
+#define I6C_U8_GETTER_DECL(fn) int fn##_u8(void *ctx, uint8_t *val);
+#define I6C_U8_GETTER_DEF(fn)                                                  \
+    int fn##_u8(void *ctx, uint8_t *val)                                       \
+    {                                                                          \
+        int v = 0, r = fn(ctx, &v);                                            \
+        if (r == 0)                                                            \
+            *val = (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v);                   \
+        return r;                                                              \
+    }
+#define I6C_GETTER(fn) fn##_u8
+#else
+#define I6C_GETTER(fn) fn
+#endif
+#endif
