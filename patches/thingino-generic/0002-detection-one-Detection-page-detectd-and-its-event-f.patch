+#!/bin/sh
+# Raptor runs this with "stop" before any of its daemons go down and with
+# "start" once they are back: detectd reads rvd, and starts again with what
+# the restarted rvd runs (its method and its model's class names).
+exec /etc/init.d/S36detectd "$1"
diff --git a/package/thingino-detect/files/www/a/config-detect.js b/package/thingino-detect/files/www/a/config-detect.js
new file mode 100644
index 000000000..0e6431056
--- /dev/null
+++ b/package/thingino-detect/files/www/a/config-detect.js
@@ -0,0 +1,498 @@
+/**
+ * The Detection page: one page for both detectors.
+ *
+ *   ipud  (SigmaStar) the IPU's YOLO run by thingino-ipud; every setting is the
+ *         "ipud" block of /etc/thingino.json, read and saved through
+ *         /x/json-ipud.cgi, which restarts ipud.
+ *   rvd   (Ingenic) raptor's IVS; the detection is raptor.conf [motion], read
+ *         in one go and saved a setting at a time through the agent
+ *         (settings/motion), and the events are the "detect" block of
+ *         /etc/thingino.json, through /x/json-detectd.cgi, which restarts
+ *         detectd.
+ *
+ * The plugin manifests' feature flags say which one the camera has (ipud,
+ * detect). Both show the same sections with the same labels and units; a
+ * control one of them lacks is hidden (data-only), and on rvd the model's
+ * settings only show for the model method (data-model).
+ */
+(function () {
+  "use strict";
+
+  const $id = (id) => document.getElementById(id);
+  const el = (k) => $id("det_" + k);
+  const EVENT_BOOLS = ["mqtt", "onvif", "ha", "frigate"];
+  const EVENT_NUMS = ["hold_ms", "mqtt_interval_ms"];
+  const EVENT_TEXTS = ["report", "mqtt_topic", "frigate_url", "frigate_camera"];
+  const saveBtn = $id("det-save");
+  const restartBtn = $id("det-restart");
+
+  function notify(type, message, timeout = 6000) {
+    if (window.showAlert) window.showAlert(type, message, timeout);
+  }
+  function setText(id, text) {
+    const n = $id(id);
+    if (n) n.textContent = text;
+  }
+  function num(k) {
+    const v = el(k).value.trim();
+    return v === "" || Number.isNaN(Number(v)) ? null : Number(v);
+  }
+  function pct(f) {
+    return f === undefined || f === null || f === "" ? "" : Math.round(Number(f) * 100);
+  }
+  function seen(objs) {
+    return objs.length ? objs.join(", ") : "nothing";
+  }
+
+  function eventsFrom(c) {
+    EVENT_BOOLS.forEach((k) => (el(k).checked = c[k] === true));
+    EVENT_NUMS.forEach((k) => (el(k).value = c[k] === undefined ? "" : c[k]));
+    EVENT_TEXTS.forEach((k) => (el(k).value = c[k] || ""));
+  }
+  function eventsTo(o) {
+    EVENT_BOOLS.forEach((k) => (o[k] = el(k).checked));
+    EVENT_NUMS.forEach((k) => {
+      if (num(k) !== null) o[k] = num(k);
+    });
+    EVENT_TEXTS.forEach((k) => (o[k] = el(k).value.trim()));
+    return o;
+  }
+  function eventsText(st) {
+    if (!st || !st.running) return st && st.reason ? `off (${st.reason})` : "off";
+    return st.mqtt ? "on, MQTT connected" : "on";
+  }
+
+  function show(backend) {
+    document.querySelectorAll("[data-only]").forEach((n) =>
+      n.classList.toggle("d-none", n.dataset.only !== backend));
+    $id("det-form").classList.remove("d-none");
+  }
+
+  function lock(message) {
+    $id("det-form").classList.add("d-none");
+    const box = $id("det-unsupported");
+    if (message) box.textContent = message;
+    box.classList.remove("d-none");
+  }
+
+  // ------------------------------------------------------------- ipud (SigmaStar)
+
+  function ipudBackend() {
+    const ENDPOINT = "/x/json-ipud.cgi";
+    let last = null;
+    let timer = null;
+
+    function status(s) {
+      if (!s || !s.running) {
+        setText("det-state", s && s.reason ? `not running (${s.reason})` : "not running");
+        ["det-rate", "det-source", "det-objects"].forEach((id) => setText(id, "-"));
+        setText("det-events", "off");
+        return;
+      }
+      setText("det-state", `running, ${s.inferences} inferences`);
+      setText("det-rate", `${s.fps} per second, ${s.invoke_ms} ms on the IPU, ${s.decode_ms} ms decode`);
+      setText("det-source", `the IPU; SCL port ${s.port}, ${s.input[0]}x${s.input[1]}${s.zero_copy ? ", zero-copy" : ""}; model ${s.model}`);
+      setText("det-events", s.mqtt ? "MQTT connected" : "as set below (MQTT off or not connected)");
+      setText("det-objects", seen((s.objects || []).map((o) => `${o.label} ${Math.round(o.score * 100)}%`)));
+    }
+
+    // Can the source picked on the page run? [ok, why not]
+    function sourceReady() {
+      const a = (last && last.available) || {};
+      const src = el("source").value;
+      if (src === "builtin")
+        return a.builtin ? [true, ""] : [false, "This firmware has no built-in model"];
+      if (src === "sdcard") {
+        if (el("sd_dir").value.trim() !== (a.sd_dir || "")) return [true, ""]; // checked after the save
+        if (!a.sd_found) return [false, `The SD card folder ${a.sd_dir || ""} is not there`];
+        if (!(a.sd_models || []).length) return [false, `No model (.img) in ${a.sd_dir}`];
+        return [true, ""];
+      }
+      return [true, ""]; // custom paths: checked when ipud starts
+    }
+
+    function refresh() {
+      const src = el("source").value;
+      document.querySelectorAll("[data-src]").forEach((n) =>
+        n.classList.toggle("d-none", n.dataset.src !== src));
+      const a = (last && last.available) || {};
+      let note = "";
+      if (src === "builtin") note = a.builtin ? "The model in this firmware." : "This firmware carries no model.";
+      if (src === "sdcard") {
+        const n = (a.sd_models || []).length;
+        note = a.sd_found ? `${n} model${n === 1 ? "" : "s"} on the card.` : "The card folder is not there (is a card in?).";
+      }
+      if (src === "custom") note = "Any path on the camera.";
+      setText("det-source-note", note);
+      const [ok, why] = sourceReady();
+      $id("det-files-alert").classList.toggle("d-none", ok);
+      setText("det-files-reason", why || "The selected model is not available");
+      // Locked while the chosen source has no model; an enabled switch can still be turned off.
+      el("enabled").disabled = !ok && !el("enabled").checked;
+    }
+
+    function apply(data) {
+      last = data;
+      const c = data.config || {};
+      const r = data.resolved || {};
+      const a = data.available || {};
+      el("enabled").checked = c.enabled === true;
+      el("confidence").value = pct(c.score);
+      el("rate").value = c.max_fps === undefined ? "" : c.max_fps;
+      el("iou").value = pct(c.iou);
+      el("labels").value = c.labels || "";
+      el("model_path").value = c.model || "";
+      el("firmware").value = c.firmware || "";
+      el("sd_dir").value = c.sd_dir || "";
+      el("source").value = r.source || c.source || "builtin";
+      const sel = el("sd_model");
+      sel.innerHTML = "";
+      const models = a.sd_models || [];
+      if (!models.length) sel.add(new Option("(none on the card)", ""));
+      models.forEach((m) => sel.add(new Option(m, m)));
+      sel.value = models.includes(c.sd_model) ? c.sd_model : models[0] || "";
+      eventsFrom(c);
+      setText("det-labels-note", r.labels_file
+        ? `Now taken from ${r.model.replace(/\.[^.]*$/, "")}.labels: ${r.labels}`
+        : "A .labels file beside the model (one comma-separated line) takes precedence.");
+      refresh();
+      status(data.status);
+    }
+
+    async function load() {
+      const res = await fetch(ENDPOINT, { cache: "no-store" });
+      if (!res.ok) throw new Error(`HTTP ${res.status}`);
+      apply(await res.json());
+    }
+
+    async function poll() {
+      try {
+        const res = await fetch(ENDPOINT + "?a=status", { cache: "no-store" });
+        if (res.ok) status(await res.json());
+      } catch (e) {
+        /* the next poll retries */
+      }
+    }
+
+    async function save() {
+      const ipud = eventsTo({});
+      ipud.enabled = el("enabled").checked;
+      if (num("confidence") !== null) ipud.score = num("confidence") / 100;
+      if (num("rate") !== null) ipud.max_fps = num("rate");
+      if (num("iou") !== null) ipud.iou = num("iou") / 100;
+      ipud.labels = el("labels").value.trim();
+      ipud.model = el("model_path").value.trim();
+      ipud.firmware = el("firmware").value.trim();
+      ipud.sd_dir = el("sd_dir").value.trim();
+      ipud.source = el("source").value;
+      ipud.sd_model = el("sd_model").value;
+      const [ok, why] = sourceReady();
+      if (ipud.enabled && !ok) {
+        notify("warning", `${why}: detection stays off.`);
+        ipud.enabled = false;
+      }
+      const res = await fetch(ENDPOINT, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ ipud }),
+      });
+      const data = await res.json();
+      if (!res.ok || data.error) throw new Error((data.error && data.error.message) || `HTTP ${res.status}`);
+      apply(data);
+      notify("success", "Saved; detection restarts with the new settings.", 3000);
+    }
+
+    function start() {
+      clearInterval(timer);
+      timer = document.hidden ? null : setInterval(poll, 1000);
+    }
+    function stop() {
+      clearInterval(timer);
+      timer = null;
+    }
+
+    setText("det-engine", "This camera runs a YOLO model on its neural-network unit (the IPU).");
+    setText("det-rate-hint", "0 runs every frame (about 22 a second).");
+    setText("det-apply-note", "Saving restarts detection with the new settings.");
+    el("source").addEventListener("change", refresh);
+    el("sd_dir").addEventListener("input", refresh);
+    document.querySelectorAll("[data-model]").forEach((n) => n.classList.remove("d-none"));
+    return { load, save, start, stop };
+  }
+
+  // ------------------------------------------------------------- rvd (Ingenic)
+
+  function rvdBackend() {
+    const SETTING = "/api/v1/settings/motion";
+    const FEED = "/x/json-detect.cgi";
+    const EVENTS = "/x/json-detectd.cgi";
+    const DOWN_RETRY_MS = 10000;
+    // field -> [agent leaf, the page's control]; saved in this order, so
+    // detection is turned on only after what it runs with is written.
+    const FIELDS = {
+      algorithm: ["algorithm", "algorithm"],
+      model: ["model", "model"],
+      num_classes: ["num-classes", "num_classes"],
+      conf_threshold: ["conf-threshold", "confidence"],
+      nms_threshold: ["nms-threshold", "iou"],
+      detect_interval_ms: ["detect-interval-ms", "rate"],
+      sensitivity: ["sensitivity", "sensitivity"],
+      cooldown_time: ["cooldown-time", "cooldown_time"],
+      draw_boxes: ["draw-boxes", "draw_boxes"],
+      enabled: ["enabled", "enabled"],
+    };
+    const MODEL_FIELDS = ["model", "num_classes", "conf_threshold", "nms_threshold", "detect_interval_ms"];
+    const METHODS = {
+      move: ["Motion", "Any movement, on a grid over the picture. Motion has its own events (Services > Motion)."],
+      base_move: ["Motion (basic)", "The SDK's simpler movement check."],
+      persondet: ["People", "The vendor's person detector."],
+      yolo: ["Objects (model)", "The classes of a model. Without a neural accelerator in the SoC this takes most of the CPU."],
+    };
+    const loaded = {};
+    let models = [];
+    let labels = [];
+    let source = null;
+    let timer = null;
+    let evTimer = null;
+    let evSoon = null;
+    let gone = false;
+
+    // The page's value of a field, in the agent's units.
+    function value(k) {
+      const n = el(FIELDS[k][1]);
+      if (n.type === "checkbox") return n.checked;
+      if (k === "detect_interval_ms") {
+        const r = num("rate");
+        if (r === null || r < 0) return null;
+        return r > 0 ? Math.round(1000 / r) : 0;
+      }
+      if (n.type === "number") {
+        const v = n.value.trim();
+        return /^\d+$/.test(v) ? Number(v) : null;
+      }
+      return n.value || null;
+    }
+    function put(k, v) {
+      const n = el(FIELDS[k][1]);
+      if (n.type === "checkbox") n.checked = v === true;
+      else if (k === "detect_interval_ms") n.value = v > 0 ? Number((1000 / v).toFixed(2)) : v === 0 ? 0 : "";
+      else n.value = v === null || v === undefined ? "" : v;
+    }
+
+    function fillSelect(n, values, text) {
+      n.textContent = "";
+      values.forEach((v) => n.add(new Option(text(v), v)));
+    }
+
+    function refresh() {
+      const a = el("algorithm").value;
+      setText("det-algorithm-hint", (METHODS[a] || ["", ""])[1]);
+      document.querySelectorAll("[data-model]").forEach((n) => n.classList.toggle("d-none", a !== "yolo"));
+      $id("det-no-model").classList.toggle("d-none", a !== "yolo" || models.length > 0);
+      setText("det-labels-note", a === "persondet"
+        ? "The person detector has one class: person."
+        : "From a file beside the model (its name ending in .txt, one class a line), else the public models' names.");
+      setText("det-events-note", a === "yolo" || a === "persondet" ? ""
+        : "The motion methods find no objects, so they send none of these events.");
+    }
+
+    function shut() {
+      if (source) source.close();
+      source = null;
+    }
+
+    // State, source and what is seen, from the pushed feed.
+    function follow() {
+      clearTimeout(timer);
+      timer = null;
+      if (source || gone || document.hidden || typeof EventSource !== "function") return;
+      source = new EventSource(FEED);
+      source.onmessage = (msg) => {
+        let ev = null;
+        try {
+          ev = JSON.parse(msg.data);
+        } catch (e) {
+          return;
+        }
+        if (ev.running === false) {
+          shut();
+          setText("det-state", "off");
+          setText("det-source", "-");
+          setText("det-objects", "-");
+          if (!gone) timer = setTimeout(follow, DOWN_RETRY_MS);
+          return;
+        }
+        const m = METHODS[loaded.algorithm];
+        setText("det-state", "on");
+        setText("det-source", `the streamer (rvd), ${m ? m[0].toLowerCase() : loaded.algorithm}, on the sub stream (${ev.width}x${ev.height})`);
+        setText("det-objects", seen((ev.detections || []).map((o) =>
+          (o.class < 0 ? "motion" : labels[o.class] || "class " + o.class) + " " + Math.round(o.confidence * 100) + "%")));
+      };
+      source.onerror = () => setText("det-state", "no answer from the camera");
+    }
+
+    async function pollEvents() {
+      try {
+        const res = await fetch(EVENTS + "?a=status", { cache: "no-store" });
+        if (res.ok) setText("det-events", eventsText(await res.json()));
+      } catch (e) {
+        /* the next poll retries */
+      }
+    }
+
+    async function load() {
+      let s = null;
+      try {
+        s = await agentJsonRequest(SETTING, { cache: "no-store" });
+      } catch (err) {
+        console.warn("Failed to load the detection settings", err);
+      }
+      if (!s || s.supported !== true) {
+        lock(s ? "" : "The camera did not answer. Reload the page.");
+        return false;
+      }
+      models = s.models || [];
+      labels = s.labels || [];
+      fillSelect(el("algorithm"), s.algorithms || ["move"], (a) => (METHODS[a] ? METHODS[a][0] : a));
+      fillSelect(el("model"), models, (m) => m.replace(/^.*\//, ""));
+      for (const k of Object.keys(FIELDS)) {
+        const v = s[k];
+        // A saved model that is no longer on the camera stays visible.
+        if (k === "model" && v && !models.includes(v)) el("model").add(new Option(v.replace(/^.*\//, "") + " (missing)", v));
+        put(k, v);
+        loaded[k] = value(k);
+      }
+      el("labels").value = labels.join(",");
+      try {
+        const res = await fetch(EVENTS, { cache: "no-store" });
+        const d = res.ok ? await res.json() : {};
+        eventsFrom(d.config || {});
+        setText("det-events", eventsText(d.status));
+      } catch (e) {
+        setText("det-events", "-");
+      }
+      refresh();
+      return true;
+    }
+
+    async function save() {
+      const method = el("algorithm").value;
+      if (method === "yolo" && !models.length) throw new Error("there is no model file on the camera for this method");
+      let staged = false;
+      for (const [k, [leaf]] of Object.entries(FIELDS)) {
+        const now = value(k);
+        if (now === null || now === loaded[k]) continue;
+        // The model's own settings are written only when a model is used.
+        if (MODEL_FIELDS.includes(k) && method !== "yolo") continue;
+        const res = await agentJsonRequest(SETTING + "/" + leaf, { method: "PATCH", body: { [k]: now }, cache: "no-store" });
+        if (!res || res.status !== "accepted") throw new Error(k.replace(/_/g, " ") + " was rejected by the camera");
+        if ((res.restart_required || []).length) staged = true;
+        loaded[k] = now;
+      }
+      // The events, and detectd started again with what rvd now runs.
+      const res = await fetch(EVENTS, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ detect: eventsTo({}) }),
+      });
+      const data = await res.json();
+      if (!res.ok || data.error) throw new Error((data.error && data.error.message) || `HTTP ${res.status}`);
+      eventsFrom(data.config || {});
+      clearTimeout(evSoon);
+      evSoon = setTimeout(pollEvents, 1500); // detectd restarting: its new state
+      if (staged) {
+        restartBtn.classList.remove("d-none");
+        notify("warning", "Saved. Restart the video to apply the new method or model.");
+      } else {
+        notify("success", "Detection settings saved.", 3000);
+      }
+    }
+
+    async function restart() {
+      restartBtn.disabled = true;
+      shut();
+      try {
+        const res = await fetch("/x/restart-streamer.cgi", { cache: "no-store" });
+        const body = await res.json();
+        if (!res.ok || body.error) throw new Error("the camera refused");
+        restartBtn.classList.add("d-none");
+        notify("success", "The video restarted.");
+      } catch (err) {
+        notify("danger", "Failed to restart the video: " + err.message);
+      } finally {
+        restartBtn.disabled = false;
+        follow();
+      }
+    }
+
+    function start() {
+      clearInterval(evTimer);
+      evTimer = setInterval(pollEvents, 5000);
+      follow();
+    }
+    function stop() {
+      clearInterval(evTimer);
+      evTimer = null;
+      clearTimeout(evSoon);
+      evSoon = null;
+      clearTimeout(timer);
+      timer = null;
+      shut();
+    }
+    function leave() {
+      gone = true;
+      stop();
+    }
+
+    setText("det-engine", "On this camera the streamer's video daemon (rvd) runs it on the sub stream.");
+    setText("det-rate-hint", "The model method only; 0 runs on every frame it can get.");
+    setText("det-apply-note",
+      "Turning detection on or off, the sensitivity, the boxes and the events apply at once. " +
+      "The method, the model and its numbers are saved to /etc/raptor.conf and apply when the video restarts.");
+    el("labels").readOnly = true;
+    el("algorithm").addEventListener("change", refresh);
+    restartBtn.addEventListener("click", restart);
+    return { load, save, start, stop, leave };
+  }
+
+  // ------------------------------------------------------------- the page
+
+  const device = (window.thinginoUIConfig && window.thinginoUIConfig.device) || {};
+  const name = device.ipud ? "ipud" : device.detect ? "rvd" : null;
+  if (!name) {
+    lock();
+    return;
+  }
+  const backend = name === "ipud" ? ipudBackend() : rvdBackend();
+  show(name);
+
+  async function load() {
+    const ok = await backend.load();
+    if (ok !== false) backend.start();
+  }
+
+  saveBtn.addEventListener("click", async () => {
+    saveBtn.disabled = true;
+    try {
+      await backend.save();
+    } catch (err) {
+      notify("danger", `Could not save: ${err.message || err}`);
+    } finally {
+      saveBtn.disabled = false;
+    }
+  });
+  $id("det-reload").addEventListener("click", () =>
+    backend.load().then(() => notify("info", "Reloaded.", 2000)).catch((e) => notify("danger", `Reload failed: ${e.message}`)));
+  function onVisibility() {
+    if (document.hidden) backend.stop();
+    else backend.start();
+  }
+  document.addEventListener("visibilitychange", onVisibility);
+  document.addEventListener("thingino:page-leave", () => {
+    if (backend.leave) backend.leave();
+    else backend.stop();
+    document.removeEventListener("visibilitychange", onVisibility);
+  }, { once: true });
+
+  load().catch((e) => notify("danger", `Could not read the settings: ${e.message}`));
+})();
