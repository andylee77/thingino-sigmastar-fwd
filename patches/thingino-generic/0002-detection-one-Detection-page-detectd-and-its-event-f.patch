diff --git a/package/thingino-detect/files/www/x/json-detectd.cgi b/package/thingino-detect/files/www/x/json-detectd.cgi
new file mode 100755
index 000000000..6bba567f9
--- /dev/null
+++ b/package/thingino-detect/files/www/x/json-detectd.cgi
@@ -0,0 +1,92 @@
+#!/bin/sh
+# shellcheck disable=SC1091,SC3043
+# json-detectd.cgi -- the events of raptor's detection (detectd, Ingenic): the
+# "detect" block of /etc/thingino.json, for the Detection page's Events section.
+#
+#   GET                  {"config":{<detect block over the defaults>},"status":{..}}
+#   POST {"detect":{..}} merge into /etc/thingino.json, restart detectd, answer as GET
+#
+# The detection itself (method, model, thresholds) is raptor's [motion],
+# saved through the agent; this is only where its events go. Defaults from
+# /usr/share/thingino-defaults/46-detect.json; detectd's status file says
+# whether it runs, and why not.
+
+. /var/www/x/auth.sh
+require_auth
+
+CONFIG_FILE="${THINGINO_CONFIG:-/etc/thingino.json}"
+DEFAULTS_FILE=/usr/share/thingino-defaults/46-detect.json
+STATUS=/run/detectd/status.json
+REQ_FILE=""
+MERGED=""
+trap 'rm -f ${REQ_FILE:+"$REQ_FILE"} ${MERGED:+"$MERGED" "$MERGED.in"}' EXIT
+
+send_json() {
+	printf 'Status: %s\r\n' "${2:-200 OK}"
+	printf 'Content-Type: application/json\r\n'
+	printf 'Cache-Control: no-store\r\n'
+	printf 'Connection: close\r\n'
+	printf '\r\n'
+	printf '%s\n' "$1"
+	exit 0
+}
+
+status_json() {
+	if [ -s "$STATUS" ]; then
+		tr -d '\n' <"$STATUS"
+	else
+		printf '{"running":false}'
+	fi
+}
+
+# The detect block over the package defaults, merged in a /tmp copy.
+merged_config() {
+	local cfg
+	MERGED=$(mktemp /tmp/detect-cfg.XXXXXX)
+	if [ -f "$DEFAULTS_FILE" ]; then cp "$DEFAULTS_FILE" "$MERGED"; else echo '{}' >"$MERGED"; fi
+	cfg=$(jct "$CONFIG_FILE" get detect 2>/dev/null)
+	case "$cfg" in
+	"" | null) ;;
+	*)
+		printf '{"detect":%s}\n' "$cfg" >"$MERGED.in"
+		jct "$MERGED" import "$MERGED.in" >/dev/null 2>&1
+		rm -f "$MERGED.in"
+		;;
+	esac
+	cfg=$(jct "$MERGED" get detect 2>/dev/null)
+	rm -f "$MERGED"
+	case "$cfg" in "" | null) cfg='{}' ;; esac
+	printf '%s' "$cfg"
+}
+
+full_json() {
+	printf '{"config":%s,"status":%s}' "$(merged_config)" "$(status_json)"
+}
+
+case "$REQUEST_METHOD" in
+GET | "")
+	case "$QUERY_STRING" in
+	*a=status*) send_json "$(status_json)" ;;
+	*) send_json "$(full_json)" ;;
+	esac
+	;;
+POST)
+	REQ_FILE=$(mktemp /tmp/detect-req.XXXXXX)
+	if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ]; then
+		dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null >"$REQ_FILE"
+	else
+		cat >"$REQ_FILE"
+	fi
+	grep -q '"detect"' "$REQ_FILE" ||
+		send_json '{"error":{"code":400,"message":"expected {\"detect\":{...}}"}}' "400 Bad Request"
+	jct "$CONFIG_FILE" import "$REQ_FILE" >/dev/null 2>&1 ||
+		send_json '{"error":{"code":500,"message":"could not save /etc/thingino.json"}}' "500 Internal Server Error"
+	# detectd starts again with the new outputs (or stays off, saying why);
+	# the restart waits for it, so the status below may be the old one.
+	/etc/init.d/S36detectd restart >/dev/null 2>&1 &
+	send_json "$(full_json)"
+	;;
+*)
+	send_json '{"error":{"code":405,"message":"Method not allowed"}}' "405 Method Not Allowed"
+	;;
+esac
diff --git a/package/thingino-detect/thingino-detect.mk b/package/thingino-detect/thingino-detect.mk
new file mode 100644
index 000000000..593116f7d
--- /dev/null
+++ b/package/thingino-detect/thingino-detect.mk
@@ -0,0 +1,61 @@
+################################################################################
+#
+# thingino-detect
+#
+################################################################################
+
+THINGINO_DETECT_VERSION = 0.1
+THINGINO_DETECT_SITE_METHOD = local
+THINGINO_DETECT_SITE = $(THINGINO_DETECT_PKGDIR)/files
+THINGINO_DETECT_LICENSE = MIT
+
+THINGINO_DETECT_DEPENDENCIES = thingino-jct
+
+# The event front end (detfront.c, detfront.h) is source that thingino-ipud
+# compiles into ipud from this package's build folder; detectd, on a camera
+# whose rvd detects, is built with it here and talks to rvd through
+# raptor-ipc's control-socket client.
+ifeq ($(BR2_PACKAGE_THINGINO_RAPTOR_IVS_DETECT),y)
+THINGINO_DETECT_DEPENDENCIES += thingino-raptor-ipc
+define THINGINO_DETECT_BUILD_CMDS
+	$(TARGET_CC) $(TARGET_CFLAGS) $(TARGET_LDFLAGS) -Os -s -Wall -Wextra \
+		-o $(@D)/detectd $(@D)/detectd.c $(@D)/detfront.c -ldl -lrss_ipc
+endef
+define THINGINO_DETECT_INSTALL_DETECTD_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/detectd $(TARGET_DIR)/usr/sbin/detectd
+	$(INSTALL) -D -m 0755 $(@D)/S36detectd $(TARGET_DIR)/etc/init.d/S36detectd
+	$(INSTALL) -D -m 0755 $(@D)/raptor-hook $(TARGET_DIR)/etc/raptor.d/detectd
+	$(INSTALL) -D -m 0644 $(@D)/detect.json \
+		$(TARGET_DIR)/usr/share/thingino-defaults/46-detect.json
+	if [ "$(BR2_PACKAGE_THINGINO_WEBUI)" = "y" ]; then \
+		$(INSTALL) -D -m 0755 $(@D)/www/x/json-detectd.cgi \
+			$(TARGET_DIR)/var/www/x/json-detectd.cgi; \
+	fi
+endef
+endif
+
+ifeq ($(BR2_PACKAGE_THINGINO_WEBUI),y)
+THINGINO_DETECT_DEPENDENCIES += thingino-webui
+define THINGINO_DETECT_INSTALL_WWW_CMDS
+	$(INSTALL) -D -m 0644 $(@D)/www/config-detect.html \
+		$(TARGET_DIR)/var/www/config-detect.html
+	$(INSTALL) -D -m 0644 $(@D)/www/a/config-detect.js \
+		$(TARGET_DIR)/var/www/a/config-detect.js
+	$(INSTALL) -D -m 0644 $(@D)/detect.webui.json \
+		$(TARGET_DIR)/var/www/a/plugins/detect.webui.json
+endef
+endif
+
+# The publishers keep ipud's names (/usr/libexec/ipud-*): the ONVIF events,
+# Home Assistant entities and Frigate events they make are named after ipud on
+# every camera, so a controller sees one kind of camera.
+define THINGINO_DETECT_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0644 $(@D)/detect-events $(TARGET_DIR)/usr/libexec/detect-events
+	$(INSTALL) -D -m 0755 $(@D)/ipud-onvif $(TARGET_DIR)/usr/libexec/ipud-onvif
+	$(INSTALL) -D -m 0755 $(@D)/ipud-ha $(TARGET_DIR)/usr/libexec/ipud-ha
+	$(INSTALL) -D -m 0755 $(@D)/ipud-frigate $(TARGET_DIR)/usr/libexec/ipud-frigate
+	$(THINGINO_DETECT_INSTALL_DETECTD_CMDS)
+	$(THINGINO_DETECT_INSTALL_WWW_CMDS)
+endef
+
+$(eval $(generic-package))
