diff --git a/package/thingino-detect/files/S36detectd b/package/thingino-detect/files/S36detectd
new file mode 100755
index 000000000..7ac8ee924
--- /dev/null
+++ b/package/thingino-detect/files/S36detectd
@@ -0,0 +1,136 @@
+#!/bin/sh
+# S36detectd -- the events of raptor's detection (thingino-detect, Ingenic).
+# rvd detects ([motion] of /etc/raptor.conf); detectd publishes what it finds
+# to the same outputs as ipud on SigmaStar: MQTT, ONVIF, Home Assistant and
+# Frigate, set up by /usr/libexec/detect-events from the "detect" block of
+# /etc/thingino.json (the keys of ipud's block: report, hold_ms, mqtt,
+# mqtt_topic, mqtt_interval_ms, onvif, ha, frigate, frigate_url,
+# frigate_camera). It runs only when rvd detects objects ([motion] enabled,
+# with the person detector or a model) and at least one output is on; the
+# class names are the agent's (motion/labels). Raptor's init script stops it
+# before rvd goes down and starts it once rvd is back (/etc/raptor.d/detectd).
+
+DAEMON=/usr/sbin/detectd
+PIDFILE=/run/detectd.pid
+NAME=detectd
+CONFIG=${DETECT_CONFIG:-/etc/thingino.json}
+DEFAULTS=/usr/share/thingino-defaults/46-detect.json
+STATUS=/run/detectd/status.json
+EVENT_DIR=/run/motion
+
+. /usr/libexec/detect-events
+
+# A key of the detect block, or the package default.
+get() {
+	_v=$(jct "$CONFIG" get "detect.$1" 2>/dev/null)
+	[ -n "$_v" ] || _v=$(jct "$DEFAULTS" get "detect.$1" 2>/dev/null)
+	printf '%s' "$_v"
+}
+
+raptor_get() {
+	raptorctl config get "$1" "$2" 2>/dev/null | tr -d '\r\n"'
+}
+
+not_running() {
+	mkdir -p "${STATUS%/*}"
+	printf '{"running":false,"reason":"%s"}\n' "$1" >"$STATUS"
+}
+
+num() {
+	case "$1" in
+	"" | *[!0-9]*) echo "$2" ;;
+	*) echo "$1" ;;
+	esac
+}
+
+# The model's class names, comma-separated, from the agent's motion/labels
+# ({"labels":["person",...]}); the vendor's person detector has one.
+labels() {
+	if [ "$1" = persondet ]; then
+		echo person
+		return
+	fi
+	agentctl get-setting motion/labels 2>/dev/null |
+		sed -n 's/.*"labels": *\[\(.*\)\].*/\1/p' | sed 's/", *"/,/g; s/^"//; s/"$//'
+}
+
+start() {
+	[ -x "$DAEMON" ] || return 0
+	if [ "$(raptor_get motion enabled)" != "true" ]; then
+		detect_events_off
+		not_running "detection is off"
+		return 0
+	fi
+	algo=$(raptor_get motion algorithm)
+	case "$algo" in
+	yolo | persondet) ;;
+	*)
+		detect_events_off
+		not_running "the method (${algo:-move}) finds motion, not objects"
+		return 0
+		;;
+	esac
+	if [ "$(get mqtt)" != "true" ] && [ "$(get onvif)" != "true" ] &&
+		[ "$(get ha)" != "true" ] && [ "$(get frigate)" != "true" ]; then
+		detect_events_off
+		not_running "no event output is on"
+		return 0
+	fi
+	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
+		echo "$NAME already running"
+		return 0
+	fi
+
+	lab=$(labels "$algo")
+	set -- -H "$(num "$(get hold_ms)" 3000)" -M "$(num "$(get mqtt_interval_ms)" 500)"
+	[ -n "$lab" ] && set -- "$@" -L "$lab"
+	report=$(get report)
+	[ -n "$report" ] && set -- "$@" -k "$report"
+
+	detect_events "$NAME" "$report" "$lab"
+	[ -n "$DE_DIR" ] && set -- "$@" -O "$DE_DIR"
+	[ -n "$DE_TOPIC" ] && set -- "$@" -q "$DE_TOPIC"
+	[ -n "$DE_HOOK" ] && set -- "$@" -x "$DE_HOOK"
+
+	echo "Starting $NAME..."
+	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- "$@"
+}
+
+stop() {
+	pid=$(cat "$PIDFILE" 2>/dev/null)
+	[ -n "$pid" ] || pid=$(pidof detectd)
+	rm -f "$PIDFILE"
+	[ -n "$pid" ] || return 0
+	echo "Stopping $NAME..."
+	kill "$pid" 2>/dev/null
+	i=0
+	while [ "$i" -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
+		usleep 100000
+		i=$((i + 1))
+	done
+	if kill -0 "$pid" 2>/dev/null; then
+		kill -9 "$pid" 2>/dev/null
+	fi
+	# detectd clears its event files on exit; a killed one leaves them
+	rm -f "$EVENT_DIR/ipud_person" "$EVENT_DIR/ipud_vehicle" "$EVENT_DIR/ipud_pet"
+	return 0
+}
+
+case "$1" in
+start)
+	start
+	;;
+stop)
+	stop
+	;;
+restart)
+	stop
+	start
+	;;
+*)
+	echo "Usage: $0 {start|stop|restart}" >&2
+	exit 1
+	;;
+esac
+
+exit 0
diff --git a/package/thingino-detect/files/detect-events b/package/thingino-detect/files/detect-events
new file mode 100644
index 000000000..13bed57fc
--- /dev/null
+++ b/package/thingino-detect/files/detect-events
@@ -0,0 +1,117 @@
+# shellcheck shell=sh disable=SC2034  # DE_DIR, DE_TOPIC, DE_HOOK are for the caller
+# detect-events -- the event outputs of on-camera detection, set up the same
+# way for ipud (S35ipud, SigmaStar) and detectd (S36detectd, Ingenic). Sourced.
+#
+# The caller defines get KEY, which reads its own settings block (ipud.* or
+# detect.* in /etc/thingino.json): onvif, ha, frigate, frigate_url,
+# frigate_camera, mqtt, mqtt_topic. Both blocks have the same keys.
+#
+#   detect_events NAME REPORT LABELS
+#       NAME: for messages; REPORT: the classes to report (empty: every one);
+#       LABELS: the model's class names (empty: the six default ones).
+#       Sets DE_DIR (ONVIF event files), DE_TOPIC (MQTT base topic) and DE_HOOK
+#       (the presence hook), each empty when off, for the daemon's -O, -q and
+#       -x; exports the broker (IPUD_MQTT_*) and Frigate (IPUD_FRIGATE_*)
+#       settings the daemon and the hook read.
+#   detect_events_off
+#       Drops the ONVIF events and the Home Assistant entities an earlier run
+#       made.
+#
+# The outputs and their names are ipud's, on every platform: the ONVIF event
+# files /run/motion/ipud_<group> (ipud-onvif), the Home Assistant entities
+# under cameras/<id>/ipud (ipud-ha), Frigate events with sub_label "ipud"
+# (ipud-frigate), and the MQTT topic thingino/<hostname>/ipud by default. So a
+# controller sees one kind of camera, whichever detector found the object.
+
+DE_SEND2=/etc/send2.json
+DE_ONVIF=/usr/libexec/ipud-onvif
+DE_HA=/usr/libexec/ipud-ha
+DE_FRIGATE=/usr/libexec/ipud-frigate
+DE_EVENT_DIR=/run/motion
+DE_DEFAULT_LABELS=person,bicycle,car,motorcycle,bus,truck
+
+# The ONVIF event groups (ipud-onvif) of the classes reported: REPORT, or every
+# class of the model when it is empty.
+de_onvif_groups() {
+	_list=",${1:-$2},"
+	_g=
+	case "$_list" in *,person,*) _g="$_g person" ;; esac
+	case "$_list" in *,bicycle,* | *,car,* | *,motorcycle,* | *,bus,* | *,truck,*) _g="$_g vehicle" ;; esac
+	case "$_list" in *,cat,* | *,dog,*) _g="$_g pet" ;; esac
+	echo "$_g"
+}
+
+detect_events_off() {
+	[ -x "$DE_ONVIF" ] && "$DE_ONVIF" off
+	if [ -x "$DE_HA" ]; then
+		"$DE_HA" off >/dev/null 2>&1 &
+	fi
+	return 0
+}
+
+detect_events() {
+	_name=$1
+	_report=$2
+	_labels=${3:-$DE_DEFAULT_LABELS}
+	DE_DIR=
+	DE_TOPIC=
+	DE_HOOK=
+
+	if [ -x "$DE_ONVIF" ]; then
+		if [ "$(get onvif)" = "true" ]; then
+			# shellcheck disable=SC2046
+			"$DE_ONVIF" on $(de_onvif_groups "$_report" "$_labels")
+			DE_DIR=$DE_EVENT_DIR
+		else
+			"$DE_ONVIF" off
+		fi
+	fi
+
+	# Home Assistant: thingino-ha's broker and the camera's device; it wins
+	# over mqtt. Discovery goes in the background: at boot the init script
+	# runs before the network, and the retained discovery of an earlier start
+	# stands meanwhile.
+	_ha_on=
+	if [ -x "$DE_HA" ] && [ "$(get ha)" = "true" ]; then
+		if _ha_env=$("$DE_HA" env) && eval "$_ha_env"; then
+			export IPUD_MQTT_HOST IPUD_MQTT_PORT IPUD_MQTT_USER IPUD_MQTT_PASS IPUD_MQTT_CLIENT_ID
+			"$DE_HA" on "$_report" "$_labels" >/dev/null 2>&1 &
+			DE_TOPIC=$IPUD_HA_TOPIC
+			_ha_on=1
+		fi
+	elif [ -x "$DE_HA" ]; then
+		"$DE_HA" off >/dev/null 2>&1 &
+	fi
+
+	# Frigate: a manual event per class while it is present (the hook). The
+	# reset ends events a previous run left open (none after a boot: their
+	# ids live in /run).
+	if [ -x "$DE_FRIGATE" ] && [ "$(get frigate)" = "true" ]; then
+		IPUD_FRIGATE_URL=$(get frigate_url)
+		IPUD_FRIGATE_CAMERA=$(get frigate_camera)
+		if [ -n "$IPUD_FRIGATE_URL" ] && [ -n "$IPUD_FRIGATE_CAMERA" ]; then
+			export IPUD_FRIGATE_URL IPUD_FRIGATE_CAMERA
+			"$DE_FRIGATE" reset
+			DE_HOOK=$DE_FRIGATE
+		else
+			echo "$_name: frigate is on, but frigate_url or frigate_camera is empty" >&2
+		fi
+	fi
+
+	if [ -z "$_ha_on" ] && [ "$(get mqtt)" = "true" ] && [ -f "$DE_SEND2" ]; then
+		IPUD_MQTT_HOST=$(jct "$DE_SEND2" get mqtt.host 2>/dev/null)
+		IPUD_MQTT_PORT=$(jct "$DE_SEND2" get mqtt.port 2>/dev/null)
+		IPUD_MQTT_USER=$(jct "$DE_SEND2" get mqtt.username 2>/dev/null)
+		IPUD_MQTT_PASS=$(jct "$DE_SEND2" get mqtt.password 2>/dev/null)
+		IPUD_MQTT_CLIENT_ID=$(jct "$DE_SEND2" get mqtt.client_id 2>/dev/null)
+		export IPUD_MQTT_HOST IPUD_MQTT_PORT IPUD_MQTT_USER IPUD_MQTT_PASS IPUD_MQTT_CLIENT_ID
+		_topic=$(get mqtt_topic)
+		[ -n "$_topic" ] || _topic="thingino/$(hostname)/ipud"
+		if [ -n "$IPUD_MQTT_HOST" ]; then
+			DE_TOPIC=$_topic
+		else
+			echo "$_name: mqtt is on but $DE_SEND2 names no broker" >&2
+		fi
+	fi
+	return 0
+}
