diff --git a/package/thingino-raptor/files/www/a/detect-overlay.js b/package/thingino-raptor/files/www/a/detect-overlay.js
new file mode 100644
index 000000000..036cbc944
--- /dev/null
+++ b/package/thingino-raptor/files/www/a/detect-overlay.js
@@ -0,0 +1,211 @@
+/**
+ * The detection overlay of the preview page: a box, a label and a score for
+ * each object, drawn on a canvas over the live picture. A detector's own
+ * script feeds it; this file only draws and keeps the Detections button.
+ *
+ *   const overlay = window.thinginoDetectOverlay.create({
+ *     canvasId, buttonId, storeKey, title,
+ *     start() { ... },   // begin feeding: call overlay.draw(objects)
+ *     stop() { ... },    // stop feeding
+ *   });
+ *
+ * draw() takes a list of { label, score, box: [x0, y0, x1, y1] } with the box
+ * normalised to the frame (0..1), or null to hide the overlay. The picture is
+ * the media element that shares the canvas's wrapper: the WebRTC <video> on
+ * raptor's preview, the snapshot <img id="preview"> on the plain one. A video
+ * is letterboxed inside its box (object-fit: contain), so the canvas covers
+ * the content rectangle, not the element.
+ *
+ * Off until the viewer turns it on with the button (remembered per browser).
+ * start() runs while it is on, the tab is visible and the player has a
+ * picture; stop() when it is turned off, the tab is hidden, the player loses
+ * its picture (a disconnected stream) or the page is left (the router's
+ * thingino:page-leave), which also removes every listener added here.
+ */
+(function () {
+  "use strict";
+
+  const COLORS = {
+    person: "#ff4d4d",
+    bicycle: "#ffd24d",
+    car: "#4da6ff",
+    motorcycle: "#ff9f40",
+    bus: "#4dffb8",
+    truck: "#b84dff",
+  };
+  const OTHER = "#ffd24d";
+
+  function create(opts) {
+    const canvas = document.getElementById(opts.canvasId);
+    if (!canvas) return null;
+    let feeding = false;
+
+    function media() {
+      const wrap = canvas.parentElement;
+      return (
+        (wrap && wrap.querySelector("video, img#preview")) ||
+        document.getElementById("raptor-webrtc-video") ||
+        document.getElementById("preview")
+      );
+    }
+
+    // Whether el shows a picture now. A <video> does once it has a frame; a
+    // disconnected one (its stream taken away) has none, and boxes over an
+    // empty player would be boxes over nothing.
+    function hasPicture(el) {
+      if (!el) return false;
+      if (el.tagName === "VIDEO")
+        return el.videoWidth > 0 && el.readyState >= 2;
+      return true;
+    }
+
+    // The displayed picture inside el, in el's offset coordinates.
+    function contentRect(el) {
+      if (!hasPicture(el)) return null;
+      const w = el.clientWidth;
+      const h = el.clientHeight;
+      const nw = el.videoWidth || el.naturalWidth || w;
+      const nh = el.videoHeight || el.naturalHeight || h;
+      if (!w || !h || !nw || !nh) return null;
+      const s = Math.min(w / nw, h / nh);
+      const dw = nw * s;
+      const dh = nh * s;
+      return {
+        x: el.offsetLeft + (w - dw) / 2,
+        y: el.offsetTop + (h - dh) / 2,
+        w: dw,
+        h: dh,
+      };
+    }
+
+    function place() {
+      const el = media();
+      const r = el && contentRect(el);
+      if (!r) return false;
+      canvas.style.left = r.x + "px";
+      canvas.style.top = r.y + "px";
+      canvas.style.width = r.w + "px";
+      canvas.style.height = r.h + "px";
+      const cw = Math.round(r.w);
+      const ch = Math.round(r.h);
+      if (canvas.width !== cw) canvas.width = cw;
+      if (canvas.height !== ch) canvas.height = ch;
+      return true;
+    }
+
+    function draw(objects) {
+      if (!objects || !place()) {
+        canvas.style.display = "none";
+        return;
+      }
+      canvas.style.display = "";
+      const ctx = canvas.getContext("2d");
+      const w = canvas.width;
+      const h = canvas.height;
+      ctx.clearRect(0, 0, w, h);
+      ctx.lineWidth = 2;
+      ctx.font = "12px sans-serif";
+      objects.forEach((o) => {
+        const [x0, y0, x1, y1] = o.box;
+        const color = COLORS[o.label] || OTHER;
+        ctx.strokeStyle = color;
+        ctx.strokeRect(x0 * w, y0 * h, (x1 - x0) * w, (y1 - y0) * h);
+        const text = `${o.label} ${Math.round(o.score * 100)}%`;
+        const tw = ctx.measureText(text).width + 6;
+        ctx.fillStyle = color;
+        ctx.fillRect(x0 * w, Math.max(0, y0 * h - 16), tw, 16);
+        ctx.fillStyle = "#000";
+        ctx.fillText(text, x0 * w + 3, Math.max(12, y0 * h - 4));
+      });
+    }
+
+    function enabled() {
+      try {
+        return localStorage.getItem(opts.storeKey) === "1";
+      } catch (e) {
+        return false;
+      }
+    }
+
+    function setEnabled(on) {
+      try {
+        if (on) localStorage.setItem(opts.storeKey, "1");
+        else localStorage.removeItem(opts.storeKey);
+      } catch (e) {
+        /* no storage: the button still works for this page */
+      }
+    }
+
+    function open() {
+      if (feeding || !enabled() || document.hidden || !hasPicture(media()))
+        return;
+      feeding = true;
+      opts.start();
+    }
+
+    function close() {
+      if (feeding) opts.stop();
+      feeding = false;
+      draw(null);
+    }
+
+    const button = document.createElement("button");
+    button.type = "button";
+    button.id = opts.buttonId;
+    button.className = "btn btn-outline-secondary";
+    button.title = opts.title;
+    button.innerHTML = '<i class="bi bi-bounding-box"></i> Detections';
+
+    function render() {
+      const on = enabled();
+      button.classList.toggle("active", on);
+      button.setAttribute("aria-pressed", String(on));
+    }
+
+    button.addEventListener("click", () => {
+      setEnabled(!enabled());
+      render();
+      if (enabled()) open();
+      else close();
+    });
+
+    const bar = document.querySelector(".preview-header-actions");
+    if (bar) bar.appendChild(button);
+    else if (canvas.parentElement)
+      canvas.parentElement.insertAdjacentElement("beforebegin", button);
+
+    function onVisibility() {
+      if (document.hidden) close();
+      else open();
+    }
+
+    // The player gains or loses its picture: connect, disconnect, a stream
+    // switch. Feed only while there is one.
+    const player = media();
+    const PICTURE_EVENTS = ["loadeddata", "playing"];
+
+    function leave() {
+      close();
+      document.removeEventListener("visibilitychange", onVisibility);
+      window.removeEventListener("resize", place);
+      if (player && player.removeEventListener) {
+        PICTURE_EVENTS.forEach((t) => player.removeEventListener(t, open));
+        player.removeEventListener("emptied", close);
+      }
+    }
+
+    document.addEventListener("visibilitychange", onVisibility);
+    document.addEventListener("thingino:page-leave", leave, { once: true });
+    window.addEventListener("resize", place);
+    if (player && player.addEventListener) {
+      PICTURE_EVENTS.forEach((t) => player.addEventListener(t, open));
+      player.addEventListener("emptied", close);
+    }
+    render();
+    open();
+
+    return { draw, enabled };
+  }
+
+  window.thinginoDetectOverlay = { create };
+})();
diff --git a/package/thingino-raptor/files/www/a/preview-detect.js b/package/thingino-raptor/files/www/a/preview-detect.js
new file mode 100644
index 000000000..3c0a23b4e
--- /dev/null
+++ b/package/thingino-raptor/files/www/a/preview-detect.js
@@ -0,0 +1,97 @@
+/**
+ * Preview-page overlay for raptor's IVS detection: draws what rvd detects
+ * (the vendor's person detector or a JZDL model) over the live preview.
+ *
+ * rvd reports its boxes in sub-stream pixels and its classes as numbers. The
+ * feed carries the sub stream's size with them, so a box is normalised here;
+ * the sub stream is the whole frame scaled down, so the same box fits the main
+ * stream's picture. A class number becomes a name from the agent's
+ * settings/motion/labels: the model's own names file when it has one, else
+ * the names the public models were trained on.
+ *
+ * While the viewer has the Detections button on, /x/json-detect.cgi pushes the
+ * detections as server-sent events: one when they change, so the camera runs
+ * no request per update. While rvd does not detect, the feed answers
+ * {"running":false} and ends, and this asks again after a while.
+ * /a/detect-overlay.js draws, owns the button, and closes the feed while the
+ * tab is hidden and when the page is left.
+ *
+ * Plugin-owned file: registered via raptor-detect.webui.json
+ * `preview.scripts`, injected into the preview page at build time.
+ */
+(function () {
+  "use strict";
+
+  const FEED = "/x/json-detect.cgi";
+  const LABELS = "/api/v1/settings/motion/labels";
+  const DOWN_RETRY_MS = 15000;
+
+  if (!window.thinginoDetectOverlay || typeof EventSource !== "function")
+    return;
+
+  let source = null;
+  let timer = null;
+  let labels = [];
+
+  // The feed's event -> the overlay's objects.
+  function objects(ev) {
+    const w = ev.width;
+    const h = ev.height;
+    if (!w || !h) return [];
+    return (ev.detections || []).map((d) => ({
+      label: labels[d.class] || "class " + d.class,
+      score: d.confidence,
+      box: [d.x0 / w, d.y0 / h, d.x1 / w, d.y1 / h],
+    }));
+  }
+
+  function shut() {
+    if (source) source.close();
+    source = null;
+  }
+
+  function open() {
+    clearTimeout(timer);
+    timer = null;
+    if (source) return;
+    source = new EventSource(FEED);
+    source.onmessage = (msg) => {
+      let ev = null;
+      try {
+        ev = JSON.parse(msg.data);
+      } catch (e) {
+        return;
+      }
+      if (ev.running === false) {
+        shut();
+        overlay.draw(null);
+        timer = setTimeout(open, DOWN_RETRY_MS);
+        return;
+      }
+      overlay.draw(objects(ev));
+    };
+    source.onerror = () => overlay.draw(null);
+  }
+
+  const overlay = window.thinginoDetectOverlay.create({
+    canvasId: "detect-overlay",
+    buttonId: "detect-overlay-toggle",
+    storeKey: "thingino.detectOverlay",
+    title: "Show the camera's detections over the picture",
+    start() {
+      open();
+      // The names, once per start: they change with the model.
+      if (typeof agentJsonRequest === "function")
+        agentJsonRequest(LABELS, { cache: "no-store" })
+          .then((l) => {
+            labels = (l && l.labels) || [];
+          })
+          .catch(() => {});
+    },
+    stop() {
+      clearTimeout(timer);
+      timer = null;
+      shut();
+    },
+  });
+})();
diff --git a/package/thingino-raptor/files/www/x/json-detect.cgi b/package/thingino-raptor/files/www/x/json-detect.cgi
new file mode 100755
index 000000000..ce2fb9132
--- /dev/null
+++ b/package/thingino-raptor/files/www/x/json-detect.cgi
@@ -0,0 +1,40 @@
+#!/bin/sh
+# The feed of rvd's detections for the preview overlay and the Detection page:
+# server-sent events, one when the detections change and one every few seconds
+# otherwise, so a viewer that has gone is noticed. Each is
+#   {"running":true,"width":W,"height":H,"detections":[{x0,y0,x1,y1,confidence,class}...]}
+# with the boxes in the sub stream's pixels, W x H. One raptorctl call a tick is
+# all it costs: no agent run per update. When rvd does not detect (the option is
+# off, the stack is down) it sends {"running":false} and ends; the page asks
+# again later.
+
+# shellcheck disable=SC1091  # auth.sh is installed on the camera, not in the build tree
+. /var/www/x/auth.sh
+require_auth
+
+printf 'Status: 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-store\r\n\r\nretry: 15000\n\n'
+
+# The sub stream's size as rvd runs it.
+status=$(raptorctl rvd status 2>/dev/null)
+w=$(printf '%s' "$status" | sed -n 's/.*"chn": *1, *"w": *\([0-9]*\), *"h": *\([0-9]*\).*/\1/p')
+h=$(printf '%s' "$status" | sed -n 's/.*"chn": *1, *"w": *\([0-9]*\), *"h": *\([0-9]*\).*/\2/p')
+
+last=
+n=0
+while :; do
+	d=$(raptorctl rvd ivs-detections 2>/dev/null) || break
+	case "$d" in
+		*'"detections":['*) ;;
+		*) break ;;
+	esac
+	d=${d#*\"detections\":}
+	d=${d%\}*}
+	if [ "$d" != "$last" ] || [ $((n % 10)) = 0 ]; then
+		printf 'data: {"running":true,"width":%s,"height":%s,"detections":%s}\n\n' "${w:-0}" "${h:-0}" "$d" || exit 0
+		last=$d
+	fi
+	n=$((n + 1))
+	usleep 300000 2>/dev/null || sleep 1
+done
+printf 'data: {"running":false}\n\n'
+exit 0
