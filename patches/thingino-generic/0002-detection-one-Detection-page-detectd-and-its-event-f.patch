diff --git a/package/thingino-detect/files/detectd.c b/package/thingino-detect/files/detectd.c
new file mode 100644
index 000000000..53d9e1731
--- /dev/null
+++ b/package/thingino-detect/files/detectd.c
@@ -0,0 +1,209 @@
+/* detectd.c - the events of raptor's detection (rvd's IVS on Ingenic).
+ *
+ * rvd runs the detector (the vendor's person detector, a JZDL or NNA model);
+ * detectd reads what it sees over rvd's control socket (the ivs-detections
+ * command, the same snapshot the preview overlay draws) and hands it to the
+ * detection front end shared with ipud (detfront.c): the status file, the
+ * socket (/run/detectd.sock), MQTT, the ONVIF event files and the presence
+ * hook (Frigate). Motion boxes (class -1) are not objects and are left to
+ * raptor's own motion events.
+ *
+ * rvd gives the boxes in the sub stream's pixels; they are divided by the
+ * sub stream's size (rvd's status), which is the whole picture scaled, so
+ * the fractions map onto every stream as ipud's do.
+ *
+ * MQTT broker settings come from the environment, as for ipud:
+ * IPUD_MQTT_HOST, _PORT, _USER, _PASS, _CLIENT_ID.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <unistd.h>
+#include "detfront.h"
+
+/* raptor-ipc (librss_ipc): one request and its reply on a control socket */
+int rss_ctrl_send_command(const char *sock_path, const char *cmd_json, char *resp_buf,
+                          int resp_buf_size, uint32_t timeout_ms);
+int rss_ctrl_send_command_alloc(const char *sock_path, const char *cmd_json, char **resp_out,
+                                uint32_t timeout_ms);
+
+#define lg(...) df_log(NULL, __VA_ARGS__)
+
+static volatile sig_atomic_t g_stop;
+static void on_signal(int sig) { (void)sig; g_stop = 1; }
+
+/* The number after "key": in s (up to end), or def. */
+static double num_after(const char *s, const char *end, const char *key, double def)
+{
+    size_t kl = strlen(key);
+    for (const char *p = s; p && p < end; p++) {
+        p = memchr(p, '"', (size_t)(end - p));
+        if (!p) break;
+        if ((size_t)(end - p) > kl + 1 && !strncmp(p + 1, key, kl) && p[kl + 1] == '"') {
+            const char *q = p + kl + 2;
+            while (q < end && (*q == ' ' || *q == ':')) q++;
+            char *e;
+            double v = strtod(q, &e);
+            return e == q ? def : v;
+        }
+    }
+    return def;
+}
+
+/* The sub stream's size from rvd's status: {"chn":1,"w":W,"h":H,...}. */
+static int sub_size(const char *sock, int *w, int *h)
+{
+    char *r = NULL;
+    int n = rss_ctrl_send_command_alloc(sock, "{\"cmd\":\"status\"}", &r, 1000);
+    int ok = 0;
+    if (n > 0 && r) {
+        const char *end = r + n;
+        for (const char *p = r; (p = strstr(p, "\"chn\"")); p++) {
+            const char *close = memchr(p, '}', (size_t)(end - p));
+            if (!close) break;
+            if ((int)num_after(p, close, "chn", -1) == 1) {
+                *w = (int)num_after(p, close, "w", 0);
+                *h = (int)num_after(p, close, "h", 0);
+                ok = *w > 0 && *h > 0;
+                break;
+            }
+        }
+    }
+    free(r);
+    return ok;
+}
+
+/* rvd's detections: -1 when rvd does not answer or does not detect, else
+ * how many reported objects went into out. */
+static int read_dets(const char *sock, const df_cfg *c, int w, int h, df_obj *out, int max)
+{
+    char r[8192];
+    int n = rss_ctrl_send_command(sock, "{\"cmd\":\"ivs-detections\"}", r, sizeof r, 1000);
+    if (n <= 0) return -1;
+    const char *p = strstr(r, "\"detections\"");
+    if (!p || !strstr(r, "\"ok\"")) return -1;
+    p = strchr(p, '[');
+    if (!p) return -1;
+    int nr = 0;
+    while (nr < max && (p = strchr(p, '{'))) {
+        const char *e = strchr(p, '}');
+        if (!e) break;
+        int cls = (int)num_after(p, e, "class", -1);
+        if (df_reported(c, cls)) {
+            float x0 = (float)num_after(p, e, "x0", 0) / (float)w, y0 = (float)num_after(p, e, "y0", 0) / (float)h;
+            float x1 = (float)num_after(p, e, "x1", 0) / (float)w, y1 = (float)num_after(p, e, "y1", 0) / (float)h;
+            out[nr].cls = cls;
+            out[nr].score = (float)num_after(p, e, "confidence", 0);
+            out[nr].x0 = x0 < 0 ? 0 : x0 > 1 ? 1 : x0;
+            out[nr].y0 = y0 < 0 ? 0 : y0 > 1 ? 1 : y0;
+            out[nr].x1 = x1 < 0 ? 0 : x1 > 1 ? 1 : x1;
+            out[nr].y1 = y1 < 0 ? 0 : y1 > 1 ? 1 : y1;
+            nr++;
+        }
+        p = e + 1;
+    }
+    return nr;
+}
+
+static void usage(const char *a0)
+{
+    fprintf(stderr,
+        "usage: %s [options]\n"
+        "  -L labels   class names in the model's order (person,bicycle,car,motorcycle,bus,truck)\n"
+        "  -k labels   report only these (default all)\n"
+        "  -P ms       how often rvd is asked (250)\n"
+        "  -R path     rvd's control socket (/var/run/rss/rvd.sock)\n"
+        "  -s path     status JSON (/run/detectd/status.json)  -S path  socket (/run/detectd.sock)\n"
+        "  -I ms       status rewrite interval (1000)\n"
+        "  -q topic    MQTT base topic (broker from IPUD_MQTT_*)\n"
+        "  -H ms       presence hold before OFF (3000)  -M ms  min MQTT detections interval (500)\n"
+        "  -O dir      ONVIF event files: dir/ipud_person, ipud_vehicle, ipud_pet while present\n"
+        "  -x cmd      run 'cmd LABEL ON|OFF' on each presence change (IPUD_SCORE, IPUD_DRAW)\n"
+        "  -n N        stop after N reads      -t  print each read\n"
+        "  -F          foreground, log to stderr    -v  verbose\n", a0);
+}
+
+int main(int argc, char **argv)
+{
+    df_cfg c;
+    const char *keep = NULL, *rvd = "/var/run/rss/rvd.sock";
+    int opt, poll_ms = 250, max_reads = 0;
+
+    df_defaults(&c, "detectd");
+    c.status_path = "/run/detectd/status.json";
+    c.sock_path = "/run/detectd.sock";
+    while ((opt = getopt(argc, argv, "L:k:P:R:s:S:I:q:H:M:O:x:n:tFvh")) != -1) {
+        switch (opt) {
+        case 'L': df_parse_labels(&c, optarg); break;
+        case 'k': keep = optarg; break;
+        case 'P': poll_ms = atoi(optarg) < 50 ? 50 : atoi(optarg); break;
+        case 'R': rvd = optarg; break;
+        case 's': c.status_path = optarg; break;
+        case 'S': c.sock_path = optarg; break;
+        case 'I': c.status_ms = atoi(optarg); break;
+        case 'q': c.topic = optarg; break;
+        case 'H': c.hold_ms = atoi(optarg); break;
+        case 'M': c.mqtt_min_ms = atoi(optarg); break;
+        case 'O': c.ev_dir = *optarg ? optarg : NULL; break;
+        case 'x': c.hook = *optarg ? optarg : NULL; break;
+        case 'n': max_reads = atoi(optarg); break;
+        case 't': c.print = 1; break;
+        case 'F': c.foreground = 1; break;
+        case 'v': c.verbose = 1; break;
+        default: usage(argv[0]); return 2;
+        }
+    }
+    if (!c.foreground) openlog("detectd", LOG_PID, LOG_DAEMON);
+    if (keep && *keep) df_parse_keep(&c, keep);
+    signal(SIGINT, on_signal);
+    signal(SIGTERM, on_signal);
+
+    df_t *fe = df_open(&c);
+    if (!fe) return df_fail(&c, "out of memory");
+    lg(LOG_INFO, "reading %s every %d ms, %d classes", rvd, poll_ms, c.nlabels);
+
+    df_obj objs[DF_MAX_OBJS];
+    int w = 0, h = 0, up = -1;
+    long reads = 0, n_up = 0;
+    double t_win = df_now_ms(), rate = 0;
+    long win_n = 0;
+
+    while (!g_stop) {
+        double t0 = df_now_ms();
+        df_service(fe, t0);
+        if (w <= 0 && !sub_size(rvd, &w, &h)) w = 0;
+        int n = w > 0 ? read_dets(rvd, &c, w, h, objs, DF_MAX_OBJS) : -1;
+        double t1 = df_now_ms();
+        int now_up = n >= 0;
+        if (now_up != up) {
+            lg(LOG_INFO, now_up ? "rvd detects (sub stream %dx%d)" : "rvd does not detect, or does not answer", w, h);
+            up = now_up;
+        }
+        if (!now_up) w = h = 0;         /* ask the size again: rvd may have restarted with another */
+        else n_up++;
+        df_update(fe, t1, objs, n < 0 ? 0 : n, (unsigned long long)(t1 * 1000), t1 - t0);
+        reads++; win_n++;
+        if (t1 - t_win >= 2000) {
+            rate = win_n * 1000.0 / (t1 - t_win);
+            win_n = 0;
+            t_win = t1;
+        }
+        if (df_status_due(fe, t1)) {
+            char m[256];
+            snprintf(m, sizeof m, "\"source\":\"rvd\",\"rvd\":%s,\"input\":[%d,%d],\"fps\":%.1f,\"reads\":%ld,\"detecting\":%ld",
+                     now_up ? "true" : "false", w, h, rate, reads, n_up);
+            df_status(fe, m);
+        }
+        if (max_reads && reads >= max_reads) break;
+        double left = poll_ms - (df_now_ms() - t0);
+        if (left > 0 && !g_stop) usleep((useconds_t)(left * 1000));
+    }
+    lg(LOG_INFO, "stopping after %ld reads", reads);
+    df_close(fe);
+    return 0;
+}
