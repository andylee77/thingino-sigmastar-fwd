+trap 'rm -f /tmp/agent-raptor-isp.$$ /tmp/agent-raptor-wb.$$ /tmp/agent-raptor-stream0.$$ /tmp/agent-raptor-stream1.$$ /tmp/agent-raptor-rvdconfig.$$' EXIT
 
