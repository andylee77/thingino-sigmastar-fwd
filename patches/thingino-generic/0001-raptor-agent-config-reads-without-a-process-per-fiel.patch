+# Values of several keys of stream $1's section dump in one awk pass, one line
+# each in the order asked, read the way agent_stream_field reads one: the
+# first "key = value" line, the value trimmed, quotes and CRs dropped. A key
+# written "upper:<key>" comes out upper-cased (agent_stream_format/_mode).
+# A key the dump does not carry gives an empty line: the caller falls back to
+# agent_config_get, as agent_stream_field does. This replaces a
+# printf|sed|head|sed|tr pipeline per field.
+agent_stream_dump_values() {
+	_dv_id=$1
+	shift
+	agent_stream_section_dump "$_dv_id" | awk -v keys="$*" '
+		{
+			i = index($0, "=")
+			if (!i) next
+			key = substr($0, 1, i - 1)
+			gsub(/^[ \t\r\f\v]+|[ \t\r\f\v]+$/, "", key)
+			if (key in m) next
+			val = substr($0, i + 1)
+			sub(/^[ \t\r\f\v]+/, "", val)
+			sub(/[ \t\r\f\v]+$/, "", val)
+			gsub(/["\r]/, "", val)
+			m[key] = val
+		}
+		END {
+			n = split(keys, want, " ")
+			for (k = 1; k <= n; k++) {
+				if (want[k] ~ /^upper:/) print toupper(m[substr(want[k], 7)])
+				else print m[want[k]]
+			}
+		}'
 }
 
