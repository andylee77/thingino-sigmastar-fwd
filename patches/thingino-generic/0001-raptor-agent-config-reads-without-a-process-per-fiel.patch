+	# default, so a key it lacks has no value: asking raptorctl again (a
+	# single-key get, then the listing) would only come back empty.
+	eval "[ -z \"\${$_var+x}\" ]" || return 0
 	value=$(raptorctl config get "$section" "$key" 2>/dev/null | tr -d '\r\n"')
 	# A single-key get only finds keys set in raptor.conf; the section listing
 	# also carries the defaults the daemons run with.
@@ -85,13 +93,19 @@ agent_config_var() {
 agent_config_preload() {
