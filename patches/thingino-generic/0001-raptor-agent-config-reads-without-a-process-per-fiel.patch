-	_st_rc=$(agent_stream_field "$1" rc_mode | tr 'A-Z' 'a-z')
+	#
+	# One raptorctl section dump, parsed by a single awk pass -- not a
+	# printf|sed|head|sed|tr pipeline per field. The old per-field reader forked
+	# roughly ninety busybox processes per stream (~0.6 s on an Infinity6C core,
+	# and the Streamer page reads both streams at once), which is what made the
+	# settings pages take seconds to load. This forks a handful.
+	_sl_id=$1
+	_sl_jpeg_gate=$(agent_config_bool jpeg enabled true)
+	_sl_fields=$(agent_stream_section_dump "$_sl_id" | awk -F'=' '
+		{
+			key = $1; val = $2
+			gsub(/[ \t\r]/, "", key)
+			sub(/^[ \t]+/, "", val); sub(/[ \t\r]+$/, "", val); gsub(/"/, "", val)
+			m[key] = val
+		}
+		END {
+			print m["width"]; print m["height"]; print m["fps"]
+			print m["bitrate"]; print (m["max_bitrate"] == "" ? 0 : m["max_bitrate"])
+			print m["gop"]; print tolower(m["codec"]); print m["profile"]
+			print tolower(m["rc_mode"]); print m["jpeg"]
+			print m["jpeg_quality"]; print m["enabled"]
+		}')
+	# Pull the fixed-order lines into vars with read builtins (no forks); the
+	# heredoc keeps the reads in this shell, unlike a pipe.
+	{
+		read -r _st_w
+		read -r _st_h
+		read -r _st_fps
+		read -r _st_bitrate
+		read -r _st_maxbr
+		read -r _st_gop
+		read -r _st_codec
+		read -r _sl_profile_raw
+		read -r _st_rc
+		read -r _sl_jpeg_raw
+		read -r _st_jq
+		read -r _sl_enabled_raw
+	} <<-EOF
+	$_sl_fields
+	EOF
+	_st_profile=$(agent_profile_to_name "$_sl_profile_raw")
 	# rvd pairs a JPEG channel with every stream unless [jpeg] or the stream
 	# says otherwise.
-	if [ "$(agent_config_bool jpeg enabled true)" = true ]; then
-		_st_jpeg=$(agent_bool_word "$(agent_stream_field "$1" jpeg)" true)
+	if [ "$_sl_jpeg_gate" = true ]; then
+		_st_jpeg=$(agent_bool_word "$_sl_jpeg_raw" true)
 	else
 		_st_jpeg=false
 	fi
-	_st_jq=$(agent_stream_field "$1" jpeg_quality)
 	[ -n "$_st_jq" ] || _st_jq=$(agent_config_get jpeg quality)
-	_st_enabled=$(agent_stream_enabled "$1")
+	[ -n "$_st_maxbr" ] || _st_maxbr=0
+	# Stream 0 is always on; stream 1's enabled key (default true) came out of
