 		agent_config_var "$_section"
-		# A failed read stays uncached so its keys fall back to single gets.
-		_listing=$(raptorctl config get "$_section" 2>/dev/null) &&
+		# A failed read stays uncached so its keys fall back to single gets,
+		# unless raptorctl printed the section header: then it read the
+		# config and the section has no entries ("Section not found"), so
