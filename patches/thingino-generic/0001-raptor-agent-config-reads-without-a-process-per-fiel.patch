+# Parse the flat ISP dump once per adapter invocation into _isp_<key> vars, so
+# callers read a shell variable instead of sed-ing the whole blob for every
+# field (the Image Quality / config pages read ~13 of them). The dump is flat
+# JSON of integer fields (plus wb_mode, a string handled separately); only keys
+# matching [a-z_] with an integer value are imported, so the eval is safe.
+agent_isp_load() {
+	[ "$_isp_loaded" = 1 ] && return 0
+	_isp_loaded=1
+	eval "$(agent_isp_json | awk '
+		{
+			gsub(/[{}"]/, "")
+			_n = split($0, _p, ",")
+			for (_i = 1; _i <= _n; _i++) {
+				_c = index(_p[_i], ":")
+				if (_c == 0) continue
+				_k = substr(_p[_i], 1, _c - 1)
+				_v = substr(_p[_i], _c + 1)
+				if (_k ~ /^[a-z_][a-z0-9_]*$/ && _v ~ /^-?[0-9]+$/)
+					printf "_isp_%s=%s\n", _k, _v
+			}
+		}')"
+}
+
 agent_image_raw() {
 	key=$1
-	isp=$(agent_isp_json)
-	if [ -n "$isp" ]; then
-		value=$(agent_json_number_field "$key" "$isp")
-		if [ -n "$value" ]; then
-			printf '%s' "$value"
-			return 0
-		fi
-		# Some ISP dumps use nested objects; fall through to config.
+	agent_isp_load
+	eval "value=\${_isp_$key:-}"
+	if [ -n "$value" ]; then
+		printf '%s' "$value"
+		return 0
 	fi
+	# Not an integer field in the ISP dump (nested/absent); fall through to config.
 	agent_config_get image "$key"
 }
 
@@ -658,6 +696,14 @@ agent_motion_set_enabled() {
 	return 0
 }
 
+# Whether rvd runs an IVS channel now (it builds one only at its start).
+agent_ivs_running() {
