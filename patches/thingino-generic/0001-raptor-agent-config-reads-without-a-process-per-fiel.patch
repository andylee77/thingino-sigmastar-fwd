+# ---- GET /config without a shell copy per field ---------------------------
+# agent_print_config and the stream blocks under it printed every field as
+#   "$(agent_json_x "$(agent_config_get section key)")"
+# which is two or three copies of the shell (and often a tr) per field: about
+# 390 processes for one config read, though every section is already in
+# memory after agent_config_preload. The helpers below hand their result back
+# in a variable (_cv, _js) instead of on stdout, so a field costs none. The
+# printing helpers stay as they are for every other caller.
+
+# section key -> _cv, as agent_config_get.
+agent_cfg() {
+	if agent_config_lookup "$1" "$2"; then
+		_cv=$value
+		return 0
+	fi
+	_cv=
+	# A preloaded listing that lacks the key: no value (see agent_config_get).
+	eval "[ -z \"\${$_var+x}\" ]" || return 0
+	_cv=$(agent_config_get "$1" "$2")
+}
+
+# value default -> _cv true/false, as agent_bool01_to_json and agent_config_bool.
+agent_bool_val() {
+	case "$1" in
