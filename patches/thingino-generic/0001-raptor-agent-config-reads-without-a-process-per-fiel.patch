+# What the runtime object of every stream shares, read once per request:
+# runtime/all prints two streams, and each used to read all of it again.
+# Call before agent_print_stream_runtime.
+agent_stream_runtime_shared_load() {
+	_rt_audio=$(agent_stream_audio_enabled)
+	_rt_port=$(agent_rtsp_port)
+	_rt_scheme=$(agent_rtsp_scheme)
+	_rt_ip=$(agent_network_ip)
+	_rt_listening=$(agent_rtsp_listening "$_rt_port")
