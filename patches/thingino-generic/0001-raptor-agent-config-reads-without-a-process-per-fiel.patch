@@ -5,6 +5,18 @@ OS_RELEASE_FILE="${OS_RELEASE_FILE:-/etc/os-release}"
 THINGINO_CONFIG_FILE="${THINGINO_CONFIG_FILE:-/etc/thingino.json}"
 
 agent_json_string() {
+	# Most values (numbers, names, addresses, URLs, dates) have nothing to
+	# escape: quote them as they are instead of forking a printf|awk pipeline
+	# for each one -- an adapter reply builds dozens of strings. Anything
+	# outside this set takes the awk path, which escapes it.
+	case "$1" in
+		*[!A-Za-z0-9._:/@,+=\ -]*) ;;
+		*)
+			value=$1
+			printf '"%s"' "$value"
+			return 0
+			;;
+	esac
 	value=$(printf '%s' "$1" | awk 'BEGIN { ORS="" } {
 		gsub(/\\/, "\\\\");
 		gsub(/"/, "\\\"");
