 }
 
+agent_stream_section_dump() {
+	# Cache one `raptorctl config get streamN` per adapter invocation, for the
+	# one-pass stream readers (agent_stream_state_load, agent_stream_dump_values).
+	# The section dump carries the EFFECTIVE config, every key with its running
