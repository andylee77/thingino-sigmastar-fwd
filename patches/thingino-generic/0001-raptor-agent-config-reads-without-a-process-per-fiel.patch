+		*'"active":true'* | *'"active": true'*) return 0 ;;
+	esac
+	return 1
+}
+
 agent_motion_active() {
 	status=$(agent_daemon_status rmd)
 	state=$(agent_json_string_field state "$status")
@@ -678,6 +724,181 @@ agent_motion_active() {
 	printf 'false'
 }
 
+# The detection algorithms rvd can run on this image: the SDK's motion grid
+# always, the vendor's person detector when its library is installed, and a
+# model when an engine for it is: JZDL, or on a T41 the Uranus runtime of the
+# NNA backend (BR2_PACKAGE_THINGINO_RAPTOR_IVS_NNA).
+agent_motion_algorithms() {
+	_ma='"move","base_move"'
+	[ -e /usr/lib/libpersonDet_inf.so ] && _ma="$_ma,\"persondet\""
+	if [ -e /usr/lib/libjzdl.m.so ] || [ -e /usr/lib/liburanus_core.so ]; then
+		_ma="$_ma,\"yolo\""
+	fi
+	printf '[%s]' "$_ma"
+}
+
+# The model files a model run can load: JZDL's .bin, the Uranus runtime's .mgk;
+# the image's, then a models folder at the top of an SD card (a model dropped
+# there can be picked without a new image; its <model>.txt class names beside it).
+agent_motion_models() {
+	_mm=
+	for _mf in /usr/share/models/*.bin /usr/share/models/*.mgk \
+		/mnt/mmcblk*/models/*.bin /mnt/mmcblk*/models/*.mgk; do
+		[ -f "$_mf" ] || continue
+		_mm="$_mm${_mm:+,}\"$_mf\""
+	done
+	printf '[%s]' "$_mm"
+}
+
+# section key default -> _cv, a whole number (the default when the file has
+# none or something else).
+agent_cfg_int() {
+	agent_cfg "$1" "$2"
+	case "$_cv" in
+		'' | *[!0-9]*) _cv=$3 ;;
+	esac
+}
+
+# PATCH one whole-number [motion] key that rvd reads at its start.
+agent_set_motion_int() {
+	value=$(agent_setting_value "$2" "$3") || return 1
+	agent_validate_int "$value" || return 1
+	if [ "$value" -lt "$5" ] || [ "$value" -gt "$6" ]; then
+		echo "$3 must be $5-$6" >&2
+		return 1
+	fi
+	agent_config_set motion "$4" "$value" || return 1
+	agent_config_save
+	agent_print_setting_restart "$1" "$3" "$value"
+}
+
+# rod draws rvd's detections into the sub stream whenever [motion] is on: it
+# adds an overlay element named "detect" unless raptor.conf declares one, and
+# draws only while that element is visible. So the switch is that element's
+# section. It is written only to turn the boxes off (and back on once it
+# exists): a declared element is created at rod's start even with detection
+# off, a full-frame buffer of the sub stream.
+agent_motion_draw_boxes() {
+	agent_config_bool osd.detect visible true
+}
+
+agent_motion_set_draw_boxes() {
+	_db_have=$(raptorctl config get osd.detect 2>/dev/null || true)
+	if [ "$1" = false ] || [ -n "$_db_have" ]; then
+		agent_osd_ensure_section osd.detect || return 1
+		agent_config_set osd.detect visible "$1" || return 1
+		agent_config_save
+	fi
+	# Live while rod has the element; a rod that starts later reads the file.
+	if [ "$1" = true ]; then
+		agent_ctl rod show-element detect >/dev/null 2>&1 || true
+	else
+		agent_ctl rod hide-element detect >/dev/null 2>&1 || true
+	fi
+}
+
+# The class names of the model in use, in class order: one a line in a file
+# beside it, <model>.txt for <model>.bin or <model>.mgk. A model without that file gets the
+# names the public Magik models were trained on (COCO's order: the four-class
+# model has its first four, the person detector its first), as many as the
+# model has classes.
+AGENT_MOTION_COCO='person,bicycle,car,motorcycle,airplane,bus,train,truck,boat,traffic light,fire hydrant,stop sign,parking meter,bench,bird,cat,dog,horse,sheep,cow,elephant,bear,zebra,giraffe,backpack,umbrella,handbag,tie,suitcase,frisbee,skis,snowboard,sports ball,kite,baseball bat,baseball glove,skateboard,surfboard,tennis racket,bottle,wine glass,cup,fork,knife,spoon,bowl,banana,apple,sandwich,orange,broccoli,carrot,hot dog,pizza,donut,cake,chair,couch,potted plant,bed,dining table,toilet,tv,laptop,mouse,remote,keyboard,cell phone,microwave,oven,toaster,sink,refrigerator,book,clock,vase,scissors,teddy bear,hair drier,toothbrush'
+
+agent_motion_labels() {
+	_ml=$(agent_config_get motion model)
+	_ml=${_ml:-/usr/share/models/magik_model_yolov5.bin}
+	_ml=${_ml%.bin}
+	_ml=${_ml%.mgk}.txt
+	_mo=
+	_mn=0
+	if [ -f "$_ml" ]; then
+		while IFS= read -r _mline || [ -n "$_mline" ]; do
+			_mline=$(printf '%s' "$_mline" | tr -cd 'A-Za-z0-9 _-')
+			[ -n "$_mline" ] || continue
+			_mo="$_mo${_mo:+,}\"$_mline\""
+			_mn=$((_mn + 1))
+			[ "$_mn" -ge 80 ] && break
+		done <"$_ml"
+	else
+		agent_cfg_int motion num_classes 4
+		_mold=$IFS
+		IFS=,
+		for _mline in $AGENT_MOTION_COCO; do
+			[ "$_mn" -ge "$_cv" ] && break
+			_mo="$_mo${_mo:+,}\"$_mline\""
+			_mn=$((_mn + 1))
+		done
+		IFS=$_mold
+	fi
+	printf '[%s]' "$_mo"
+}
+
+# The [motion] values, as the inside of a JSON object: "enabled" always, the
+# detection values on an image with IVS (rvd's defaults where raptor.conf has
+# none).
+agent_print_motion_fields() {
+	agent_cfg_bool motion enabled false
+	printf '"enabled":%s' "$_cv"
+	if agent_isp_has ivs; then
+		agent_cfg motion algorithm
+		agent_jstr "${_cv:-move}"
+		printf ',"algorithm":%s' "$_js"
+		agent_cfg_int motion sensitivity 3
+		printf ',"sensitivity":%s' "$_cv"
+		agent_cfg_int motion cooldown_sec 10
+		printf ',"cooldown_time":%s' "$_cv"
+		agent_cfg motion model
+		agent_jstr "${_cv:-/usr/share/models/magik_model_yolov5.bin}"
+		printf ',"model":%s' "$_js"
+		agent_cfg_int motion num_classes 4
+		printf ',"num_classes":%s' "$_cv"
+		agent_cfg_int motion conf_threshold 40
+		printf ',"conf_threshold":%s' "$_cv"
+		agent_cfg_int motion nms_threshold 50
+		printf ',"nms_threshold":%s' "$_cv"
+		agent_cfg_int motion detect_interval_ms 0
+		printf ',"detect_interval_ms":%s' "$_cv"
+		printf ',"draw_boxes":%s' "$(agent_motion_draw_boxes)"
+	fi
+}
+
+# settings/motion: everything the Detection page shows, in one answer.
+agent_print_motion_settings() {
+	printf '{'
+	agent_print_motion_fields
+	if agent_isp_has ivs; then
+		printf ',"supported":true,"algorithms":%s,"models":%s,"labels":%s' \
+			"$(agent_motion_algorithms)" "$(agent_motion_models)" "$(agent_motion_labels)"
+	else
+		printf ',"supported":false'
+	fi
+	printf '}\n'
+}
+
+# What rvd detects right now: its boxes are in sub-stream pixels, so that
+# stream's size goes with them. An image without IVS has none.
+agent_print_runtime_detections() {
+	agent_cfg_int stream1 width 0
+	_dw=$_cv
+	agent_cfg_int stream1 height 0
+	_dh=$_cv
+	_dj=
+	if agent_isp_has ivs && command -v raptorctl >/dev/null 2>&1; then
+		_dj=$(raptorctl rvd ivs-detections 2>/dev/null) || _dj=
+	fi
+	case "$_dj" in
+		*'"detections":['*)
+			_dc=$(printf '%s' "$_dj" | sed -n 's/.*"count": *\([0-9]*\).*/\1/p')
+			_dl=${_dj#*\"detections\":}
+			_dl=${_dl%\}*}
+			printf '{"width":%s,"height":%s,"count":%s,"detections":%s}' "$_dw" "$_dh" "${_dc:-0}" "$_dl"
+			;;
+		*)
+			printf '{"width":%s,"height":%s,"count":0,"detections":[]}' "$_dw" "$_dh"
+			;;
+	esac
+}
