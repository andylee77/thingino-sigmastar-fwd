-trap 'rm -f /tmp/agent-raptor-isp.$$ /tmp/agent-raptor-wb.$$ /tmp/agent-raptor-rvdconfig.$$' EXIT
+# The per-invocation caches below (get-isp, get-wb, stream section dumps, the
