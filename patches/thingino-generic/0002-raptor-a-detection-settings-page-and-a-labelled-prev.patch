diff --git a/package/thingino-raptor/files/www/a/config-detect.js b/package/thingino-raptor/files/www/a/config-detect.js
new file mode 100644
index 000000000..1e6931c93
--- /dev/null
+++ b/package/thingino-raptor/files/www/a/config-detect.js
@@ -0,0 +1,272 @@
+/**
+ * Settings and status page for raptor's detection (rvd's IVS: the SDK's
+ * motion grid, the vendor's person detector, a JZDL model).
+ *
+ * One read of the agent's settings/motion gives everything the page shows:
+ * whether this camera can detect at all, the methods whose libraries are
+ * installed, the model files on the camera, the saved values and the class
+ * names. A save writes only what changed, one setting at a time; the camera
+ * says for each whether it applied at once or waits for a restart of the
+ * video, and the page offers that restart.
+ *
+ * The status line follows /x/json-detect.cgi, the same pushed feed the preview
+ * overlay draws from, while the tab is visible.
+ */
+(function () {
+  "use strict";
+
+  const SETTING = "/api/v1/settings/motion";
+  const FEED = "/x/json-detect.cgi";
+  const DOWN_RETRY_MS = 10000;
+
+  // field -> [agent leaf, kind]; saved in this order, so detection is turned
+  // on only after what it runs with is written.
+  const FIELDS = {
+    algorithm: ["algorithm", "text"],
+    model: ["model", "text"],
+    num_classes: ["num-classes", "int"],
+    conf_threshold: ["conf-threshold", "int"],
+    nms_threshold: ["nms-threshold", "int"],
+    sensitivity: ["sensitivity", "int"],
+    cooldown_time: ["cooldown-time", "int"],
+    draw_boxes: ["draw-boxes", "bool"],
+    enabled: ["enabled", "bool"],
+  };
+  const MODEL_FIELDS = [
+    "model",
+    "num_classes",
+    "conf_threshold",
+    "nms_threshold",
+  ];
+  const METHODS = {
+    move: ["Motion", "Any movement, on a grid over the picture."],
+    base_move: ["Motion (basic)", "The SDK's simpler movement check."],
+    persondet: ["People", "The vendor's person detector."],
+    yolo: [
+      "Objects (model)",
+      "The classes of a model. Without a neural accelerator in the SoC this takes most of the CPU.",
+    ],
+  };
+
+  const $id = (id) => document.getElementById(id);
+  const el = (k) => $id("detect_" + k);
+  const saveBtn = $id("detect-save");
+  const restartBtn = $id("detect-restart");
+  const loaded = {};
+  let models = [];
+  let labels = [];
+  let source = null;
+  let timer = null;
+  let gone = false;
+
+  function notify(type, message) {
+    if (window.showAlert) window.showAlert(type, message, 6000);
+    else alert(message);
+  }
+
+  function fieldValue(k) {
+    const n = el(k);
+    const kind = FIELDS[k][1];
+    if (kind === "bool") return n.checked;
+    if (kind === "int") {
+      const v = n.value.trim();
+      return /^\d+$/.test(v) ? Number(v) : null;
+    }
+    return n.value || null;
+  }
+
+  function show(k, v) {
+    const n = el(k);
+    if (FIELDS[k][1] === "bool") n.checked = v === true;
+    else n.value = v === null || v === undefined ? "" : v;
+  }
+
+  function fillSelect(n, values, text) {
+    n.textContent = "";
+    values.forEach((v) => {
+      const o = document.createElement("option");
+      o.value = v;
+      o.textContent = text(v);
+      n.appendChild(o);
+    });
+  }
+
+  // The model settings matter to the model method only; without a model file
+  // on the camera that method cannot run, and the page says so.
+  function refreshMethod() {
+    const a = el("algorithm").value;
+    $id("detect-algorithm-hint").textContent = (METHODS[a] || ["", ""])[1];
+    $id("detect-model-card").classList.toggle("d-none", a !== "yolo");
+    $id("detect-no-model").classList.toggle(
+      "d-none",
+      a !== "yolo" || models.length > 0,
+    );
+  }
+
+  function lock(message) {
+    $id("detect-form").classList.add("d-none");
+    const box = $id("detect-unsupported");
+    if (message) box.textContent = message;
+    box.classList.remove("d-none");
+  }
+
+  function shut() {
+    if (source) source.close();
+    source = null;
+  }
+
+  // The status line, from the pushed feed.
+  function follow() {
+    clearTimeout(timer);
+    timer = null;
+    if (source || gone || document.hidden || typeof EventSource !== "function")
+      return;
+    source = new EventSource(FEED);
+    source.onmessage = (msg) => {
+      let ev = null;
+      try {
+        ev = JSON.parse(msg.data);
+      } catch (e) {
+        return;
+      }
+      if (ev.running === false) {
+        shut();
+        $id("detect-state").textContent = "off";
+        $id("detect-objects").textContent = "-";
+        if (!gone) timer = setTimeout(follow, DOWN_RETRY_MS);
+        return;
+      }
+      $id("detect-state").textContent = "on";
+      const seen = (ev.detections || []).map(
+        (o) =>
+          (labels[o.class] || "class " + o.class) +
+          " " +
+          Math.round(o.confidence * 100) +
+          "%",
+      );
+      $id("detect-objects").textContent = seen.length
+        ? seen.join(", ")
+        : "nothing";
+    };
+    source.onerror = () => {
+      $id("detect-state").textContent = "no answer from the camera";
+    };
+  }
+
+  async function load() {
+    let s = null;
+    try {
+      s = await agentJsonRequest(SETTING, { cache: "no-store" });
+    } catch (err) {
+      console.warn("Failed to load the detection settings", err);
+    }
+    if (!s || s.supported !== true) {
+      lock(s ? "" : "The camera did not answer. Reload the page.");
+      return;
+    }
+    models = s.models || [];
+    labels = s.labels || [];
+    fillSelect(el("algorithm"), s.algorithms || ["move"], (a) =>
+      METHODS[a] ? METHODS[a][0] : a,
+    );
+    fillSelect(el("model"), models, (m) => m.replace(/^.*\//, ""));
+    for (const k of Object.keys(FIELDS)) {
+      const v = s[k];
+      // A saved model that is no longer on the camera stays visible.
+      if (k === "model" && v && models.length && !models.includes(v)) {
+        const o = document.createElement("option");
+        o.value = v;
+        o.textContent = v.replace(/^.*\//, "") + " (missing)";
+        el(k).appendChild(o);
+      }
+      show(k, v);
+      loaded[k] = fieldValue(k);
+    }
+    refreshMethod();
+    follow();
+  }
+
+  async function save() {
+    const method = el("algorithm").value;
+    if (method === "yolo" && !models.length) {
+      notify("danger", "There is no model file on the camera for this method.");
+      return;
+    }
+    saveBtn.disabled = true;
+    let staged = false;
+    try {
+      for (const [k, [leaf]] of Object.entries(FIELDS)) {
+        const now = fieldValue(k);
+        if (now === null || now === loaded[k]) continue;
+        // The model's own settings are written only when a model is used.
+        if (MODEL_FIELDS.includes(k) && method !== "yolo") continue;
+        const res = await agentJsonRequest(SETTING + "/" + leaf, {
+          method: "PATCH",
+          body: { [k]: now },
+          cache: "no-store",
+        });
+        if (!res || res.status !== "accepted") {
+          throw new Error(k.replace(/_/g, " ") + " was rejected by the camera");
+        }
+        if ((res.restart_required || []).length) staged = true;
+        loaded[k] = now;
+      }
+      if (staged) {
+        restartBtn.classList.remove("d-none");
+        notify(
+          "warning",
+          "Saved. Restart the video to apply the new method or model.",
+        );
+      } else {
+        notify("success", "Detection settings saved.");
+      }
+    } catch (err) {
+      console.error("Failed to save the detection settings", err);
+      notify("danger", "Failed to save the detection settings: " + err.message);
+    } finally {
+      saveBtn.disabled = false;
+    }
+  }
+
+  async function restart() {
+    restartBtn.disabled = true;
+    shut();
+    try {
+      const res = await fetch("/x/restart-streamer.cgi", { cache: "no-store" });
+      const body = await res.json();
+      if (!res.ok || body.error) throw new Error("the camera refused");
+      restartBtn.classList.add("d-none");
+      notify("success", "The video restarted.");
+    } catch (err) {
+      notify("danger", "Failed to restart the video: " + err.message);
+    } finally {
+      restartBtn.disabled = false;
+      follow();
+    }
+  }
+
+  function onVisibility() {
+    if (document.hidden) {
+      clearTimeout(timer);
+      timer = null;
+      shut();
+    } else if (loaded.enabled !== undefined) {
+      follow();
+    }
+  }
+
+  function leave() {
+    gone = true;
+    clearTimeout(timer);
+    timer = null;
+    shut();
+    document.removeEventListener("visibilitychange", onVisibility);
+  }
+
+  el("algorithm").addEventListener("change", refreshMethod);
+  saveBtn.addEventListener("click", save);
+  restartBtn.addEventListener("click", restart);
+  document.addEventListener("visibilitychange", onVisibility);
+  document.addEventListener("thingino:page-leave", leave, { once: true });
+  load();
+})();
diff --git a/package/thingino-raptor/files/www/a/detect-overlay.js b/package/thingino-raptor/files/www/a/detect-overlay.js
new file mode 100644
index 000000000..036cbc944
--- /dev/null
+++ b/package/thingino-raptor/files/www/a/detect-overlay.js
@@ -0,0 +1,211 @@
+/**
+ * The detection overlay of the preview page: a box, a label and a score for
+ * each object, drawn on a canvas over the live picture. A detector's own
+ * script feeds it; this file only draws and keeps the Detections button.
+ *
+ *   const overlay = window.thinginoDetectOverlay.create({
+ *     canvasId, buttonId, storeKey, title,
+ *     start() { ... },   // begin feeding: call overlay.draw(objects)
+ *     stop() { ... },    // stop feeding
+ *   });
+ *
+ * draw() takes a list of { label, score, box: [x0, y0, x1, y1] } with the box
+ * normalised to the frame (0..1), or null to hide the overlay. The picture is
+ * the media element that shares the canvas's wrapper: the WebRTC <video> on
+ * raptor's preview, the snapshot <img id="preview"> on the plain one. A video
+ * is letterboxed inside its box (object-fit: contain), so the canvas covers
+ * the content rectangle, not the element.
+ *
+ * Off until the viewer turns it on with the button (remembered per browser).
+ * start() runs while it is on, the tab is visible and the player has a
+ * picture; stop() when it is turned off, the tab is hidden, the player loses
+ * its picture (a disconnected stream) or the page is left (the router's
+ * thingino:page-leave), which also removes every listener added here.
+ */
+(function () {
+  "use strict";
+
+  const COLORS = {
+    person: "#ff4d4d",
+    bicycle: "#ffd24d",
+    car: "#4da6ff",
+    motorcycle: "#ff9f40",
+    bus: "#4dffb8",
+    truck: "#b84dff",
+  };
+  const OTHER = "#ffd24d";
+
+  function create(opts) {
+    const canvas = document.getElementById(opts.canvasId);
+    if (!canvas) return null;
+    let feeding = false;
+
+    function media() {
+      const wrap = canvas.parentElement;
+      return (
+        (wrap && wrap.querySelector("video, img#preview")) ||
+        document.getElementById("raptor-webrtc-video") ||
+        document.getElementById("preview")
+      );
+    }
+
+    // Whether el shows a picture now. A <video> does once it has a frame; a
+    // disconnected one (its stream taken away) has none, and boxes over an
+    // empty player would be boxes over nothing.
+    function hasPicture(el) {
+      if (!el) return false;
+      if (el.tagName === "VIDEO")
+        return el.videoWidth > 0 && el.readyState >= 2;
+      return true;
+    }
+
+    // The displayed picture inside el, in el's offset coordinates.
+    function contentRect(el) {
+      if (!hasPicture(el)) return null;
+      const w = el.clientWidth;
+      const h = el.clientHeight;
+      const nw = el.videoWidth || el.naturalWidth || w;
+      const nh = el.videoHeight || el.naturalHeight || h;
+      if (!w || !h || !nw || !nh) return null;
+      const s = Math.min(w / nw, h / nh);
+      const dw = nw * s;
+      const dh = nh * s;
+      return {
+        x: el.offsetLeft + (w - dw) / 2,
+        y: el.offsetTop + (h - dh) / 2,
+        w: dw,
+        h: dh,
+      };
+    }
+
+    function place() {
+      const el = media();
+      const r = el && contentRect(el);
+      if (!r) return false;
+      canvas.style.left = r.x + "px";
+      canvas.style.top = r.y + "px";
+      canvas.style.width = r.w + "px";
+      canvas.style.height = r.h + "px";
+      const cw = Math.round(r.w);
+      const ch = Math.round(r.h);
+      if (canvas.width !== cw) canvas.width = cw;
+      if (canvas.height !== ch) canvas.height = ch;
+      return true;
+    }
+
+    function draw(objects) {
+      if (!objects || !place()) {
+        canvas.style.display = "none";
+        return;
+      }
+      canvas.style.display = "";
+      const ctx = canvas.getContext("2d");
+      const w = canvas.width;
+      const h = canvas.height;
+      ctx.clearRect(0, 0, w, h);
+      ctx.lineWidth = 2;
+      ctx.font = "12px sans-serif";
+      objects.forEach((o) => {
+        const [x0, y0, x1, y1] = o.box;
+        const color = COLORS[o.label] || OTHER;
+        ctx.strokeStyle = color;
+        ctx.strokeRect(x0 * w, y0 * h, (x1 - x0) * w, (y1 - y0) * h);
+        const text = `${o.label} ${Math.round(o.score * 100)}%`;
+        const tw = ctx.measureText(text).width + 6;
+        ctx.fillStyle = color;
+        ctx.fillRect(x0 * w, Math.max(0, y0 * h - 16), tw, 16);
+        ctx.fillStyle = "#000";
+        ctx.fillText(text, x0 * w + 3, Math.max(12, y0 * h - 4));
+      });
+    }
+
+    function enabled() {
+      try {
+        return localStorage.getItem(opts.storeKey) === "1";
+      } catch (e) {
+        return false;
+      }
+    }
+
+    function setEnabled(on) {
+      try {
+        if (on) localStorage.setItem(opts.storeKey, "1");
+        else localStorage.removeItem(opts.storeKey);
+      } catch (e) {
+        /* no storage: the button still works for this page */
+      }
+    }
+
+    function open() {
+      if (feeding || !enabled() || document.hidden || !hasPicture(media()))
+        return;
+      feeding = true;
+      opts.start();
+    }
+
+    function close() {
+      if (feeding) opts.stop();
+      feeding = false;
+      draw(null);
+    }
+
+    const button = document.createElement("button");
+    button.type = "button";
+    button.id = opts.buttonId;
+    button.className = "btn btn-outline-secondary";
+    button.title = opts.title;
+    button.innerHTML = '<i class="bi bi-bounding-box"></i> Detections';
+
+    function render() {
+      const on = enabled();
+      button.classList.toggle("active", on);
+      button.setAttribute("aria-pressed", String(on));
+    }
+
+    button.addEventListener("click", () => {
+      setEnabled(!enabled());
+      render();
+      if (enabled()) open();
+      else close();
+    });
+
+    const bar = document.querySelector(".preview-header-actions");
+    if (bar) bar.appendChild(button);
+    else if (canvas.parentElement)
+      canvas.parentElement.insertAdjacentElement("beforebegin", button);
+
+    function onVisibility() {
+      if (document.hidden) close();
+      else open();
+    }
+
+    // The player gains or loses its picture: connect, disconnect, a stream
+    // switch. Feed only while there is one.
+    const player = media();
+    const PICTURE_EVENTS = ["loadeddata", "playing"];
+
+    function leave() {
+      close();
+      document.removeEventListener("visibilitychange", onVisibility);
+      window.removeEventListener("resize", place);
+      if (player && player.removeEventListener) {
+        PICTURE_EVENTS.forEach((t) => player.removeEventListener(t, open));
+        player.removeEventListener("emptied", close);
+      }
+    }
+
+    document.addEventListener("visibilitychange", onVisibility);
+    document.addEventListener("thingino:page-leave", leave, { once: true });
+    window.addEventListener("resize", place);
+    if (player && player.addEventListener) {
+      PICTURE_EVENTS.forEach((t) => player.addEventListener(t, open));
+      player.addEventListener("emptied", close);
+    }
+    render();
+    open();
+
+    return { draw, enabled };
+  }
+
+  window.thinginoDetectOverlay = { create };
+})();
diff --git a/package/thingino-raptor/files/www/a/preview-detect.js b/package/thingino-raptor/files/www/a/preview-detect.js
new file mode 100644
index 000000000..3c0a23b4e
--- /dev/null
+++ b/package/thingino-raptor/files/www/a/preview-detect.js
@@ -0,0 +1,97 @@
+/**
+ * Preview-page overlay for raptor's IVS detection: draws what rvd detects
+ * (the vendor's person detector or a JZDL model) over the live preview.
+ *
+ * rvd reports its boxes in sub-stream pixels and its classes as numbers. The
+ * feed carries the sub stream's size with them, so a box is normalised here;
+ * the sub stream is the whole frame scaled down, so the same box fits the main
+ * stream's picture. A class number becomes a name from the agent's
+ * settings/motion/labels: the model's own names file when it has one, else
+ * the names the public models were trained on.
+ *
+ * While the viewer has the Detections button on, /x/json-detect.cgi pushes the
+ * detections as server-sent events: one when they change, so the camera runs
+ * no request per update. While rvd does not detect, the feed answers
+ * {"running":false} and ends, and this asks again after a while.
+ * /a/detect-overlay.js draws, owns the button, and closes the feed while the
+ * tab is hidden and when the page is left.
+ *
+ * Plugin-owned file: registered via raptor-detect.webui.json
+ * `preview.scripts`, injected into the preview page at build time.
+ */
+(function () {
+  "use strict";
+
+  const FEED = "/x/json-detect.cgi";
+  const LABELS = "/api/v1/settings/motion/labels";
+  const DOWN_RETRY_MS = 15000;
+
+  if (!window.thinginoDetectOverlay || typeof EventSource !== "function")
+    return;
+
+  let source = null;
+  let timer = null;
+  let labels = [];
+
+  // The feed's event -> the overlay's objects.
+  function objects(ev) {
+    const w = ev.width;
+    const h = ev.height;
+    if (!w || !h) return [];
+    return (ev.detections || []).map((d) => ({
+      label: labels[d.class] || "class " + d.class,
+      score: d.confidence,
+      box: [d.x0 / w, d.y0 / h, d.x1 / w, d.y1 / h],
+    }));
+  }
+
+  function shut() {
+    if (source) source.close();
+    source = null;
+  }
+
+  function open() {
+    clearTimeout(timer);
+    timer = null;
+    if (source) return;
+    source = new EventSource(FEED);
+    source.onmessage = (msg) => {
+      let ev = null;
+      try {
+        ev = JSON.parse(msg.data);
+      } catch (e) {
+        return;
+      }
+      if (ev.running === false) {
+        shut();
+        overlay.draw(null);
+        timer = setTimeout(open, DOWN_RETRY_MS);
+        return;
+      }
+      overlay.draw(objects(ev));
+    };
+    source.onerror = () => overlay.draw(null);
+  }
+
+  const overlay = window.thinginoDetectOverlay.create({
+    canvasId: "detect-overlay",
+    buttonId: "detect-overlay-toggle",
+    storeKey: "thingino.detectOverlay",
+    title: "Show the camera's detections over the picture",
+    start() {
+      open();
+      // The names, once per start: they change with the model.
+      if (typeof agentJsonRequest === "function")
+        agentJsonRequest(LABELS, { cache: "no-store" })
+          .then((l) => {
+            labels = (l && l.labels) || [];
+          })
+          .catch(() => {});
+    },
+    stop() {
+      clearTimeout(timer);
+      timer = null;
+      shut();
+    },
+  });
+})();
